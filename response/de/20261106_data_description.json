{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-11-06T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"Ein Vulkan, ein Regenwald und ein Bambushain? Der Haleakalā-Nationalpark auf Maui bietet all das. Der Park erstreckt sich über die gesamte Insel Maui, vom 3.055 Meter hohen Gipfel bis zur Küste, und schützt Landschaften, die sich je nach Höhe, Niederschlagsmenge und Temperatur dramatisch verändern. Er wurde 1916 als Teil des Hawaii-Nationalparks gegründet und 1961 zu einem eigenständigen Nationalpark erklärt. Der Name Haleakalā bedeutet übersetzt „Haus der Sonne“ und spiegelt die hawaiianische Legende (mo’olelo) wider, wonach Māui die Sonne einfing, um den Tag zu verlängern.","Image":{"Url":"/th?id=OHR.PipiwaiTrail_DE-DE9691097479_1920x1080.webp","Wallpaper":"/th?id=OHR.PipiwaiTrail_DE-DE9691097479_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Ein grüner Tunnel durch Maui","Title":"Bambuswald, Pīpīwai Trail, Haleakalā-Nationalpark, Maui, Hawaii, USA","Copyright":"© MNStudio/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/20.760987,-156.155095/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=20.760987,-156.155095;S9;Haleakalā-Nationalpark, Maui, Hawaii&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261106_PipiwaiTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Haleakala-Nationalpark+Hawaii&form=hpcapt&filters=HpDate:\"20261105_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261106_PipiwaiTrail"},"Ssd":"20261106","Name":"PipiwaiTrail","Market":"DE-DE","Hash":"9691097479","FullDateString":"6. Nov.. 2026"},{"ImageContent":{"Description":"Ein einfacher Holzsteg führt in eine der berühmtesten Landschaften Englands. Der Lake District, ein UNESCO-Weltkulturerbe, ist ein Flickenteppich aus schimmernden Seen, schroffen Hügeln und jahrhundertealten Steinmauern.","Image":{"Url":"/th?id=OHR.StileCrossing_DE-DE6131632165_1920x1080.webp","Wallpaper":"/th?id=OHR.StileCrossing_DE-DE6131632165_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Ein Schritt näher am Gipfel","Title":"Holzsteg an einer Steinmauer, Black Crag, Lake District, England","Copyright":"© Alex Treadway/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/54.460861,-3.08875/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=54.460861,-3.08875;S9;Lake District, England&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261105_StileCrossing\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Lake+District+Vereinigtes+K%c3%b6nigreich&form=hpcapt&filters=HpDate:\"20261104_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261105_StileCrossing"},"Ssd":"20261105","Name":"StileCrossing","Market":"DE-DE","Hash":"6131632165","FullDateString":"5. Nov.. 2026"},{"ImageContent":{"Description":"In Xuancheng in der Provinz Anhui paddeln Menschen durch ein leuchtendes Labyrinth aus Sumpfzypressen, wo der Herbst die überfluteten Wälder in ein Farbenspiel aus Bernstein, Kupfer und tiefem Rost verwandelt. Die wissenschaftlich als „Taxodium distichum“ bezeichnete Sumpfzypresse ist unter den Nadelbäumen ungewöhnlich, da sie jeden Herbst ihre weichen, federartigen Nadeln abwirft, die sich vor dem Abfallen rotbraun färben.","Image":{"Url":"/th?id=OHR.AutumnChina_DE-DE5410503674_1920x1080.webp","Wallpaper":"/th?id=OHR.AutumnChina_DE-DE5410503674_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Paddeln durch ein Gemälde","Title":"Paddler zwischen farbenprächtigen Sumpfzypressen, Xuancheng, Anhui, China","Copyright":"© Jackal Pan/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/30.9525,118.75528/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=30.9525,118.75528;S9;Xuancheng, Anhui, China&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261104_AutumnChina\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Sumpfzypressen&form=hpcapt&filters=HpDate:\"20261103_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261104_AutumnChina"},"Ssd":"20261104","Name":"AutumnChina","Market":"DE-DE","Hash":"5410503674","FullDateString":"4. Nov.. 2026"},{"ImageContent":{"Description":"Der Pragser Wildsee liegt auf fast 1.500 Metern Höhe in den Südtiroler Dolomiten. Umgeben von Wäldern und den imposanten Gipfeln des Naturparks Fanes-Sennes-Prags, ist der See für sein auffallend grün-blaues Wasser bekannt. Ein 3,5 Kilometer langer Wanderweg führt um das Ufer herum, aber der Wildsee lässt sich auch mit traditionellen Holzruderbooten erkunden. Der See ist zudem Ausgangspunkt für mehrere Bergwanderungen, darunter der berühmte Alta Via 1 Höhenweg der Dolomiten.","Image":{"Url":"/th?id=OHR.AlpineBraies_DE-DE4176036164_1920x1080.webp","Wallpaper":"/th?id=OHR.AlpineBraies_DE-DE4176036164_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Stille Gipfelwelten","Title":"Pragser Wildsee, Naturpark Fanes‑Sennes‑Prags, Dolomiten, Italien","Copyright":"© leonid_tit/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/46.693566,12.084606/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=46.693566,12.084606;S9;Pragser Wildsee, Dolomiten&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261103_AlpineBraies\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Pragser+Wildsee+Dolomiten&form=hpcapt&filters=HpDate:\"20261102_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261103_AlpineBraies"},"Ssd":"20261103","Name":"AlpineBraies","Market":"DE-DE","Hash":"4176036164","FullDateString":"3. Nov.. 2026"},{"ImageContent":{"Description":"Auch wenn uns der November der Weihnachtszeit einen Schritt näherbringt, haben Eisbären andere Pläne. Sie versammeln sich an den Ufern der Hudson Bay in Manitoba, Kanada, und warten darauf, dass sich Meereis bildet, damit sie wieder auf Robbenjagd gehen können.","Image":{"Url":"/th?id=OHR.HudsonBear_DE-DE3504338986_1920x1080.webp","Wallpaper":"/th?id=OHR.HudsonBear_DE-DE3504338986_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Eine Zukunft, geprägt vom Eis","Title":"Eisbär mit Jungen, Hudson Bay, Manitoba, Kanada","Copyright":"© Danita Delimont/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"In einer einzigen Saison kann ein Eisbär auf der Suche nach Nahrung und geeigneten Eisflächen mehr als 1.000 Kilometer zurücklegen.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261102_HudsonBear\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Eisb%c3%a4ren&form=hpcapt&filters=HpDate:\"20261101_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261102_HudsonBear"},"Ssd":"20261102","Name":"HudsonBear","Market":"DE-DE","Hash":"3504338986","FullDateString":"2. Nov.. 2026"},{"ImageContent":{"Description":"Heute lassen wir den Blick über die nebelverhangene Landschaft des Schwarzwaldes schweifen, der sich über rund 160 Kilometer durch den Südwesten Deutschlands erstreckt und bewaldete Hügel, tiefe Täler, Seen und charmante Städtchen umfasst. Sein höchster Gipfel, der Feldberg, ist 1.493 Meter hoch. Der Schwarzwald ist der Ursprung der Flüsse Donau und Neckar und die Region ist reich an Geschichte und Tradition. Die Forstwirtschaft spielt hier seit jeher eine wichtige Rolle und die jahrhundertealte Uhrmachertradition hat dazu beigetragen, dass die unverwechselbare Kuckucksuhr weit über die Grenzen Deutschlands hinaus berühmt wurde.","Image":{"Url":"/th?id=OHR.SchwarzwaldAutumn_DE-DE2707949453_1920x1080.webp","Wallpaper":"/th?id=OHR.SchwarzwaldAutumn_DE-DE2707949453_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Wälder im Nebel","Title":"Schwarzwald, Baden-Württemberg","Copyright":"© Britus/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.286722,8.215281/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=48.286722,8.215281;S9;Schwarzwald, Baden-Württemberg&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261101_SchwarzwaldAutumn\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Schwarzwald+Deutschland&form=hpcapt&filters=HpDate:\"20261031_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261101_SchwarzwaldAutumn"},"Ssd":"20261101","Name":"SchwarzwaldAutumn","Market":"DE-DE","Hash":"2707949453","FullDateString":"1. Nov.. 2026"},{"ImageContent":{"Description":"Vergessen Sie die Nebelmaschine. Frankfurt am Main hat etwas weitaus Wirkungsvolleres zu bieten: eine gotische Kathedrale mit einem Turm, wie geschaffen für eine Mitternachts-Séance. Der hier abgebildete Kaiserdom St. Bartholomäus bietet die perfekte mittelalterliche Kulisse für Halloween. Doch die Geschichte dieses Feiertags ist noch gruseliger als das Foto.","Image":{"Url":"/th?id=OHR.FrankfurtHalloween_DE-DE2172526536_1920x1080.webp","Wallpaper":"/th?id=OHR.FrankfurtHalloween_DE-DE2172526536_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Der Geist vergangener Kaiserreiche","Title":"Kaiserdom St. Bartholomäus in Frankfurt am Main, Deutschland","Copyright":"© AlxeyPnferov/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/50.110766,8.68539/8?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=50.110766,8.68539;S9;Kaiserdom St. Bartholomäus, Frankfurt am Main&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261031_FrankfurtHalloween\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Halloween&form=hpcapt&filters=HpDate:\"20261030_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261031_FrankfurtHalloween"},"Ssd":"20261031","Name":"FrankfurtHalloween","Market":"DE-DE","Hash":"2172526536","FullDateString":"31. Okt.. 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"Das erste Licht der Morgendämmerung spiegelt sich auf dem vereisten Abraham Lake, eingerahmt von den Gipfeln der Rocky Mountains. Im Winter ist dieser malerische See in Alberta berühmt für seine gefrorenen Blasen aus Methangas, die unter dem Eis eingeschlossen sind. Starke Winde halten die Oberfläche schneefrei und sorgen so den ganzen Winter über für einen freien Blick. Im Frühling, wenn das Eis schmilzt, entweicht das Gas in die Atmosphäre.","Image":{"Url":"/th?id=OHR.AbrahamCanada_DE-DE1158881043_1920x1080.webp","Wallpaper":"/th?id=OHR.AbrahamCanada_DE-DE1158881043_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Verborgene Tiefen","Title":"Abraham Lake in Alberta, Kanada","Copyright":"© Guang Cao/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.1392,-116.4355/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=52.1392,-116.4355;S9;Abraham Lake, Alberta&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261113_AbrahamCanada\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Abraham+Lake+Stausee+Kanada&form=hpcapt&filters=HpDate:\"20261112_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261113_AbrahamCanada"},"Ssd":"20261113","Name":"AbrahamCanada","Market":"DE-DE","Hash":"1158881043","FullDateString":"13. Nov.. 2026"},{"ImageContent":{"Description":"Der nördlich von Moab gelegene Arches-Nationalpark in der Wüste von Utah beherbergt mehr als 2.000 natürliche Sandsteinbögen – die weltweit größte Konzentration solcher Felsformationen. Das heutige Bild zeigt das „North Window“, eine der bekanntesten Formen in der „Windows Section“ des Parks, wo hoch aufragende Felsrippen, Durchbrüche und geformter Sandstein eine Landschaft schaffen, die fast schon architektonisch anmutet","Image":{"Url":"/th?id=OHR.NorthWindow_DE-DE3364064033_1920x1080.webp","Wallpaper":"/th?id=OHR.NorthWindow_DE-DE3364064033_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Architektur ohne Architekten","Title":"North Window, Arches-Nationalpark, Moab, Utah, USA","Copyright":"© lightphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.6857117,-109.5328291/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=38.6857117,-109.5328291;S9;North Window, Arches-Nationalpark, Moab, Utah&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261112_NorthWindow\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Arches-Nationalpark+Utah&form=hpcapt&filters=HpDate:\"20261111_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261112_NorthWindow"},"Ssd":"20261112","Name":"NorthWindow","Market":"DE-DE","Hash":"3364064033","FullDateString":"12. Nov.. 2026"},{"ImageContent":{"Description":"Der Atlantische Regenwald ist einer der weltweit bedeutendsten Hotspots der Artenvielfalt und erstreckt sich über einen Großteil der brasilianischen Atlantikküste bis nach Argentinien und Paraguay. Seine Landschaft umfasst tropische und subtropische Wälder, Mangroven und küstennahe Lebensräume und bietet rund 20.000 Pflanzenarten sowie einer außergewöhnlichen Vielfalt an Wildtieren, darunter Jaguare und Goldlöwenäffchen, eine Heimat. Ein Großteil des Waldes ist im Laufe der Jahrhunderte verschwunden, doch er spielt weiterhin eine wichtige Rolle bei der Speicherung von Kohlenstoff und der Versorgung von Millionen von Menschen in der gesamten Region mit Süßwasser.","Image":{"Url":"/th?id=OHR.Atlantica_DE-DE2362030432_1920x1080.webp","Wallpaper":"/th?id=OHR.Atlantica_DE-DE2362030432_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Ein Wald voller Wunder","Title":"Der Atlantische Regenwald, Brasilien","Copyright":"© FG Trade/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Im Atlantischen Regenwald leben rund 150 Millionen Menschen, was etwa einem Drittel der Gesamtbevölkerung Südamerikas entspricht.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261111_Atlantica\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Atlantischer+Regenwald+Brasilien&form=hpcapt&filters=HpDate:\"20261110_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261111_Atlantica"},"Ssd":"20261111","Name":"Atlantica","Market":"DE-DE","Hash":"2362030432","FullDateString":"11. Nov.. 2026"},{"ImageContent":{"Description":"Von oben betrachtet wirkt Rose Island wie ein grüner Pinselstrich, umgeben von allen erdenklichen Blauschattierungen. Nur fünf Kilometer östlich von Paradise Island auf den Bahamas, bietet diese schlanke Insel weniger belebte Straßen und Stadtviertel, aber dafür mehr Sandstrände, seichtes Wasser und eine Lagune im Landesinneren. Ihr friedliches Erscheinungsbild wird von einer Prise filmischer Dramatik unterstrichen: Rose Island diente als Drehort für das James-Bond-Abenteuer „Thunderball“ aus dem Jahr 1965, einschließlich der explosiven Zerstörung der „Disco Volante“.","Image":{"Url":"/th?id=OHR.RoseIsland_DE-DE1760101963_1920x1080.webp","Wallpaper":"/th?id=OHR.RoseIsland_DE-DE1760101963_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Die Lizenz zum Chillen","Title":"Luftaufnahme von Rose Island, Bahamas","Copyright":"© Abstract Aerial Art/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/25.088243,-77.225304/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=25.088243,-77.225304;S9;Rose Island, Bahamas&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261110_RoseIsland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Rose+Island+Bahamas&form=hpcapt&filters=HpDate:\"20261109_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261110_RoseIsland"},"Ssd":"20261110","Name":"RoseIsland","Market":"DE-DE","Hash":"1760101963","FullDateString":"10. Nov.. 2026"},{"ImageContent":{"Description":"Der 9. November 1989 war ein historischer Tag für Berlin und Deutschland. Am Abend verkündete der DDR-Politiker Günter Schabowski auf einer Pressekonferenz neue Reiseregelungen. Auf die Frage, wann diese gelten sollten, antwortete er voreilig und versehentlich, dies sei „sofort“ und „unverzüglich“ der Fall. Daraufhin strömten Tausende Menschen zu den Grenzübergängen in Berlin. Die Grenzsoldaten waren auf den großen Andrang nicht vorbereitet und öffneten schließlich die Übergänge.","Image":{"Url":"/th?id=OHR.MauerBerlin_DE-DE4395338070_1920x1080.webp","Wallpaper":"/th?id=OHR.MauerBerlin_DE-DE4395338070_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"Die Nacht, die Deutschland veränderte","Title":"Schüler spähen durch einen Spalt in einem noch erhaltenen Abschnitt der Berliner Mauer","Copyright":"© Sean Gallup/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.520008,13.404954/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=52.520008,13.404954;S9;Berlin, Deutschland&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261109_MauerBerlin\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Fall+der+Berliner+Mauer&form=hpcapt&filters=HpDate:\"20261108_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261109_MauerBerlin"},"Ssd":"20261109","Name":"MauerBerlin","Market":"DE-DE","Hash":"4395338070","FullDateString":"9. Nov.. 2026"},{"ImageContent":{"Description":"Was ist los, wenn die dunkelste Nacht des Jahres zum strahlendsten Fest wird? Dann ist Diwali! Das Lichterfest wird weltweit von Millionen Menschen gefeiert und steht ganz im Zeichen von Diyas, Laternen, Rangoli, Gebeten, Süßigkeiten und Familientreffen.","Image":{"Url":"/th?id=OHR.DiwaliLamps_DE-DE0703233561_1920x1080.webp","Wallpaper":"/th?id=OHR.DiwaliLamps_DE-DE0703233561_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Ein strahlendes Fest","Title":"Laternen für Diwali, Mumbai, Maharashtra, Indien","Copyright":"© Dinodia Photo/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/18.969048,72.821182/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=18.969048,72.821182;S9;Mumbai, Maharashtra, Indien&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261108_DiwaliLamps\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Diwali&form=hpcapt&filters=HpDate:\"20261107_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261108_DiwaliLamps"},"Ssd":"20261108","Name":"DiwaliLamps","Market":"DE-DE","Hash":"0703233561","FullDateString":"8. Nov.. 2026"},{"ImageContent":{"Description":"Obwohl er oft als Büffel bezeichnet wird, gehört der amerikanische Bison nicht zu den echten Büffeln, die in Afrika und Asien beheimatet sind. Sein wissenschaftlicher Name „Bison bison”, lässt wenig Raum für Verwechslungen. Dieses nordamerikanische Säugetier kann bis zu 900 Kilo wiegen und dennoch mit einer Geschwindigkeit von fast 60 km/h sprinten. Sein muskulöser Schulterhöcker hilft ihm den Kopf hin und her zu schwingen, um Schnee beiseite zu schieben und so an das darunter liegende Gras zu gelangen. Sowohl Männchen als auch Weibchen haben Hörner und einen Bart. Schwanzbewegungen geben Aufschluss über ihre Stimmung: Schwanzwedeln signalisiert in der Regel Gelassenheit, während ein gehobener Schwanz auf Unruhe hindeuten kann.","Image":{"Url":"/th?id=OHR.DakotaBison_DE-DE0154878283_1920x1080.webp","Wallpaper":"/th?id=OHR.DakotaBison_DE-DE0154878283_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Der zurückgekehrte Riese","Title":"Ein Bison in der Grassteppe des Theodore-Roosevelt-Nationalparks, Nord-Dakota, USA","Copyright":"© Tandem Stock/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/47.275714,-103.463282/3?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=de-DE&od=2&shading=flat&pp=47.275714,-103.463282;S9;Theodore-Roosevelt-Nationalpark, Nord-Dakota&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261107_DakotaBison\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Bisons&form=hpcapt&filters=HpDate:\"20261106_2300\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261107_DakotaBison"},"Ssd":"20261107","Name":"DakotaBison","Market":"DE-DE","Hash":"0154878283","FullDateString":"7. Nov.. 2026"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"Bild des Tages","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"Weitere Informationen","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"Kurzinfo:","LOC_HOMEPAGE_GALLERY_CARD_TITLE":"Letzte Bilder der Homepage","LOC_HOMEPAGE_VERTICAL_SCROLL_GALLERY_IMAGE_ARIALABEL":"Homepage-Bild am {0}","LOC_HOMEPAGE_ON_THIS_DAY_TITLE":"An diesem Tag in der Geschichte","LOC_HOMEPAGE_ON_THIS_DAY_IMAGE_ARIALABEL":"An diesem Tag in {0}, {1}","LOC_HOMEPAGE_SHARE_TOOLTIP":"Heutige Bing-Startseite teilen","LOC_HOMEPAGE_WALLPAPERDOWNLOAD_TOOLTIP":"Dieses Bild herunterladen. Dieses Bild darf nur als Hintergrundbild verwendet werden.","LOC_HOMEPAGE_WALLPAPERNOTAVAILABLE":"Dieses Bild steht nicht zum Download als Hintergrundbild zur Verfügung.","LOC_HOMEPAGE_INFO_TEXT":"Info","LOC_BING_WP_APP_LINK":"https://go