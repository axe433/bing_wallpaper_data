{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-25T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"On Lanzarote, part of Spain's Canary Islands, geology got carried away. Dark sand meets the Atlantic beneath cliffs streaked with ochre and rust, the handiwork of volcanic activity spanning millions of years. One chapter of this story arrived remarkably recently: between 1730 and 1736, numerous vents opened across Lanzarote, sending lava over dozens of square kilometres and burying roads, villages and farmland.","Image":{"Url":"/th?id=OHR.ElGolfo_EN-CA7672858081_1920x1080.webp","Wallpaper":"/th?id=OHR.ElGolfo_EN-CA7672858081_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Ash meets splash","Title":"Aerial view of black lava beach, El Golfo, Lanzarote, Canary Islands, Spain","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/28.978999,-13.829368/3?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=28.978999,-13.829368;S9;El Golfo, Lanzarote, Canary Islands, Spain&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260924_ElGolfo\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Lanzarote+Spain&form=hpcapt&filters=HpDate:\"20260924_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260924_ElGolfo"},"Ssd":"20260924","Name":"ElGolfo","Market":"EN-CA","Hash":"7672858081","FullDateString":"Sep 24, 2026"},{"ImageContent":{"Description":"Most landmarks were built by history. This one was built for a story. Hobbiton Movie Set sits in Matamata, New Zealand, on a working sheep farm that caught the eye of filmmakers scouting locations for The Lord of the Rings in 1998. The hills already looked Shire-like; round doors, tidy gardens and curling chimneys completed the illusion. The set was later rebuilt for The Hobbit films and became a destination for those eager to step into Middle-earth.","Image":{"Url":"/th?id=OHR.TolkienWeek_EN-CA7225706887_1920x1080.webp","Wallpaper":"/th?id=OHR.TolkienWeek_EN-CA7225706887_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Beyond the last page","Title":"Hobbit house at Hobbiton Movie Set, Matamata, New Zealand","Copyright":"© djr-photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-37.8721,175.682907/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=-37.8721,175.682907;S9;Hobbiton Movie Set, Matamata, New Zealand&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260923_TolkienWeek\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Tolkien+Week&form=hpcapt&filters=HpDate:\"20260923_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260923_TolkienWeek"},"Ssd":"20260923","Name":"TolkienWeek","Market":"EN-CA","Hash":"7225706887","FullDateString":"Sep 23, 2026"},{"ImageContent":{"Description":"The autumn equinox marks a turning point in the Northern Hemisphere. Occurring each September, it is the moment when the sun crosses the equator heading south, and day and night are nearly equal in length. After this celestial balance, daylight gradually shrinks as the journey towards winter begins.","Image":{"Url":"/th?id=OHR.FallAspens_EN-CA6568286298_1920x1080.webp","Wallpaper":"/th?id=OHR.FallAspens_EN-CA6568286298_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The golden season","Title":"Fall aspen trees near Guardsman Pass, Utah, United States","Copyright":"© Danita Delimont/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"The North and South Poles are illuminated by sunlight at the same time only during the equinoxes.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260922_FallAspens\"&FORM=HPQUIZ","BackstageUrl":"/search?q=September+equinox&form=hpcapt&filters=HpDate:\"20260922_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260922_FallAspens"},"Ssd":"20260922","Name":"FallAspens","Market":"EN-CA","Hash":"6568286298","FullDateString":"Sep 22, 2026"},{"ImageContent":{"Description":"Few animals can claim to be both expert groomers and guardians of underwater forests. That's why Sea Otter Awareness Week, held each year during the last full week of September, encourages people to discover more about these remarkable marine mammals and the challenges they face.","Image":{"Url":"/th?id=OHR.GroomingOtter_EN-CA5802555233_1920x1080.webp","Wallpaper":"/th?id=OHR.GroomingOtter_EN-CA5802555233_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Life between fur and sea","Title":"Sea otter grooming fur, Monterey Bay, California, United States","Copyright":"© Suzi Eszterhas/Minden Pictures","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.800739,-121.947311/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=36.800739,-121.947311;S9;Monterey Bay, California, United States&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260921_GroomingOtter\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Sea+Otter+Awareness+Week&form=hpcapt&filters=HpDate:\"20260921_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260921_GroomingOtter"},"Ssd":"20260921","Name":"GroomingOtter","Market":"EN-CA","Hash":"5802555233","FullDateString":"Sep 21, 2026"},{"ImageContent":{"Description":"No other city is nearly as romanticised as Paris. Yet the French capital's history has not always been as rosy as the sunset glowing behind the Eiffel Tower. Built for the 1889 Exposition Universelle, or the World's Fair, which marked the centennial of the start of the French Revolution, the tower was originally intended to serve as the fair's entrance centrepiece. Designed by engineer Gustave Eiffel and his team, the iron landmark rose 300 metres above the Champ de Mars and became the tallest structure in the world at the time.","Image":{"Url":"/th?id=OHR.ParisSunset_EN-CA5063473686_1920x1080.webp","Wallpaper":"/th?id=OHR.ParisSunset_EN-CA5063473686_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The tower that won Paris over","Title":"Eiffel Tower at sunset, Paris, France","Copyright":"© Alexander Spatari/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.85341,2.3488/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=48.85341,2.3488;S9;Paris, France&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260920_ParisSunset\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Paris&form=hpcapt&filters=HpDate:\"20260920_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260920_ParisSunset"},"Ssd":"20260920","Name":"ParisSunset","Market":"EN-CA","Hash":"5063473686","FullDateString":"Sep 20, 2026"},{"ImageContent":{"Description":"As Oktoberfest opens today, visitors arriving in Bavaria, Germany, may hear a sound even older than the famous festival itself: the deep, resonant voice of the alphorn. This traditional Alpine instrument is closely linked to the culture of Bavaria, Austria and Switzerland, where it once helped shepherds communicate across mountain valleys.","Image":{"Url":"/th?id=OHR.AlphornBavaria_EN-CA4386550572_1920x1080.webp","Wallpaper":"/th?id=OHR.AlphornBavaria_EN-CA4386550572_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"The Alpine sound of Oktoberfest","Title":"Alphorn players, Bavaria, Germany","Copyright":"© U. J. Alexander/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Oktoberfest began in 1810 as a celebration of the wedding of Bavarian Crown Prince Ludwig and Princess Therese.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260919_AlphornBavaria\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Oktoberfest&form=hpcapt&filters=HpDate:\"20260919_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260919_AlphornBavaria"},"Ssd":"20260919","Name":"AlphornBavaria","Market":"EN-CA","Hash":"4386550572","FullDateString":"Sep 19, 2026"},{"ImageContent":{"Description":"A long, winding road cuts through rocks more than 300 million years old in England's Peak District. As if that geological timescale were not remarkable enough, the road passes through Winnats Pass, a narrow limestone gorge whose towering cliffs reveal the ancient seas that once covered this part of Britain.","Image":{"Url":"/th?id=OHR.WinnatsPassPeak_EN-CA3554895186_1920x1080.webp","Wallpaper":"/th?id=OHR.WinnatsPassPeak_EN-CA3554895186_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Through the heart of the pass","Title":"Winnats Pass, Peak District National Park, England","Copyright":"© Daniel_Kay/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/53.339626,-1.798998/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=53.339626,-1.798998;S9;Winnats Pass, Peak District National Park, England&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260918_WinnatsPassPeak\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Peak+District+National+Park&form=hpcapt&filters=HpDate:\"20260918_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260918_WinnatsPassPeak"},"Ssd":"20260918","Name":"WinnatsPassPeak","Market":"EN-CA","Hash":"3554895186","FullDateString":"Sep 18, 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"In 1890, Yosemite became America's third national park. More than a century later, it still feels like a place that operates on geological time rather than human schedules. From Olmsted Point, the overlook in today's image, that timescale is impossible to miss. The smooth granite underfoot was sculpted by glaciers, while scattered boulders known as glacial erratics were carried here by ice and abandoned when it melted.","Image":{"Url":"/th?id=OHR.OlmstedPoint_EN-CA1947517359_1920x1080.webp","Wallpaper":"/th?id=OHR.OlmstedPoint_EN-CA1947517359_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Reading time in granite","Title":"Sunset from Olmsted Point, Yosemite National Park, California, United States","Copyright":"© Robb Hirsch/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.850924,-119.572719/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=37.850924,-119.572719;S9;Yosemite National Park, California, United States&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261001_OlmstedPoint\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Yosemite+National+Park&form=hpcapt&filters=HpDate:\"20261001_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261001_OlmstedPoint"},"Ssd":"20261001","Name":"OlmstedPoint","Market":"EN-CA","Hash":"1947517359","FullDateString":"Oct 1, 2026"},{"ImageContent":{"Description":"Balanced on a slender stalk in Norfolk, England, the male bearded reedling in today's image stands out with a pale blue-grey head, a bright orange bill and the black facial markings that give the species its name. Despite its striking appearance, this small bird spends much of its life hidden among the dense wetland vegetation of marshes, lakeshores and reed beds.","Image":{"Url":"/th?id=OHR.BeardReedling_EN-CA1270469815_1920x1080.webp","Wallpaper":"/th?id=OHR.BeardReedling_EN-CA1270469815_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A face you don't forget","Title":"Male bearded reedling, Norfolk, England","Copyright":"© Andrew Sproule/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Bearded reedlings are found across much of Europe and Asia, from Britain's wetlands to reed beds stretching across Central and East Asia.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260930_BeardReedling\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Bearded+reedling&form=hpcapt&filters=HpDate:\"20260930_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260930_BeardReedling"},"Ssd":"20260930","Name":"BeardReedling","Market":"EN-CA","Hash":"1270469815","FullDateString":"Sep 30, 2026"},{"ImageContent":{"Description":"Seen from above, the Kasilof River winds like a ribbon of turquoise through Alaska's Kenai Peninsula. The vivid blue water comes from glacial silt carried downstream from Tustumena Lake, one of the largest freshwater lakes in the state. Flowing about 27 kilometres before emptying into Cook Inlet, the river is shorter than its famous neighbour, the Kenai, but no less remarkable.","Image":{"Url":"/th?id=OHR.KasilofRiver_EN-CA0207893749_1920x1080.webp","Wallpaper":"/th?id=OHR.KasilofRiver_EN-CA0207893749_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Born of glaciers","Title":"The blue, glacier-fed waters of the Kasilof River, Alaska, United States","Copyright":"© jared lloyd/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/60.386498454,-151.301832126/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=60.386498454,-151.301832126;S9;Kasilof River, Alaska, United States&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260929_KasilofRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Kasilof+River+Alaska&form=hpcapt&filters=HpDate:\"20260929_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260929_KasilofRiver"},"Ssd":"20260929","Name":"KasilofRiver","Market":"EN-CA","Hash":"0207893749","FullDateString":"Sep 29, 2026"},{"ImageContent":{"Description":"Most first-time visitors know Jaipur, in Rajasthan, India, as the Pink City, but the earlier royal capital was centred on Amber Fort. That's where much of the dynasty's political and architectural history was shaped. The fort developed over more than a century, beginning under Raja Man Singh I in 1592 and continuing under later Kachwaha rulers who controlled the kingdom that eventually became Jaipur State. The royal family moved to the newly planned city of Jaipur in 1727, but Amber continued to serve ceremonial functions.","Image":{"Url":"/th?id=OHR.AmberHall_EN-CA9553208557_1920x1080.webp","Wallpaper":"/th?id=OHR.AmberHall_EN-CA9553208557_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"History with a view","Title":"Sattais Katcheri Hall in Amber Fort near Jaipur, Rajasthan, India","Copyright":"© R.M. Nunes/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/26.986382,75.851341/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=26.986382,75.851341;S9;Amber Fort, Jaipur, Rajasthan, India&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260928_AmberHall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Amber+Fort+Jaipur+Rajasthan&form=hpcapt&filters=HpDate:\"20260928_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260928_AmberHall"},"Ssd":"20260928","Name":"AmberHall","Market":"EN-CA","Hash":"9553208557","FullDateString":"Sep 28, 2026"},{"ImageContent":{"Description":"Think of this as underwater hide-and-seek: the sea pen stands out while the crab blends in. Today's image comes from the waters surrounding Komodo National Park in Indonesia, established in 1980 and named after the Komodo dragon, the world's largest living lizard. The protected area includes islands, mangroves, seagrass beds and coral reefs. Located between the Pacific and Indian Oceans, the park is shaped by powerful currents that support a rich diversity of marine life, including species that rely on camouflage to survive.","Image":{"Url":"/th?id=OHR.DecoCrab_EN-CA9118939695_1920x1080.webp","Wallpaper":"/th?id=OHR.DecoCrab_EN-CA9118939695_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Night garden of the deep","Title":"Decorator crab on a sea pen, Komodo National Park, Indonesia","Copyright":"© Alex Mustard/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-8.527705,119.483323/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=-8.527705,119.483323;S9;Komodo National Park, Indonesia&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260927_DecoCrab\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Komodo+National+Park&form=hpcapt&filters=HpDate:\"20260927_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260927_DecoCrab"},"Ssd":"20260927","Name":"DecoCrab","Market":"EN-CA","Hash":"9118939695","FullDateString":"Sep 27, 2026"},{"ImageContent":{"Description":"People have been coming to Niagara Falls, on the Canada-US border, for centuries to admire the view. A few, however, decided admiring it from a safe distance was overrated. In 1901, Annie Edson Taylor climbed into a barrel and became the first recorded person to survive going over the Falls. Others followed with their own stunts, although such attempts are now illegal. The Falls have also inspired artists, filmmakers and musicians, with Hollywood giving them a starring role in 'Niagara' (1953), featuring Marilyn Monroe and Joseph Cotten.","Image":{"Url":"/th?id=OHR.NiagaraOnt_EN-CA8662967301_1920x1080.webp","Wallpaper":"/th?id=OHR.NiagaraOnt_EN-CA8662967301_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Niagara's afterparty look","Title":"Horseshoe Falls illuminated at night in Niagara Falls, Ontario","Copyright":"© Jianmei Wang/E+/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/43.082273,-79.075963/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-CA&od=2&shading=flat&pp=43.082273,-79.075963;S9;Horseshoe Falls, Niagara Falls, Ontario&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260926_NiagaraOnt\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Horseshoe+Falls&form=hpcapt&filters=HpDate:\"20260926_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260926_NiagaraOnt"},"Ssd":"20260926","Name":"NiagaraOnt","Market":"EN-CA","Hash":"8662967301","FullDateString":"Sep 26, 2026"},{"ImageContent":{"Description":"What if the full moon were the guest of honour at your family dinner? That is the idea behind the Mid-Autumn Festival, also known as the Moon Festival. Celebrated on the 15th day of the eighth lunar month, it is one of the most important festivals in Chinese culture. Its roots trace back more than 3,000 years to moon-honouring rituals during the Zhou Dynasty. Its best-known legend tells of Chang'e, who drank an elixir of immortality and rose to the moon.","Image":{"Url":"/th?id=OHR.MidAutumn2026_EN-CA8501373237_1920x1080.webp","Wallpaper":"/th?id=OHR.MidAutumn2026_EN-CA8501373237_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"When the moon joins the party","Title":"Chinese lanterns for Mid-Autumn Festival celebration","Copyright":"© LeeYiuTung/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"A record-breaking mooncake in China once weighed nearly 13 tonnes and measured over 7 metres wide.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260925_MidAutumn2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Mid+Autumn+Festival&form=hpcapt&filters=HpDate:\"20260925_0400\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260925_MidAutumn2026"},"Ssd":"20260925","Name":"MidAutumn2026","Market":"EN-CA","Hash":"8501373237","F