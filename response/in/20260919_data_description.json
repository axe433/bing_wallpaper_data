{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-19T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"As Oktoberfest opens today, visitors arriving in Bavaria, Germany, may hear a sound even older than the famous festival itself: the deep, resonant voice of the alphorn. This traditional Alpine instrument is closely linked to Bavaria, Austria and Switzerland, where it once helped shepherds communicate across mountain valleys.","Image":{"Url":"/th?id=OHR.AlphornBavaria_EN-IN7812928124_1920x1080.webp","Wallpaper":"/th?id=OHR.AlphornBavaria_EN-IN7812928124_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"The Alpine sound of Oktoberfest","Title":"Alphorn players, Bavaria, Germany","Copyright":"© U. J. Alexander/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Oktoberfest began in 1810 as a celebration of the wedding of Bavarian Crown Prince Ludwig and Princess Therese.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260919_AlphornBavaria\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Oktoberfest&form=hpcapt&filters=HpDate:\"20260918_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260919_AlphornBavaria"},"Ssd":"20260919","Name":"AlphornBavaria","Market":"EN-IN","Hash":"7812928124","FullDateString":"19 Sept, 2026"},{"ImageContent":{"Description":"A long, winding road cuts through rocks more than 300 million years old in England's Peak District. As if that geological timescale were not remarkable enough, the road passes through Winnats Pass, a narrow limestone gorge whose towering cliffs reveal the ancient seas that once covered this part of Britain.","Image":{"Url":"/th?id=OHR.WinnatsPassPeak_EN-IN7644884043_1920x1080.webp","Wallpaper":"/th?id=OHR.WinnatsPassPeak_EN-IN7644884043_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Through the heart of the pass","Title":"Winnats Pass, Peak District National Park, England","Copyright":"© Daniel_Kay/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/53.339626,-1.798998/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-IN&od=2&shading=flat&pp=53.339626,-1.798998;S9;Winnats Pass, Peak District National Park, England&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260918_WinnatsPassPeak\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Peak+District+National+Park&form=hpcapt&filters=HpDate:\"20260917_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260918_WinnatsPassPeak"},"Ssd":"20260918","Name":"WinnatsPassPeak","Market":"EN-IN","Hash":"7644884043","FullDateString":"18 Sept, 2026"},{"ImageContent":{"Description":"Each year, late summer and early autumn bring one of France's most anticipated traditions: the 'vendanges,' the grape-picking season. The timing varies from one wine region to another and depends on weather conditions, sun exposure and the ripeness of the fruit. For many vineyards, harvest is still a hands-on effort, with teams carefully selecting bunches destined for some of the country's most celebrated wines.","Image":{"Url":"/th?id=OHR.Santenay_EN-IN8437955164_1920x1080.webp","Wallpaper":"/th?id=OHR.Santenay_EN-IN8437955164_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A toast to the harvest","Title":"Sorine windmill and vineyards, Santenay wine region, Côte de Beaune, Burgundy, France","Copyright":"© Marco Bottigelli/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/46.913044,4.696484/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-IN&od=2&shading=flat&pp=46.913044,4.696484;S9;Santenay, Côte de Beaune, France&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260917_Santenay\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Santenay+wine+region&form=hpcapt&filters=HpDate:\"20260916_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260917_Santenay"},"Ssd":"20260917","Name":"Santenay","Market":"EN-IN","Hash":"8437955164","FullDateString":"17 Sept, 2026"},{"ImageContent":{"Description":"Two polar bear cubs pick their way across the snow in Svalbard, a remote Norwegian archipelago of glaciers, mountains and frozen fjords deep in the Arctic Ocean. This wild landscape is part of the Barents Sea region, home to one of the world's largest polar bear populations, with around 2,600 bears.","Image":{"Url":"/th?id=OHR.IcyCubs_EN-IN8228486187_1920x1080.webp","Wallpaper":"/th?id=OHR.IcyCubs_EN-IN8228486187_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The Arctic's new explorers","Title":"Polar bear cubs playing in Svalbard, Norway","Copyright":"© Danny Green/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/78.719849,20.349333/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-IN&od=2&shading=flat&pp=78.719849,20.349333;S9;Svalbard, Norway&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260916_IcyCubs\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Polar+bear&form=hpcapt&filters=HpDate:\"20260915_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260916_IcyCubs"},"Ssd":"20260916","Name":"IcyCubs","Market":"EN-IN","Hash":"8228486187","FullDateString":"16 Sept, 2026"},{"ImageContent":{"Description":"Evolution occasionally favours maximalism. Just look at these red-and-green macaws with their scarlet plumage, vivid green wings and blue flight feathers. Their lives unfold across tropical South America, in a routine that connects fruit, seeds and soil in ways that are easy to miss from the ground.","Image":{"Url":"/th?id=OHR.RedMacawsFlight_EN-IN8058515331_1920x1080.webp","Wallpaper":"/th?id=OHR.RedMacawsFlight_EN-IN8058515331_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Survival of the flashiest","Title":"Red-and-green macaws","Copyright":"© markes51/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Large macaws can exert bite pressures of several hundred PSI, far greater than the average human bite, allowing them to crack tough nuts and seeds with ease.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260915_RedMacawsFlight\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Red+and+green+macaw&form=hpcapt&filters=HpDate:\"20260914_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260915_RedMacawsFlight"},"Ssd":"20260915","Name":"RedMacawsFlight","Market":"EN-IN","Hash":"8058515331","FullDateString":"15 Sept, 2026"},{"ImageContent":{"Description":"In today's image, kochia plants spread across the landscape in China in shades of green and deep red. Native to parts of Eurasia, kochia was introduced to the United States in the late 1800s as an ornamental plant and a source of material for broom making. Its ability to withstand drought, heat, saline soils and low rainfall helped it spread across the Great Plains and much of the American West.","Image":{"Url":"/th?id=OHR.KochiaChina_EN-IN7950718460_1920x1080.webp","Wallpaper":"/th?id=OHR.KochiaChina_EN-IN7950718460_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Where toughness takes root","Title":"Field of kochia plants, China","Copyright":"© lingqi xie/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Kochia is a member of the amaranth family, sharing botanical ties with beets, spinach, and quinoa.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260914_KochiaChina\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Kochia+plant&form=hpcapt&filters=HpDate:\"20260913_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260914_KochiaChina"},"Ssd":"20260914","Name":"KochiaChina","Market":"EN-IN","Hash":"7950718460","FullDateString":"14 Sept, 2026"},{"ImageContent":{"Description":"The image captures the jagged skyline of Cadini di Misurina at sunrise in Veneto, northeastern Italy. Visitors heading towards nearby Tre Cime di Lavaredo often come for the famous route only to find their attention hijacked by the Cadini. Part of the Dolomites, these needle-like peaks reaching more than 2,800 metres at their highest point seem sculpted for drama. The twist? They started out as ancient coral reefs.","Image":{"Url":"/th?id=OHR.MisurinaPeak_EN-IN7734195824_1920x1080.webp","Wallpaper":"/th?id=OHR.MisurinaPeak_EN-IN7734195824_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A reef above its station","Title":"Cadini di Misurina, Dolomites, Veneto, Italy","Copyright":"© Vithun Khamsong/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/46.573096,12.276032/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-IN&od=2&shading=flat&pp=46.573096,12.276032;S9;Cadini di Misurina, Dolomites, Veneto, Italy&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260913_MisurinaPeak\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Cadini+di+Misurina+Dolomites&form=hpcapt&filters=HpDate:\"20260912_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260913_MisurinaPeak"},"Ssd":"20260913","Name":"MisurinaPeak","Market":"EN-IN","Hash":"7734195824","FullDateString":"13 Sept, 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"What do a bear's ears, a house on fire and a road packed with hairpin turns have in common? They're all part of the story of southeastern Utah's public lands.","Image":{"Url":"/th?id=OHR.BearsEars_EN-IN8507636618_1920x1080.webp","Wallpaper":"/th?id=OHR.BearsEars_EN-IN8507636618_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The stories written across the land","Title":"Cedar Mesa and Muley Point near Bears Ears National Monument, Utah, United States","Copyright":"© Jeff Clay/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.630001,-109.867653/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-IN&od=2&shading=flat&pp=37.630001,-109.867653;S9;Bears Ears, Utah, United States&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260926_BearsEars\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Bears+Ears+National+Monument&form=hpcapt&filters=HpDate:\"20260925_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260926_BearsEars"},"Ssd":"20260926","Name":"BearsEars","Market":"EN-IN","Hash":"8507636618","FullDateString":"26 Sept, 2026"},{"ImageContent":{"Description":"What if the full moon were the guest of honour at your family dinner? That is the idea behind the Mid-Autumn Festival, also known as the Moon Festival. Celebrated on the 15th day of the eighth lunar month, it is one of the most important festivals in Chinese culture. Its roots trace back more than 3,000 years to moon-honouring rituals during the Zhou Dynasty. Its best-known legend tells of Chang'e, who drank an elixir of immortality and rose to the moon.","Image":{"Url":"/th?id=OHR.MidAutumn2026_EN-IN8396341266_1920x1080.webp","Wallpaper":"/th?id=OHR.MidAutumn2026_EN-IN8396341266_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"When the moon joins the party","Title":"Chinese lanterns for Mid-Autumn Festival celebration","Copyright":"© LeeYiuTung/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"A record-breaking mooncake in China once weighed nearly 12 tonnes and measured about 8 metres wide.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260925_MidAutumn2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Mid+Autumn+Festival&form=hpcapt&filters=HpDate:\"20260924_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260925_MidAutumn2026"},"Ssd":"20260925","Name":"MidAutumn2026","Market":"EN-IN","Hash":"8396341266","FullDateString":"25 Sept, 2026"},{"ImageContent":{"Description":"Most landmarks were built by history. This one was built for a story. Hobbiton Movie Set sits in Matamata, New Zealand, on a working sheep farm that caught the eye of filmmakers scouting locations for 'The Lord of the Rings' in 1998. The hills already looked Shire-like; round doors, tidy gardens and curling chimneys completed the illusion. The set was later rebuilt for 'The Hobbit' films and became a destination for those eager to step into Middle-earth.","Image":{"Url":"/th?id=OHR.TolkienWeek_EN-IN8323924749_1920x1080.webp","Wallpaper":"/th?id=OHR.TolkienWeek_EN-IN8323924749_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Beyond the last page","Title":"Hobbit house at Hobbiton Movie Set, Matamata, New Zealand","Copyright":"© djr-photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-37.8721,175.682907/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-IN&od=2&shading=flat&pp=-37.8721,175.682907;S9;Hobbiton Movie Set, Matamata, New Zealand&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260924_TolkienWeek\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Tolkien+Week&form=hpcapt&filters=HpDate:\"20260923_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260924_TolkienWeek"},"Ssd":"20260924","Name":"TolkienWeek","Market":"EN-IN","Hash":"8323924749","FullDateString":"24 Sept, 2026"},{"ImageContent":{"Description":"The autumn equinox marks a turning point in the Northern Hemisphere. Occurring each September, it is the moment when the sun crosses the equator heading south, and day and night are nearly equal in length. After this celestial balance, daylight gradually shrinks as the journey towards winter begins.","Image":{"Url":"/th?id=OHR.FallAspens_EN-IN8196194133_1920x1080.webp","Wallpaper":"/th?id=OHR.FallAspens_EN-IN8196194133_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The golden season","Title":"Autumn aspen trees near Guardsman Pass, Utah, United States","Copyright":"© Danita Delimont/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"The North and South Poles are illuminated by sunlight at the same time only during the equinoxes.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260923_FallAspens\"&FORM=HPQUIZ","BackstageUrl":"/search?q=September+equinox&form=hpcapt&filters=HpDate:\"20260922_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260923_FallAspens"},"Ssd":"20260923","Name":"FallAspens","Market":"EN-IN","Hash":"8196194133","FullDateString":"23 Sept, 2026"},{"ImageContent":{"Description":"On Lanzarote, part of Spain's Canary Islands, geology got carried away. Dark sand meets the Atlantic beneath cliffs streaked with ochre and rust, the handiwork of volcanic activity spanning millions of years. One chapter of this story arrived remarkably recently: between 1730 and 1736, numerous vents opened across Lanzarote, sending lava over dozens of square kilometres and burying roads, villages and farmland.","Image":{"Url":"/th?id=OHR.ElGolfo_EN-IN8071994539_1920x1080.webp","Wallpaper":"/th?id=OHR.ElGolfo_EN-IN8071994539_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Ash meets splash","Title":"Aerial view of black lava beach, El Golfo, Lanzarote, Canary Islands, Spain","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/28.978999,-13.829368/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-IN&od=2&shading=flat&pp=28.978999,-13.829368;S9;El Golfo, Lanzarote, Canary Islands, Spain&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260922_ElGolfo\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Lanzarote+Spain&form=hpcapt&filters=HpDate:\"20260921_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260922_ElGolfo"},"Ssd":"20260922","Name":"ElGolfo","Market":"EN-IN","Hash":"8071994539","FullDateString":"22 Sept, 2026"},{"ImageContent":{"Description":"Few animals are both expert groomers and guardians of underwater forests. In today's image, a sea otter grooms its fur in Monterey Bay, California—a daily ritual essential to its survival. Sea otters have the densest fur of any animal, with up to one million hairs per square inch. Unlike seals and whales, they have little blubber, so their thick, air-trapping coat provides insulation against the cold Pacific.","Image":{"Url":"/th?id=OHR.GroomingOtter_EN-IN7966484109_1920x1080.webp","Wallpaper":"/th?id=OHR.GroomingOtter_EN-IN7966484109_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Life between fur and sea","Title":"Sea otter grooming fur, Monterey Bay, California, United States","Copyright":"© Suzi Eszterhas/Minden Pictures","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.800739,-121.947311/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-IN&od=2&shading=flat&pp=36.800739,-121.947311;S9;Monterey Bay, California, United States&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260921_GroomingOtter\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Sea+otters&form=hpcapt&filters=HpDate:\"20260920_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260921_GroomingOtter"},"Ssd":"20260921","Name":"GroomingOtter","Market":"EN-IN","Hash":"7966484109","FullDateString":"21 Sept, 2026"},{"ImageContent":{"Description":"No other city is nearly as romanticised as Paris. Yet the French capital's history has not always been as rosy as the sunset glowing behind the Eiffel Tower. Built for the 1889 Exposition Universelle, or the World's Fair, which marked the centennial of the start of the French Revolution, the tower was originally intended to serve as the fair's entrance centrepiece. Designed by engineer Gustave Eiffel and his team, the iron landmark rose more than 300 metres above the Champ de Mars and became the tallest structure in the world at the time.","Image":{"Url":"/th?id=OHR.ParisSunset_EN-IN7894876294_1920x1080.webp","Wallpaper":"/th?id=OHR.ParisSunset_EN-IN7894876294_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The tower that won Paris over","Title":"Eiffel Tower at sunset, Paris, France","Copyright":"© Alexander Spatari/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.85341,2.3488/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-IN&od=2&shading=flat&pp=48.85341,2.3488;S9;Paris, France&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260920_ParisSunset\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Paris&form=hpcapt&filters=HpDate:\"20260919_1830\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260920_ParisSunset"},"Ssd":"20260920","Name":"ParisSunset","Market":"EN-IN","Hash":"7894876294","FullDateString":"20 Sept, 2026"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"दिन की छवि","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"अधिक जानें","LOC_HOMEPAGE_VERTICAL_SCROLL_DONATE_NOW":"अभी दान दें","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"त्वरित तथ्य:","LOC_HOMEPAGE_GALLERY_CARD_TITLE":"हाल ही की मुख पृष्ठ छवियाँ","LOC_HOMEPAGE_VERTICAL_SCROLL_GALLERY_IMAGE_ARIALABEL":"{0} की मुख्य पृष्ठ छवि","LOC_HOMEPAGE_ON_THIS_DAY_TITLE":"इतिहास में आज के दिन","LOC_HOMEPAGE_ON_THIS_DAY_IMAGE_ARIALABEL":"{0}, {1} में इस दिन","LOC_HOMEPAGE_SHARE_TOOLTIP":"आज का Bing मुखपृष्ठ साझा करें","LOC_HOMEPAGE_WALLPAPERDOWNLOAD_TOOLTIP":"इस छवि को डाउनलोड करें. इस छवि का उपयोग केवल वॉलपेपर तक प्रतिबंधित है.","LOC_MUSCARD_DOWNLOAD_LINK":"यह छवि डाउनलोड करें","LOC_HOMEPAGE_WALLPAPERNOTAVAILABLE":"यह छवि वॉलपेपर के रूप में डाउनलोड करने के लिए उपलब्ध नहीं है.","LOC_HOMEPAGE_INFO_TEXT":"जानकारी","LOC_BING_WP_APP_LINK":"https://go.microsoft.com/fwlink/?linkid=2127455","LOC_BING_WP