{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-10-03T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"Los osos pardos del Parque Nacional y Reserva del lago Clark, en Alaska (Estados Unidos), viven ahora su temporada de comidas copiosas. En octubre aprovechan todo lo que queda disponible, desde peces y juncias hasta bayas, raíces y almejas, porque cada gramo cuenta: algunos superan los 450 kilogramos antes de meterse en la osera, y esa grasa es lo único que los sostendrá durante un invierno sin comer ni beber.","Image":{"Url":"/th?id=OHR.GrizzlySwim_ES-ES2255914104_1920x1080.webp","Wallpaper":"/th?id=OHR.GrizzlySwim_ES-ES2255914104_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Pescar, comer y repetir","Title":"Oso pardo en Silver Salmon Creek, Parque Nacional y Reserva del lago Clark, Alaska, EE. UU.","Copyright":"© Danny Green/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/61.147081,-153.734242/3?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=61.147081,-153.734242;S9;Parque Nacional y Reserva del lago Clark, Alaska, EE. UU.&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261003_GrizzlySwim\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Oso+pardo&form=hpcapt&filters=HpDate:\"20261002_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261003_GrizzlySwim"},"Ssd":"20261003","Name":"GrizzlySwim","Market":"ES-ES","Hash":"2255914104","FullDateString":"3 de oct de 2026"},{"ImageContent":{"Description":"El río Chattooga baja por los montes Apalaches, en Carolina del Norte (Estados Unidos), y es uno de los tramos de aguas bravas más celebrados del sureste del país. Nace en plena montaña y durante kilómetros marca la frontera entre Georgia, Carolina del Norte y Carolina del Sur, encajonado entre laderas boscosas y escalones de roca.","Image":{"Url":"/th?id=OHR.ChattoogaRiver_ES-ES4729549409_1920x1080.webp","Wallpaper":"/th?id=OHR.ChattoogaRiver_ES-ES4729549409_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Aguas bravas entre bosques","Title":"Río Chattooga en los montes Apalaches, Carolina del Norte, EE. UU.","Copyright":"© mtilghma/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.080936,-83.109932/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=35.080936,-83.109932;S9;Río Chattooga, Carolina del Norte, EE.UU.&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261002_ChattoogaRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Montes+Apalaches&form=hpcapt&filters=HpDate:\"20261001_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261002_ChattoogaRiver"},"Ssd":"20261002","Name":"ChattoogaRiver","Market":"ES-ES","Hash":"4729549409","FullDateString":"2 de oct de 2026"},{"ImageContent":{"Description":"En El Golfo, en la costa oeste de Lanzarote (Canarias, España), la geología perdió toda contención: arena negra, acantilados con vetas ocres y el Atlántico rompiendo sin tregua. El pueblo es un puñado de casas blancas dedicadas a la pesca y al pescado fresco.","Image":{"Url":"/th?id=OHR.ElGolfo_ES-ES8850772045_1920x1080.webp","Wallpaper":"/th?id=OHR.ElGolfo_ES-ES8850772045_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Arena volcánica y olas salvajes","Title":"Vista aérea de la playa de lava negra, El Golfo, Lanzarote, Islas Canarias, España","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/28.978999,-13.829368/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=28.978999,-13.829368;S9;El Golfo, Lanzarote, Islas Canarias, España&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261001_ElGolfo\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Lanzarote&form=hpcapt&filters=HpDate:\"20260930_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261001_ElGolfo"},"Ssd":"20261001","Name":"ElGolfo","Market":"ES-ES","Hash":"8850772045","FullDateString":"1 de oct de 2026"},{"ImageContent":{"Description":"Sujeto a un tallo en Norfolk (Inglaterra), el macho de bigotudo luce cabeza gris azulada, pico naranja y esas dos manchas negras que le dan nombre, más parecidas a unas patillas que a un bigote. Vive escondido en los carrizales, y casi siempre lo delata su reclamo metálico antes que su figura.","Image":{"Url":"/th?id=OHR.BeardReedling_ES-ES8271136302_1920x1080.webp","Wallpaper":"/th?id=OHR.BeardReedling_ES-ES8271136302_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Un canto inolvidable","Title":"Macho de bigotudo, Norfolk, Inglaterra","Copyright":"© Andrew Sproule/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260930_BeardReedling\"&FORM=HPQUIZ","BackstageUrl":"/search?q=bigotudo+Panurus+biarmicus&form=hpcapt&filters=HpDate:\"20260929_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260930_BeardReedling"},"Ssd":"20260930","Name":"BeardReedling","Market":"ES-ES","Hash":"8271136302","FullDateString":"30 de sept de 2026"},{"ImageContent":{"Description":"Visto desde el aire, el río Kasilof dibuja una cinta turquesa sobre la península Kenai, en Alaska (EE. UU.). Ese color no es un efecto de la luz: procede del limo glaciar en suspensión que baja desde el lago Tustumena, uno de los mayores de agua dulce del estado, alimentado a su vez por un glaciar de los montes Kenai.","Image":{"Url":"/th?id=OHR.KasilofRiver_ES-ES8214443142_1920x1080.webp","Wallpaper":"/th?id=OHR.KasilofRiver_ES-ES8214443142_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Nacidos de glaciares","Title":"Las aguas azules alimentadas por glaciares del río Kasilof, Alaska, EE. UU.","Copyright":"© jared lloyd/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/60.386498454,-151.301832126/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=60.386498454,-151.301832126;S9;Río Kasilof, Alaska, EE. UU.&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260929_KasilofRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=R%c3%ado+Kasilof+Alaska&form=hpcapt&filters=HpDate:\"20260928_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260929_KasilofRiver"},"Ssd":"20260929","Name":"KasilofRiver","Market":"ES-ES","Hash":"8214443142","FullDateString":"29 de sept de 2026"},{"ImageContent":{"Description":"El Fuerte de Amber, junto a Jaipur (Rajastán, India), fue la capital real antes de que existiera la ciudad rosa. Su construcción arrancó en 1592 con Raja Man Singh I y continuó más de un siglo bajo los soberanos kachwaha; en 1727 la corte se mudó a la nueva Jaipur, aunque Amber siguió acogiendo ceremonias.","Image":{"Url":"/th?id=OHR.AmberHall_ES-ES8111355480_1920x1080.webp","Wallpaper":"/th?id=OHR.AmberHall_ES-ES8111355480_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Los 27 pilares de la historia","Title":"Sattais Katcheri en el Fuerte de Amber cerca de Jaipur, Rajasthan, India","Copyright":"© R.M. Nunes/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/26.986382,75.851341/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=26.986382,75.851341;S9;Fuerte de Amber, Jaipur, Rajasthan, India&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260928_AmberHall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Fuerte+Amber&form=hpcapt&filters=HpDate:\"20260927_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260928_AmberHall"},"Ssd":"20260928","Name":"AmberHall","Market":"ES-ES","Hash":"8111355480","FullDateString":"28 de sept de 2026"},{"ImageContent":{"Description":"En los fondos del Parque Nacional de Komodo (Indonesia), un cangrejo decorador se refugia sobre una pluma de mar, ese coral blando que se ancla al sedimento y se despliega como un abanico. La estrategia es sencilla y brillante: la pluma llama la atención y el cangrejo desaparece.","Image":{"Url":"/th?id=OHR.DecoCrab_ES-ES3779382499_1920x1080.webp","Wallpaper":"/th?id=OHR.DecoCrab_ES-ES3779382499_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Jardín nocturno en la profundidad","Title":"Cangrejo decorador en una pluma marina, Parque Nacional de Komodo, Indonesia","Copyright":"© Alex Mustard/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-8.527705,119.483323/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=-8.527705,119.483323;S9;Parque Nacional de Komodo, Indonesia&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260927_DecoCrab\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Parque+Nacional+de+Komodo&form=hpcapt&filters=HpDate:\"20260926_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260927_DecoCrab"},"Ssd":"20260927","Name":"DecoCrab","Market":"ES-ES","Hash":"3779382499","FullDateString":"27 de sept de 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"La Catedral-Basílica de Nuestra Señora del Pilar se asoma al Ebro en Zaragoza (Aragón, España), y hoy arranca a su alrededor la semana grande de la ciudad: el pregón abre unas Fiestas del Pilar que se prolongan hasta el domingo 18 de octubre.","Image":{"Url":"/th?id=OHR.ZaragozaBasilica_ES-ES1990532240_1920x1080.webp","Wallpaper":"/th?id=OHR.ZaragozaBasilica_ES-ES1990532240_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Hoy: Zara-goza","Title":"Catedral-Basílica de Nuestra Señora del Pilar, Zaragoza, Aragón, España","Copyright":"© frantic00/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.656992,-0.878791/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=41.656992,-0.878791;S9;Catedral-Basílica de Nuestra Señora del Pilar, Zaragoza, España&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261010_ZaragozaBasilica\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Fiestas+del+Pilar&form=hpcapt&filters=HpDate:\"20261009_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261010_ZaragozaBasilica"},"Ssd":"20261010","Name":"ZaragozaBasilica","Market":"ES-ES","Hash":"1990532240","FullDateString":"10 de oct de 2026"},{"ImageContent":{"Description":"Frente a la costa de Córcega (Francia), las islas Sanguinarias emergen del Mediterráneo como un pequeño archipiélago de cuatro islotes rocosos y escarpados. Vistos desde una antigua torre de vigilancia, custodian la entrada del golfo de Ajaccio, y aunque el más alejado queda a menos de dos kilómetros de tierra firme, el conjunto transmite un aislamiento sorprendente, moldeado por el viento, las olas y el salitre.","Image":{"Url":"/th?id=OHR.IlesSanguinaires_ES-ES4266688471_1920x1080.webp","Wallpaper":"/th?id=OHR.IlesSanguinaires_ES-ES4266688471_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Los centinelas de Córcega","Title":"Vista de las islas Sanguinarias desde Córcega, Francia","Copyright":"© Francesco Riccardo Iacomino/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.88166,8.59779/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=41.88166,8.59779;S9;Islas Sanguinarias, Córcega, Francia&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261009_IlesSanguinaires\"&FORM=HPQUIZ","BackstageUrl":"/search?q=islas+Sanguinarias&form=hpcapt&filters=HpDate:\"20261008_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261009_IlesSanguinaires"},"Ssd":"20261009","Name":"IlesSanguinaires","Market":"ES-ES","Hash":"4266688471","FullDateString":"9 de oct de 2026"},{"ImageContent":{"Description":"Frente a las costas de Mayotte (Francia), en el océano Índico, este pulpo ha adoptado una postura defensiva que viene a decir: quien se acerque, que se lo piense mejor. Es una advertencia con estilo, porque en lugar de coraza confía en la transformación.","Image":{"Url":"/th?id=OHR.MayotteOctopus_ES-ES3892391318_1920x1080.webp","Wallpaper":"/th?id=OHR.MayotteOctopus_ES-ES3892391318_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Ahora me ves, ahora no","Title":"Pulpo en postura defensiva, Mayotte, Francia, océano Índico","Copyright":"© Gabriel Barathieu/Minden Pictures","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-12.822125,45.148273/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=-12.822125,45.148273;S9;Mayotte, Francia, océano Índico&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261008_MayotteOctopus\"&FORM=HPQUIZ","BackstageUrl":"/search?q=D%c3%ada+Mundial+del+Pulpo&form=hpcapt&filters=HpDate:\"20261007_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261008_MayotteOctopus"},"Ssd":"20261008","Name":"MayotteOctopus","Market":"ES-ES","Hash":"3892391318","FullDateString":"8 de oct de 2026"},{"ImageContent":{"Description":"En Puzzlewood, junto a Coleford, en el Bosque de Dean (Inglaterra), los senderos serpentean entre árboles retorcidos, rocas tapizadas de musgo y gargantas de piedra que hacen dudar en cada curva. Esas formaciones tan raras se llaman scowles: cavidades naturales que quedaron al descubierto con el tiempo y que después se explotaron para extraer hierro, ya en época romana o incluso antes. En 1848, un trabajador encontró más de 3.000 monedas romanas escondidas en vasijas dentro de una grieta.","Image":{"Url":"/th?id=OHR.ForestofDean_ES-ES3526600939_1920x1080.webp","Wallpaper":"/th?id=OHR.ForestofDean_ES-ES3526600939_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"¿Perdido? Sigue el sendero","Title":"Rocas cubiertas de musgo en Puzzlewood, Bosque de Dean, Gloucestershire, Inglaterra","Copyright":"© Fulcanelli_AOS/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/51.812183,-2.516615/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=51.812183,-2.516615;S9;Bosque de Dean, Gloucestershire, Inglaterra&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261007_ForestofDean\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Puzzlewood+Bosque+de+Dean&form=hpcapt&filters=HpDate:\"20261006_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261007_ForestofDean"},"Ssd":"20261007","Name":"ForestofDean","Market":"ES-ES","Hash":"3526600939","FullDateString":"7 de oct de 2026"},{"ImageContent":{"Description":"En el Geoparque Nacional de Zhangye, en Gansu (China), las montañas cuentan su historia geológica a rayas: las lomas se suceden en bandas rojas, naranjas, amarillas y ocres. Es el relieve Danxia, formado por capas sedimentarias que los movimientos tectónicos levantaron y plegaron, y que la erosión terminó de esculpir en crestas, barrancos y farallones.","Image":{"Url":"/th?id=OHR.DanxiaLandform_ES-ES4557489111_1920x1080.webp","Wallpaper":"/th?id=OHR.DanxiaLandform_ES-ES4557489111_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"La Tierra contada a rayas","Title":"Relieve Danxia, Geoparque Nacional de Zhangye, Gansu, China","Copyright":"© Weiquan Lin/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.966774,100.04408/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=es-ES&od=2&shading=flat&pp=38.966774,100.04408;S9;Geoparque Nacional de Zhangye, Gansu, China&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261006_DanxiaLandform\"&FORM=HPQUIZ","BackstageUrl":"/search?q=D%c3%ada+Internacional+de+la+Geodiversidad&form=hpcapt&filters=HpDate:\"20261005_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261006_DanxiaLandform"},"Ssd":"20261006","Name":"DanxiaLandform","Market":"ES-ES","Hash":"4557489111","FullDateString":"6 de oct de 2026"},{"ImageContent":{"Description":"¿Qué puede enseñarnos un pingüino de Adelia, un ave de apenas setenta centímetros? Bastante. En el Día Mundial de los Docentes, esta especie de las costas de la Antártida ofrece una lección de ingenio, resistencia y algo de picaresca. Debe su nombre a Adèle, esposa del explorador francés Jules Dumont d'Urville, que dio con la especie durante una expedición en 1840.","Image":{"Url":"/th?id=OHR.AdelieTeacher_ES-ES0045236370_1920x1080.webp","Wallpaper":"/th?id=OHR.AdelieTeacher_ES-ES0045236370_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Al agua, lección a lección","Title":"Pingüinos de Adelia, Antártida","Copyright":"© Otto Plantema/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Los pingüinos de Adelia no tienen dientes: en la lengua y el paladar presentan púas afiladas orientadas hacia atrás, llamadas papilas.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261005_AdelieTeacher\"&FORM=HPQUIZ","BackstageUrl":"/search?q=D%c3%ada+Mundial+de+los+Docentes&form=hpcapt&filters=HpDate:\"20261004_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261005_AdelieTeacher"},"Ssd":"20261005","Name":"AdelieTeacher","Market":"ES-ES","Hash":"0045236370","FullDateString":