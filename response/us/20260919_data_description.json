{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-19T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"A long, winding road cuts through rocks more than 300 million years old in England's Peak District. As if that geological timescale were not remarkable enough, the road passes through Winnats Pass, a narrow limestone gorge whose towering cliffs reveal the ancient seas that once covered this part of Britain.","Image":{"Url":"/th?id=OHR.WinnatsPassPeak_EN-US6112068451_1920x1080.webp","Wallpaper":"/th?id=OHR.WinnatsPassPeak_EN-US6112068451_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Through the heart of the pass","Title":"Winnats Pass, Peak District National Park, England","Copyright":"© Daniel_Kay/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/53.339626,-1.798998/9?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=53.339626,-1.798998;S9;Winnats Pass, Peak District National Park, England&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260918_WinnatsPassPeak\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Peak+District+National+Park&form=hpcapt&filters=HpDate:\"20260918_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260918_WinnatsPassPeak"},"Ssd":"20260918","Name":"WinnatsPassPeak","Market":"EN-US","Hash":"6112068451","FullDateString":"Sep 18, 2026"},{"ImageContent":{"Description":"Each year, late summer and early fall bring one of France's most anticipated traditions: the 'vendanges,' the grape-picking season. The timing varies from one wine region to another and depends on weather conditions, sun exposure, and the ripeness of the fruit. For many vineyards, harvest is still a hands-on effort, with teams carefully selecting bunches destined for some of the country's most celebrated wines.","Image":{"Url":"/th?id=OHR.Santenay_EN-US5299702509_1920x1080.webp","Wallpaper":"/th?id=OHR.Santenay_EN-US5299702509_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A toast to the harvest","Title":"Sorine windmill and vineyards, Santenay wine region, Côte de Beaune, Burgundy, France","Copyright":"© Marco Bottigelli/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/46.913044,4.696484/8?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=46.913044,4.696484;S9;Santenay, Côte de Beaune, France&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260917_Santenay\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Santenay+wine+region&form=hpcapt&filters=HpDate:\"20260917_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260917_Santenay"},"Ssd":"20260917","Name":"Santenay","Market":"EN-US","Hash":"5299702509","FullDateString":"Sep 17, 2026"},{"ImageContent":{"Description":"Two polar bear cubs pick their way across the snow in Svalbard, a remote Norwegian archipelago of glaciers, mountains, and frozen fjords deep in the Arctic Ocean. This wild landscape is part of the Barents Sea region, home to one of the world's largest polar bear populations, with around 2,600 bears.","Image":{"Url":"/th?id=OHR.IcyCubs_EN-US5222104616_1920x1080.webp","Wallpaper":"/th?id=OHR.IcyCubs_EN-US5222104616_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The Arctic's new explorers","Title":"Polar bear cubs playing in Svalbard, Norway","Copyright":"© Danny Green/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/78.719849,20.349333/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=78.719849,20.349333;S9;Svalbard, Norway&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260916_IcyCubs\"&FORM=HPQUIZ","BackstageUrl":"/search?q=polar+bear&form=hpcapt&filters=HpDate:\"20260916_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260916_IcyCubs"},"Ssd":"20260916","Name":"IcyCubs","Market":"EN-US","Hash":"5222104616","FullDateString":"Sep 16, 2026"},{"ImageContent":{"Description":"Today marks the first day of Hispanic Heritage Month, a nationwide celebration honoring the histories, cultures, and contributions of Americans with roots in Spain, Mexico, the Caribbean, and Central and South America. Observed each year from September 15 to October 15, the month begins on a date that coincides with the independence anniversaries of several Latin American nations, including Costa Rica, El Salvador, Guatemala, Honduras, and Nicaragua.","Image":{"Url":"/th?id=OHR.FortUnion_EN-US5138724452_1920x1080.webp","Wallpaper":"/th?id=OHR.FortUnion_EN-US5138724452_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A crossroad of cultures","Title":"Fort Union National Monument, New Mexico","Copyright":"© zrfphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.906501,-105.011522/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=35.906501,-105.011522;S9;Fort Union National Monument, New Mexico&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260915_FortUnion\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Hispanic+Heritage+Month&form=hpcapt&filters=HpDate:\"20260915_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260915_FortUnion"},"Ssd":"20260915","Name":"FortUnion","Market":"EN-US","Hash":"5138724452","FullDateString":"Sep 15, 2026"},{"ImageContent":{"Description":"In today's image, kochia plants spread across the landscape in China in shades of green and deep red. Native to parts of Eurasia, kochia was introduced to the United States in the late 1800s as an ornamental plant and a source of material for broom making. Its ability to withstand drought, heat, saline soils, and low rainfall helped it spread across the Great Plains and much of the American West.","Image":{"Url":"/th?id=OHR.KochiaChina_EN-US5037126636_1920x1080.webp","Wallpaper":"/th?id=OHR.KochiaChina_EN-US5037126636_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Where toughness takes root","Title":"Field of kochia plants, China","Copyright":"© lingqi xie/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Kochia is a member of the amaranth family, sharing botanical ties with beets, spinach, and quinoa.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260914_KochiaChina\"&FORM=HPQUIZ","BackstageUrl":"/search?q=kochia+plant&form=hpcapt&filters=HpDate:\"20260914_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260914_KochiaChina"},"Ssd":"20260914","Name":"KochiaChina","Market":"EN-US","Hash":"5037126636","FullDateString":"Sep 14, 2026"},{"ImageContent":{"Description":"The image captures the jagged skyline of Cadini di Misurina at sunrise in Veneto, northeastern Italy. Visitors heading toward nearby Tre Cime di Lavaredo often come for the famous route only to find their attention hijacked by the Cadini. Part of the Dolomites, these needle-like peaks reaching more than 9,300 feet at their highest point seem sculpted for drama. The twist? They started out as ancient coral reefs.","Image":{"Url":"/th?id=OHR.MisurinaPeak_EN-US4897144498_1920x1080.webp","Wallpaper":"/th?id=OHR.MisurinaPeak_EN-US4897144498_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A reef above its station","Title":"Cadini di Misurina, Dolomites, Veneto, Italy","Copyright":"© Vithun Khamsong/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/46.573096,12.276032/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=46.573096,12.276032;S9;Cadini di Misurina, Dolomites, Veneto, Italy&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260913_MisurinaPeak\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Cadini+di+Misurina+Dolomites&form=hpcapt&filters=HpDate:\"20260913_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260913_MisurinaPeak"},"Ssd":"20260913","Name":"MisurinaPeak","Market":"EN-US","Hash":"4897144498","FullDateString":"Sep 13, 2026"},{"ImageContent":{"Description":"A day at the beach is rarely quiet when California sea lions are around. With their booming barks, playful personalities, and a knack for stealing the spotlight, these marine mammals know how to put on a show.","Image":{"Url":"/th?id=OHR.SardineBait_EN-US4802395270_1920x1080.webp","Wallpaper":"/th?id=OHR.SardineBait_EN-US4802395270_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Masters of the surf and shore","Title":"California sea lions hunting a sardine bait ball, offshore Mexico, Pacific Ocean","Copyright":"© Henley Spiers/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"California sea lions can dive as deep as 1,000 feet and hold their breath for up to 10 minutes.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260912_SardineBait\"&FORM=HPQUIZ","BackstageUrl":"/search?q=California+sea+lion&form=hpcapt&filters=HpDate:\"20260912_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260912_SardineBait"},"Ssd":"20260912","Name":"SardineBait","Market":"EN-US","Hash":"4802395270","FullDateString":"Sep 12, 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"What if the full moon were the guest of honor at your family dinner? That is the idea behind the Mid-Autumn Festival, also known as the Moon Festival. Celebrated on the 15th day of the eighth lunar month, it is one of the most important festivals in Chinese culture. Its roots trace back more than 3,000 years to moon-honoring rituals during the Zhou Dynasty. Its best-known legend tells of Chang'e, who drank an elixir of immortality and rose to the moon.","Image":{"Url":"/th?id=OHR.MidAutumn2026_EN-US9341405351_1920x1080.webp","Wallpaper":"/th?id=OHR.MidAutumn2026_EN-US9341405351_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"When the moon joins the party","Title":"Chinese lanterns for Mid-Autumn Festival celebration","Copyright":"© LeeYiuTung/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"A record-breaking mooncake in China once weighed nearly 13 tons and measured over 26 feet wide.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260925_MidAutumn2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Mid+Autumn+Festival&form=hpcapt&filters=HpDate:\"20260925_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260925_MidAutumn2026"},"Ssd":"20260925","Name":"MidAutumn2026","Market":"EN-US","Hash":"9341405351","FullDateString":"Sep 25, 2026"},{"ImageContent":{"Description":"On Lanzarote, part of Spain's Canary Islands, geology got carried away. Dark sand meets the Atlantic beneath cliffs streaked with ocher and rust, the handiwork of volcanic activity spanning millions of years. One chapter of this story arrived remarkably recently: between 1730 and 1736, numerous vents opened across Lanzarote, sending lava over dozens of square miles and burying roads, villages, and farmland.","Image":{"Url":"/th?id=OHR.ElGolfo_EN-US9261454857_1920x1080.webp","Wallpaper":"/th?id=OHR.ElGolfo_EN-US9261454857_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Ash meets splash","Title":"Aerial view of black lava beach, El Golfo, Lanzarote, Canary Islands, Spain","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/28.978999,-13.829368/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=28.978999,-13.829368;S9;El Golfo, Lanzarote, Canary Islands, Spain&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260924_ElGolfo\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Lanzarote+Spain&form=hpcapt&filters=HpDate:\"20260924_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260924_ElGolfo"},"Ssd":"20260924","Name":"ElGolfo","Market":"EN-US","Hash":"9261454857","FullDateString":"Sep 24, 2026"},{"ImageContent":{"Description":"Most landmarks were built by history. This one was built for a story. Hobbiton Movie Set sits in Matamata, New Zealand, on a working sheep farm that caught the eye of filmmakers scouting locations for The Lord of the Rings in 1998. The hills already looked Shire-like; round doors, tidy gardens, and curling chimneys completed the illusion. The set was later rebuilt for The Hobbit films and became a destination for those eager to step into Middle-earth.","Image":{"Url":"/th?id=OHR.TolkienWeek_EN-US7313336185_1920x1080.webp","Wallpaper":"/th?id=OHR.TolkienWeek_EN-US7313336185_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Beyond the last page","Title":"Hobbit house at Hobbiton Movie Set, Matamata, New Zealand","Copyright":"© djr-photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-37.8721,175.682907/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=-37.8721,175.682907;S9;Hobbiton Movie Set, Matamata, New Zealand&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260923_TolkienWeek\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Tolkien+Week&form=hpcapt&filters=HpDate:\"20260923_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260923_TolkienWeek"},"Ssd":"20260923","Name":"TolkienWeek","Market":"EN-US","Hash":"7313336185","FullDateString":"Sep 23, 2026"},{"ImageContent":{"Description":"The autumn equinox marks a turning point in the Northern Hemisphere. Occurring each September, it is the moment when the sun crosses the equator heading south, and day and night are nearly equal in length. After this celestial balance, daylight gradually shrinks as the journey toward winter begins.","Image":{"Url":"/th?id=OHR.FallAspens_EN-US7211031109_1920x1080.webp","Wallpaper":"/th?id=OHR.FallAspens_EN-US7211031109_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The golden season","Title":"Fall aspen trees near Guardsman Pass, Utah, USA","Copyright":"© Danita Delimont/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"The North and South Poles are illuminated by sunlight at the same time only during the equinoxes.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260922_FallAspens\"&FORM=HPQUIZ","BackstageUrl":"/search?q=september+equinox&form=hpcapt&filters=HpDate:\"20260922_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260922_FallAspens"},"Ssd":"20260922","Name":"FallAspens","Market":"EN-US","Hash":"7211031109","FullDateString":"Sep 22, 2026"},{"ImageContent":{"Description":"Few animals can claim to be both expert groomers and guardians of underwater forests. That's why Sea Otter Awareness Week, held each year during the last full week of September, encourages people to discover more about these remarkable marine mammals and the challenges they face.","Image":{"Url":"/th?id=OHR.GroomingOtter_EN-US6710084372_1920x1080.webp","Wallpaper":"/th?id=OHR.GroomingOtter_EN-US6710084372_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Life between fur and sea","Title":"Sea otter grooming fur, Monterey Bay, California","Copyright":"© Suzi Eszterhas/Minden Pictures","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.800739,-121.947311/8?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=36.800739,-121.947311;S9;Monterey Bay, California&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260921_GroomingOtter\"&FORM=HPQUIZ","BackstageUrl":"/search?q=sea+otter+awareness+week&form=hpcapt&filters=HpDate:\"20260921_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260921_GroomingOtter"},"Ssd":"20260921","Name":"GroomingOtter","Market":"EN-US","Hash":"6710084372","FullDateString":"Sep 21, 2026"},{"ImageContent":{"Description":"No other city is nearly as romanticized as Paris. Yet the French capital's history has not always been as rosy as the sunset glowing behind the Eiffel Tower. Built for the 1889 Exposition Universelle, or the World's Fair, which marked the centennial of the start of the French Revolution, the tower was originally intended to serve as the fair's entrance centerpiece. Designed by engineer Gustave Eiffel and his team, the iron landmark rose nearly 1,000 feet above the Champ de Mars and became the tallest structure in the world at the time.","Image":{"Url":"/th?id=OHR.ParisSunset_EN-US6532307523_1920x1080.webp","Wallpaper":"/th?id=OHR.ParisSunset_EN-US6532307523_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The tower that won Paris over","Title":"Eiffel Tower at sunset, Paris, France","Copyright":"© Alexander Spatari/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.85341,2.3488/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=48.85341,2.3488;S9;Paris, France&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260920_ParisSunset\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Paris&form=hpcapt&filters=HpDate:\"20260920_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260920_ParisSunset"},"Ssd":"20260920","Name":"ParisSunset","Market":"EN-US","Hash":"6532307523","FullDateString":"Sep 20, 2026"},{"ImageContent":{"Description":"As Oktoberfest opens today, visitors arriving in Bavaria, Germany may hear a sound even older than the famous festival itself: the deep, resonant voice of the alphorn. This traditional Alpine instrument is closely linked to the culture of Bavaria, Austria, and Switzerland, where it once helped shepherds communicate across mountain valleys.","Image":{"Url":"/th?id=OHR.AlphornBavaria_EN-US6200857270_1920x1080.webp","Wallpaper":"/th?id=OHR.AlphornBavaria_EN-US6200857270_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"The Alpine sound of Oktoberfest","Title":"Alphorn players, Bavaria, Germany","Copyright":"© U. J. Alexander/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Oktoberfest began in 1810 as a celebration of the wedding of Bavarian Crown Prince Ludwig and Princess Therese.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260919_AlphornBavaria\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Oktoberfest&form=hpcapt&filters=HpDate:\"20260919_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260919_AlphornBavaria"},"Ssd":"20260919","Name":"AlphornBavaria","Market":"EN-US","Hash":"6200857270","FullDateString":"Sep 19, 2026"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"Image of the day","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"Learn more","LOC_HOMEPAGE_VERTICAL_SCROLL_DONATE_NOW":"Donate now","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"Quick fact:","LOC_HOMEPAGE_GALLERY_CARD_TITLE":"Recent Homepage images","LOC_HOMEPAGE_VERTICAL_SCROLL_GALLERY_IMAGE_ARIALABEL":"Homepage image for {0}","LOC_HOMEPAGE_ON_THIS_DAY_TITLE":"On this day in history","LOC_HOMEPAGE_ON_THIS_DAY_IMAGE_ARIALABEL":"On this day in {0}, {1}","LOC_HOMEPAGE_SHARE_TOOLTIP":"Share today's Bing homepage","LOC_HOMEPAGE_WALLPAPERDOWNLOAD_TOOLTIP":"Download this image. Use of this image is restricted to wallpaper only.","LOC_MUSCARD_DOWNLOAD_LINK":"Download this image","LOC_HOMEPAGE_WALLPAPERNOTAVAILABLE":"This image is not available to download as wallpaper.","LOC_HOMEPAGE_INFO_TEXT":"Info","LOC_BING_WP_APP_LINK":"https://go.microsoft.com/fwlink/?linkid=2127455","LOC_BING_WP_APP_LINK_TEXT":"Get the Bing Wallpaper ap