{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-08-01T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"Some railways retire. The Virginia Creeper Trail simply changed gears. Stretching 34.3 miles through southwest Virginia, this trail follows a former rail line once used to haul lumber and iron ore through the Appalachian Mountains. Its unusual name traces back to the steam locomotives that labored up steep grades in the early 1900s.","Image":{"Url":"/th?id=OHR.VirginiaTrail_EN-US9403114082_1920x1080.webp","Wallpaper":"/th?id=OHR.VirginiaTrail_EN-US9403114082_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Trailing through time","Title":"Aerial view of the Virginia Creeper Trail, Damascus, Virginia","Copyright":"© Eifel Kreutz/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.631287,-81.783826/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=36.631287,-81.783826;S9;Virginia Creeper Trail, Damascus, Virginia&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260731_VirginiaTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Virginia+Creeper+Trail&form=hpcapt&filters=HpDate:\"20260731_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260731_VirginiaTrail"},"Ssd":"20260731","Name":"VirginiaTrail","Market":"EN-US","Hash":"9403114082","FullDateString":"Jul 31, 2026"},{"ImageContent":{"Description":"Some landscapes are famous. Monument Valley is legendary. Straddling the Arizona–Utah border within the Navajo Nation, this desert wonder is shaped by towering sandstone buttes that rise as much as 1,000 feet above the valley floor. Known in Navajo as Tsé Bii' Ndzisgaii—'valley of the rocks'—the region blends dramatic geology with living culture.","Image":{"Url":"/th?id=OHR.NavajoNation_EN-US6947714656_1920x1080.webp","Wallpaper":"/th?id=OHR.NavajoNation_EN-US6947714656_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A landscape of living heritage","Title":"Monument Valley, Navajo Nation, Arizona","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.942237,-110.092148/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=36.942237,-110.092148;S9;Monument Valley, Navajo Nation, Arizona&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260730_NavajoNation\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Monument+Valley&form=hpcapt&filters=HpDate:\"20260730_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260730_NavajoNation"},"Ssd":"20260730","Name":"NavajoNation","Market":"EN-US","Hash":"6947714656","FullDateString":"Jul 30, 2026"},{"ImageContent":{"Description":"On International Tiger Day, this family moves through Ranthambore National Park in Rajasthan, India, with the confidence of those who know exactly where they stand in the food chain. These are Bengal tigers, built for both stealth and power: an adult can stretch over 10 feet from nose to tail and weigh around 500 pounds, yet walk without making a sound. Their stripes also play a part in a landscape where visibility is a double-edged sword, camouflaging their bodies in patterns that prey struggle to read.","Image":{"Url":"/th?id=OHR.TigerFamily_EN-US4918106900_1920x1080.webp","Wallpaper":"/th?id=OHR.TigerFamily_EN-US4918106900_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A comeback with claws","Title":"A family of Bengal tigers at Ranthambore National Park, Rajasthan, India","Copyright":"© Archna Singh/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/25.977797,76.553258/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=25.977797,76.553258;S9;Ranthambore National Park, Rajasthan, India&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260729_TigerFamily\"&FORM=HPQUIZ","BackstageUrl":"/search?q=International+Tiger+Day&form=hpcapt&filters=HpDate:\"20260729_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260729_TigerFamily"},"Ssd":"20260729","Name":"TigerFamily","Market":"EN-US","Hash":"4918106900","FullDateString":"Jul 29, 2026"},{"ImageContent":{"Description":"Off Anacapa Island, California, the ocean grows its own forests. Within Channel Islands National Park—also known as the 'Galápagos of North America'—giant kelp stretches beyond 100 feet in length, forming buoyant ribbons lifted by air-filled bladders and anchored below by rootlike holdfasts.","Image":{"Url":"/th?id=OHR.ChannelKelp_EN-US3809417919_1920x1080.webp","Wallpaper":"/th?id=OHR.ChannelKelp_EN-US3809417919_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A balance in motion","Title":"A kelp forest off Anacapa Island, Channel Islands National Park, California","Copyright":"© Ian Shive/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.004342,-119.391995/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=34.004342,-119.391995;S9;Anacapa Island, California&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260728_ChannelKelp\"&FORM=HPQUIZ","BackstageUrl":"/search?q=World+Nature+Conservation+Day&form=hpcapt&filters=HpDate:\"20260728_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260728_ChannelKelp"},"Ssd":"20260728","Name":"ChannelKelp","Market":"EN-US","Hash":"3809417919","FullDateString":"Jul 28, 2026"},{"ImageContent":{"Description":"Step inside the Chicago Cultural Center, and your eyes are instantly drawn upward to a glowing canopy of color—the Tiffany Dome. Suspended above Preston Bradley Hall, this masterpiece spans approximately 38 feet in diameter and is composed of roughly 30,000 pieces of Favrile glass, each shaped like a fish scale. Sunlight filters through its translucent surface, shifting blues and golds across its intricate pattern.","Image":{"Url":"/th?id=OHR.ChicagoTiffany_EN-US3297949501_1920x1080.webp","Wallpaper":"/th?id=OHR.ChicagoTiffany_EN-US3297949501_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"Chicago, look up!","Title":"Tiffany Dome, Chicago Cultural Center, Illinois","Copyright":"© Felix Lipov/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.88388,-87.62498/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=41.88388,-87.62498;S9;Tiffany Dome, Chicago Cultural Center, Chicago&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260727_ChicagoTiffany\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Tiffany+Dome+Chicago+Cultural+Center&form=hpcapt&filters=HpDate:\"20260727_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260727_ChicagoTiffany"},"Ssd":"20260727","Name":"ChicagoTiffany","Market":"EN-US","Hash":"3297949501","FullDateString":"Jul 27, 2026"},{"ImageContent":{"Description":"At sunrise in Honduras' Pig Keys—small, low-lying coastal islets tucked within mangrove-rich wetlands—a red mangrove lifts its tangled roots above glassy water. This striking scene captures what July 26 celebrates: the International Day for the Conservation of the Mangrove Ecosystem, created to spotlight these vital coastal forests.","Image":{"Url":"/th?id=OHR.RedMangroveSunrise_EN-US2034025633_1920x1080.webp","Wallpaper":"/th?id=OHR.RedMangroveSunrise_EN-US2034025633_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Between land and sea, life begins","Title":"Sunrise on a red mangrove in the Pig Keys, Honduras","Copyright":"© Mac Stone/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/14.822356,-86.5979/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=14.822356,-86.5979;S9;Honduras&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260726_RedMangroveSunrise\"&FORM=HPQUIZ","BackstageUrl":"/search?q=International+Day+for+Conservation+of+the+Mangrove+Ecosystem&form=hpcapt&filters=HpDate:\"20260726_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260726_RedMangroveSunrise"},"Ssd":"20260726","Name":"RedMangroveSunrise","Market":"EN-US","Hash":"2034025633","FullDateString":"Jul 26, 2026"},{"ImageContent":{"Description":"In Spain's far northwest, Galicia meets the Atlantic with force—its long coastline carved by waves into cliffs, inlets, and wave-cut platforms. Rain-fed hills and dense forests spill toward the sea, creating a landscape that feels closer to Ireland than southern Spain, with shifting skies and a distinctly Atlantic mood.","Image":{"Url":"/th?id=OHR.GaliciaBeach_EN-US1635715019_1920x1080.webp","Wallpaper":"/th?id=OHR.GaliciaBeach_EN-US1635715019_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Into Galicia's hidden arches","Title":"Praia das Catedrais, Galicia, Spain","Copyright":"© Tui De Roy/Amazing Aerial Agency/Abobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/43.554231,-7.157587/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=43.554231,-7.157587;S9;Praia das Catedrais, Galicia, Spain&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260725_GaliciaBeach\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Galicia+Spain&form=hpcapt&filters=HpDate:\"20260725_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260725_GaliciaBeach"},"Ssd":"20260725","Name":"GaliciaBeach","Market":"EN-US","Hash":"1635715019","FullDateString":"Jul 25, 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"Every August 7, National Lighthouse Day shines a light on the beacons that have guided ships safely along America's coasts for centuries. The date commemorates the Lighthouse Act of 1789, signed into law by President George Washington.","Image":{"Url":"/th?id=OHR.LimeKiln_EN-US2748515593_1920x1080.webp","Wallpaper":"/th?id=OHR.LimeKiln_EN-US2748515593_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Guiding ships through history","Title":"Lime Kiln Lighthouse on San Juan Island, Washington State","Copyright":"© Edmund Lowe Photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.516128,-123.152644/8?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=48.516128,-123.152644;S9;Lime Kiln Lighthouse, San Juan Island, Washington State&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260807_LimeKiln\"&FORM=HPQUIZ","BackstageUrl":"/search?q=National+Lighthouse+Day&form=hpcapt&filters=HpDate:\"20260807_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260807_LimeKiln"},"Ssd":"20260807","Name":"LimeKiln","Market":"EN-US","Hash":"2748515593","FullDateString":"Aug 7, 2026"},{"ImageContent":{"Description":"In the Masai Mara, Kenya, the ground seems to move. A vast surge of wildebeest—hoofed grazers built for endurance—travel in tightly packed herds, drawn by fresh grass and water replenished by seasonal rains.","Image":{"Url":"/th?id=OHR.MaraCrossing_EN-US8682968377_1920x1080.webp","Wallpaper":"/th?id=OHR.MaraCrossing_EN-US8682968377_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Where the river tests the brave","Title":"Migrating wildebeest crossing Mara River in Masai Mara, Kenya","Copyright":"© Manoj Shah/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Weighing as much as 600 pounds, adult wildebeests rank among the larger herbivorous antelope species.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260806_MaraCrossing\"&FORM=HPQUIZ","BackstageUrl":"/search?q=wildebeest&form=hpcapt&filters=HpDate:\"20260806_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260806_MaraCrossing"},"Ssd":"20260806","Name":"MaraCrossing","Market":"EN-US","Hash":"8682968377","FullDateString":"Aug 6, 2026"},{"ImageContent":{"Description":"In Fez, Morocco, the Royal Palace—known as Dar al-Makhzen—has stood as a seat of power since the 13th century, when Morocco's rulers established a fortified royal city around it. Behind its high walls lie gardens, courtyards, mosques, and royal residences spread across a vast complex still used by the king today, making it both historic and fully active.","Image":{"Url":"/th?id=OHR.FezMorocco_EN-US8380353742_1920x1080.webp","Wallpaper":"/th?id=OHR.FezMorocco_EN-US8380353742_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Gates of a hidden kingdom","Title":"Decorated gate of the Royal Palace of Fez, Morocco","Copyright":"© cgst26/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.05306,-4.99361/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=34.05306,-4.99361;S9;Fez, Morocco&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260805_FezMorocco\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Royal+Palace+of+Fez&form=hpcapt&filters=HpDate:\"20260805_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260805_FezMorocco"},"Ssd":"20260805","Name":"FezMorocco","Market":"EN-US","Hash":"8380353742","FullDateString":"Aug 5, 2026"},{"ImageContent":{"Description":"Owls take center stage on International Owl Awareness Day, an annual observance highlighting their remarkable adaptations and worldwide distribution. Found on every continent except Antarctica, these birds are known for forward-facing eyes, flat facial discs that channel sound, and specialized hearing. Many species hunt in near silence thanks to soft-edged feathers. Their eyes remain fixed in their sockets, so they rely on flexible necks to scan their surroundings. From forests to deserts, owls inhabit a wide range of environments and play an important role in maintaining ecosystem balance.","Image":{"Url":"/th?id=OHR.AdorableOwlet_EN-US7873975586_1920x1080.webp","Wallpaper":"/th?id=OHR.AdorableOwlet_EN-US7873975586_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Hoot hoot hooray!","Title":"Florida burrowing owlet, Cape Coral, Florida, USA","Copyright":"© mlorenzphotography/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Owls can rotate their heads up to 270° to compensate for eyes that are fixed in their sockets.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260804_AdorableOwlet\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Owl+bird&form=hpcapt&filters=HpDate:\"20260804_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260804_AdorableOwlet"},"Ssd":"20260804","Name":"AdorableOwlet","Market":"EN-US","Hash":"7873975586","FullDateString":"Aug 4, 2026"},{"ImageContent":{"Description":"Colorful luzzus—traditional Maltese fishing boats—fill the sheltered harbor of Marsaxlokk, a village on Malta's southeastern coast. Just a short drive from Valletta, the island's capital, it remains one of the country's main fishing hubs, where daily life follows the steady pace of the sea. Home to roughly 4,000 residents, the village is also widely known for its lively waterfront, especially its popular Sunday fish market, and for the steady return of boats carrying fresh catches each morning.","Image":{"Url":"/th?id=OHR.BoatsMalta_EN-US5373607495_1920x1080.webp","Wallpaper":"/th?id=OHR.BoatsMalta_EN-US5373607495_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Bright boats, timeless traditions","Title":"Colorful boats in Marsaxlokk Harbor, Malta","Copyright":"© Klubovy/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.842987,14.54532/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=35.842987,14.54532;S9;Marsaxlokk, Malta&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260803_BoatsMalta\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Marsaxlokk+Malta&form=hpcapt&filters=HpDate:\"20260803_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260803_BoatsMalta"},"Ssd":"20260803","Name":"BoatsMalta","Market":"EN-US","Hash":"5373607495","FullDateString":"Aug 3, 2026"},{"ImageContent":{"Description":"Finland is famous for the northern lights, its high happiness rankings, saunas, and thousands of lakes. Helsinki adds history, design, and the Baltic Sea to that list. The story begins in 1550, when King Gustav I of Sweden founded a trading town that would become Finland's capital in 1812. Today, a walk through the city can take you from Senate Square and the white-domed Helsinki Cathedral to the sea fortress of Suomenlinna, a UNESCO World Heritage Site accessible by ferry.","Image":{"Url":"/th?id=OHR.HelsinkiBlue_EN-US4898215906_1920x1080.webp","Wallpaper":"/th?id=OHR.HelsinkiBlue_EN-US4898215906_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Daughter of the Baltic","Title":"Helsinki's shoreline during blue hour, Uusimaa, Finland","Copyright":"© Miemo Penttinen/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/60.208715,25.004253/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=60.208715,25.004253;S9;Helsinki, Uusimaa, Finland&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260802_HelsinkiBlue\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Helsinki&form=hpcapt&filters=HpDate:\"20260802_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260802_HelsinkiBlue"},"Ssd":"20260802","Name":"HelsinkiBlue","Market":"EN-US","Hash":"4898215906","FullDateString":"Aug 2, 2026"},{"ImageContent":{"Description":"Most landscapes change over thousands of years. Volcanoes can reshape them in a matter of hours, and on Hawaii's Big Island, they continue to do just that. Recognizing the scientific and natural importance of this ever-changing environment, Hawaii Volcanoes National Park was established on August 1, 1916. For more than a century, it has protected over 350,000 acres of volcanic terrain, native forests, and rare wildlife.","Image":{"Url":"/th?id=OHR.HawaiiLava_EN-US4126737972_1920x1080.webp","Wallpaper":"/th?id=OHR.HawaiiLava_EN-US4126737972_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The power of Kīlauea","Title":"A series of lava flows spill into the ocean, Big Island, Hawaii","Copyright":"© Ken McCurdy/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/19.61087,-155.52742/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=19.61087,-155.52742;S9;Hawaii&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260801_HawaiiLava\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Hawaii+Volcanoes+National+Park&form=hpcapt&filters=HpDate:\"20260801_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260801_HawaiiLava"},"Ssd":"20260801","Name":"HawaiiLava","Market":"EN-US","Hash":"4126737972","FullDateString":"Aug 1, 2026"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"Image of the day","LOC_HOMEPAGE_VERTICAL_SCRO