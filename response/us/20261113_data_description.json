{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-11-13T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"On November 12, Arches National Park marks the anniversary of its designation as a national park in 1971. Just north of Moab, Utah, the high-desert park is home to more than 2,000 natural sandstone arches—the densest concentration of arches in the world. Today's image, North Window, is one of the best-known formations in the park's Windows Section, where towering fins, openings, and sculpted sandstone create a landscape that looks almost architectural.","Image":{"Url":"/th?id=OHR.NorthWindow_EN-US1170338293_1920x1080.webp","Wallpaper":"/th?id=OHR.NorthWindow_EN-US1170338293_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Architecture without an architect","Title":"North Window, Arches National Park, Moab, Utah","Copyright":"© lightphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.6857117,-109.5328291/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=38.6857117,-109.5328291;S9;North Window, Arches National Park, Moab, Utah&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261112_NorthWindow\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Arches+National+Park&form=hpcapt&filters=HpDate:\"20261112_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261112_NorthWindow"},"Ssd":"20261112","Name":"NorthWindow","Market":"EN-US","Hash":"1170338293","FullDateString":"Nov 12, 2026"},{"ImageContent":{"Description":"As the sun filters through autumn trees in an upstate New York park, rows of flags turn the landscape into a tribute. Veterans Day, observed every November 11, honors all who have served in the US Armed Forces.","Image":{"Url":"/th?id=OHR.SunsetFlags_EN-US1046151448_1920x1080.webp","Wallpaper":"/th?id=OHR.SunsetFlags_EN-US1046151448_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A salute in red, white, and blue","Title":"American flags in a public park in upstate New York","Copyright":"© Matt Champlin/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Veterans Day was originally known as Armistice Day. In 1954, the holiday was renamed to honor American veterans of all wars.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261111_SunsetFlags\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Veterans+Day&form=hpcapt&filters=HpDate:\"20261111_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261111_SunsetFlags"},"Ssd":"20261111","Name":"SunsetFlags","Market":"EN-US","Hash":"1046151448","FullDateString":"Nov 11, 2026"},{"ImageContent":{"Description":"From above, Rose Island looks like a brushstroke of green surrounded by every shade of blue. Just three miles east of Paradise Island in The Bahamas, this slender cay trades busy roads and city blocks for sandy shores, shallow waters, and an inland lagoon. Its peaceful appearance comes with a touch of movie drama. Rose Island was used as a filming location for the 1965 James Bond adventure 'Thunderball,' including the explosive destruction of the Disco Volante.","Image":{"Url":"/th?id=OHR.RoseIsland_EN-US0952497192_1920x1080.webp","Wallpaper":"/th?id=OHR.RoseIsland_EN-US0952497192_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Licensed to chill","Title":"Aerial view of Rose Island, The Bahamas","Copyright":"© Abstract Aerial Art/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/25.088243,-77.225304/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=25.088243,-77.225304;S9;Rose Island, The Bahamas&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261110_RoseIsland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Rose+Island+Bahamas&form=hpcapt&filters=HpDate:\"20261110_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261110_RoseIsland"},"Ssd":"20261110","Name":"RoseIsland","Market":"EN-US","Hash":"0952497192","FullDateString":"Nov 10, 2026"},{"ImageContent":{"Description":"Cross the Guadalquivir River in Seville, the capital of Spain's Andalusia region, and the city's rhythm seems to change. On the other side lies Triana, a colorful neighborhood where ceramics, flamenco, and local traditions are woven into everyday life. Since the 19th century, the Isabel II Bridge, also known as the Triana Bridge, has connected the neighborhood to Seville's historic center.","Image":{"Url":"/th?id=OHR.TrianaSpain_EN-US0872031458_1920x1080.webp","Wallpaper":"/th?id=OHR.TrianaSpain_EN-US0872031458_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Where art finds its rhythm","Title":"Historic district of Triana, Seville, Spain","Copyright":"© Andrzej Rostek/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.382904,-6.006341/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=37.382904,-6.006341;S9;Triana, Seville, Spain&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261109_TrianaSpain\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Seville+Spain&form=hpcapt&filters=HpDate:\"20261109_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261109_TrianaSpain"},"Ssd":"20261109","Name":"TrianaSpain","Market":"EN-US","Hash":"0872031458","FullDateString":"Nov 9, 2026"},{"ImageContent":{"Description":"What happens when the darkest night of the year gets the brightest celebration? Diwali. The Festival of Lights is celebrated by millions worldwide, bringing together diyas, lanterns, rangoli, prayers, sweets, and family gatherings.","Image":{"Url":"/th?id=OHR.DiwaliLamps_EN-US0788074051_1920x1080.webp","Wallpaper":"/th?id=OHR.DiwaliLamps_EN-US0788074051_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A celebration that shines","Title":"Lanterns for Diwali, Mumbai, Maharashtra, India","Copyright":"© Dinodia Photo/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/18.969048,72.821182/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=18.969048,72.821182;S9;Mumbai, Maharashtra, India&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261108_DiwaliLamps\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Diwali&form=hpcapt&filters=HpDate:\"20261108_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261108_DiwaliLamps"},"Ssd":"20261108","Name":"DiwaliLamps","Market":"EN-US","Hash":"0788074051","FullDateString":"Nov 8, 2026"},{"ImageContent":{"Description":"When the going gets tough, the bison gets grazing. National Bison Day celebrates the North American mammal that can weigh up to 2,000 pounds yet sprint at 35 mph. Observed on the first Saturday of November, the day honors the bovine that became the United States' national mammal in 2016.","Image":{"Url":"/th?id=OHR.DakotaBison_EN-US0710175615_1920x1080.webp","Wallpaper":"/th?id=OHR.DakotaBison_EN-US0710175615_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The giant that came back","Title":"A bison in the grasslands of Theodore Roosevelt National Park, North Dakota","Copyright":"© Tandem Stock/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/47.275714,-103.463282/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=47.275714,-103.463282;S9;Theodore Roosevelt National Park, North Dakota&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261107_DakotaBison\"&FORM=HPQUIZ","BackstageUrl":"/search?q=National+Bison+Day&form=hpcapt&filters=HpDate:\"20261107_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261107_DakotaBison"},"Ssd":"20261107","Name":"DakotaBison","Market":"EN-US","Hash":"0710175615","FullDateString":"Nov 7, 2026"},{"ImageContent":{"Description":"A volcano, a rainforest, and a bamboo grove? Haleakalā National Park on Maui has all three. Spanning Maui from its 10,023-foot summit to the coast, the park protects landscapes that change dramatically with elevation, rainfall, and temperature. It was established in 1916 as part of Hawaii National Park and became its own national park in 1961. The name Haleakalā translates to 'House of the Sun,' reflecting the Hawaiian mo'olelo of Māui capturing the sun to lengthen the day.","Image":{"Url":"/th?id=OHR.PipiwaiTrail_EN-US0631882545_1920x1080.webp","Wallpaper":"/th?id=OHR.PipiwaiTrail_EN-US0631882545_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A green tunnel through Maui","Title":"Bamboo forest, Pīpīwai Trail, Haleakalā National Park, Maui, Hawaii","Copyright":"© MNStudio/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/20.760987,-156.155095/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=20.760987,-156.155095;S9;Haleakalā National Park, Maui, Hawaii&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261106_PipiwaiTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Haleakala+National+Park&form=hpcapt&filters=HpDate:\"20261106_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261106_PipiwaiTrail"},"Ssd":"20261106","Name":"PipiwaiTrail","Market":"EN-US","Hash":"0631882545","FullDateString":"Nov 6, 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"It's World Philosophy Day, when big thinkers gather to discuss life's eternal mysteries. To celebrate, today's image features the \"Body of Knowledge\" sculpture at Goethe University in Frankfurt, Germany, which molds steel letters from eight different alphabets into a human form. Spanish artist Jaume Plensa explains: \"Our body is the home of the spirit. The place in which ideas live.\" On World Philosophy Day, we're all encouraged to look beyond easy answers and explore the questions that shape us, and the world around us.","Image":{"Url":"/th?id=OHR.KnowledgeSculpture_EN-US9746703110_1920x1080.webp","Wallpaper":"/th?id=OHR.KnowledgeSculpture_EN-US9746703110_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"Where ideas take shape","Title":"The \"Body of Knowledge\" sculpture by Jaume Plensa at Goethe University in Frankfurt, Germany","Copyright":"© Todamo/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/50.127805,8.667807/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=50.127805,8.667807;S9;Goethe University, Frankfurt&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261119_KnowledgeSculpture\"&FORM=HPQUIZ","BackstageUrl":"/search?q=World+Philosophy+Day&form=hpcapt&filters=HpDate:\"20261119_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261119_KnowledgeSculpture"},"Ssd":"20261119","Name":"KnowledgeSculpture","Market":"EN-US","Hash":"9746703110","FullDateString":"Nov 19, 2026"},{"ImageContent":{"Description":"These barn owls, bathed in evening light, are waiting for the hunt to begin. As night falls, these birds of prey swoop into action, listening for tiny movements in grass or leaves made by mice and voles. Their heart-shaped faces help funnel sound into some of the sharpest ears in the animal kingdom. This allows them to locate their prey with pinpoint precision in the dark before swooping silently, their soft feathers muffling their approach. In autumn, young barn owls strike out to find their own territories. As the nights grow longer, you might spot them earlier in the evening, gliding over fields in search of supper.","Image":{"Url":"/th?id=OHR.BarnOwlsUnite_EN-US9661992435_1920x1080.webp","Wallpaper":"/th?id=OHR.BarnOwlsUnite_EN-US9661992435_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Hunting from dusk till dawn","Title":"Pair of barn owls","Copyright":"© Zahoor Salmi/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Barn owls don't hoot; they make eerie, screeching noises, which might explain their reputation as harbingers of doom.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261118_BarnOwlsUnite\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Barn+owl&form=hpcapt&filters=HpDate:\"20261118_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261118_BarnOwlsUnite"},"Ssd":"20261118","Name":"BarnOwlsUnite","Market":"EN-US","Hash":"9661992435","FullDateString":"Nov 18, 2026"},{"ImageContent":{"Description":"Happy National Take a Hike Day! It's time to breathe in that crisp fall air and step into the great outdoors. Today's image features the Trail of the Cedars, one of 700 miles of hiking trails in Glacier National Park, Montana. Its 0.9-mile-long loop includes a raised boardwalk which cuts a path through western red cedars and hemlock trees. The park boasts routes for all abilities, taking in alpine lakes, wildflower meadows, mountain passes, and wilderness stretching to the Canadian border. But if you don't have spectacular scenery on your doorstep, a short stroll along a tree-lined street is an easy way to celebrate and enjoy the benefits of getting out, as the days draw in.","Image":{"Url":"/th?id=OHR.TrailCedars_EN-US9469685112_1920x1080.webp","Wallpaper":"/th?id=OHR.TrailCedars_EN-US9469685112_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Step into the great outdoors","Title":"Trail of the Cedars, Glacier National Park, Montana, USA","Copyright":"© DBushue Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.706957,-113.817235/8?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=48.706957,-113.817235;S9;Glacier National Park, Montana&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261117_TrailCedars\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Take+a+Hike+Day&form=hpcapt&filters=HpDate:\"20261117_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261117_TrailCedars"},"Ssd":"20261117","Name":"TrailCedars","Market":"EN-US","Hash":"9469685112","FullDateString":"Nov 17, 2026"},{"ImageContent":{"Description":"Incredible views and rock-solid foundations are part of the charm of these ancient dwellings, set into the cliffside in New Mexico. Nomads had long used the natural caves above Cliff Dweller Creek as temporary shelter, but it was the Native American Mogollon people who made them their home. Archaeologists believe they created dozens of rooms inside five alcoves in the 1270s and 1280s. Up to 15 families lived here at any one time, raising children, making pottery, and overlooking the fertile Gila River valley where they grew crops and hunted wildlife. For reasons unknown, the Mogollon people moved on around 1300, leaving behind one of the American Southwest's most important archaeological sites. On November 16, 1907, President Theodore Roosevelt designated the area as Gila Cliff Dwellings National Monument, helping to ensure its preservation for future generations.","Image":{"Url":"/th?id=OHR.GilaCliff_EN-US9298229333_1920x1080.webp","Wallpaper":"/th?id=OHR.GilaCliff_EN-US9298229333_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Built to last","Title":"Gila Cliff Dwellings National Monument, New Mexico, USA","Copyright":"© Chiara Salvadori/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/33.254028,-108.272634/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=33.254028,-108.272634;S9;Gila Cliff Dwellings National Monument, New Mexico&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261116_GilaCliff\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Gila+Cliff+Dwellings+National+Monument&form=hpcapt&filters=HpDate:\"20261116_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261116_GilaCliff"},"Ssd":"20261116","Name":"GilaCliff","Market":"EN-US","Hash":"9298229333","FullDateString":"Nov 16, 2026"},{"ImageContent":{"Description":"As fall's first frost works its way across the South, ice crystals form on the leaves of evergreen shrubs, like this azalea. Long gone are the pinks, oranges, and yellows of their spring blooms, but a new colorful display awaits, as their green leaves turn shades of red and purple. For the plants, the new pigments protect their leaves as temperatures drop, but for gardeners, they create a vibrant autumnal display, framed in white frost. When spring arrives, new growth will restore the shrub's green leaves, and the colorful cycle begins anew.","Image":{"Url":"/th?id=OHR.FirstFrost_EN-US8881008245_1920x1080.webp","Wallpaper":"/th?id=OHR.FirstFrost_EN-US8881008245_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Frosty foliage","Title":"Frozen azalea with red leaves","Copyright":"© avoferten/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"The pigments that turn azalea leaves shades of red or purple are called anthocyanins.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261115_FirstFrost\"&FORM=HPQUIZ","BackstageUrl":"/search?q=azaleas&form=hpcapt&filters=HpDate:\"20261115_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261115_FirstFrost"},"Ssd":"20261115","Name":"FirstFrost","Market":"EN-US","Hash":"8881008245","FullDateString":"Nov 15, 2026"},{"ImageContent":{"Description":"Welcome to Hong Kong, home to the world's largest collection of skyscrapers. Those pictured here tower above Victoria Harbour, whose deep waters allowed the island to develop as a busy trading port. Ships carrying tea, silk, and other goods have passed through since the 1840s, but growth rocketed in the decades after World War II, fueling a construction boom. With little flat land available between the harbor and the hills, developers had to build upward, creating this distinctive skyline. In 2026, Hong Kong has 569 buildings above 492 feet high—more than any other city.","Image":{"Url":"/th?id=OHR.BlueHK_EN-US7870996687_1920x1080.webp","Wallpaper":"/th?id=OHR.BlueHK_EN-US7870996687_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The only way is up","Title":"Victoria Harbour, Hong Kong, China","Copyright":"© Juan Romero/Cavan Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/22.285,114.165/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=22.285,114.165;S9;Victoria Harbour, Hong Kong&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261114_BlueHK\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Victoria+Harbour+Hong+Kong&form=hpcapt&filters=HpDate:\"20261114_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261114_BlueHK"},"Ssd":"20261114","Name":"BlueHK","Market":"EN-US","Hash":"7870996687","FullDateString":"Nov 14, 2026"},{"ImageContent":{"Description":"Dawn's first light is reflected on the frozen surface of Abraham Lake, framed by peaks of the Rocky Mountains. In winter, this picturesque lake in Alberta is famous for its frozen bubbles of methane gas, trapped beneath the ice. Strong winds keep the surface clear of snow, offering winter-long views. Come spring, when the ice thaws, the gas escapes into the atmosphere. Despite its natural beauty, the lake is a human-made reservoir, created in 1972 when the Bighorn Dam was built on the North Saskatchewan River. Its icy beauty in winter and turquoise waters in summer make it a popular photography spot all year round.","Image":{"Url":"/th?id=OHR.AbrahamCanada_EN-US3455540217_1920x1080.webp","Wallpaper":"/th?id=OHR.AbrahamCanada_EN-US3455540217_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Hidden depths","Title":"Abraham Lake in Alberta, Canada","Copyright":"© Guang Cao/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.1392,-116.4355/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=52.1392,-116.4355;S9;Abraham Lake, Alberta&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261113_AbrahamCanada\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Abraham+Lake+Alberta&form=hpcapt&filters=HpDate:\"20261113_0800\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261113_AbrahamCanada"},"Ssd":"20261113","Name":"AbrahamCanada","Market":"EN-US","Hash":"3455540217","FullDateString":"Nov 13, 2026"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"Image of the day","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"Learn more","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"Quick fact:","LOC_HOMEPAGE_GALLERY_CARD_TITLE":"Recent Homepage images","LOC_HOMEPAGE_VERTICAL_SCROLL_GALLERY_IMAGE_ARIALABEL":"Homepage image for {0}","LOC_HOMEPAGE_ON_THIS_DAY_TITLE":"On this day in history","LOC_HOMEPAGE_ON_THIS_DAY_IMAGE_ARIALABEL":"On this day in {0}, {1}","LOC_HOMEPAGE_SHARE_TOOLTIP":"Share today's Bing homepage","LOC_HOMEPAGE_WALLPAPERDOWNLOAD_TOOLTIP":"Download this image. Use of this image is restricted to wallpaper only.","LOC_HOMEPAGE_WALLPAPERNOTAVAILABLE":"This image is not available to download as wallpaper.","LOC_HOMEPAGE_INFO_TEXT":"Info","LOC_BING_WP_APP_LINK":"https://go.microsoft.com/fwlink/?linkid=2127455","LOC_BING_WP_APP_LINK_TEXT":"Get the Bing Wal