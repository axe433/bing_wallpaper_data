{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-08-10T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"Where two great deserts meet, Joshua Tree National Park reveals a stark, mesmerizing landscape shaped by wind, time, and extremes. In Southern California, the higher Mojave Desert merges with the hotter, lower Colorado Desert, creating a unique blend of ecosystems and remarkable biodiversity.","Image":{"Url":"/th?id=OHR.SandPath_EN-US3759872156_1920x1080.webp","Wallpaper":"/th?id=OHR.SandPath_EN-US3759872156_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Where two deserts collide","Title":"Joshua Tree National Park, California","Copyright":"© JJ Landscapes/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/33.951965,-115.942135/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=33.951965,-115.942135;S9;Joshua Tree National Park, California&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260810_SandPath\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Joshua+Tree+National+Park&form=hpcapt&filters=HpDate:\"20260810_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260810_SandPath"},"Ssd":"20260810","Name":"SandPath","Market":"EN-US","Hash":"3759872156","FullDateString":"Aug 10, 2026"},{"ImageContent":{"Description":"Today, the International Day of the World's Indigenous Peoples invites a closer look at communities whose stories stretch far beyond recorded history. Proclaimed by the United Nations in 1994 and first observed in 1995, the date marks a landmark 1982 meeting focused on protecting Indigenous rights worldwide. More than 476 million Indigenous people now live across about 90 countries, sustaining thousands of cultures and the majority of the world's roughly 7,000 languages.","Image":{"Url":"/th?id=OHR.JMTjibaou_EN-US3454380257_1920x1080.webp","Wallpaper":"/th?id=OHR.JMTjibaou_EN-US3454380257_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Architecture of identity","Title":"Jean-Marie Tjibaou Cultural Centre, New Caledonia","Copyright":"© Fabien Astre/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-22.256,166.482/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=-22.256,166.482;S9;Jean-Marie Tjibaou Cultural Centre, New Caledonia&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260809_JMTjibaou\"&FORM=HPQUIZ","BackstageUrl":"/search?q=International+Day+of+the+Worlds+Indigenous+Peoples&form=hpcapt&filters=HpDate:\"20260809_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260809_JMTjibaou"},"Ssd":"20260809","Name":"JMTjibaou","Market":"EN-US","Hash":"3454380257","FullDateString":"Aug 9, 2026"},{"ImageContent":{"Description":"On August 8, curiosity takes center stage on International Infinity Day—a celebration inspired by the sideways figure 8, a symbol of something without end. Founded in 1987 by New York–based philosopher Jean-Pierre Ady Fenyo, the day invites everyone to explore big ideas through science, art, and imagination. It's not just about math—it's also about possibilities, from the vastness of space to the limits of human creativity.","Image":{"Url":"/th?id=OHR.StocktonInfinity_EN-US3006724421_1920x1080.webp","Wallpaper":"/th?id=OHR.StocktonInfinity_EN-US3006724421_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Crossing into infinity","Title":"Infinity Bridge in Stockton-on-Tees, England","Copyright":"© Bahadir Yeniceri/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/54.5647944,-1.2991917/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=54.5647944,-1.2991917;S9;Infinity Bridge, Stockton-on-Tees, England&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260808_StocktonInfinity\"&FORM=HPQUIZ","BackstageUrl":"/search?q=International+Infinity+Day&form=hpcapt&filters=HpDate:\"20260808_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260808_StocktonInfinity"},"Ssd":"20260808","Name":"StocktonInfinity","Market":"EN-US","Hash":"3006724421","FullDateString":"Aug 8, 2026"},{"ImageContent":{"Description":"Every August 7, National Lighthouse Day shines a light on the beacons that have guided ships safely along America's coasts for centuries. The date commemorates the Lighthouse Act of 1789, signed into law by President George Washington.","Image":{"Url":"/th?id=OHR.LimeKiln_EN-US2748515593_1920x1080.webp","Wallpaper":"/th?id=OHR.LimeKiln_EN-US2748515593_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Guiding ships through history","Title":"Lime Kiln Lighthouse on San Juan Island, Washington State","Copyright":"© Edmund Lowe Photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.516128,-123.152644/8?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=48.516128,-123.152644;S9;Lime Kiln Lighthouse, San Juan Island, Washington State&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260807_LimeKiln\"&FORM=HPQUIZ","BackstageUrl":"/search?q=National+Lighthouse+Day&form=hpcapt&filters=HpDate:\"20260807_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260807_LimeKiln"},"Ssd":"20260807","Name":"LimeKiln","Market":"EN-US","Hash":"2748515593","FullDateString":"Aug 7, 2026"},{"ImageContent":{"Description":"In the Masai Mara, Kenya, the ground seems to move. A vast surge of wildebeest—hoofed grazers built for endurance—travel in tightly packed herds, drawn by fresh grass and water replenished by seasonal rains.","Image":{"Url":"/th?id=OHR.MaraCrossing_EN-US8682968377_1920x1080.webp","Wallpaper":"/th?id=OHR.MaraCrossing_EN-US8682968377_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Where the river tests the brave","Title":"Migrating wildebeest crossing Mara River in Masai Mara, Kenya","Copyright":"© Manoj Shah/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Weighing as much as 600 pounds, adult wildebeests rank among the larger herbivorous antelope species.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260806_MaraCrossing\"&FORM=HPQUIZ","BackstageUrl":"/search?q=wildebeest&form=hpcapt&filters=HpDate:\"20260806_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260806_MaraCrossing"},"Ssd":"20260806","Name":"MaraCrossing","Market":"EN-US","Hash":"8682968377","FullDateString":"Aug 6, 2026"},{"ImageContent":{"Description":"In Fez, Morocco, the Royal Palace—known as Dar al-Makhzen—has stood as a seat of power since the 13th century, when Morocco's rulers established a fortified royal city around it. Behind its high walls lie gardens, courtyards, mosques, and royal residences spread across a vast complex still used by the king today, making it both historic and fully active.","Image":{"Url":"/th?id=OHR.FezMorocco_EN-US8380353742_1920x1080.webp","Wallpaper":"/th?id=OHR.FezMorocco_EN-US8380353742_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Gates of a hidden kingdom","Title":"Decorated gate of the Royal Palace of Fez, Morocco","Copyright":"© cgst26/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.05306,-4.99361/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=34.05306,-4.99361;S9;Fez, Morocco&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260805_FezMorocco\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Royal+Palace+of+Fez&form=hpcapt&filters=HpDate:\"20260805_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260805_FezMorocco"},"Ssd":"20260805","Name":"FezMorocco","Market":"EN-US","Hash":"8380353742","FullDateString":"Aug 5, 2026"},{"ImageContent":{"Description":"Owls take center stage on International Owl Awareness Day, an annual observance highlighting their remarkable adaptations and worldwide distribution. Found on every continent except Antarctica, these birds are known for forward-facing eyes, flat facial discs that channel sound, and specialized hearing. Many species hunt in near silence thanks to soft-edged feathers. Their eyes remain fixed in their sockets, so they rely on flexible necks to scan their surroundings. From forests to deserts, owls inhabit a wide range of environments and play an important role in maintaining ecosystem balance.","Image":{"Url":"/th?id=OHR.AdorableOwlet_EN-US7873975586_1920x1080.webp","Wallpaper":"/th?id=OHR.AdorableOwlet_EN-US7873975586_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Hoot hoot hooray!","Title":"Florida burrowing owlet, Cape Coral, Florida, USA","Copyright":"© mlorenzphotography/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Owls can rotate their heads up to 270° to compensate for eyes that are fixed in their sockets.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260804_AdorableOwlet\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Owl+bird&form=hpcapt&filters=HpDate:\"20260804_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260804_AdorableOwlet"},"Ssd":"20260804","Name":"AdorableOwlet","Market":"EN-US","Hash":"7873975586","FullDateString":"Aug 4, 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"Location matters. Just ask the false clownfish seen in the image at Lighthouse Reef, near Cabilao Island, Philippines. In these tropical waters packed with hungry mouths and fierce competition, they've secured prime real estate: a sea anemone armed with thousands of microscopic stinging cells.","Image":{"Url":"/th?id=OHR.CabilaoClowns_EN-US6302440247_1920x1080.webp","Wallpaper":"/th?id=OHR.CabilaoClowns_EN-US6302440247_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A prime 'reef' estate","Title":"Three false clownfish in a sea anemone, Cabilao Island, Bohol, Philippines","Copyright":"© Franco Banfi/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/9.881099,123.771501/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=9.881099,123.771501;S9;Cabilao Island, Bohol, Philippines&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260817_CabilaoClowns\"&FORM=HPQUIZ","BackstageUrl":"/search?q=false+clownfish&form=hpcapt&filters=HpDate:\"20260817_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260817_CabilaoClowns"},"Ssd":"20260817","Name":"CabilaoClowns","Market":"EN-US","Hash":"6302440247","FullDateString":"Aug 17, 2026"},{"ImageContent":{"Description":"What do swans, secret hideaways, and a medieval fish tank have in common? They're all part of the story of Ross Errilly Friary. Founded around 1351, this well-preserved Franciscan friary in Ireland is often called Ross Abbey, though it never had an abbot because it was never an abbey.","Image":{"Url":"/th?id=OHR.RossErrillyRuins_EN-US5729358123_1920x1080.webp","Wallpaper":"/th?id=OHR.RossErrillyRuins_EN-US5729358123_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"Where swans started a legend","Title":"Ruins of Ross Errilly Friary, County Galway, Ireland","Copyright":"© Maria Janus/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/53.47966,-9.131635/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=53.47966,-9.131635;S9;Ross Errilly Friary, County Galway, Ireland&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260816_RossErrillyRuins\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Ross+Errilly+Friary+Ireland&form=hpcapt&filters=HpDate:\"20260816_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260816_RossErrillyRuins"},"Ssd":"20260816","Name":"RossErrillyRuins","Market":"EN-US","Hash":"5729358123","FullDateString":"Aug 16, 2026"},{"ImageContent":{"Description":"Nature has a knack for balancing the impossible. In New Mexico's Ah-Shi-Sle-Pah Wilderness, towering hoodoos perch hefty rock caps on slender stems. Wind, water, and ice have spent roughly 75 million years sculpting these remote badlands into an open-air gallery that feels more alien than terrestrial.","Image":{"Url":"/th?id=OHR.ValleyDreams_EN-US5250331985_1920x1080.webp","Wallpaper":"/th?id=OHR.ValleyDreams_EN-US5250331985_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The great balancing act","Title":"Hoodoos in Ah Shi Sle Pah Wilderness in San Juan County, New Mexico","Copyright":"© Westend61/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.155291,-107.935427/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=36.155291,-107.935427;S9;Ah Shi Sle Pah Wilderness, New Mexico&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260815_ValleyDreams\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Ah+Shi+Sle+Pah+Wilderness&form=hpcapt&filters=HpDate:\"20260815_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260815_ValleyDreams"},"Ssd":"20260815","Name":"ValleyDreams","Market":"EN-US","Hash":"5250331985","FullDateString":"Aug 15, 2026"},{"ImageContent":{"Description":"Roads solved one problem but quietly created another. People could travel faster than ever, while wildlife now faced highways cutting across routes they had followed for generations. The result was more collisions, fragmented habitats, and isolated wildlife populations. That challenge led to building wildlife crossings called ecoducts: bridges or tunnels designed to reconnect habitats and give animals a safe way across busy roads. Some of the earliest modern examples appeared in France during the 1950s, and the idea soon spread across Europe. Countries such as the Netherlands helped refine ecoduct design by building wide green bridges covered in soil and native vegetation, from grasses and shrubs to trees.","Image":{"Url":"/th?id=OHR.WildlifeCrossingPoland_EN-US5004733603_1920x1080.webp","Wallpaper":"/th?id=OHR.WildlifeCrossingPoland_EN-US5004733603_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Built for paws, not people","Title":"Aerial view of a wildlife crossing near Zakrzów, Poland","Copyright":"© bbsferrari/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"In 1950s France, the first wildlife crossings took shape, offering animals a way through landscapes newly divided by roads.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260814_WildlifeCrossingPoland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Wildlife+crossing&form=hpcapt&filters=HpDate:\"20260814_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260814_WildlifeCrossingPoland"},"Ssd":"20260814","Name":"WildlifeCrossingPoland","Market":"EN-US","Hash":"5004733603","FullDateString":"Aug 14, 2026"},{"ImageContent":{"Description":"Not every summer tradition happens on the ground. Some take place hundreds of miles overhead, one meteor at a time. The Perseids return every year from mid-July through late August, reaching their peak around August 12-13. Visible across much of the world, they often produce dozens of meteors per hour under dark skies. Picture yourself looking up. One streak appears after another. How many can you spot before you lose count? Each streak comes from debris shed by Comet Swift-Tuttle as Earth moves through its dust trail. The meteors appear to radiate from the constellation Perseus.","Image":{"Url":"/th?id=OHR.PerseidasTenerife_EN-US4798593153_1920x1080.webp","Wallpaper":"/th?id=OHR.PerseidasTenerife_EN-US4798593153_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Make a wish","Title":"Perseid meteors over Teide Observatory, Tenerife, Spain","Copyright":"© Westend61/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/28.291565,-16.629129/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=28.291565,-16.629129;S9;Teide Observatory, Tenerife, Spain&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260813_PerseidasTenerife\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Perseids+meteor+shower&form=hpcapt&filters=HpDate:\"20260813_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260813_PerseidasTenerife"},"Ssd":"20260813","Name":"PerseidasTenerife","Market":"EN-US","Hash":"4798593153","FullDateString":"Aug 13, 2026"},{"ImageContent":{"Description":"On August 12, World Elephant Day invites us to pause and consider not just the size of these animals, but the depth of their lives. In places like Amboseli National Park in Kenya—captured in this image—a herd doesn't simply pass through the landscape; it remembers it. Matriarchs guide their families between water sources, tracing routes shaped as much by memory as by terrain.","Image":{"Url":"/th?id=OHR.ElephantDay_EN-US4280370948_1920x1080.webp","Wallpaper":"/th?id=OHR.ElephantDay_EN-US4280370948_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Giants worth protecting","Title":"A group of elephants, Amboseli National Park, Kenya","Copyright":"© Ibrahim Suha Derbent/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-2.6527,37.26058/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-US&od=2&shading=flat&pp=-2.6527,37.26058;S9;Amboseli National Park, Kenya&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","