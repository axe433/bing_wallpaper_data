{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-26T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"Most rivers spend their lives flowing around obstacles. The Sharavathi River reaches the edge of a cliff and simply jumps. At Jog Falls in Karnataka, the river plunges 253 metres, making it the third-highest waterfall in India.","Image":{"Url":"/th?id=OHR.JogFalls2026_ROW3282923682_1920x1080.webp","Wallpaper":"/th?id=OHR.JogFalls2026_ROW3282923682_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Jog Falls, Sharavathi River, Karnataka, India","Copyright":"© Amith Nag Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260925_JogFalls2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Jog+Falls+India&form=hpcapt&filters=HpDate:\"20260925_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260925_JogFalls2026"},"Ssd":"20260925","Name":"JogFalls2026","Market":"ROW","Hash":"3282923682","FullDateString":"25 Sept 2026"},{"ImageContent":{"Description":"Castelmezzano, in the province of Potenza in Basilicata, Italy, is hidden from view until you reach it. You arrive through a tunnel and as you emerge, the village suddenly appears, wedged among the sandstone pinnacles of the Lucanian Dolomites. The houses seem to climb over one another at around 750 metres above sea level, connected by steps and narrow lanes that rise towards the remains of the Norman fortress.","Image":{"Url":"/th?id=OHR.CastelmezzanoItaly_ROW3044667748_1920x1080.webp","Wallpaper":"/th?id=OHR.CastelmezzanoItaly_ROW3044667748_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Castelmezzano, Basilicata, Italy","Copyright":"© Sean Pavone/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260924_CastelmezzanoItaly\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Castelmezzano&form=hpcapt&filters=HpDate:\"20260924_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260924_CastelmezzanoItaly"},"Ssd":"20260924","Name":"CastelmezzanoItaly","Market":"ROW","Hash":"3044667748","FullDateString":"24 Sept 2026"},{"ImageContent":{"Description":"A round door, a bright green frame and a hillside that looks straight out of Middle-earth—welcome to Hobbiton Movie Set in Matamata, New Zealand. Built in 1999 for 'The Lord of the Rings,' the original set featured 39 temporary Hobbit Holes across a 4.9-hectare site. After filming ended, the set was dismantled, but it returned in 2009 for 'The Hobbit' films and was rebuilt as a permanent attraction.","Image":{"Url":"/th?id=OHR.TolkienWeek_ROW2596246369_1920x1080.webp","Wallpaper":"/th?id=OHR.TolkienWeek_ROW2596246369_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Hobbit house at Hobbiton Movie Set, Matamata, New Zealand","Copyright":"© djr-photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260923_TolkienWeek\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Hobbiton+Movie+Set&form=hpcapt&filters=HpDate:\"20260923_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260923_TolkienWeek"},"Ssd":"20260923","Name":"TolkienWeek","Market":"ROW","Hash":"2596246369","FullDateString":"23 Sept 2026"},{"ImageContent":{"Description":"What makes a tree 'quake?' Take a closer look at an aspen leaf. Its flattened stalk catches even a light breeze, making the leaves flutter and giving the tree its name: quaking aspen. Near Guardsman Pass in Utah, United States, these trees form striking groves across the higher mountain slopes, where cooler, moist conditions suit them well.","Image":{"Url":"/th?id=OHR.FallAspens_ROW2359837997_1920x1080.webp","Wallpaper":"/th?id=OHR.FallAspens_ROW2359837997_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Autumn aspen trees near Guardsman Pass, Utah, United States","Copyright":"© Danita Delimont/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260922_FallAspens\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Aspen+trees&form=hpcapt&filters=HpDate:\"20260922_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260922_FallAspens"},"Ssd":"20260922","Name":"FallAspens","Market":"ROW","Hash":"2359837997","FullDateString":"22 Sept 2026"},{"ImageContent":{"Description":"Few animals are as closely tied to the health of coastal ecosystems as the sea otter. In today's image, one grooms its fur in Monterey Bay, California, USA. This behaviour is far more than a daily ritual. Unlike seals and whales, sea otters have little insulating blubber, so they rely on the densest fur of any animal. Careful cleaning traps air within their coat, creating a waterproof layer that helps them stay warm in the cold Pacific.","Image":{"Url":"/th?id=OHR.GroomingOtter_ROW2104979669_1920x1080.webp","Wallpaper":"/th?id=OHR.GroomingOtter_ROW2104979669_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Sea otter grooming fur, Monterey Bay, California, United States","Copyright":"© Suzi Eszterhas/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260921_GroomingOtter\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Sea+otter&form=hpcapt&filters=HpDate:\"20260921_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260921_GroomingOtter"},"Ssd":"20260921","Name":"GroomingOtter","Market":"ROW","Hash":"2104979669","FullDateString":"21 Sept 2026"},{"ImageContent":{"Description":"No other city is nearly as romanticised as Paris. Yet the French capital's history has not always been as rosy as the sunset glowing behind the Eiffel Tower. Built for the 1889 Exposition Universelle, or the World's Fair, which marked the centennial of the start of the French Revolution, the tower was originally intended to serve as the fair's entrance centrepiece. Designed by engineer Gustave Eiffel and his team, the iron landmark rose 300 metres above the Champ de Mars and became the tallest structure in the world at the time.","Image":{"Url":"/th?id=OHR.ParisSunset_ROW1775373883_1920x1080.webp","Wallpaper":"/th?id=OHR.ParisSunset_ROW1775373883_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Eiffel Tower at sunset, Paris, France","Copyright":"© Alexander Spatari/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260920_ParisSunset\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Paris&form=hpcapt&filters=HpDate:\"20260920_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260920_ParisSunset"},"Ssd":"20260920","Name":"ParisSunset","Market":"ROW","Hash":"1775373883","FullDateString":"20 Sept 2026"},{"ImageContent":{"Description":"Think you know what a desert looks like? Lençóis Maranhenses National Park might change your mind. Along Brazil's Maranhão coast, huge white dunes sit beside freshwater lagoons, creating a landscape that changes with the seasons. Established as a national park in 1981 and recognised as a UNESCO World Heritage Site in 2024, it covers more than 156,000 hectares (about 386,887 acres) and stretches along 80 kilometres of coastline. The dunes are shaped by prevailing winds, while seasonal rains collect in the hollows between them. Some lagoons last only through the wet season, while others remain year-round, including Lagoa da Esperança.","Image":{"Url":"/th?id=OHR.Lencois_ROW1554257872_1920x1080.webp","Wallpaper":"/th?id=OHR.Lencois_ROW1554257872_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Lençóis Maranhenses National Park, Brazil","Copyright":"© Ignacio Palacios/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260919_Lencois\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Lencois+Maranhenses+National+Park&form=hpcapt&filters=HpDate:\"20260919_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260919_Lencois"},"Ssd":"20260919","Name":"Lencois","Market":"ROW","Hash":"1554257872","FullDateString":"19 Sept 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"Rivers have long played an important role in life across the world, supporting communities, wildlife and industry. Featured in today's image, the Chattooga River runs for about 92 kilometres across Georgia, North Carolina and South Carolina in the United States. Flowing through the Appalachian Mountains, it winds between steep, forested slopes, rocky gorges and cascading rapids before reaching Lake Tugaloo. The river remains one of the Southeast's few major free-flowing rivers and is known for its scenery, whitewater recreation and wildlife.","Image":{"Url":"/th?id=OHR.ChattoogaRiver_ROW2393025936_1920x1080.webp","Wallpaper":"/th?id=OHR.ChattoogaRiver_ROW2393025936_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Chattooga River in the Appalachian Mountains, North Carolina, United States","Copyright":"© mtilghma/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261002_ChattoogaRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Chattooga+River&form=hpcapt&filters=HpDate:\"20261002_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261002_ChattoogaRiver"},"Ssd":"20261002","Name":"ChattoogaRiver","Market":"ROW","Hash":"2393025936","FullDateString":"2 Oct 2026"},{"ImageContent":{"Description":"In 1890, Yosemite became America's third national park. More than a century later, it still feels like a place that operates on geological time rather than human schedules. From Olmsted Point, the overlook in today's image, that timescale is impossible to miss. The smooth granite underfoot was sculpted by glaciers, while scattered boulders known as glacial erratics were carried here by ice and abandoned when it melted.","Image":{"Url":"/th?id=OHR.OlmstedPoint_ROW5031185741_1920x1080.webp","Wallpaper":"/th?id=OHR.OlmstedPoint_ROW5031185741_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Sunset from Olmsted Point, Yosemite National Park, California, United States","Copyright":"© Robb Hirsch/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261001_OlmstedPoint\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Yosemite+National+Park&form=hpcapt&filters=HpDate:\"20261001_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261001_OlmstedPoint"},"Ssd":"20261001","Name":"OlmstedPoint","Market":"ROW","Hash":"5031185741","FullDateString":"1 Oct 2026"},{"ImageContent":{"Description":"Balanced on a slender stalk in Norfolk, England, the male bearded reedling in today's image stands out with a pale blue-grey head, a bright orange bill and the black facial markings that give the species its name. Despite its striking appearance, this small bird spends much of its life hidden among the dense wetland vegetation of marshes, lakeshores and reed beds.","Image":{"Url":"/th?id=OHR.BeardReedling_ROW4731809759_1920x1080.webp","Wallpaper":"/th?id=OHR.BeardReedling_ROW4731809759_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Male bearded reedling, Norfolk, England","Copyright":"© Andrew Sproule/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260930_BeardReedling\"&FORM=HPQUIZ","BackstageUrl":"/search?q=bearded+reedling&form=hpcapt&filters=HpDate:\"20260930_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260930_BeardReedling"},"Ssd":"20260930","Name":"BeardReedling","Market":"ROW","Hash":"4731809759","FullDateString":"30 Sept 2026"},{"ImageContent":{"Description":"Seen from above, the Kasilof River winds like a ribbon of turquoise through Alaska's Kenai Peninsula. The vivid blue water comes from glacial silt carried downstream from Tustumena Lake, one of the largest freshwater lakes in the state. Flowing about 27 kilometres before emptying into Cook Inlet, the river is shorter than its famous neighbour, the Kenai, but no less remarkable.","Image":{"Url":"/th?id=OHR.KasilofRiver_ROW4499047229_1920x1080.webp","Wallpaper":"/th?id=OHR.KasilofRiver_ROW4499047229_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"The blue, glacier-fed waters of the Kasilof River, Alaska, United States","Copyright":"© jared lloyd/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260929_KasilofRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Kasilof+River+Alaska&form=hpcapt&filters=HpDate:\"20260929_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260929_KasilofRiver"},"Ssd":"20260929","Name":"KasilofRiver","Market":"ROW","Hash":"4499047229","FullDateString":"29 Sept 2026"},{"ImageContent":{"Description":"Most first-time visitors know Jaipur, in Rajasthan, India, as the Pink City, but the earlier royal capital was centred on Amber Fort. That's where much of the dynasty's political and architectural history was shaped. The fort developed over more than a century, beginning under Raja Man Singh I in 1592 and continuing under later Kachwaha rulers who controlled the kingdom that eventually became Jaipur State. The royal family moved to the newly planned city of Jaipur in 1727, but Amber continued to serve ceremonial functions.","Image":{"Url":"/th?id=OHR.AmberHall_ROW4225263688_1920x1080.webp","Wallpaper":"/th?id=OHR.AmberHall_ROW4225263688_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Sattais Katcheri Hall in Amber Fort near Jaipur, Rajasthan, India","Copyright":"© R.M. Nunes/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260928_AmberHall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Amber+Fort+Jaipur+Rajasthan&form=hpcapt&filters=HpDate:\"20260928_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260928_AmberHall"},"Ssd":"20260928","Name":"AmberHall","Market":"ROW","Hash":"4225263688","FullDateString":"28 Sept 2026"},{"ImageContent":{"Description":"Forget rolling vineyards—around Stuttgart in Germany, the vines take the uphill route, climbing steep terraces above the Neckar valley and weaving between dry-stone walls. These vineyards are a defining feature of the city's landscape, with some of the steepest plots requiring extensive handwork because machinery is difficult to use. Local winegrowers, known as Wengerter, tend the vines on slopes that can reach gradients of 50 per cent. Traditional varieties such as Trollinger and Riesling are closely associated with the region and remain widely grown today.","Image":{"Url":"/th?id=OHR.NeckarVineyards_ROW5359254474_1920x1080.webp","Wallpaper":"/th?id=OHR.NeckarVineyards_ROW5359254474_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Sunset over the vineyards of Steinhaldenfeld, Neckar valley, Stuttgart, Germany","Copyright":"© Cyril Gosselin/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260927_NeckarVineyards\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Neckar+valley&form=hpcapt&filters=HpDate:\"20260927_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260927_NeckarVineyards"},"Ssd":"20260927","Name":"NeckarVineyards","Market":"ROW","Hash":"5359254474","FullDateString":"27 Sept 2026"},{"ImageContent":{"Description":"What do a bear's ears, a house on fire and a road packed with hairpin turns have in common? They're all part of the story of America's public lands in southeastern Utah. Bears Ears National Monument protects important cultural and natural resources, including archaeological sites that reflect thousands of years of human history. Its name comes from two buttes that rise side by side and resemble a bear's ears.","Image":{"Url":"/th?id=OHR.BearsEars_ROW3487899068_1920x1080.webp","Wallpaper":"/th?id=OHR.BearsEars_ROW3487899068_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Cedar Mesa and Muley Point near Bears Ears National Monument, Utah, United States","Copyright":"© Jeff Clay/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260926_BearsEars\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Bears+Ears+National+Monument&form=hpcapt&filters=HpDate:\"20260926_0700\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260926_BearsEars"},"Ssd":"20260926","Name":"BearsEars","Market":"ROW","Hash":"3487899068","FullDateString":"26 Sept 2026"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"Image of the day","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"Learn more","LOC_HOMEPAGE_VERTICAL_SCROLL_DONATE_NOW":"Donate now","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"Quick fact:","LOC_HOMEPAGE_GALLERY_CARD_TITLE":"Recent Homepage images","LOC_HOMEPAGE_VERTICAL_SCROLL_GALLERY_IMAGE_ARIALABEL":"Homepage image for {0}","LOC_HOMEPAGE_ON_THIS_DAY_TITLE":"On this day in history","LOC_HOMEPAGE_ON_THIS_DAY_IMAGE_ARIALABEL":"On this day in {0}, {1}","LOC_HOMEPAGE_SHARE_TOOLTIP":"Share today's Bing homepage","LOC_HOMEPAGE_WALLPAPERDOWNLOAD_TOOLTIP":"Download this image. Use of this image is restricted to wallpaper only.","LOC_MUSCARD_DOWNLOAD_LINK":"Download this image","LOC_HOMEPAGE_WALLPAPERNOTAVAILABLE":"This image is not available to download as wallpaper.","LOC_HOMEPAGE_INFO_TEXT":"Info","LOC_BING_WP_APP_LINK":"https://go.microsoft.com/fwlink/?linkid=2127455","LOC_BING_WP_APP_LINK_TEXT":"Get the Bing Wallpaper app","LOC_BING_APP_TEXT":"Get Bing Wallpaper on your devices","LOC_BING_APP_LINK_PC":"https://bing.microsoftapp.net/bing/?adjust=nk9xri2_dzfz5n2","LOC_BING_APP_LINK_MOBILE":"https://app.adjust.com/d93ddtl_a75k0gg?deeplink=sapphire%3A%2F%2Fwallpaper","LOC_BING_APP_DOWNLOAD_TEXT":"Mobile App","LOC_BING_WP_APP_DOWNLOAD_TEXT":"Desktop App","LOC_BING_APP_TEXT_MOBILE":"Get daily photos with Bing App","LOC_BING_APP_DOWNLOAD_TEXT_MOBILE":"Get","LOC_HOMEPAGE_VERTICAL_SCROLL_TOB":"Trending on Bing","LOC_HOMEPAGE_BELOW_SEARCHBOX_TOB":"Trending on Bing","LOC_HOMEPAGE_BELOW_SEARCHBOX_TOB_NEXT":"Next","LOC_HOMEPAGE_BELOW_SEARCHBOX_TOB_Close":"Hide trending on Bing","LOC_HOMEPAGE_TOB_TAG_NEW":"New","LOC_HOMEPAG