{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"/rp/2P1v961xAkWrVG1OpTWrB7cXL38.gz.css","Postloaded":false},{"Path":"/rp/PYyOBp32ikiHoBUcO0XwZq6y2GY.gz.css","Postloaded":false},{"Path":"/rp/v-XCA5xwjvVzQ0P62S1BCFnh-m0.gz.css","Postloaded":false},{"Path":"/rp/Mj_F7RzA5PKfor_cwwls3CEyIeY.gz.css","Postloaded":false},{"Path":"/rp/hYhZb3rTk3plX-hOqaRO9UgrBOU.gz.css","Postloaded":true},{"Path":"/rp/bYEn1kd1TEb157gu5rL0XE-xG9A.gz.css","Postloaded":true},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":true},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":true},{"Path":"/rp/C55hud04WRj662Ou8c3t6oJFAE0.gz.css","Postloaded":false},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableFeedPositionToggle":false,"EnableNewsAndTrending":true,"EnableUnifiedTobFeedBackplate":true,"EnableUnifiedTobFeedBackplateProdPosition":true,"HideCopilot":true,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-11-12T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"11月12日是拱门国家公园于1971年获指定为国家公园的周年纪念日。这座高海拔沙漠公园位于犹他州莫阿布以北，拥有2000多座天然砂岩拱门，是世界上拱门分布最密集的地区。今天图片中的北窗，是公园窗区最知名的地貌之一；在那里，高耸的岩脊、岩石开口和经自然雕琢的砂岩，共同构成了一片近乎建筑作品般的景观。","Image":{"Url":"/th?id=OHR.NorthWindow_ZH-CN6734579353_1920x1080.webp","Wallpaper":"/th?id=OHR.NorthWindow_ZH-CN6734579353_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"没有建筑师的建筑杰作","Title":"北窗，拱门国家公园，莫阿布，犹他州，美国","Copyright":"© lightphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"拱门国家公园禁止游客攀爬、手脚并用地攀登、行走或站立在任何天然拱门上，也禁止从拱门上绳降。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261112_NorthWindow\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%8b%b1%e9%97%a8%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261111_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261112_NorthWindow"},"Ssd":"20261112","Name":"NorthWindow","Market":"ZH-CN","Hash":"6734579353","FullDateString":"2026 11月 12"},{"ImageContent":{"Description":"大西洋森林是世界上重要的生物多样性热点地区之一，沿巴西大西洋沿岸的广大地带延伸，并进入阿根廷和巴拉圭境内。这里的景观包括热带与亚热带森林、红树林和海岸生境，孕育了约2万种植物以及种类繁多的野生动物，其中包括美洲豹和金狮绢毛猴。几个世纪以来，大片森林已经消失，但它仍在储存碳，并为该地区数百万人提供淡水方面发挥着重要作用。","Image":{"Url":"/th?id=OHR.Atlantica_ZH-CN6593995386_1920x1080.webp","Wallpaper":"/th?id=OHR.Atlantica_ZH-CN6593995386_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"奇妙纷呈的森林","Title":"大西洋森林，巴西","Copyright":"© FG Trade/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"大西洋森林地区生活着约1.5亿人，约占南美洲总人口的三分之一。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261111_Atlantica\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b7%b4%e8%a5%bf%e5%a4%a7%e8%a5%bf%e6%b4%8b%e6%a3%ae%e6%9e%97&form=hpcapt&filters=HpDate:\"20261110_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261111_Atlantica"},"Ssd":"20261111","Name":"Atlantica","Market":"ZH-CN","Hash":"6593995386","FullDateString":"2026 11月 11"},{"ImageContent":{"Description":"从空中俯瞰，玫瑰岛就像一抹绿意，周围环绕着深浅不一的蓝色海水。这座狭长的小岛位于巴哈马天堂岛以东仅三英里处，没有繁忙的道路和成片的城市街区，取而代之的是沙滩、浅海和岛内潟湖。宁静的外表之下，它还藏着一段电影故事：1965年的詹姆斯·邦德冒险电影《霹雳弹》曾在玫瑰岛取景，其中包括“飞碟号”被炸毁的场景。","Image":{"Url":"/th?id=OHR.RoseIsland_ZH-CN6477140814_1920x1080.webp","Wallpaper":"/th?id=OHR.RoseIsland_ZH-CN6477140814_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"惬意放松，尽享海岛时光","Title":"玫瑰岛航拍图，巴哈马","Copyright":"© Abstract Aerial Art/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"玫瑰岛只能乘船抵达；从拿骚或天堂岛出发，航程通常需25至30分钟，具体取决于海况。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261110_RoseIsland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b7%b4%e5%93%88%e9%a9%ac%e7%8e%ab%e7%91%b0%e5%b2%9b&form=hpcapt&filters=HpDate:\"20261109_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261110_RoseIsland"},"Ssd":"20261110","Name":"RoseIsland","Market":"ZH-CN","Hash":"6477140814","FullDateString":"2026 11月 10"},{"ImageContent":{"Description":"在西班牙安达卢西亚地区首府塞维利亚，跨过瓜达尔基维尔河，城市的节奏似乎便悄然改变。河对岸是色彩缤纷的特里亚纳街区，陶艺、弗拉门戈和当地传统融入日常生活。自19世纪以来，伊莎贝尔二世桥——又称特里亚纳桥——一直连接着这里与塞维利亚的历史中心。","Image":{"Url":"/th?id=OHR.TrianaSpain_ZH-CN6329291776_1920x1080.webp","Wallpaper":"/th?id=OHR.TrianaSpain_ZH-CN6329291776_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"艺术与韵律交汇之地","Title":"特里亚纳历史街区，塞维利亚，西班牙","Copyright":"© Andrzej Rostek/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"特里亚纳市场下方保留着圣豪尔赫城堡的遗址；这座城堡曾是宗教裁判所的总部，如今设有历史展览。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261109_TrianaSpain\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%a5%bf%e7%8f%ad%e7%89%99%e5%a1%9e%e7%bb%b4%e5%88%a9%e4%ba%9a&form=hpcapt&filters=HpDate:\"20261108_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261109_TrianaSpain"},"Ssd":"20261109","Name":"TrianaSpain","Market":"ZH-CN","Hash":"6329291776","FullDateString":"2026 11月 9"},{"ImageContent":{"Description":"一年中最黑暗的夜晚遇上最明亮的庆典，会是什么景象？答案就是排灯节。世界各地数百万人庆祝这个灯节，点亮油灯和灯笼，绘制兰戈利彩绘，祈祷、品尝甜点，并与家人团聚。","Image":{"Url":"/th?id=OHR.DiwaliLamps_ZH-CN2462894749_1920x1080.webp","Wallpaper":"/th?id=OHR.DiwaliLamps_ZH-CN2462894749_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"光芒四射的节日","Title":"排灯节灯笼，孟买，马哈拉施特拉邦，印度","Copyright":"© Dinodia Photo/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"排灯节持续五天，但由于它遵循印度教阴历，每年在公历上的日期都会变化。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261108_DiwaliLamps\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%8e%92%e7%81%af%e8%8a%82&form=hpcapt&filters=HpDate:\"20261107_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261108_DiwaliLamps"},"Ssd":"20261108","Name":"DiwaliLamps","Market":"ZH-CN","Hash":"2462894749","FullDateString":"2026 11月 8"},{"ImageContent":{"Description":"再艰难的环境，也挡不住野牛吃草的脚步。美国全国野牛日赞颂这种北美哺乳动物：它体重可达2000磅(约907千克)，奔跑时速却能达到35英里(约56千米)。这个节日定在每年11月的第一个星期六，旨在向2016年成为美国国家哺乳动物的野牛致敬。","Image":{"Url":"/th?id=OHR.DakotaBison_ZH-CN2302503868_1920x1080.webp","Wallpaper":"/th?id=OHR.DakotaBison_ZH-CN2302503868_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"归来的草原巨兽","Title":"草原上的一头野牛，西奥多·罗斯福国家公园，北达科他州，美国","Copyright":"© Tandem Stock/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"野牛在泥土中打滚形成的浅坑可能积水，为草原植物和动物提供栖息地。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261107_DakotaBison\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%be%8e%e6%b4%b2%e9%87%8e%e7%89%9b&form=hpcapt&filters=HpDate:\"20261106_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261107_DakotaBison"},"Ssd":"20261107","Name":"DakotaBison","Market":"ZH-CN","Hash":"2302503868","FullDateString":"2026 11月 7"},{"ImageContent":{"Description":"火山、雨林和竹林？毛伊岛上的哈莱亚卡拉国家公园三者兼有。公园的范围从毛伊岛上海拔10023英尺的山顶一直延伸到海岸，保护着随海拔、降雨量和气温变化而呈现迥异面貌的景观。它于1916年作为夏威夷国家公园的一部分设立，1961年成为独立的国家公园。哈莱阿卡拉意为“太阳之家”，这一名称呼应了夏威夷口述传说“moʻolelo”中毛伊捉住太阳、延长白昼的故事。","Image":{"Url":"/th?id=OHR.PipiwaiTrail_ZH-CN1811194311_1920x1080.webp","Wallpaper":"/th?id=OHR.PipiwaiTrail_ZH-CN1811194311_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"穿越毛伊岛的绿色隧道","Title":"竹林，皮皮维小径，哈莱亚卡拉国家公园，毛伊岛，夏威夷州，美国","Copyright":"© MNStudio/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"前往哈莱阿卡拉山顶观赏日出的游客须提前预约；名额最多提前60天开放。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261106_PipiwaiTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%93%88%e8%8e%b1%e4%ba%9a%e5%8d%a1%e6%8b%89%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261105_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261106_PipiwaiTrail"},"Ssd":"20261106","Name":"PipiwaiTrail","Market":"ZH-CN","Hash":"1811194311","FullDateString":"2026 11月 6"}],"PreloadMediaContents":[{"ImageContent":{"Description":"今天是世界哲学日，思想家们齐聚一堂，探讨人生中永恒的谜题。为庆祝这一节日，今天的图片展示了位于德国法兰克福的法兰克福歌德大学的雕塑《知识之躯》：来自八种不同文字体系的钢制字母被塑造成一个人形。西班牙艺术家豪梅·普兰萨解释道：‘我们的身体是精神的家园，是思想栖居的地方。’在世界哲学日，我们都受到鼓励，去超越简单的答案，探索塑造我们自身和周围世界的问题。","Image":{"Url":"/th?id=OHR.KnowledgeSculpture_ZH-CN3168800853_1920x1080.webp","Wallpaper":"/th?id=OHR.KnowledgeSculpture_ZH-CN3168800853_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"思想在此成形","Title":"雕塑《知识之躯》，由豪梅·普兰萨创作，位于德国法兰克福的法兰克福歌德大学","Copyright":"© Todamo/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"豪梅·普兰萨的《知识之躯》于2009年受法兰克福歌德大学委托，以彩绘不锈钢制成，尺寸为800×526× 526厘米。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261119_KnowledgeSculpture\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e5%93%b2%e5%ad%a6%e6%97%a5&form=hpcapt&filters=HpDate:\"20261118_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261119_KnowledgeSculpture"},"Ssd":"20261119","Name":"KnowledgeSculpture","Market":"ZH-CN","Hash":"3168800853","FullDateString":"2026 11月 19"},{"ImageContent":{"Description":"沐浴在傍晚光线中的这对仓鸮，正等待狩猎开始。夜幕降临时，这些猛禽便迅速行动，倾听鼠类和田鼠类在草丛或落叶中发出的细微动静。它们心形的面庞有助于将声音汇集到耳朵，使其听觉跻身动物界最敏锐的行列。这让它们能在黑暗中精准定位猎物，然后悄无声息地俯冲而下，柔软的羽毛掩盖了它们靠近的声响。秋天，年轻的仓鸮会离开巢穴，寻找自己的领地。随着夜晚变长，你可能会在傍晚更早地看到它们掠过田野，寻找晚餐。","Image":{"Url":"/th?id=OHR.BarnOwlsUnite_ZH-CN2930153291_1920x1080.webp","Wallpaper":"/th?id=OHR.BarnOwlsUnite_ZH-CN2930153291_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"从黄昏狩猎到黎明","Title":"一对仓鸮","Copyright":"© Zahoor Salmi/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"仓鸮不会发出‘咕咕’声；它们会发出令人毛骨悚然的尖叫声，这或许解释了为什么它们被视为厄运的预兆。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261118_BarnOwlsUnite\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%bb%93%e9%b8%ae&form=hpcapt&filters=HpDate:\"20261117_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261118_BarnOwlsUnite"},"Ssd":"20261118","Name":"BarnOwlsUnite","Market":"ZH-CN","Hash":"2930153291","FullDateString":"2026 11月 18"},{"ImageContent":{"Description":"全国徒步日快乐！是时候呼吸清爽的秋日空气，走进广阔的大自然了。今天的图片展示的是蒙大拿州冰川国家公园的雪松林步道；公园内的徒步步道总长达700英里。这条长0.9英里的环形步道设有高架栈道，穿行于北美乔柏和铁杉属树木之间。公园拥有适合不同能力水平游客的路线，沿途可欣赏高山湖泊、野花草甸、山口，以及一直延伸至加拿大边境的荒野。不过，即使家门口没有壮丽风景，随着白昼渐短，沿着绿树成荫的街道散散步，也能轻松庆祝这个日子，享受出门走走的益处。","Image":{"Url":"/th?id=OHR.TrailCedars_ZH-CN2670680285_1920x1080.webp","Wallpaper":"/th?id=OHR.TrailCedars_ZH-CN2670680285_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"走进广阔的大自然","Title":"雪松林步道，冰川国家公园，蒙大拿州，美国","Copyright":"© DBushue Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"在冰川国家公园的雪松林步道，游客可观赏雪崩峡谷，并在雪崩溪附近留意聆听美洲河乌的鸣声。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261117_TrailCedars\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%86%b0%e5%b7%9d%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad%e7%9a%84%e9%9b%aa%e6%9d%be%e6%9e%97%e6%ad%a5%e9%81%93&form=hpcapt&filters=HpDate:\"20261116_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261117_TrailCedars"},"Ssd":"20261117","Name":"TrailCedars","Market":"ZH-CN","Hash":"2670680285","FullDateString":"2026 11月 17"},{"ImageContent":{"Description":"壮丽的景色和坚实的岩石地基，是这些嵌在新墨西哥州悬崖上的古老民居的魅力所在。游牧者早已将崖居溪上方的天然洞穴用作临时栖身之所，但真正将这里当作家园的，是美洲原住民莫戈隆文化的族人。考古学家认为，他们在13世纪70至80年代，于五处岩穴中建造了数十个房间。这里一度同时住着多达15个家庭；他们在此抚养子女、制作陶器，俯瞰肥沃的吉拉河谷，并在那里种植作物、狩猎野生动物。大约在1300年，莫戈隆人出于未知原因离开，留下了美国西南部最重要的考古遗址之一。1907年11月16日，西奥多·罗斯福总统将此地指定为吉拉悬崖民居国家纪念地，帮助确保它得到保护，留存给后代。","Image":{"Url":"/th?id=OHR.GilaCliff_ZH-CN2393001519_1920x1080.webp","Wallpaper":"/th?id=OHR.GilaCliff_ZH-CN2393001519_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"历经岁月，屹立不倒","Title":"美国新墨西哥州吉拉悬崖民居国家纪念地","Copyright":"© Chiara Salvadori/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"吉拉悬崖民居的原始屋顶木梁至今仍保存着；木梁的年轮帮助考古学家确定这些古老建筑的年代。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261116_GilaCliff\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%90%89%e6%8b%89%e6%82%ac%e5%b4%96%e6%b0%91%e5%b1%85%e5%9b%bd%e5%ae%b6%e7%ba%aa%e5%bf%b5%e5%9c%b0&form=hpcapt&filters=HpDate:\"20261115_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261116_GilaCliff"},"Ssd":"20261116","Name":"GilaCliff","Market":"ZH-CN","Hash":"2393001519","FullDateString":"2026 11月 16"},{"ImageContent":{"Description":"随着秋天的第一场霜降临南方，冰晶在常绿灌木的叶片上凝结，就像这株杜鹃。春日花朵的粉色、橙色和黄色早已褪去，但新的色彩盛宴即将上演：绿色的叶片渐渐变成深浅不一的红色和紫色。对植物而言，这些新形成的色素能在气温下降时保护叶片；对园丁而言，白霜映衬下则是一幅绚丽的秋日景象。春天到来时，新芽会让灌木重披绿装，缤纷的色彩轮回也将重新开始。","Image":{"Url":"/th?id=OHR.FirstFrost_ZH-CN2219029557_1920x1080.webp","Wallpaper":"/th?id=OHR.FirstFrost_ZH-CN2219029557_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"霜染枝叶","Title":"覆霜的红叶杜鹃","Copyright":"© avoferten/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"使杜鹃叶片呈现红色或紫色的色素叫作花青素。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261115_FirstFrost\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%9d%9c%e9%b9%83%e8%8a%b1&form=hpcapt&filters=HpDate:\"20261114_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261115_FirstFrost"},"Ssd":"20261115","Name":"FirstFrost","Market":"ZH-CN","Hash":"2219029557","FullDateString":"2026 11月 15"},{"ImageContent":{"Description":"欢迎来到香港，这里拥有全球最多的摩天大楼。图中的高楼耸立在维多利亚港上方，港口水深，使香港得以发展成为繁忙的贸易港。自19世纪40年代起，载着茶叶、丝绸和其他货物的船只便在这里往来；第二次世界大战后的几十年间，经济增长急剧加速，带动了建筑业的繁荣。港口与山丘之间可用的平地有限，开发商只得向上建造，塑造了这片独具特色的天际线。2026年，香港有569栋高度超过492英尺的建筑，比任何其他城市都多。","Image":{"Url":"/th?id=OHR.BlueHK_ZH-CN1382345392_1920x1080.webp","Wallpaper":"/th?id=OHR.BlueHK_ZH-CN1382345392_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"唯有向上发展","Title":"中国香港维多利亚港","Copyright":"© Juan Romero/Cavan Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"“幻彩咏香江”通常于晚上8点上演，以音乐配合维多利亚港上空的激光和探照灯光束。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261114_BlueHK\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%ad%e5%9b%bd%e9%a6%99%e6%b8%af%e7%bb%b4%e5%a4%9a%e5%88%a9%e4%ba%9a%e6%b8%af&form=hpcapt&filters=HpDate:\"20261113_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261114_BlueHK"},"Ssd":"20261114","Name":"BlueHK","Market":"ZH-CN","Hash":"1382345392","FullDateString":"2026 11月 14"},{"ImageContent":{"Description":"黎明的第一缕曙光映照在亚伯拉罕湖冰封的湖面上，远处是落基山脉的群峰。冬季，这座位于艾伯塔省的如画湖泊以困在冰层下的甲烷气泡而闻名。强风使湖面不被积雪覆盖，让人们整个冬天都能观赏这一景象。到了春天，冰层融化，气体便逸散到大气中。","Image":{"Url":"/th?id=OHR.AbrahamCanada_ZH-CN0344365912_1920x1080.webp","Wallpaper":"/th?id=OHR.AbrahamCanada_ZH-CN0344365912_1920x1200.jpg&rf=LaDigue_1920x1200.jpg",