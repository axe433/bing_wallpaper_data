{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"https://r.bing.com/rb/2D/cir3,cc,nc/0drQAsq6w8jNRhWFk9TcmprI8vU.css?bu=CPQB9wGYAqcCmwKbApsC4wI&or=w","Postloaded":false},{"Path":"https://r.bing.com/rs/2D/7p/cir3,cc,nc/CUCSI1SFeWrmYnIaftq0iQdznqQ.css?or=w","Postloaded":true},{"Path":"https://r.bing.com/rb/2D/cir3,cc,nc/_S_hO16T1q81cdlQu_gFOlk1pfg.css?bu=CJMDmwKbAt0CtwKbApsCmwI&or=w","Postloaded":true},{"Path":"https://r.bing.com/rs/2D/62/cc,nc/pZ5R_tJWe7QpulmAzB8Jp71qd-o.css?or=w","Postloaded":true},{"Path":"https://r.bing.com/rb/2D/cir3,cc,nc/zmTB4hEk3xeY-WDa-Zn8LizFCcg.css?bu=AvAC_gI&or=w","Postloaded":false},{"Path":"https://r.bing.com/rs/2D/62/cc,nc/pZ5R_tJWe7QpulmAzB8Jp71qd-o.css?or=w","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableHPV2Portal":false,"EnableHPV2PortalFullScreen":false,"EnableHPV2NoCopilot":false,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-07-24T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"除了引人注目的体色，栖息在伊莎贝拉岛，加拉帕戈斯群岛，厄瓜多尔的美洲红鹳还以其高度同步的求偶仪式而闻名。数百只红鹳会参与一场极具仪式感的“集体舞”，它们整齐划一地行进，并有节奏地左右摆动头部以吸引配偶。这种集体行为确保了整个集群能在同一时间进行繁殖，从而在群岛严酷的火山地貌中最大限度地提高雏鸟的存活率。","Image":{"Url":"/th?id=OHR.GalapagosFlamingos_ZH-CN1152519387_1920x1080.webp","Wallpaper":"/th?id=OHR.GalapagosFlamingos_ZH-CN1152519387_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"缤纷多彩的一家人","Title":"美洲红鹳群在伊莎贝拉岛，加拉帕戈斯群岛，厄瓜多尔","Copyright":"© Tui De Roy/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"红鹳双亲均能分泌“嗉囊乳”来哺育雏鸟，这种营养丰富的物质类似于哺乳动物的乳汁，在伊莎贝拉岛，加拉帕戈斯群岛，厄瓜多尔。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260724_GalapagosFlamingos\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%be%8e%e6%b4%b2%e7%ba%a2%e9%b9%b3&form=hpcapt&filters=HpDate:\"20260723_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260724_GalapagosFlamingos"},"Ssd":"20260724","Name":"GalapagosFlamingos","Market":"ZH-CN","Hash":"1152519387","FullDateString":"2026 7月 24"},{"ImageContent":{"Description":"有些花卉静谧地装点着花园，而大丽花（Dahlias）的登场则宛如领衔主演。这些原产于墨西哥的菊科（Asteraceae）成员拥有超过5.7万个培育品种，这在很大程度上归功于其独特的遗传特征。大丽花是典型的八倍体（Octoploids），意味着它们拥有八组染色体，这种多倍体特征使其花朵形态极具多样性，既有如纽扣般娇小的品种，也有直径达14英寸的巨型花冠。","Image":{"Url":"/th?id=OHR.PinkDahlia_ZH-CN2259107800_1920x1080.webp","Wallpaper":"/th?id=OHR.PinkDahlia_ZH-CN2259107800_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"瓣叠交响","Title":"粉红色大丽花","Copyright":"© Harald Biebel/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"大丽花的一个阿兹特克语名称常被译为“水管花”，这源于该植物细长且中空的茎部特征，这种中空茎在古代曾被用作输送水分的管道。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260723_PinkDahlia\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a4%a7%e4%b8%bd%e8%8a%b1%e5%b1%9e%e6%a4%8d%e7%89%a9&form=hpcapt&filters=HpDate:\"20260722_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260723_PinkDahlia"},"Ssd":"20260723","Name":"PinkDahlia","Market":"ZH-CN","Hash":"2259107800","FullDateString":"2026 7月 23"},{"ImageContent":{"Description":"想象一座由动物建造的城市，在阳光下熠熠生辉，并在海浪之下涌动着生命。这就是珊瑚礁。在珊瑚礁意识周（Coral Reef Awareness Week）期间，我们赞美这些非凡的生态系统，以及依赖其生存的无数物种","Image":{"Url":"/th?id=OHR.CoralAwareness_ZH-CN1621627126_1920x1080.webp","Wallpaper":"/th?id=OHR.CoralAwareness_ZH-CN1621627126_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"细微之举，影响深远","Title":"珊瑚礁与海滩在拉贾安帕特，印度尼西亚","Copyright":"© SergeUWPhoto/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"珊瑚礁作为“21世纪的药库”在拉贾安帕特，印度尼西亚及全球海洋中展现出巨大的生物医学价值，其产生的独特化合物正被用于开发治疗癌症及心脏病的新型药物。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260722_CoralAwareness\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%8f%8a%e7%91%9a%e7%a4%81%e6%84%8f%e8%af%86%e5%91%a8&form=hpcapt&filters=HpDate:\"20260721_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260722_CoralAwareness"},"Ssd":"20260722","Name":"CoralAwareness","Market":"ZH-CN","Hash":"1621627126","FullDateString":"2026 7月 22"},{"ImageContent":{"Description":"有些建筑的初衷并非为了引人注目，但时间却另有安排。清晨时分，圣卡塔琳娜拱门在危地马拉安提瓜的街道上熠熠生辉，其鲜艳的黄色外墙精准地捕捉着晨光，石板路向前延伸，远方的水火山拔地而起。这座拱门建于17世纪，旨在解决一个实际问题：幽居修女需要在修道院建筑之间穿行，以符合宗教誓约中不被街道行人直视的要求。正是这种对隐私的克制，而非对景观的追求，造就了如今中美洲出镜率最高的地标之一。讽刺的是，这种反差随时间的沉淀而愈发迷人。","Image":{"Url":"/th?id=OHR.SantaCatalina_ZH-CN6223370790_1920x1080.webp","Wallpaper":"/th?id=OHR.SantaCatalina_ZH-CN6223370790_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"拱影寻踪","Title":"圣卡塔琳娜拱门，安提瓜，危地马拉","Copyright":"© Filippo Maria Bianchi/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"这座标志性的法制时钟于19世纪30年代被增设，至今仍需每三天人工手动上弦一次，在圣卡塔琳娜拱门，安提瓜，危地马拉。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260721_SantaCatalina\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%8d%b1%e5%9c%b0%e9%a9%ac%e6%8b%89%e5%9c%a3%e5%8d%a1%e5%a1%94%e7%90%b3%e5%a8%9c%e6%8b%b1%e9%97%a8&form=hpcapt&filters=HpDate:\"20260720_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260721_SantaCatalina"},"Ssd":"20260721","Name":"SantaCatalina","Market":"ZH-CN","Hash":"6223370790","FullDateString":"2026 7月 21"},{"ImageContent":{"Description":"从月球那遍布环形山的表面望去，地球在无垠的黑暗中呈现为一抹微光闪烁的娥眉状——这一罕见的奇观与我们惯常的地面观测视角截然相反。这片由数十亿年撞击作用塑造的荒芜地貌，完整地保存了早期太阳系的演化记录。7月20日是国际月球日，旨在纪念1969年阿波罗11号任务中人类首次踏上月球表面的历史性时刻。该纪念日由联合国于2021年设立，不仅致敬过去的辉煌成就，更聚焦于当下持续不断的月球探测努力。","Image":{"Url":"/th?id=OHR.Artemis_ZH-CN3540365575_1920x1080.webp","Wallpaper":"/th?id=OHR.Artemis_ZH-CN3540365575_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"月瞰寰宇","Title":"月球与地球由阿耳忒弥斯2号机组人员拍摄","Copyright":"© NASA","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"月球的自转速率与其绕地球公转的速率完全同步，由于这种“同步自转”特性，我们在地球上观测时始终只能看到月球的同一面。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260720_Artemis\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%99%85%e6%9c%88%e7%90%83%e6%97%a5&form=hpcapt&filters=HpDate:\"20260719_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260720_Artemis"},"Ssd":"20260720","Name":"Artemis","Market":"ZH-CN","Hash":"3540365575","FullDateString":"2026 7月 20"},{"ImageContent":{"Description":"一群家燕栖息在纤细的芦苇上，在片刻的宁静中聚集，与其往常疾速的身影形成了鲜明对比。这些鸟类以迅捷且极具灵动性的飞行能力及标志性的深叉状尾羽著称，其生理构造天生便高度适应不间断的飞行生活。它们能在半空中精准捕食昆虫，并在各大洲之间长途跋涉。羽色与斑纹的细微差异暗示此处可能聚集了多个亚种，这有力地证明了家燕广泛的全球分布范围。","Image":{"Url":"/th?id=OHR.HirundoRustica_ZH-CN2798518247_1920x1080.webp","Wallpaper":"/th?id=OHR.HirundoRustica_ZH-CN2798518247_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"敛羽栖时","Title":"不同亚种的家燕聚在一起休息","Copyright":"© Oscar Dominguez/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"家燕每年在繁殖地与越冬地之间往返迁徙，其行程可达数千英里。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260719_HirundoRustica\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%ae%b6%e7%87%95&form=hpcapt&filters=HpDate:\"20260718_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260719_HirundoRustica"},"Ssd":"20260719","Name":"HirundoRustica","Market":"ZH-CN","Hash":"2798518247","FullDateString":"2026 7月 19"},{"ImageContent":{"Description":"倒映在平静的水面上，拉科茨桥——通称为“恶魔桥”——在德国萨克森州构成了一个近乎完美的石环。这座窄长的玄武岩结构始建于1860年，经过精密的工程设计，使其拱形结构与水面倒影在湖面静止时能精准对齐，形成一个无缝的圆环。该建筑由当地产的火山石建成，与其说它具有实用功能，不如说它体现了精准的几何设计，其惊艳的造型纯粹是为了追求视觉上的美学冲击。作为热门的摄影题材，它还曾出现在包括《黑客帝国：矩阵重启》（2021年）在内的电影中。如今，由于桥体结构脆弱，为了对其进行保护，严禁行人通行，游客仅可从岸边观赏。","Image":{"Url":"/th?id=OHR.DevilsBridge_ZH-CN2164982440_1920x1080.webp","Wallpaper":"/th?id=OHR.DevilsBridge_ZH-CN2164982440_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"环影圆成","Title":"恶魔桥在克罗姆劳杜鹃花公园，萨克森州，德国","Copyright":"© Mike Mareen/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"这种“恶魔桥”的称谓源于古老的民间传说，意指只有撒旦才能建造出如此违背重力的拱形结构，在克罗姆劳，萨克森州，德国。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260718_DevilsBridge\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%81%b6%e9%ad%94%e6%a1%a5%e5%9c%a8%e5%85%8b%e7%bd%97%e5%a7%86%e5%8a%b3%e6%9d%9c%e9%b9%83%e8%8a%b1%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20260717_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260718_DevilsBridge"},"Ssd":"20260718","Name":"DevilsBridge","Market":"ZH-CN","Hash":"2164982440","FullDateString":"2026 7月 18"}],"PreloadMediaContents":[{"ImageContent":{"Description":"有些铁路会退出历史舞台，而“弗吉尼亚爬山虎步道”则实现了华丽转身。这条步道全长34.3英里，横贯弗吉尼亚州西南部，沿用了一条昔日的铁路线——该线路曾用于在阿巴拉契亚山脉间运输木材和铁矿石。步道那独特的名字，源自20世纪初那些在陡峭坡道上艰难爬行的蒸汽机车。","Image":{"Url":"/th?id=OHR.VirginiaTrail_ZH-CN2299501599_1920x1080.webp","Wallpaper":"/th?id=OHR.VirginiaTrail_ZH-CN2299501599_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"穿越时光的足迹","Title":"鸟瞰弗吉尼亚爬山虎步道，达马斯克斯，弗吉尼亚州，美国","Copyright":"© Eifel Kreutz/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"这条步道的英文名字“Virginia creeper”（弗吉尼亚爬山虎）具有双重寓意：一是指沿铁轨茂盛生长的当地原生五叶爬山虎植物，二是指20世纪初蒸汽机车在攀爬陡峭山坡时如蜗牛爬行般缓慢的行驶速度。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260731_VirginiaTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%bc%97%e5%90%89%e5%b0%bc%e4%ba%9a%e7%88%ac%e5%b1%b1%e8%99%8e%e6%ad%a5%e9%81%93&form=hpcapt&filters=HpDate:\"20260730_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260731_VirginiaTrail"},"Ssd":"20260731","Name":"VirginiaTrail","Market":"ZH-CN","Hash":"2299501599","FullDateString":"2026 7月 31"},{"ImageContent":{"Description":"在纳瓦霍族保留地，亚利桑那州与犹他州交界处，美国，有些景观举世闻名，而纪念碑谷则堪称传奇。这一沙漠奇观横跨州界，其地貌由高耸的砂岩孤峰塑造而成，这些孤峰从谷底拔地而起，高度可达1000英尺。在纳瓦霍语中，该地区被称为 Tsé Bii' Ndzisgaii（意为“岩石之谷”），它将壮丽的地质构造与鲜活的民族文化完美融合。","Image":{"Url":"/th?id=OHR.NavajoNation_ZH-CN9274387505_1920x1080.webp","Wallpaper":"/th?id=OHR.NavajoNation_ZH-CN9274387505_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"旷野无声，活态传承之境","Title":"在纳瓦霍族保留地的纪念碑谷，亚利桑那州，美国","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"阿甘结束其跨国长跑的著名地点位于163号美国国道，这里拥有俯瞰山谷的最具标志性视野，在纪念碑谷，纳瓦霍族保留地，美国。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260730_NavajoNation\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%ba%aa%e5%bf%b5%e7%a2%91%e8%b0%b7&form=hpcapt&filters=HpDate:\"20260729_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260730_NavajoNation"},"Ssd":"20260730","Name":"NavajoNation","Market":"ZH-CN","Hash":"9274387505","FullDateString":"2026 7月 30"},{"ImageContent":{"Description":"在全球老虎日这一天，这群孟加拉虎迈着自信的步伐走过印度，拉贾斯坦邦，兰坦博尔国家公园，展现出顶级掠食者对自身在食物链中地位的精准认知。孟加拉虎兼具隐蔽性与力量：成年个体的体长从鼻尖到尾端可超过10英尺，体重约500磅，行走时却能悄无声息。在视觉可见度是一把“双刃剑”的自然生境中，它们的斑纹发挥了关键作用，通过复杂的图案模式在环境中进行伪装，使猎物难以辨识其身形。","Image":{"Url":"/th?id=OHR.TigerFamily_ZH-CN9064744163_1920x1080.webp","Wallpaper":"/th?id=OHR.TigerFamily_ZH-CN9064744163_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"虎啸归来，锐爪重临","Title":"孟加拉虎一家在兰坦博尔国家公园，拉贾斯坦邦，印度","Copyright":"© Archna Singh/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"老虎是卓越的游泳者，经常通过泡水来降温，这在大多数猫科动物中极为罕见，在兰坦博尔国家公园，拉贾斯坦邦，印度。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260729_TigerFamily\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%85%a8%e7%90%83%e8%80%81%e8%99%8e%e6%97%a5&form=hpcapt&filters=HpDate:\"20260728_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260729_TigerFamily"},"Ssd":"20260729","Name":"TigerFamily","Market":"ZH-CN","Hash":"9064744163","FullDateString":"2026 7月 29"},{"ImageContent":{"Description":"在美国加利福尼亚州，海峡群岛国家公园，安纳卡帕岛附近，海洋孕育着属于自己的森林。在被称为“北美洲加拉帕戈斯”的海峡群岛国家公园内，巨藻的长度可超过 100 英尺，它们通过充满空气的气囊在水中形成具有浮力的丝带，并由底部的根状固着器锚定在海床之上。","Image":{"Url":"/th?id=OHR.ChannelKelp_ZH-CN8732903732_1920x1080.webp","Wallpaper":"/th?id=OHR.ChannelKelp_ZH-CN8732903732_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"生机律动，恒久之衡","Title":"一片海藻林在安纳卡帕岛附近，海峡群岛国家公园，加利福尼亚州，美国","Copyright":"© Ian Shive/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"海獭是此处的关键种；通过捕食海胆，它们能防止海藻林被过度啃食，在安纳卡帕岛附近，海峡群岛国家公园，美国。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260728_ChannelKelp\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e8%87%aa%e7%84%b6%e4%bf%9d%e6%8a%a4%e6%97%a5&form=hpcapt&filters=HpDate:\"20260727_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260728_ChannelKelp"},"Ssd":"20260728","Name":"ChannelKelp","Market":"ZH-CN","Hash":"8732903732","FullDateString":"2026 7月 28"},{"ImageContent":{"Description":"步入位于美国，伊利诺伊州，芝加哥文化中心的建筑内部，目光瞬间会被上方绚丽夺目的彩色顶棚——蒂芙尼穹顶所吸引。这座艺术杰作悬挂在普雷斯顿·布拉德利大厅上方，直径约38英尺，由约30,000片法夫里尔玻璃组成，每片玻璃都呈鱼鳞状。阳光透过其半透明的表面，在错综复杂的图案中映射出变幻莫测的蓝色与金色。","Image":{"Url":"/th?id=OHR.ChicagoTiffany_ZH-CN9860688834_1920x1080.webp","Wallpaper":"/th?id=OHR.ChicagoTiffany_ZH-CN9860688834_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"仰望芝城，流光溢彩","Title":"蒂芙尼穹顶，芝加哥文化中心，伊利诺伊州，美国","Copyright":"© Felix Lipov/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"穹顶基座饰有十二星座图案，其玻璃工艺旨在模仿波光粼粼且具有虹彩质感的海面，在美国伊利诺伊州芝加哥文化中心。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260727_ChicagoTiffany\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%8a%9d%e5%8a%a0%e5%93%a5%e6%96%87%e5%8c%96%e4%b8%ad%e5%bf%83%e8%92%82%e8%8a%99%e5%b0%bc%e7%a9%b9%e9%a1%b6&form=hpcapt&filters=HpDate:\"20260726_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260727_ChicagoTiffany"},"Ssd":"20260727","Name":"ChicagoTiffany","Market":"ZH-CN","Hash":"9860688834","FullDateString":"2026 7月 27"},{"ImageContent":{"Description":"在洪都拉斯小猪群岛的日出时分——那是掩映在红树林湿地中低矮的沿海小岛——一株红树将其交错的根系挺立于如镜的水面之上。这幅动人的画面精准捕捉了7月26日所庆祝的主题：保护红树林生态系统国际日，该节日的设立旨在呼吁全球关注这些至关重要的海岸森林。","Image":{"Url":"/th?id=OHR.RedMangroveSunrise_ZH-CN7940335392_1920x1080.webp","Wallpaper":"/th?id=OHR.RedMangroveSunrise_ZH-CN7940335392_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海陆际会，生机肇始","Title":"红树上的日出在小猪群岛，洪都拉斯","Copyright":"© Mac Stone/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"红树具有特殊的“胎生”特性，其种子在脱离母树掉入潮汐前就已在枝头萌发，在小猪群岛，洪都拉斯。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260726_RedMangroveSunrise\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%bf%9d%e6%8a%a4%e7%ba%a2%e6%a0%91%e6%9e%97%e7%94%9f%e6%80%81%e7%b3%bb%e7%bb%9f%e5%9b%bd%e9%99%85%e6%97%a5&form=hpcapt&filters=HpDate:\"20260725_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260726_RedMangroveSunrise"},"Ssd":"20260726","Name":"RedMangroveSunrise","Market":"ZH-CN","Hash":"7940335392","FullDateString":"2026 7月 26"},{"ImageContent":{"Description":"在西班牙遥远的西北部，加利西亚与大西洋交汇。漫长的海岸线在海浪的强力冲刷下，形成了由悬崖、内湾和海蚀平台交织而成的地貌。雨水充沛的山丘与密林向海绵延，这种景观带有鲜明的大西洋气候基调，使其在感官上更接近于爱尔兰，而非人们惯常印象中的西班牙南部。","Image":{"Url":"/th?id=OHR.GaliciaBeach_ZH-CN1246611659_1920x1080.webp","Wallpaper":"/th?id=OHR.GaliciaBeach_ZH-CN1246611659_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"加境幽廊","Title":"大教堂海滩，加利西亚，西班牙","Copyright":"© Tui De Roy/Amazing Aerial Agency/Abobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"除了因酷似教堂的拱门而闻名外，该地标的官方定名为“圣水海滩”，在大教堂海滩，加利西亚，西班牙。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260725_GaliciaBeach\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%a5%bf%e7%8f%ad%e7%89%99%e5%8a%a0%e5%88%a9%e8%a5%bf%e4%ba%9a&form=hpcapt&filters=HpDate:\"20260724_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260725_GaliciaBeach"},"Ssd":"20260725","Name":"GaliciaBeach","Market":"ZH-CN","Hash":"1246611659","FullDateString":"2026 7月 25"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"每日一图","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"了解更多","LOC_HOMEPAGE_VERTICAL_SCROLL_DONATE_NOW":"立即捐赠","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"速览:","LOC_HOMEPAGE_GALLERY_CARD_TITLE":"近期的主页图片","LOC_HOMEPAGE_VERTICAL_SCROLL_GALLERY_IMAGE_ARIALABEL":"{0} 的主页图像","LOC_HOMEPAGE_ON_THIS_DAY_TITLE":"历史上的今天","LOC_HOMEPAGE_ON_THIS_DAY_IMAGE_ARIALABEL":"在这一天，在 {0}中，{1}","LOC_HOMEPAGE_SHARE_TOOLTIP":"共享今日必应主页","LOC_HOMEPAGE_WALLPAPERDOWNLOAD_TOOLTIP":"下载今日美图。仅限用作桌面壁纸。","LOC_MUSCARD_DOWNLOAD_LINK":"下载此图像","LOC_HOMEPAGE_WALLPAPERNOTAVAILABLE":"此图片不能下载用作壁纸。","LOC_HOMEPAGE_INFO_TEXT":"信息","LOC_BING_WP_APP_LINK":"https://go.microsoft.com/fwlink/?linkid=2127455","LOC_BING_WP_APP_LINK_TEXT":"获取新版必应壁纸应用","LOC_BING_APP_TEXT":"在设备上获取必应壁纸","LOC_BING_APP_LINK_PC":"https://bing.microsoftapp.net/bing/?adjust=nk9xri2_dzfz5n2","LOC_BING_APP_LINK_MOBILE":"https://app.adjust.com/d93ddtl_a75k0gg?d