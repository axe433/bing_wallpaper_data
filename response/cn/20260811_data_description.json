{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"https://r.bing.com/rb/2D/cir3,cc,nc/62LADVHxQPW7NT_OJuZbSiwjv0g.css?bu=CfQB9wGYAqcCmwKbApsCmwLsAg&or=w","Postloaded":false},{"Path":"https://r.bing.com/rs/2D/7D/cir3,cc,nc/CUCSI1SFeWrmYnIaftq0iQdznqQ.css?or=w","Postloaded":true},{"Path":"https://r.bing.com/rb/2D/cir3,cc,nc/_S_hO16T1q81cdlQu_gFOlk1pfg.css?bu=CKEDmwKbAuYCvAKbApsCmwI&or=w","Postloaded":true},{"Path":"https://r.bing.com/rs/2D/6b/cc,nc/pZ5R_tJWe7QpulmAzB8Jp71qd-o.css?or=w","Postloaded":true},{"Path":"https://r.bing.com/rs/2D/4z/cc,nc/4PRBJAfIvdmgyFOSepob3sG79T4.css?or=w","Postloaded":true},{"Path":"https://r.bing.com/rb/2D/cir3,cc,nc/zmTB4hEk3xeY-WDa-Zn8LizFCcg.css?bu=AvkCjAM&or=w","Postloaded":false},{"Path":"https://r.bing.com/rs/2D/6b/cc,nc/pZ5R_tJWe7QpulmAzB8Jp71qd-o.css?or=w","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableHPV2Portal":false,"EnableHPV2PortalFullScreen":false,"EnableHPV2ScrollBg":false,"EnableHPV2HeaderGrad":false,"EnableHPV2NoCopilot":false,"HideCopilot":false,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-08-11T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"8月12日世界大象日，让我们停下脚步，不仅思考这些动物的庞大体型，也体会它们生命的深度。在图片所示的肯尼亚安博塞利国家公园等地，非洲草原象群并非只是穿越景观；它们还会记住这片土地。母象首领带领家族往返于不同水源，行进路线既由地形塑造，也由记忆指引。","Image":{"Url":"/th?id=OHR.ElephantDay_ZH-CN8350171749_1920x1080.webp","Wallpaper":"/th?id=OHR.ElephantDay_ZH-CN8350171749_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"值得守护的巨兽","Title":"安博塞利国家公园的非洲草原象群，卡贾多郡，肯尼亚","Copyright":"© Ibrahim Suha Derbent/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"2024年的一项研究利用在安博塞利录制的叫声发现，非洲象会用类似个体名字的叫声彼此称呼。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260812_ElephantDay\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e5%a4%a7%e8%b1%a1%e6%97%a5&form=hpcapt&filters=HpDate:\"20260811_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260812_ElephantDay"},"Ssd":"20260812","Name":"ElephantDay","Market":"ZH-CN","Hash":"8350171749","FullDateString":"2026 8月 12"},{"ImageContent":{"Description":"哥本哈根新港运河是一条标志性水道，鲜艳色彩与深厚历史在此交融。它于17世纪70年代在克里斯蒂安五世统治时期挖建，曾是重要门户，货船可由此将货物直接卸入城市中心。远在成为今天明信片般完美的地标之前，这座港口曾以粗犷闻名：水手云集、酒馆喧闹，与色彩明快的山墙联排屋并立。","Image":{"Url":"/th?id=OHR.ColorfulCop_ZH-CN8015611442_1920x1080.webp","Wallpaper":"/th?id=OHR.ColorfulCop_ZH-CN8015611442_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"绚丽多彩的哥本哈根","Title":"哥本哈根新港运河沿岸的彩色房屋，首都大区，丹麦","Copyright":"© emicristea/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"汉斯·克里斯蒂安·安徒生一生中曾在新港的18号、20号和67号三个不同地址居住。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260811_ColorfulCop\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%93%a5%e6%9c%ac%e5%93%88%e6%a0%b9%e6%96%b0%e6%b8%af%e8%bf%90%e6%b2%b3&form=hpcapt&filters=HpDate:\"20260810_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260811_ColorfulCop"},"Ssd":"20260811","Name":"ColorfulCop","Market":"ZH-CN","Hash":"8015611442","FullDateString":"2026 8月 11"},{"ImageContent":{"Description":"两片大沙漠交汇之处，约书亚树国家公园展现出由风、时间和极端环境塑造的冷峻迷人景观。在南加利福尼亚州，海拔较高的莫哈韦沙漠与更炎热、地势更低的科罗拉多沙漠相融，形成独特的生态系统组合与非凡的生物多样性。","Image":{"Url":"/th?id=OHR.SandPath_ZH-CN7820825668_1920x1080.webp","Wallpaper":"/th?id=OHR.SandPath_ZH-CN7820825668_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"两片沙漠交汇之地","Title":"约书亚树国家公园，加利福尼亚州，美国","Copyright":"© JJ Landscapes/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"约书亚树地区的二长花岗岩最初是熔融岩体，在一亿多年前于地下冷却形成。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260810_SandPath\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%ba%a6%e4%b9%a6%e4%ba%9a%e6%a0%91%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20260809_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260810_SandPath"},"Ssd":"20260810","Name":"SandPath","Market":"ZH-CN","Hash":"7820825668","FullDateString":"2026 8月 10"},{"ImageContent":{"Description":"今天，世界土著人民国际日邀请我们更深入地了解那些历史远早于文字记载的社群。联合国于1994年设立这一纪念日，并于1995年首次举行活动；日期所纪念的是1982年一次致力于保护全球土著人民权利的重要会议。如今，约90个国家生活着超过4.76亿土著人民，他们延续着数千种文化，也传承着全球约7,000种语言中的大多数。","Image":{"Url":"/th?id=OHR.JMTjibaou_ZH-CN6992670356_1920x1080.webp","Wallpaper":"/th?id=OHR.JMTjibaou_ZH-CN6992670356_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"身份认同的建筑表达","Title":"让-马里·吉巴乌文化中心，新喀里多尼亚","Copyright":"© Fabien Astre/Alamy","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"文化中心的十座高耸“构筑体”高度各异，其中最高的一座在新喀里多尼亚的景观中高达28米。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260809_JMTjibaou\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e5%9c%9f%e8%91%97%e4%ba%ba%e6%b0%91%e5%9b%bd%e9%99%85%e6%97%a5&form=hpcapt&filters=HpDate:\"20260808_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260809_JMTjibaou"},"Ssd":"20260809","Name":"JMTjibaou","Market":"ZH-CN","Hash":"6992670356","FullDateString":"2026 8月 9"},{"ImageContent":{"Description":"8月8日，国际无限日让好奇心成为主角。这项庆祝活动的灵感来自横置的数字8——象征永无止境的无限符号。纽约哲学家让-皮埃尔·阿迪·费尼奥于1987年创立这一节日，邀请每个人通过科学、艺术和想象力探索宏大理念。它不只关乎数学，也关乎从浩瀚宇宙到人类创造力边界的种种可能。","Image":{"Url":"/th?id=OHR.StocktonInfinity_ZH-CN5941379745_1920x1080.webp","Wallpaper":"/th?id=OHR.StocktonInfinity_ZH-CN5941379745_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"迈向无限","Title":"蒂斯河畔斯托克顿无限桥，英格兰","Copyright":"© Bahadir Yeniceri/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"由于无法设置中央桥墩，无限桥采用不等高系杆拱和倒置鞍形结构，为180米长的桥身增强刚度。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260808_StocktonInfinity\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%99%85%e6%97%a0%e9%99%90%e6%97%a5&form=hpcapt&filters=HpDate:\"20260807_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260808_StocktonInfinity"},"Ssd":"20260808","Name":"StocktonInfinity","Market":"ZH-CN","Hash":"5941379745","FullDateString":"2026 8月 8"},{"ImageContent":{"Description":"每年的8月7日是“全国灯塔日”，这一节日旨在颂扬那些数百年来指引船只安全航行于美国沿海的灯塔。这一日期是为了纪念乔治·华盛顿总统签署生效的《1789年灯塔法案》。","Image":{"Url":"/th?id=OHR.LimeKiln_ZH-CN5664152522_1920x1080.webp","Wallpaper":"/th?id=OHR.LimeKiln_ZH-CN5664152522_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"指引船只穿越历史","Title":"圣胡安岛石灰窑灯塔，华盛顿州，美国","Copyright":"© Edmund Lowe Photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"石灰窑点州立公园被认为是全球最佳的陆基观鲸地点之一，因为这里的海岸水深急剧下降，使得虎鲸群能够游至非常靠近岩石绝壁的海域。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260807_LimeKiln\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%9f%b3%e7%81%b0%e7%aa%91%e7%81%af%e5%a1%94&form=hpcapt&filters=HpDate:\"20260806_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260807_LimeKiln"},"Ssd":"20260807","Name":"LimeKiln","Market":"ZH-CN","Hash":"5664152522","FullDateString":"2026 8月 7"},{"ImageContent":{"Description":"在肯尼亚的马赛马拉，大地仿佛在移动。成群结队的角马——这种拥有极强耐力的蹄类食草动物——在季节性降雨滋润出的鲜嫩青草与水源的吸引下，浩浩荡荡地迁徙着。","Image":{"Url":"/th?id=OHR.MaraCrossing_ZH-CN8816902094_1920x1080.webp","Wallpaper":"/th?id=OHR.MaraCrossing_ZH-CN8816902094_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"生死渡口，勇者的史诗","Title":"马赛马拉迁徙的角马群横渡马拉河, 肯尼亚","Copyright":"© Manoj Shah/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"成年角马体重可达600磅，属于体型较大的食草性羚羊。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260806_MaraCrossing\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%a7%92%e9%a9%ac&form=hpcapt&filters=HpDate:\"20260805_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260806_MaraCrossing"},"Ssd":"20260806","Name":"MaraCrossing","Market":"ZH-CN","Hash":"8816902094","FullDateString":"2026 8月 6"}],"PreloadMediaContents":[{"ImageContent":{"Description":"通往此处的最佳路径并非由混凝土铺就。每当退潮时，一条岩石小径便会显露出来，连接着加拿大西温哥华的怀特克利夫公园（Whytecliff Park）与怀特小岛（Whyte Islet）。数小时后，海水会悄然漫过这条通道，将“把握时机”也变成了体验的一部分。这片海岸线吸引着一代又一代的游客：潮汐开辟了道路，而湿滑的岩石则让人心存敬畏；作为回报，你将收获回望海滩与格伦伊格尔斯（Gleneagles）山坡民居时的壮丽景致。","Image":{"Url":"/th?id=OHR.WhyteCliffP_ZH-CN0573407830_1920x1080.webp","Wallpaper":"/th?id=OHR.WhyteCliffP_ZH-CN0573407830_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"浪潮间的通道","Title":"怀特克利夫公园，西温哥华，加拿大","Copyright":"© Aolin Chen/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"怀特克利夫公园于1993年成为加拿大首个咸水海洋保护区，为近岸栖息地提供保护。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260819_WhyteCliffP\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%80%80%e7%89%b9%e5%85%8b%e5%88%a9%e5%a4%ab%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20260818_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260819_WhyteCliffP"},"Ssd":"20260819","Name":"WhyteCliffP","Market":"ZH-CN","Hash":"0573407830","FullDateString":"2026 8月 19"},{"ImageContent":{"Description":"从空中俯瞰，帕尔马诺瓦与其说是一座城镇，不如说是一颗精心绘制、嵌入意大利弗留利-威尼斯朱利亚平原的星。威尼斯共和国于1593年建立这座要塞城市，其设计兼顾防御、秩序与宏伟观感。街道从中央广场向外辐射，城墙则构成精确的九角星形。这种几何形态绝非偶然。帕尔马诺瓦成为近代早期军事建筑最具影响力的典范之一。其同心式防御工事最初由威尼斯修建，后来在拿破仑时期得到加固和扩建。","Image":{"Url":"/th?id=OHR.Palmanova_ZH-CN0378401592_1920x1080.webp","Wallpaper":"/th?id=OHR.Palmanova_ZH-CN0378401592_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"星形城市的几何之美","Title":"弗留利要塞城市帕尔马诺瓦航拍图，意大利","Copyright":"© Riccardo Saponi/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"帕尔马诺瓦所属的联合国教科文组织世界遗产由六个组成部分构成，横跨三国一千多公里。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260818_Palmanova\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%84%8f%e5%a4%a7%e5%88%a9%e5%b8%95%e5%b0%94%e9%a9%ac%e8%af%ba%e7%93%a6&form=hpcapt&filters=HpDate:\"20260817_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260818_Palmanova"},"Ssd":"20260818","Name":"Palmanova","Market":"ZH-CN","Hash":"0378401592","FullDateString":"2026 8月 18"},{"ImageContent":{"Description":"地点很重要。看看图片中菲律宾卡比劳岛附近卡比劳附近的灯塔礁的眼斑双锯鱼就知道了。在这片充满饥饿捕食者和激烈竞争的热带水域，它们占据了一块黄金地段：一只拥有数千个微小刺细胞的海葵。","Image":{"Url":"/th?id=OHR.CabilaoClowns_ZH-CN0147033898_1920x1080.webp","Wallpaper":"/th?id=OHR.CabilaoClowns_ZH-CN0147033898_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"珊瑚礁上的黄金地段","Title":"海葵中的三条眼斑双锯鱼，卡比劳岛，薄荷省，菲律宾","Copyright":"© Franco Banfi/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"眼斑双锯鱼（俗称“公子小丑鱼”）的学名为 Amphiprion ocellaris；根据世界鱼类数据库（FishBase）的记录，该物种具有 11 根背鳍鳍棘。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260817_CabilaoClowns\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%9c%bc%e6%96%91%e5%8f%8c%e9%94%af%e9%b1%bc&form=hpcapt&filters=HpDate:\"20260816_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260817_CabilaoClowns"},"Ssd":"20260817","Name":"CabilaoClowns","Market":"ZH-CN","Hash":"0147033898","FullDateString":"2026 8月 17"},{"ImageContent":{"Description":"天鹅、秘密藏身处和中世纪养鱼池有什么共同之处？它们都是罗斯埃里利方济各会修道院遗址故事的一部分。这座保存完好的爱尔兰方济各会修道院建于约1351年，常被称为罗斯修道院（俗称）；不过它从未设过院长，因为它本就不是隐修院。","Image":{"Url":"/th?id=OHR.RossErrillyRuins_ZH-CN9986322001_1920x1080.webp","Wallpaper":"/th?id=OHR.RossErrillyRuins_ZH-CN9986322001_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"天鹅开启传奇之处","Title":"戈尔韦郡罗斯埃里利方济各会修道院遗址，康诺特省，爱尔兰","Copyright":"© Maria Janus/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"罗斯埃里利修道院在建立后的一个世纪间逐步扩建，现存塔楼建于1498年。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260816_RossErrillyRuins\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%88%b1%e5%b0%94%e5%85%b0%e7%bd%97%e6%96%af%c2%b7%e5%9f%83%e9%87%8c%e5%88%a9%e4%bf%ae%e9%81%93%e9%99%a2&form=hpcapt&filters=HpDate:\"20260815_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260816_RossErrillyRuins"},"Ssd":"20260816","Name":"RossErrillyRuins","Market":"ZH-CN","Hash":"9986322001","FullDateString":"2026 8月 16"},{"ImageContent":{"Description":"大自然善于平衡看似不可能之物。在新墨西哥州阿什斯利帕荒野地，高耸的石林以纤细石柱托起厚重岩帽。约7,500万年来，风、水和冰将这片偏远的恶地雕刻成一座露天展馆，景象更像异星，而非地球。","Image":{"Url":"/th?id=OHR.ValleyDreams_ZH-CN9689713135_1920x1080.webp","Wallpaper":"/th?id=OHR.ValleyDreams_ZH-CN9689713135_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"绝妙的平衡术","Title":"圣胡安县阿什斯利帕荒野地的奇岩柱，新墨西哥州，美国","Copyright":"© Westend61/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"阿什斯勒帕保存着全球最丰富的晚白垩世哺乳动物、爬行动物、植物和鱼类化石记录之一。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260815_ValleyDreams\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e9%98%bf%e4%bb%80%e6%96%af%e5%88%a9%e5%b8%95%e8%8d%92%e9%87%8e%e5%9c%b0&form=hpcapt&filters=HpDate:\"20260814_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260815_ValleyDreams"},"Ssd":"20260815","Name":"ValleyDreams","Market":"ZH-CN","Hash":"9689713135","FullDateString":"2026 8月 15"},{"ImageContent":{"Description":"道路解决了一个问题，却悄然制造了另一个问题。人类出行速度前所未有地提高，野生动物世代沿用的迁徙路线却被公路切断，导致碰撞事故增加、栖息地破碎化，野生动物种群彼此隔绝。为应对这一挑战，人们建造了称为生态桥的野生动物通道：这些桥梁或隧道旨在重新连接栖息地，让动物安全穿越繁忙道路。最早的一些现代案例于20世纪50年代出现在法国，这一理念很快传遍欧洲。荷兰等国通过建造覆盖土壤及草本、灌木和乔木等本土植被的宽阔绿色桥梁，推动了生态桥设计的完善。","Image":{"Url":"/th?id=OHR.WildlifeCrossingPoland_ZH-CN9439167246_1920x1080.webp","Wallpaper":"/th?id=OHR.WildlifeCrossingPoland_ZH-CN9439167246_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"为动物脚掌而建，而非行人","Title":"扎克舒夫附近的野生动物通道，波兰","Copyright":"© bbsferrari/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"20世纪50年代，法国首次出现了野生动物通道，为动物们在被公路分割的新景观中开辟了一条生路。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260814_WildlifeCrossingPoland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e9%87%8e%e7%94%9f%e5%8a%a8%e7%89%a9%e9%80%9a%e9%81%93&form=hpcapt&filters=HpDate:\"20260813_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260814_WildlifeCrossingPoland"},"Ssd":"20260814","Name":"WildlifeCrossingPoland","Market":"ZH-CN","Hash":"9439167246","FullDateString":"2026 8月 14"},{"ImageContent":{"Description":"并非所有夏日传统都发生在地面。有些在数百英里高空上演，每次划过一颗流星。英仙座流星雨每年从7月中旬持续至8月下旬，并在8月12日至13日前后达到峰值。世界大部分地区都能看到它；在黑暗天空下，每小时往往会出现数十颗流星。想象自己抬头仰望，一道接一道亮光划过。数到多少颗时，你会忘记数目？每道亮光都来自斯威夫特-塔特尔彗星散落的碎屑，地球穿过其尘埃带时便形成流星。它们看起来像是从英仙座辐射而出。","Image":{"Url":"/th?id=OHR.PerseidasTenerife_ZH-CN8520379683_1920x1080.webp","Wallpaper":"/th?id=OHR.PerseidasTenerife_ZH-CN8520379683_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"许个愿吧","Title":"泰德天文台上空的英仙座流星，加那利群岛，西班牙","Copyrigh