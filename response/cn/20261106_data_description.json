{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"/rp/2P1v961xAkWrVG1OpTWrB7cXL38.gz.css","Postloaded":false},{"Path":"/rp/PYyOBp32ikiHoBUcO0XwZq6y2GY.gz.css","Postloaded":false},{"Path":"/rp/v-XCA5xwjvVzQ0P62S1BCFnh-m0.gz.css","Postloaded":false},{"Path":"/rp/Mj_F7RzA5PKfor_cwwls3CEyIeY.gz.css","Postloaded":false},{"Path":"/rp/hYhZb3rTk3plX-hOqaRO9UgrBOU.gz.css","Postloaded":true},{"Path":"/rp/HF1Gsf3Q7qNgL3t2ksqk48cvars.gz.css","Postloaded":true},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":true},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":true},{"Path":"/rp/C55hud04WRj662Ou8c3t6oJFAE0.gz.css","Postloaded":false},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableFeedPositionToggle":false,"EnableNewsAndTrending":true,"EnableUnifiedTobFeedBackplate":true,"EnableUnifiedTobFeedBackplateProdPosition":true,"HideCopilot":true,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-11-06T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"火山、雨林和竹林？毛伊岛上的哈莱亚卡拉国家公园三者兼有。公园的范围从毛伊岛上海拔10023英尺的山顶一直延伸到海岸，保护着随海拔、降雨量和气温变化而呈现迥异面貌的景观。它于1916年作为夏威夷国家公园的一部分设立，1961年成为独立的国家公园。哈莱阿卡拉意为“太阳之家”，这一名称呼应了夏威夷口述传说“moʻolelo”中毛伊捉住太阳、延长白昼的故事。","Image":{"Url":"/th?id=OHR.PipiwaiTrail_ZH-CN1811194311_1920x1080.webp","Wallpaper":"/th?id=OHR.PipiwaiTrail_ZH-CN1811194311_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"穿越毛伊岛的绿色隧道","Title":"竹林，皮皮维小径，哈莱亚卡拉国家公园，毛伊岛，夏威夷州，美国","Copyright":"© MNStudio/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"前往哈莱阿卡拉山顶观赏日出的游客须提前预约；名额最多提前60天开放。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261106_PipiwaiTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%93%88%e8%8e%b1%e4%ba%9a%e5%8d%a1%e6%8b%89%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261105_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261106_PipiwaiTrail"},"Ssd":"20261106","Name":"PipiwaiTrail","Market":"ZH-CN","Hash":"1811194311","FullDateString":"2026 11月 6"},{"ImageContent":{"Description":"一座简朴的木制翻越梯，将人们引向英格兰最负盛名的风景区之一。被列为联合国教科文组织世界遗产的湖区，湖泊波光粼粼，山丘崎岖起伏，古老的石墙纵横其间；自然力量与世代相传的农耕传统共同塑造了这片景观。","Image":{"Url":"/th?id=OHR.StileCrossing_ZH-CN9811465935_1920x1080.webp","Wallpaper":"/th?id=OHR.StileCrossing_ZH-CN9811465935_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"向山巅再迈一步","Title":"石墙边的木制翻越梯，黑岩，湖区，英格兰","Copyright":"© Alex Treadway/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"英格兰湖区于2017年被列入联合国教科文组织世界遗产名录，其独特的文化景观由此获得认可。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261105_StileCrossing\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%8b%b1%e6%a0%bc%e5%85%b0%e6%b9%96%e5%8c%ba&form=hpcapt&filters=HpDate:\"20261104_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261105_StileCrossing"},"Ssd":"20261105","Name":"StileCrossing","Market":"ZH-CN","Hash":"9811465935","FullDateString":"2026 11月 5"},{"ImageContent":{"Description":"在安徽省宣城，人们划船穿过色彩斑斓的落羽杉林。秋天将这片被水淹没的林地变成由琥珀色、铜色和深铁锈色交织而成的锦绣景致。落羽杉的学名是“Taxodium distichum”，它在针叶树中颇为特别：每年秋季，柔软如羽毛的针叶会先变成红褐色，然后脱落。在北美洲，落羽杉因能生长在沼泽、河漫滩等湿地环境而闻名，常长出称为“膝状根”的瘤状根部突起，露出周围的泥土和水面。","Image":{"Url":"/th?id=OHR.AutumnChina_ZH-CN7665959692_1920x1080.webp","Wallpaper":"/th?id=OHR.AutumnChina_ZH-CN7665959692_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"泛舟如画秋林","Title":"五彩落羽杉间划船的人们，宣城，安徽省，中国","Copyright":"© Jackal Pan/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"落羽杉木材耐腐朽，历史上曾被用于制作木桶、铁路枕木和屋顶木瓦。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261104_AutumnChina\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%90%bd%e7%be%bd%e6%9d%89&form=hpcapt&filters=HpDate:\"20261103_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261104_AutumnChina"},"Ssd":"20261104","Name":"AutumnChina","Market":"ZH-CN","Hash":"7665959692","FullDateString":"2026 11月 4"},{"ImageContent":{"Description":"布莱埃斯湖坐落在意大利北部南蒂罗尔的多洛米蒂山脉，海拔近1500米。湖泊四周森林环绕，法内斯-塞内斯-布莱埃斯湖自然公园的壮丽群峰耸立其间，以动人的碧绿和湛蓝湖水闻名。一条3.5公里长的步道环绕湖岸，游客也可以乘坐传统木质划艇，从另一种视角欣赏风光。这里还是多条山间徒步路线的起点，包括多洛米蒂山脉著名的多洛米蒂高山步道1号。","Image":{"Url":"/th?id=OHR.AlpineBraies_ZH-CN7307997866_1920x1080.webp","Wallpaper":"/th?id=OHR.AlpineBraies_ZH-CN7307997866_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"群峰间的宁静","Title":"布莱埃斯湖，法内斯-塞内斯-布莱埃斯湖自然公园，多洛米蒂山脉，意大利","Copyright":"© leonid_tit/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"布莱埃斯湖最深处达36米，平均水深约17米。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261103_AlpineBraies\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a4%9a%e6%b4%9b%e7%b1%b3%e8%92%82%e5%b1%b1%e8%84%89&form=hpcapt&filters=HpDate:\"20261102_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261103_AlpineBraies"},"Ssd":"20261103","Name":"AlpineBraies","Market":"ZH-CN","Hash":"7307997866","FullDateString":"2026 11月 3"},{"ImageContent":{"Description":"11月也许让我们离节日季又近了一步，但北极熊有别的打算。它们聚集在加拿大马尼托巴省的哈得孙湾沿岸，等待海冰形成，以便重返冰面捕猎海豹。每年上演的这一幕催生了在11月第一周举行的北极熊周，以庆祝北极地区体型最大的陆生捕食者。北极熊是游泳健将、捕猎高手，也极其适应地球上最严酷的环境之一。然而，海冰不断缩减，意味着许多北极熊不得不在陆地上待更久，觅食更加困难，与人类相遇的风险也随之上升。","Image":{"Url":"/th?id=OHR.HudsonBear_ZH-CN6630706907_1920x1080.webp","Wallpaper":"/th?id=OHR.HudsonBear_ZH-CN6630706907_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"写在冰上的未来","Title":"北极熊和幼崽，哈得孙湾畔，马尼托巴省，加拿大","Copyright":"© Danita Delimont/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"为了寻找食物和合适的海冰，北极熊在一个季节里可能跋涉超过620英里。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261102_HudsonBear\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%8c%97%e6%9e%81%e7%86%8a%e5%91%a8&form=hpcapt&filters=HpDate:\"20261101_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261102_HudsonBear"},"Ssd":"20261102","Name":"HudsonBear","Market":"ZH-CN","Hash":"6630706907","FullDateString":"2026 11月 2"},{"ImageContent":{"Description":"今天，我们一起欣赏笼罩在黑森林上空的朦胧景色。黑森林绵延约160公里，横跨德国西南部，汇集了葱郁的山丘、幽深的山谷、湖泊和迷人的小镇。最高峰费尔德贝格山海拔1,493米；多瑙河和内卡河也发源于黑森林。这里同样不乏历史与传统。林业长期以来在当地占据重要地位，而延续数百年的钟表制造传统，更让别具特色的布谷鸟钟名扬德国以外。","Image":{"Url":"/th?id=OHR.SchwarzwaldAutumn_ZH-CN6323627599_1920x1080.webp","Wallpaper":"/th?id=OHR.SchwarzwaldAutumn_ZH-CN6323627599_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"林间迷雾","Title":"黑森林，巴登-符腾堡州，德国","Copyright":"© Britus/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"黑森林传统民俗头饰“绒球帽”上有14个羊毛绒球；未婚女性传统上佩戴红色绒球帽。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261101_SchwarzwaldAutumn\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%be%b7%e5%9b%bd%e9%bb%91%e6%a3%ae%e6%9e%97&form=hpcapt&filters=HpDate:\"20261031_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261101_SchwarzwaldAutumn"},"Ssd":"20261101","Name":"SchwarzwaldAutumn","Market":"ZH-CN","Hash":"6323627599","FullDateString":"2026 11月 1"},{"ImageContent":{"Description":"忘了烟雾机吧。德国法兰克福有更能烘托气氛的景物：一座哥特式大教堂，塔楼仿佛随时能上演一场午夜招魂会。画面中的圣巴尔多禄茂教堂有着中世纪风格的轮廓，简直像是万圣节特意挑选的布景。不过，这个节日本身的历史更加离奇。","Image":{"Url":"/th?id=OHR.FrankfurtHalloween_ZH-CN5998782698_1920x1080.webp","Wallpaper":"/th?id=OHR.FrankfurtHalloween_ZH-CN5998782698_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"往昔帝国的幽影","Title":"圣巴尔多禄茂教堂，法兰克福，德国","Copyright":"© AlxeyPnferov/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"1562年至1792年，神圣罗马帝国的当选皇帝曾在法兰克福的圣巴尔多禄茂教堂举行加冕仪式。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261031_FrankfurtHalloween\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%87%e5%9c%a3%e8%8a%82&form=hpcapt&filters=HpDate:\"20261030_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261031_FrankfurtHalloween"},"Ssd":"20261031","Name":"FrankfurtHalloween","Market":"ZH-CN","Hash":"5998782698","FullDateString":"2026 10月 31"}],"PreloadMediaContents":[{"ImageContent":{"Description":"黎明的第一缕曙光映照在亚伯拉罕湖冰封的湖面上，远处是落基山脉的群峰。冬季，这座位于艾伯塔省的如画湖泊以困在冰层下的甲烷气泡而闻名。强风使湖面不被积雪覆盖，让人们整个冬天都能观赏这一景象。到了春天，冰层融化，气体便逸散到大气中。","Image":{"Url":"/th?id=OHR.AbrahamCanada_ZH-CN0344365912_1920x1080.webp","Wallpaper":"/th?id=OHR.AbrahamCanada_ZH-CN0344365912_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"冰下秘境","Title":"亚伯拉罕湖，艾伯塔省，加拿大","Copyright":"© Guang Cao/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"亚伯拉罕湖以斯托尼纳科达族向导赛拉斯·亚伯拉罕命名；这一名称由艾伯塔省政府举办的征名比赛选出。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261113_AbrahamCanada\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%89%be%e4%bc%af%e5%a1%94%e7%9c%81%e4%ba%9a%e4%bc%af%e6%8b%89%e7%bd%95%e6%b9%96&form=hpcapt&filters=HpDate:\"20261112_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261113_AbrahamCanada"},"Ssd":"20261113","Name":"AbrahamCanada","Market":"ZH-CN","Hash":"0344365912","FullDateString":"2026 11月 13"},{"ImageContent":{"Description":"11月12日是拱门国家公园于1971年获指定为国家公园的周年纪念日。这座高海拔沙漠公园位于犹他州莫阿布以北，拥有2000多座天然砂岩拱门，是世界上拱门分布最密集的地区。今天图片中的北窗，是公园窗区最知名的地貌之一；在那里，高耸的岩脊、岩石开口和经自然雕琢的砂岩，共同构成了一片近乎建筑作品般的景观。","Image":{"Url":"/th?id=OHR.NorthWindow_ZH-CN6734579353_1920x1080.webp","Wallpaper":"/th?id=OHR.NorthWindow_ZH-CN6734579353_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"没有建筑师的建筑杰作","Title":"北窗，拱门国家公园，莫阿布，犹他州，美国","Copyright":"© lightphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"拱门国家公园禁止游客攀爬、手脚并用地攀登、行走或站立在任何天然拱门上，也禁止从拱门上绳降。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261112_NorthWindow\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%8b%b1%e9%97%a8%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261111_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261112_NorthWindow"},"Ssd":"20261112","Name":"NorthWindow","Market":"ZH-CN","Hash":"6734579353","FullDateString":"2026 11月 12"},{"ImageContent":{"Description":"大西洋森林是世界上重要的生物多样性热点地区之一，沿巴西大西洋沿岸的广大地带延伸，并进入阿根廷和巴拉圭境内。这里的景观包括热带与亚热带森林、红树林和海岸生境，孕育了约2万种植物以及种类繁多的野生动物，其中包括美洲豹和金狮绢毛猴。几个世纪以来，大片森林已经消失，但它仍在储存碳，并为该地区数百万人提供淡水方面发挥着重要作用。","Image":{"Url":"/th?id=OHR.Atlantica_ZH-CN6593995386_1920x1080.webp","Wallpaper":"/th?id=OHR.Atlantica_ZH-CN6593995386_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"奇妙纷呈的森林","Title":"大西洋森林，巴西","Copyright":"© FG Trade/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"大西洋森林地区生活着约1.5亿人，约占南美洲总人口的三分之一。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261111_Atlantica\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b7%b4%e8%a5%bf%e5%a4%a7%e8%a5%bf%e6%b4%8b%e6%a3%ae%e6%9e%97&form=hpcapt&filters=HpDate:\"20261110_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261111_Atlantica"},"Ssd":"20261111","Name":"Atlantica","Market":"ZH-CN","Hash":"6593995386","FullDateString":"2026 11月 11"},{"ImageContent":{"Description":"从空中俯瞰，玫瑰岛就像一抹绿意，周围环绕着深浅不一的蓝色海水。这座狭长的小岛位于巴哈马天堂岛以东仅三英里处，没有繁忙的道路和成片的城市街区，取而代之的是沙滩、浅海和岛内潟湖。宁静的外表之下，它还藏着一段电影故事：1965年的詹姆斯·邦德冒险电影《霹雳弹》曾在玫瑰岛取景，其中包括“飞碟号”被炸毁的场景。","Image":{"Url":"/th?id=OHR.RoseIsland_ZH-CN6477140814_1920x1080.webp","Wallpaper":"/th?id=OHR.RoseIsland_ZH-CN6477140814_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"惬意放松，尽享海岛时光","Title":"玫瑰岛航拍图，巴哈马","Copyright":"© Abstract Aerial Art/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"玫瑰岛只能乘船抵达；从拿骚或天堂岛出发，航程通常需25至30分钟，具体取决于海况。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261110_RoseIsland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b7%b4%e5%93%88%e9%a9%ac%e7%8e%ab%e7%91%b0%e5%b2%9b&form=hpcapt&filters=HpDate:\"20261109_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261110_RoseIsland"},"Ssd":"20261110","Name":"RoseIsland","Market":"ZH-CN","Hash":"6477140814","FullDateString":"2026 11月 10"},{"ImageContent":{"Description":"在西班牙安达卢西亚地区首府塞维利亚，跨过瓜达尔基维尔河，城市的节奏似乎便悄然改变。河对岸是色彩缤纷的特里亚纳街区，陶艺、弗拉门戈和当地传统融入日常生活。自19世纪以来，伊莎贝尔二世桥——又称特里亚纳桥——一直连接着这里与塞维利亚的历史中心。","Image":{"Url":"/th?id=OHR.TrianaSpain_ZH-CN6329291776_1920x1080.webp","Wallpaper":"/th?id=OHR.TrianaSpain_ZH-CN6329291776_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"艺术与韵律交汇之地","Title":"特里亚纳历史街区，塞维利亚，西班牙","Copyright":"© Andrzej Rostek/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"特里亚纳市场下方保留着圣豪尔赫城堡的遗址；这座城堡曾是宗教裁判所的总部，如今设有历史展览。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261109_TrianaSpain\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%a5%bf%e7%8f%ad%e7%89%99%e5%a1%9e%e7%bb%b4%e5%88%a9%e4%ba%9a&form=hpcapt&filters=HpDate:\"20261108_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261109_TrianaSpain"},"Ssd":"20261109","Name":"TrianaSpain","Market":"ZH-CN","Hash":"6329291776","FullDateString":"2026 11月 9"},{"ImageContent":{"Description":"一年中最黑暗的夜晚遇上最明亮的庆典，会是什么景象？答案就是排灯节。世界各地数百万人庆祝这个灯节，点亮油灯和灯笼，绘制兰戈利彩绘，祈祷、品尝甜点，并与家人团聚。","Image":{"Url":"/th?id=OHR.DiwaliLamps_ZH-CN2462894749_1920x1080.webp","Wallpaper":"/th?id=OHR.DiwaliLamps_ZH-CN2462894749_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"光芒四射的节日","Title":"排灯节灯笼，孟买，马哈拉施特拉邦，印度","Copyright":"© Dinodia Photo/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"排灯节持续五天，但由于它遵循印度教阴历，每年在公历上的日期都会变化。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261108_DiwaliLamps\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%8e%92%e7%81%af%e8%8a%82&form=hpcapt&filters=HpDate:\"20261107_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261108_DiwaliLamps"},"Ssd":"20261108","Name":"DiwaliLamps","Market":"ZH-CN","Hash":"2462894749","FullDateString":"2026 11月 8"},{"ImageContent":{"Description":"再艰难的环境，也挡不住野牛吃草的脚步。美国全国野牛日赞颂这种北美哺乳动物：它体重可达2000磅(约907千克)，奔跑时速却能达到35英里(约56千米)。这个节日定在每年11月的第一个星期六，旨在向2016年成为美国国家哺乳动物的野牛致敬。","Image":{"Url":"/th?id=OHR.DakotaBison_ZH-CN2302503868_1920x1080.webp","Wallpaper":"/th?id=OHR.DakotaBison_ZH-CN2302503868_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"归来的草原巨兽","Title":"草原上的一头野牛，西奥多·罗斯福国家公园，北达科他州，美国","Copyright":"© Tandem Stock/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"野牛在泥土中打滚形成的浅坑可能积水，为草原植物和动物提供栖息地。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261107_DakotaBison\"&FORM=HPQUIZ","BackstageUrl":"/sea