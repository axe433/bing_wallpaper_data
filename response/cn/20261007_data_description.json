{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"/rp/L2bVEsghukz0irKf3pTGG9RA864.gz.css","Postloaded":false},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":false},{"Path":"/rp/hYhZb3rTk3plX-hOqaRO9UgrBOU.gz.css","Postloaded":true},{"Path":"/rp/lPd1ebHst6-uCKSfsDDkyKmsXkk.gz.css","Postloaded":true},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":true},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":true},{"Path":"/rp/C55hud04WRj662Ou8c3t6oJFAE0.gz.css","Postloaded":false},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableFeedPositionToggle":false,"EnableHPV2ScrollBg":false,"EnableHPV2NoCopilot":false,"HideCopilot":false,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-10-07T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"如果一片森林能让你每转一个弯都捉摸不透，会是什么样？英国格洛斯特郡谜林位于英格兰迪恩森林的科尔福德附近，蜿蜒的小径穿过扭曲的树木、覆满苔藓的岩石和幽深的石质沟壑。这里不同寻常的岩层被称为“斯科尔斯”，是一种天然地质特征，随着时间推移逐渐裸露并发生改变，后来在罗马时期、甚至可能在更早以前被人们开采铁矿石。1848年，一名工人在一个岩洞内的陶罐中发现了3,000多枚罗马时代的钱币，使这片林地变成了一场现实中的寻宝之旅。","Image":{"Url":"/th?id=OHR.ForestofDean_ZH-CN2654753621_1920x1080.webp","Wallpaper":"/th?id=OHR.ForestofDean_ZH-CN2654753621_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"迷惑不解？沿着小径走","Title":"覆满苔藓的岩石，英国格洛斯特郡谜林，迪恩森林，格洛斯特郡，英格兰","Copyright":"© Fulcanelli_AOS/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"英国格洛斯特郡谜林位于迪恩森林，是极为罕见的内陆温带雨林生态系统残片。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261007_ForestofDean\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%8b%b1%e5%9b%bd%e6%a0%bc%e6%b4%9b%e6%96%af%e7%89%b9%e9%83%a1%e8%b0%9c%e6%9e%97&form=hpcapt&filters=HpDate:\"20261006_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261007_ForestofDean"},"Ssd":"20261007","Name":"ForestofDean","Market":"ZH-CN","Hash":"2654753621","FullDateString":"2026 10月 7"},{"ImageContent":{"Description":"如果一座山能用一道道条纹向你展示它的地质历史，会是什么样？在中国的张掖国家地质公园，岩石正是如此。红色、橙色、黄色、棕色以及其他大地色调的条带在山脊间绵延起伏。这种壮丽景观被称为丹霞地貌，由地质年代中沉积形成的多层沉积岩塑造而成。后来，构造力使岩石抬升并发生褶皱，而风化和侵蚀则将它们雕琢成山脊、峭壁、沟壑和山峰。","Image":{"Url":"/th?id=OHR.DanxiaLandform_ZH-CN2386060246_1920x1080.webp","Wallpaper":"/th?id=OHR.DanxiaLandform_ZH-CN2386060246_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"条纹中的地球故事","Title":"丹霞地貌，张掖国家地质公园，甘肃省，中国","Copyright":"© Weiquan Lin/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"张掖地质公园拥有577处文化遗址，展现当地历史及包括裕固族在内的多个族群文化。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261006_DanxiaLandform\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%99%85%e5%9c%b0%e8%b4%a8%e5%a4%9a%e6%a0%b7%e6%80%a7%e6%97%a5&form=hpcapt&filters=HpDate:\"20261005_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261006_DanxiaLandform"},"Ssd":"20261006","Name":"DanxiaLandform","Market":"ZH-CN","Hash":"2386060246","FullDateString":"2026 10月 6"},{"ImageContent":{"Description":"一只身高28英寸的鸟能教给我们哪些人生道理？非常多。在世界教师日这一天，阿德利企鹅带来了一份充满足智多谋、坚韧不拔和些许顽皮的课程计划。这一物种分布于南极海岸，以法国探险家儒勒·迪蒙·迪维尔的妻子阿黛尔之名命名；在1840年的一次远征中，人们发现了这些企鹅。","Image":{"Url":"/th?id=OHR.AdelieTeacher_ZH-CN2201820679_1920x1080.webp","Wallpaper":"/th?id=OHR.AdelieTeacher_ZH-CN2201820679_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"纵身一跃，一次一课","Title":"南极洲的阿德利企鹅","Copyright":"© Otto Plantema/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"阿德利企鹅没有牙齿，但它们的舌头和上腭长有被称为乳突的尖锐倒刺。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261005_AdelieTeacher\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e6%95%99%e5%b8%88%e6%97%a5&form=hpcapt&filters=HpDate:\"20261004_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261005_AdelieTeacher"},"Ssd":"20261005","Name":"AdelieTeacher","Market":"ZH-CN","Hash":"2201820679","FullDateString":"2026 10月 5"},{"ImageContent":{"Description":"首先，你要造一枚火箭。然后，你要让它离开地球，飞往月球，在旅途中安然无恙，并将其航天器带回家。很简单，对吧？嗯，并非如此。世界空间周于每年10月4日至10日举行，旨在庆祝让此类任务成为可能的科学。联合国于1999年设立这一纪念活动，以纪念1957年10月4日斯普特尼克1号发射升空，以及1967年10月10日《外层空间条约》生效。今年的主题是“火箭革命”，重点关注推动太空探索不断发展的技术。","Image":{"Url":"/th?id=OHR.ArtemisRocket_ZH-CN1768541365_1920x1080.webp","Wallpaper":"/th?id=OHR.ArtemisRocket_ZH-CN1768541365_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"宇宙在召唤","Title":"阿尔忒弥斯1号月球火箭，39B发射台，肯尼迪航天中心，佛罗里达州，2022年6月15日","Copyright":"© EVA MARIE UZCATEGUI/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"在阿尔忒弥斯1号任务中，猎户座飞船距地球最远达268,563英里，超过此前任何为人类设计的航天器。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261004_ArtemisRocket\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e7%a9%ba%e9%97%b4%e5%91%a8&form=hpcapt&filters=HpDate:\"20261003_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261004_ArtemisRocket"},"Ssd":"20261004","Name":"ArtemisRocket","Market":"ZH-CN","Hash":"1768541365","FullDateString":"2026 10月 4"},{"ImageContent":{"Description":"大快朵颐、肚皮更鼓并为冬季囤积能量的时节到了。在阿拉斯加州，克拉克湖国家公园和自然保护区的棕熊充分利用10月仍可获取的食物。它们以鱼、莎草、浆果、根、蛤蜊和其他食物为食，以积累脂肪储备。有些棕熊在进入洞穴冬眠前体重可超过1,000磅。储存的脂肪帮助它们度过不吃不喝的冬季。","Image":{"Url":"/th?id=OHR.GrizzlySwim_ZH-CN1005455737_1920x1080.webp","Wallpaper":"/th?id=OHR.GrizzlySwim_ZH-CN1005455737_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"捕捉、进食、重复","Title":"美国阿拉斯加州克拉克湖国家公园和自然保护区银鲑溪中的棕熊","Copyright":"© Danny Green/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"棕熊幼崽在冬季洞穴中出生，体型很小且没有毛，有时不足半磅；到春天时会长到4至8磅。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261003_GrizzlySwim\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%a3%95%e7%86%8a&form=hpcapt&filters=HpDate:\"20261002_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261003_GrizzlySwim"},"Ssd":"20261003","Name":"GrizzlySwim","Market":"ZH-CN","Hash":"1005455737","FullDateString":"2026 10月 3"},{"ImageContent":{"Description":"长期以来，河流在美国各地的生活中发挥着重要作用，为社区、野生动物和工业提供支持。1968年10月2日，林登·B·约翰逊总统签署《野生与风景河流法》，使其成为法律。该法建立了一个国家体系，用于保护具有卓越景观、休闲、地质、鱼类和野生动物、历史或文化价值的河流及河段。该法使指定河流保持自由流动状态，保护其水质，并旨在守护使它们值得获此指定的特质。","Image":{"Url":"/th?id=OHR.ChattoogaRiver_ZH-CN9453791496_1920x1080.webp","Wallpaper":"/th?id=OHR.ChattoogaRiver_ZH-CN9453791496_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"一条值得保护的河流","Title":"查图加河，阿巴拉契亚山脉，北卡罗来纳州，美国","Copyright":"© mtilghma/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"查图加河在约50英里的流程中平均每英里下降49英尺，最终流入图加卢湖。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261002_ChattoogaRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%be%8e%e5%9b%bd%e9%98%bf%e5%b7%b4%e6%8b%89%e5%a5%91%e4%ba%9a%e5%b1%b1%e8%84%89&form=hpcapt&filters=HpDate:\"20261001_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261002_ChattoogaRiver"},"Ssd":"20261002","Name":"ChattoogaRiver","Market":"ZH-CN","Hash":"9453791496","FullDateString":"2026 10月 2"},{"ImageContent":{"Description":"从这里望去，优胜美地一些最著名的地标也呈现出截然不同的一面。通常所见的半穹顶从优胜美地山谷上方拔地而起，而在这里，它露出陡峭的北壁，让这个熟悉的标志性景观看起来几乎令人感到陌生。远处还有特纳亚峡谷、云歇峰、特纳亚湖，以及记录着数百万年隆升、侵蚀与冰川作用的浅色岩石。奥姆斯特德观景点得名于景观设计师弗雷德里克·劳·奥姆斯特德及其子小弗雷德里克·劳·奥姆斯特德；父子二人的自然保护工作推动了美国国家公园运动的发展。这里提醒着人们：优胜美地不仅景色壮美，还是一片仍在以岩石讲述自身故事的土地。","Image":{"Url":"/th?id=OHR.OlmstedPoint_ZH-CN4182671075_1920x1080.webp","Wallpaper":"/th?id=OHR.OlmstedPoint_ZH-CN4182671075_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"在花岗岩中读懂时间","Title":"奥姆斯特德观景点的日落，优胜美地国家公园，加利福尼亚州，美国","Copyright":"© Robb Hirsch/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"优胜美地国家公园约95%的面积被指定为荒野。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261001_OlmstedPoint\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%bc%98%e8%83%9c%e7%be%8e%e5%9c%b0%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20260930_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261001_OlmstedPoint"},"Ssd":"20261001","Name":"OlmstedPoint","Market":"ZH-CN","Hash":"4182671075","FullDateString":"2026 10月 1"}],"PreloadMediaContents":[{"ImageContent":{"Description":"我们如何知道早在人类出现之前地球是什么样子？化石提供了许多线索。国家化石日旨在赞颂古生物学，以及那些帮助科学家重建过去环境、追溯生命演化并了解数百万年前消失生物的发现。从恐龙到微小的海洋生物，这些过去的遗存保存着早已不复存在的远古世界的一个个瞬间。","Image":{"Url":"/th?id=OHR.AmmoniteFossils_ZH-CN5825251327_1920x1080.webp","Wallpaper":"/th?id=OHR.AmmoniteFossils_ZH-CN5825251327_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"穿越时间的螺旋","Title":"侏罗纪时期的菊石化石","Copyright":"© J Nemchinova/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"化石不一定非得是骨骼。足迹、洞道、巢穴以及古代生命留下的其他痕迹也可以成为化石。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261014_AmmoniteFossils\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e5%ae%b6%e5%8c%96%e7%9f%b3%e6%97%a5&form=hpcapt&filters=HpDate:\"20261013_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261014_AmmoniteFossils"},"Ssd":"20261014","Name":"AmmoniteFossils","Market":"ZH-CN","Hash":"5825251327","FullDateString":"2026 10月 14"},{"ImageContent":{"Description":"在克罗地亚的普利特维采湖群国家公园，水似乎无处不在。十六个阶梯状湖泊由瀑布、溪流和层叠而下的水流组成的网络连接起来，蜿蜒穿过森林覆盖的石灰岩峡谷。湖水的颜色不断变化，从翠绿到深蓝不等，这是由矿物质、阳光和不断变化的倒影共同造就的。普利特维采湖群国家公园成立于1949年，是克罗地亚历史最悠久、面积最大的国家公园。这里以石灰华屏障闻名，这种天然石灰岩构造是富含矿物质的水在数百年间沉积碳酸钙形成的。这些屏障仍在继续生长和变化，逐渐改变着公园内的瀑布和湖泊。","Image":{"Url":"/th?id=OHR.PlitviceAutumn_ZH-CN5646237897_1920x1080.webp","Wallpaper":"/th?id=OHR.PlitviceAutumn_ZH-CN5646237897_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"蓝与绿的交响曲","Title":"普利特维采湖群国家公园，克罗地亚","Copyright":"© Jan Wlodarczyk/Alamy","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"普利特维采拥有84公顷的山毛榉和冷杉原始林，也是棕熊、灰狼和猞猁的家园。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261013_PlitviceAutumn\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%99%ae%e5%88%a9%e7%89%b9%e7%bb%b4%e9%87%87%e6%b9%96%e7%be%a4%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261012_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261013_PlitviceAutumn"},"Ssd":"20261013","Name":"PlitviceAutumn","Market":"ZH-CN","Hash":"5646237897","FullDateString":"2026 10月 13"},{"ImageContent":{"Description":"当铁路、救生艇站和海滨一日游在水边相遇，会得到什么？答案是曼布尔斯码头。这座维多利亚时代的地标向斯旺西湾延伸255米，于1898年5月10日开放，自此一直是威尔士海岸的一部分。","Image":{"Url":"/th?id=OHR.MumblesSwansea2026_ZH-CN5419531039_1920x1080.webp","Wallpaper":"/th?id=OHR.MumblesSwansea2026_ZH-CN5419531039_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"从铁轨到潮汐","Title":"曼布尔斯码头，斯旺西，威尔士","Copyright":"© Helen Hotson/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"曼布尔斯铁路曾在车厢上安装风帆，短暂试验以风力驱动车辆，但这项尝试并未持续多久。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261012_MumblesSwansea2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a8%81%e5%b0%94%e5%a3%ab%e6%9b%bc%e5%b8%83%e5%b0%94%e6%96%af%e7%a0%81%e5%a4%b4&form=hpcapt&filters=HpDate:\"20261011_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261012_MumblesSwansea2026"},"Ssd":"20261012","Name":"MumblesSwansea2026","Market":"ZH-CN","Hash":"5419531039","FullDateString":"2026 10月 12"},{"ImageContent":{"Description":"格莱德溪磨坊坐落在西弗吉尼亚州巴布科克州立公园内格莱德溪的岩石水域上方，周围红色、橙色和金色交错。尽管它看起来像是拓荒时代的遗迹，但这座磨坊实际上是为致敬阿巴拉契亚地区的磨坊传统而精心建造的。","Image":{"Url":"/th?id=OHR.BabcockSP_ZH-CN5266848536_1920x1080.webp","Wallpaper":"/th?id=OHR.BabcockSP_ZH-CN5266848536_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"秋色中转动的水轮","Title":"格莱德溪磨坊，巴布科克州立公园，西弗吉尼亚州，美国","Copyright":"© dszc/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"20世纪30年代，民间资源保护队的海狸营和李营共同参与了巴布科克州立公园的建设。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261011_BabcockSP\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b7%b4%e5%b8%83%e7%a7%91%e5%85%8b%e5%b7%9e%e7%ab%8b%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261010_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261011_BabcockSP"},"Ssd":"20261011","Name":"BabcockSP","Market":"ZH-CN","Hash":"5266848536","FullDateString":"2026 10月 11"},{"ImageContent":{"Description":"世界候鸟日旨在庆祝大自然最壮观的旅程之一。这项全球性活动于每年5月和10月举行，反映世界各地的迁徙模式，并强调保护鸟类赖以生存的栖息地和迁飞路线的重要性。“每一只鸟都很重要——您的观察至关重要！”是2026年的主题，着重说明个人和社区的观察可以如何为鸟类研究、监测和保护贡献力量，帮助科学家更好地了解迁徙。","Image":{"Url":"/th?id=OHR.CormorantsFlight_ZH-CN0770863330_1920x1080.webp","Wallpaper":"/th?id=OHR.CormorantsFlight_ZH-CN0770863330_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"迁飞路线上的生命","Title":"蒙特雷湾上空的双冠鸬鹚，加利福尼亚州，美国","Copyright":"© Hiroya Minakuchi/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"鸟类迁徙可以采取多种形式：有些鸟向北或向南迁徙，而另一些则迁往不同海拔或不同栖息地。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261010_CormorantsFlight\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e5%80%99%e9%b8%9f%e6%97%a5&form=hpcapt&filters=HpDate:\"20261009_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261010_CormorantsFlight"},"Ssd":"20261010","Name":"CormorantsFlight","Market":"ZH-CN","Hash":"0770863330","FullDateString":"2026 10月 10"},{"ImageContent":{"Description":"桑吉奈尔群岛就在法国科西嘉岛近海，从地中海中拔地而起，是一个由四座崎岖岩石岛屿组成的小型群岛。从一座历史悠久的瞭望塔望去，它们坐落在阿雅克肖湾的入口处。陡峭的悬崖、历经数百年的地标和开阔的海景，世世代代吸引着游客来到这一地区。尽管最远的岛屿距离海岸仅约1.2英里，但这片群岛给人的感觉却出奇地偏远：它四周被开阔水域环绕，并受到风、海浪和盐雾的塑造。","Image":{"Url":"/th?id=OHR.IlesSanguinaires_ZH-CN3149346035_1920x1080.webp","Wallpaper":"/th?id=OHR.IlesSanguinaires_ZH-CN3149346035_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"科西嘉岛的岩石前哨","Title":"桑吉奈尔群岛景观，摄自科西嘉岛，法国","Copyright":"© Francesco Riccardo Iacomino/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"建造桑吉奈尔灯塔时，石料必须用驳船运到岛上，再从岩石海岸吊运上去。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261009_IlesSanguinaires\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%a7%91%e8%a5%bf%e5%98%89%e5%b2%9b%e6%a1%91%e5%90%89%e5%a5%88%e5%b0%94%e7%be%a4%e5%b2%9b&form=hpcapt&filters=HpDate:\"20261008_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261009_IlesSanguinaires"},"Ssd":"20261009","Name":"IlesSanguinaires","Market":"ZH-CN","Hash":"3149346035","FullDateString":"2026 10月 9"},{"ImageContent":{"Description":"显然有什么东西越界了。在印度洋马约特岛近海，这只章鱼摆出了一副防御姿态，仿佛在说：无论是什么正在靠近，都该重新考虑一下自己的生命选择。","Image":{"Url":"/th?id=OHR.MayotteOctopus_ZH-CN2837659998_1920x1080.webp","Wallpaper":"/th?id=OHR.MayotteOctopus_ZH-CN2837659998_1920x1200.jpg&rf=LaDigue_1920x12