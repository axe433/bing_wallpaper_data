{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"/rp/WbrnXG_o6g55b3vAIJaTZiy1W6U.gz.css","Postloaded":false},{"Path":"/rp/fqeK6XvzgUe0xDTGK14KOsHsONA.gz.css","Postloaded":true},{"Path":"/rp/kRvQpUFDGnZ-qIQ0Bl0qAksxajE.gz.css","Postloaded":true},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":true},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":true},{"Path":"/rp/C55hud04WRj662Ou8c3t6oJFAE0.gz.css","Postloaded":false},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableHPV2ScrollBg":false,"EnableHPV2NoCopilot":false,"HideCopilot":false,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-26T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"熊的耳朵、着火的房屋和遍布急转弯的道路有什么共同之处？它们都是犹他州东南部公共土地故事的一部分。","Image":{"Url":"/th?id=OHR.BearsEars_ZH-CN0496897450_1920x1080.webp","Wallpaper":"/th?id=OHR.BearsEars_ZH-CN0496897450_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"写在大地上的故事","Title":"熊耳国家纪念区附近的雪松台地和骡子角，犹他州，美国","Copyright":"© Jeff Clay/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"熊耳委员会汇集五个部落民族，共同参与指导这座国家纪念区的管理与保护。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260926_BearsEars\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%86%8a%e8%80%b3%e5%9b%bd%e5%ae%b6%e7%ba%aa%e5%bf%b5%e5%8c%ba&form=hpcapt&filters=HpDate:\"20260925_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260926_BearsEars"},"Ssd":"20260926","Name":"BearsEars","Market":"ZH-CN","Hash":"0496897450","FullDateString":"2026 9月 26"},{"ImageContent":{"Description":"如果满月是你家宴上的贵宾，会是什么情景？这正是中秋节的意蕴，中秋节也被称为月亮节。这个节日在农历八月十五庆祝，是中国文化中最重要的节日之一。它的源头可追溯至3,000多年前周朝时期的祭月仪式。最广为人知的传说讲述了嫦娥服下长生不老药后飞上月宫的故事。","Image":{"Url":"/th?id=OHR.MidAutumn2026_ZH-CN8947536773_1920x1080.webp","Wallpaper":"/th?id=OHR.MidAutumn2026_ZH-CN8947536773_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"当月亮也来赴会","Title":"庆祝中秋节的中国灯笼","Copyright":"© LeeYiuTung/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"中国曾制作出一个破纪录的月饼，重近13吨，直径超过26英尺。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260925_MidAutumn2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%ad%e7%a7%8b%e8%8a%82&form=hpcapt&filters=HpDate:\"20260924_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260925_MidAutumn2026"},"Ssd":"20260925","Name":"MidAutumn2026","Market":"ZH-CN","Hash":"8947536773","FullDateString":"2026 9月 25"},{"ImageContent":{"Description":"在西班牙加那利群岛的兰萨罗特岛，大自然的地质创造力尽情挥洒。赭黄与铁锈色条纹交错的悬崖之下，深色沙滩与大西洋相接，这是延续数百万年的火山活动留下的杰作。这段地质故事中有一章发生在距今并不久远的年代：1730年至1736年间，兰萨罗特岛各处出现了众多火山喷口，熔岩覆盖数十平方英里的土地，掩埋了道路、村庄和农田。","Image":{"Url":"/th?id=OHR.ElGolfo_ZH-CN8329995759_1920x1080.webp","Wallpaper":"/th?id=OHR.ElGolfo_ZH-CN8329995759_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"火山灰与浪花相遇","Title":"黑色熔岩海滩鸟瞰图，埃尔戈尔福，兰萨罗特岛，加那利群岛，西班牙","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"兰萨罗特岛与奇尼霍群岛共同构成一座联合国教科文组织世界地质公园，范围涵盖陆地及周边海域。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260924_ElGolfo\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%a5%bf%e7%8f%ad%e7%89%99%e5%85%b0%e8%90%a8%e7%bd%97%e7%89%b9%e5%b2%9b&form=hpcapt&filters=HpDate:\"20260923_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260924_ElGolfo"},"Ssd":"20260924","Name":"ElGolfo","Market":"ZH-CN","Hash":"8329995759","FullDateString":"2026 9月 24"},{"ImageContent":{"Description":"金色地毯通常只出现在童话世界里，但在金秋时节的北京，它们却铺展在你的脚下。地坛公园（方泽坛）著名的银杏大道汇聚了200多株历史悠久的银杏树。每当秋风掠过，数以万计的扇形金叶翩翩飘落，将这座古老的皇家坛庙铺垫成一片如梦似幻的金黄海洋。","Image":{"Url":"/th?id=OHR.AutumnEquinoxY26_ZH-CN7957453091_1920x1080.webp","Wallpaper":"/th?id=OHR.AutumnEquinoxY26_ZH-CN7957453091_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"金秋平分，地坛染黄","Title":"地坛公园秋日美景，北京，中国","Copyright":"© by Wei/Adobestock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"秋分标志着昼夜平分，也预示着老北京最美丽的仲秋金色画卷正式展开。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260923_AutumnEquinoxY26\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%a7%8b%e5%88%86&form=hpcapt&filters=HpDate:\"20260922_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260923_AutumnEquinoxY26"},"Ssd":"20260923","Name":"AutumnEquinoxY26","Market":"ZH-CN","Hash":"7957453091","FullDateString":"2026 9月 23"},{"ImageContent":{"Description":"在犹他州瓜兹曼山口附近，季节的变化以金色写满山坡。为美国西部染上色彩的山杨中，有许多是美洲山杨——北美分布最广的本土树种。眼前看似由一棵棵独立树木组成的森林，往往有着截然不同的真相：许多山杨形成彼此相连的无性系群落，树干从共享的根系网络中长出，并与相邻树干拥有相同的遗传密码。","Image":{"Url":"/th?id=OHR.FallAspens_ZH-CN7235054933_1920x1080.webp","Wallpaper":"/th?id=OHR.FallAspens_ZH-CN7235054933_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"金色时节","Title":"瓜兹曼山口附近的秋日山杨林，犹他州，美国","Copyright":"© Danita Delimont/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"犹他州的“潘多”（Pando）颤杨林被认为是世界上最大且最古老的生物体之一；它由超过40,000棵基因完全相同的树干组成，这些树干通过一个延伸超过100英亩的巨大地下根系紧密相连。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260922_FallAspens\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%93%9c%e5%85%b9%e6%9b%bc%e5%b1%b1%e5%8f%a3%e9%99%84%e8%bf%91%e7%9a%84%e7%a7%8b%e6%97%a5%e5%b1%b1%e6%9d%a8%e6%9e%97&form=hpcapt&filters=HpDate:\"20260921_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260922_FallAspens"},"Ssd":"20260922","Name":"FallAspens","Market":"ZH-CN","Hash":"7235054933","FullDateString":"2026 9月 22"},{"ImageContent":{"Description":"很少有动物既能称得上梳理皮毛的高手，又是水下森林的守护者。正因如此，每年9月最后一个完整周举行的海獭认知周鼓励人们进一步了解这些非凡的海洋哺乳动物，以及它们面临的种种挑战。","Image":{"Url":"/th?id=OHR.GroomingOtter_ZH-CN6969472572_1920x1080.webp","Wallpaper":"/th?id=OHR.GroomingOtter_ZH-CN6969472572_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"皮毛与海洋之间的生命","Title":"正在梳理皮毛的海獭，蒙特雷湾，加利福尼亚州，美国","Copyright":"© Suzi Eszterhas/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"海獭每平方英寸可长有多达100万根毛，因此拥有所有哺乳动物中最浓密的皮毛。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260921_GroomingOtter\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%b5%b7%e7%8d%ad%e8%ae%a4%e7%9f%a5%e5%91%a8&form=hpcapt&filters=HpDate:\"20260920_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260921_GroomingOtter"},"Ssd":"20260921","Name":"GroomingOtter","Market":"ZH-CN","Hash":"6969472572","FullDateString":"2026 9月 21"},{"ImageContent":{"Description":"几乎没有哪座城市像巴黎这样被赋予如此多的浪漫想象。然而，这座法国首都的历史并非始终像埃菲尔铁塔背后的落日霞光一样绚丽。铁塔为1889年世界博览会而建；这届世博会纪念法国大革命爆发一百周年，而铁塔最初计划作为博览会入口处的核心建筑。由工程师古斯塔夫·埃菲尔及其团队设计的这座钢铁地标，从战神广场拔地而起，高度接近1,000英尺，并成为当时世界上最高的建筑。","Image":{"Url":"/th?id=OHR.ParisSunset_ZH-CN6050686638_1920x1080.webp","Wallpaper":"/th?id=OHR.ParisSunset_ZH-CN6050686638_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"终获巴黎青睐的铁塔","Title":"日落时分的埃菲尔铁塔，巴黎，法国","Copyright":"© Alexander Spatari/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"如今埃菲尔铁塔高330米；2022年安装一根新的数字广播天线后，塔身增高了6米。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260920_ParisSunset\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b7%b4%e9%bb%8e&form=hpcapt&filters=HpDate:\"20260919_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260920_ParisSunset"},"Ssd":"20260920","Name":"ParisSunset","Market":"ZH-CN","Hash":"6050686638","FullDateString":"2026 9月 20"}],"PreloadMediaContents":[{"ImageContent":{"Description":"大快朵颐、肚皮更鼓并为冬季囤积能量的时节到了。在阿拉斯加州，克拉克湖国家公园和自然保护区的棕熊充分利用10月仍可获取的食物。它们以鱼、莎草、浆果、根、蛤蜊和其他食物为食，以积累脂肪储备。有些棕熊在进入洞穴冬眠前体重可超过1,000磅。储存的脂肪帮助它们度过不吃不喝的冬季。","Image":{"Url":"/th?id=OHR.GrizzlySwim_ZH-CN1005455737_1920x1080.webp","Wallpaper":"/th?id=OHR.GrizzlySwim_ZH-CN1005455737_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"捕捉、进食、重复","Title":"美国阿拉斯加州克拉克湖国家公园和自然保护区银鲑溪中的棕熊","Copyright":"© Danny Green/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"棕熊幼崽在冬季洞穴中出生，体型很小且没有毛，有时不足半磅；到春天时会长到4至8磅。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261003_GrizzlySwim\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%a3%95%e7%86%8a&form=hpcapt&filters=HpDate:\"20261002_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261003_GrizzlySwim"},"Ssd":"20261003","Name":"GrizzlySwim","Market":"ZH-CN","Hash":"1005455737","FullDateString":"2026 10月 3"},{"ImageContent":{"Description":"长期以来，河流在美国各地的生活中发挥着重要作用，为社区、野生动物和工业提供支持。1968年10月2日，林登·B·约翰逊总统签署《野生与风景河流法》，使其成为法律。该法建立了一个国家体系，用于保护具有卓越景观、休闲、地质、鱼类和野生动物、历史或文化价值的河流及河段。该法使指定河流保持自由流动状态，保护其水质，并旨在守护使它们值得获此指定的特质。","Image":{"Url":"/th?id=OHR.ChattoogaRiver_ZH-CN9453791496_1920x1080.webp","Wallpaper":"/th?id=OHR.ChattoogaRiver_ZH-CN9453791496_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"一条值得保护的河流","Title":"查图加河，阿巴拉契亚山脉，北卡罗来纳州，美国","Copyright":"© mtilghma/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"查图加河在约50英里的流程中平均每英里下降49英尺，最终流入图加卢湖。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261002_ChattoogaRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%be%8e%e5%9b%bd%e9%98%bf%e5%b7%b4%e6%8b%89%e5%a5%91%e4%ba%9a%e5%b1%b1%e8%84%89&form=hpcapt&filters=HpDate:\"20261001_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261002_ChattoogaRiver"},"Ssd":"20261002","Name":"ChattoogaRiver","Market":"ZH-CN","Hash":"9453791496","FullDateString":"2026 10月 2"},{"ImageContent":{"Description":"从这里望去，优胜美地一些最著名的地标也呈现出截然不同的一面。通常所见的半穹顶从优胜美地山谷上方拔地而起，而在这里，它露出陡峭的北壁，让这个熟悉的标志性景观看起来几乎令人感到陌生。远处还有特纳亚峡谷、云歇峰、特纳亚湖，以及记录着数百万年隆升、侵蚀与冰川作用的浅色岩石。奥姆斯特德观景点得名于景观设计师弗雷德里克·劳·奥姆斯特德及其子小弗雷德里克·劳·奥姆斯特德；父子二人的自然保护工作推动了美国国家公园运动的发展。这里提醒着人们：优胜美地不仅景色壮美，还是一片仍在以岩石讲述自身故事的土地。","Image":{"Url":"/th?id=OHR.OlmstedPoint_ZH-CN4182671075_1920x1080.webp","Wallpaper":"/th?id=OHR.OlmstedPoint_ZH-CN4182671075_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"在花岗岩中读懂时间","Title":"奥姆斯特德观景点的日落，优胜美地国家公园，加利福尼亚州，美国","Copyright":"© Robb Hirsch/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"优胜美地国家公园约95%的面积被指定为荒野。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261001_OlmstedPoint\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%bc%98%e8%83%9c%e7%be%8e%e5%9c%b0%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20260930_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261001_OlmstedPoint"},"Ssd":"20261001","Name":"OlmstedPoint","Market":"ZH-CN","Hash":"4182671075","FullDateString":"2026 10月 1"},{"ImageContent":{"Description":"在英格兰诺福克郡，一只雄性文须雀稳稳地立在纤细的茎秆上。今天图片中的它有着浅蓝灰色的头部、亮橙色的喙，以及令这个物种得名的黑色面部斑纹，格外引人注目。尽管外表醒目，这种小鸟一生中的大部分时间却藏身于沼泽、湖岸和芦苇荡茂密的湿地植被中。","Image":{"Url":"/th?id=OHR.BeardReedling_ZH-CN2750632320_1920x1080.webp","Wallpaper":"/th?id=OHR.BeardReedling_ZH-CN2750632320_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"一张令人过目难忘的脸","Title":"雄性文须雀，诺福克郡，英格兰","Copyright":"© Andrew Sproule/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"文须雀广泛分布于欧洲和亚洲，从英国的湿地一直延伸到中亚和东亚的芦苇荡。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260930_BeardReedling\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%96%87%e9%a1%bb%e9%9b%80&form=hpcapt&filters=HpDate:\"20260929_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260930_BeardReedling"},"Ssd":"20260930","Name":"BeardReedling","Market":"ZH-CN","Hash":"2750632320","FullDateString":"2026 9月 30"},{"ImageContent":{"Description":"从空中俯瞰，卡西洛夫河宛如一条绿松石色的丝带，蜿蜒穿过阿拉斯加州的基奈半岛。鲜艳的蓝色河水源于从图斯图梅纳湖向下游输送的冰川粉砂；该湖是阿拉斯加州最大的淡水湖之一。河流全长约17英里，最终注入库克湾。它虽比著名的邻河基奈河短，却同样不同凡响。","Image":{"Url":"/th?id=OHR.KasilofRiver_ZH-CN2394091052_1920x1080.webp","Wallpaper":"/th?id=OHR.KasilofRiver_ZH-CN2394091052_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"冰川孕育之河","Title":"卡西洛夫河冰川融水滋养的湛蓝河水，阿拉斯加州，美国","Copyright":"© jared lloyd/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"卡西洛夫河畔的克鲁克德溪州立休闲地在 5 月和 6 月最受欢迎，此时游客可从河岸垂钓帝王鲑。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260929_KasilofRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%be%8e%e5%9b%bd%e9%98%bf%e6%8b%89%e6%96%af%e5%8a%a0%e5%b7%9e%e5%8d%a1%e8%a5%bf%e6%b4%9b%e5%a4%ab%e6%b2%b3&form=hpcapt&filters=HpDate:\"20260928_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260929_KasilofRiver"},"Ssd":"20260929","Name":"KasilofRiver","Market":"ZH-CN","Hash":"2394091052","FullDateString":"2026 9月 29"},{"ImageContent":{"Description":"大多数初次到访印度拉贾斯坦邦斋浦尔的游客都知道这座城市有“粉红之城”的美誉，但更早的王都以琥珀堡为中心。这个王朝的大部分政治与建筑史正是在那里书写的。琥珀堡的营建历时一个多世纪，始于1592年拉贾·曼·辛格一世统治时期，之后由历代卡奇瓦哈统治者续建；他们统治的王国后来成为斋浦尔土邦。王室于 1727 年迁往新规划的斋浦尔城，但琥珀堡仍继续承担礼仪功能。","Image":{"Url":"/th?id=OHR.AmberHall_ZH-CN1223127100_1920x1080.webp","Wallpaper":"/th?id=OHR.AmberHall_ZH-CN1223127100_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"可览美景的历史胜地","Title":"斋浦尔附近琥珀堡内的 Sattais Katcheri 大厅，拉贾斯坦邦，印度","Copyright":"© R.M. Nunes/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"琥珀堡是联合国教科文组织世界遗产“拉贾斯坦邦的山地要塞”所包含的六座堡垒之一；该遗产于 2013 年列入《世界遗产名录》。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260928_AmberHall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%8d%b0%e5%ba%a6%e6%8b%89%e8%b4%be%e6%96%af%e5%9d%a6%e9%82%a6%e6%96%8b%e6%b5%a6%e5%b0%94%e7%90%a5%e7%8f%80%e5%a0%a1&form=hpcapt&filters=HpDate:\"20260927_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260928_AmberHall"},"Ssd":"20260928","Name":"AmberHall","Market":"ZH-CN","Hash":"1223127100","FullDateString":"2026 9月 28"},{"ImageContent":{"Description":"不妨把这看作一场水下捉迷藏：海笔格外醒目，螃蟹却融入其中。今天的图片拍摄于印度尼西亚科莫多国家公园周边水域。该公园成立于1980年，以世界上现存最大的蜥蜴科莫多巨蜥命名。这片保护区包括岛屿、红树林、海草床和珊瑚礁。公园位于太平洋与印度洋之间，强劲洋流塑造了这里的生态环境，孕育出丰富多样的海洋生物，其中也包括依靠伪装生存的物种。","Image":{"Url":"/th?id=OHR.DecoCrab_ZH-CN0973306994_1920x1080.webp","Wallpaper":"/th?id=OHR.DecoCrab_ZH-CN0973306994_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"深海夜花园","Title":"海笔上的装饰蟹，科莫多国家公园，印度尼西亚","Copyright":"© Alex Mustard/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"科莫多国家公园于1991年被列入联合国教科文组织《世界遗产名录》。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260927_DecoCrab\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%a7%91%e8%8e%ab%e5%a4%9a%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9