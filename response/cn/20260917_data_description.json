{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"/rp/WbrnXG_o6g55b3vAIJaTZiy1W6U.gz.css","Postloaded":false},{"Path":"/rp/hYhZb3rTk3plX-hOqaRO9UgrBOU.gz.css","Postloaded":true},{"Path":"/rp/kRvQpUFDGnZ-qIQ0Bl0qAksxajE.gz.css","Postloaded":true},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":true},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":true},{"Path":"/rp/C55hud04WRj662Ou8c3t6oJFAE0.gz.css","Postloaded":false},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableHPV2ScrollBg":false,"EnableHPV2NoCopilot":false,"HideCopilot":false,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-17T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"每年夏末秋初，法国最令人期待的传统之一——“vendanges”葡萄采摘季——如期而至。采摘时间因葡萄酒产区而异，并取决于天气状况、日照以及果实的成熟度。对许多葡萄园而言，采收仍主要依靠人工，工作人员会仔细挑选一串串葡萄，用于酿造法国一些最负盛名的葡萄酒。","Image":{"Url":"/th?id=OHR.Santenay_ZH-CN5676942384_1920x1080.webp","Wallpaper":"/th?id=OHR.Santenay_ZH-CN5676942384_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"为丰收举杯","Title":"桑特奈葡萄酒产区葡萄园中的索林风车，伯恩丘，勃艮第，法国","Copyright":"© Marco Bottigelli/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"索林风车是伯恩丘现存最后一座仍可运转的公共风车；这座19世纪风车于1995年得到忠实修复。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260917_Santenay\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%a1%91%e7%89%b9%e5%a5%88%e8%91%a1%e8%90%84%e9%85%92%e4%ba%a7%e5%8c%ba&form=hpcapt&filters=HpDate:\"20260916_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260917_Santenay"},"Ssd":"20260917","Name":"Santenay","Market":"ZH-CN","Hash":"5676942384","FullDateString":"2026 9月 17"},{"ImageContent":{"Description":"两只北极熊幼崽小心翼翼地穿行在斯瓦尔巴群岛的雪地上；这片偏远的挪威群岛深入北冰洋腹地，由冰川、山脉和冰封峡湾构成。这片荒野属于巴伦支海地区，生活着全球最大的北极熊种群之一，约有2,600只。","Image":{"Url":"/th?id=OHR.IcyCubs_ZH-CN5287408951_1920x1080.webp","Wallpaper":"/th?id=OHR.IcyCubs_ZH-CN5287408951_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"北极的新晋探索者","Title":"斯瓦尔巴群岛玩耍的北极熊幼崽，挪威","Copyright":"© Danny Green/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"在经历了约一个世纪的大规模捕猎后，斯瓦尔巴群岛的北极熊自1973年起受到保护。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260916_IcyCubs\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%8c%97%e6%9e%81%e7%86%8a&form=hpcapt&filters=HpDate:\"20260915_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260916_IcyCubs"},"Ssd":"20260916","Name":"IcyCubs","Market":"ZH-CN","Hash":"5287408951","FullDateString":"2026 9月 16"},{"ImageContent":{"Description":"进化偶尔也会偏爱繁复华丽。看看这些红绿金刚鹦鹉：它们拥有猩红色羽毛、鲜绿色翅膀和蓝色飞羽。它们生活在南美洲热带地区，日常活动以不易从地面察觉的方式将果实、种子与土壤联系在一起。","Image":{"Url":"/th?id=OHR.RedMacawsFlight_ZH-CN5045822113_1920x1080.webp","Wallpaper":"/th?id=OHR.RedMacawsFlight_ZH-CN5045822113_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"最炫者生存","Title":"红绿金刚鹦鹉","Copyright":"© markes51/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"大型金刚鹦鹉可产生数百磅每平方英寸的咬合压力，远高于普通人类，因而能轻松咬开坚硬的坚果和种子。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260915_RedMacawsFlight\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%ba%a2%e7%bb%bf%e9%87%91%e5%88%9a%e9%b9%a6%e9%b9%89&form=hpcapt&filters=HpDate:\"20260914_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260915_RedMacawsFlight"},"Ssd":"20260915","Name":"RedMacawsFlight","Market":"ZH-CN","Hash":"5045822113","FullDateString":"2026 9月 15"},{"ImageContent":{"Description":"在今天的画面中，中国大地上铺展着绿色与深红色的地肤。地肤原产于欧亚大陆部分地区，19世纪末作为观赏植物和制作扫帚的材料来源被引入美国。它耐旱、耐热、耐盐碱土壤和少雨环境的能力，帮助其扩散至美国大平原及美国西部大部分地区。","Image":{"Url":"/th?id=OHR.KochiaChina_ZH-CN4719995421_1920x1080.webp","Wallpaper":"/th?id=OHR.KochiaChina_ZH-CN4719995421_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"坚韧在此扎根","Title":"地肤田，中国","Copyright":"© lingqi xie/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"地肤属于苋科，与甜菜、菠菜和藜麦有植物学上的亲缘关系。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260914_KochiaChina\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9c%b0%e8%82%a4&form=hpcapt&filters=HpDate:\"20260913_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260914_KochiaChina"},"Ssd":"20260914","Name":"KochiaChina","Market":"ZH-CN","Hash":"4719995421","FullDateString":"2026 9月 14"},{"ImageContent":{"Description":"画面捕捉了意大利东北部威尼托大区米苏里纳群峰日出时的锯齿状天际线。前往附近三峰山的游客，往往本为那条著名路线而来，却发现自己的目光被米苏里纳群峰吸引。作为多洛米蒂山脉的一部分，这些针状山峰最高处超过9,300英尺，仿佛专为营造戏剧效果而雕琢。出人意料的是，它们最初是古老的珊瑚礁。","Image":{"Url":"/th?id=OHR.MisurinaPeak_ZH-CN3877105161_1920x1080.webp","Wallpaper":"/th?id=OHR.MisurinaPeak_ZH-CN3877105161_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"高处的珊瑚礁","Title":"米苏里纳群峰，多洛米蒂山脉，威尼托大区，意大利","Copyright":"© Vithun Khamsong/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"联合国教科文组织的多洛米蒂山脉遗产地由九个组成部分构成，其中有18座海拔超过3000米的山峰。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260913_MisurinaPeak\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a4%9a%e6%b4%9b%e7%b1%b3%e8%92%82%e5%b1%b1%e8%84%89%e7%b1%b3%e8%8b%8f%e9%87%8c%e7%ba%b3%e7%be%a4%e5%b3%b0&form=hpcapt&filters=HpDate:\"20260912_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260913_MisurinaPeak"},"Ssd":"20260913","Name":"MisurinaPeak","Market":"ZH-CN","Hash":"3877105161","FullDateString":"2026 9月 13"},{"ImageContent":{"Description":"加州海狮在场时，海滩上的一天很少会安静。洪亮的吠叫、顽皮的个性，再加上抢尽风头的本领，让这些海洋哺乳动物深谙如何上演一场好戏。","Image":{"Url":"/th?id=OHR.SardineBait_ZH-CN3256234033_1920x1080.webp","Wallpaper":"/th?id=OHR.SardineBait_ZH-CN3256234033_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海浪与海岸的高手","Title":"墨西哥近海围猎沙丁鱼饵球的加州海狮，太平洋","Copyright":"© Henley Spiers/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"它们能潜至1,000英尺深处，并可屏息长达10分钟。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260912_SardineBait\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%8a%a0%e5%b7%9e%e6%b5%b7%e7%8b%ae&form=hpcapt&filters=HpDate:\"20260911_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260912_SardineBait"},"Ssd":"20260912","Name":"SardineBait","Market":"ZH-CN","Hash":"3256234033","FullDateString":"2026 9月 12"},{"ImageContent":{"Description":"九月，法国里维埃拉沐浴在更柔和的光线中，地中海植被也逐渐恢复生机。山丘间弥漫着阿勒颇松、迷迭香和野百里香的芳香。内陆地区，百年橄榄树和山顶村庄讲述着一个由希腊、罗马和普罗旺斯影响共同塑造的故事。","Image":{"Url":"/th?id=OHR.FrenchRivieraVillage_ZH-CN2888811422_1920x1080.webp","Wallpaper":"/th?id=OHR.FrenchRivieraVillage_ZH-CN2888811422_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"地中海风情尽显","Title":"滨海自由城，法国里维埃拉，法国","Copyright":"© StockByM/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"滨海自由城的圣埃尔姆城堡奉萨伏依公爵埃马努埃莱·菲利贝托之命，于1557年建成，用于加强海岸防御。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260911_FrenchRivieraVillage\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%bb%a8%e6%b5%b7%e8%87%aa%e7%94%b1%e5%9f%8e&form=hpcapt&filters=HpDate:\"20260910_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260911_FrenchRivieraVillage"},"Ssd":"20260911","Name":"FrenchRivieraVillage","Market":"ZH-CN","Hash":"2888811422","FullDateString":"2026 9月 11"}],"PreloadMediaContents":[{"ImageContent":{"Description":"在西班牙加那利群岛的兰萨罗特岛，大自然的地质创造力尽情挥洒。赭黄与铁锈色条纹交错的悬崖之下，深色沙滩与大西洋相接，这是延续数百万年的火山活动留下的杰作。这段地质故事中有一章发生在距今并不久远的年代：1730年至1736年间，兰萨罗特岛各处出现了众多火山喷口，熔岩覆盖数十平方英里的土地，掩埋了道路、村庄和农田。","Image":{"Url":"/th?id=OHR.ElGolfo_ZH-CN8329995759_1920x1080.webp","Wallpaper":"/th?id=OHR.ElGolfo_ZH-CN8329995759_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"火山灰与浪花相遇","Title":"黑色熔岩海滩鸟瞰图，埃尔戈尔福，兰萨罗特岛，加那利群岛，西班牙","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"兰萨罗特岛与奇尼霍群岛共同构成一座联合国教科文组织世界地质公园，范围涵盖陆地及周边海域。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260924_ElGolfo\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%a5%bf%e7%8f%ad%e7%89%99%e5%85%b0%e8%90%a8%e7%bd%97%e7%89%b9%e5%b2%9b&form=hpcapt&filters=HpDate:\"20260923_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260924_ElGolfo"},"Ssd":"20260924","Name":"ElGolfo","Market":"ZH-CN","Hash":"8329995759","FullDateString":"2026 9月 24"},{"ImageContent":{"Description":"金色地毯通常只出现在童话世界里，但在金秋时节的北京，它们却铺展在你的脚下。地坛公园（方泽坛）著名的银杏大道汇聚了200多株历史悠久的银杏树。每当秋风掠过，数以万计的扇形金叶翩翩飘落，将这座古老的皇家坛庙铺垫成一片如梦似幻的金黄海洋。","Image":{"Url":"/th?id=OHR.AutumnEquinoxY26_ZH-CN7957453091_1920x1080.webp","Wallpaper":"/th?id=OHR.AutumnEquinoxY26_ZH-CN7957453091_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"金秋平分，地坛染黄","Title":"地坛公园秋日美景，北京，中国","Copyright":"© by Wei/Adobestock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"秋分标志着昼夜平分，也预示着老北京最美丽的仲秋金色画卷正式展开。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260923_AutumnEquinoxY26\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%a7%8b%e5%88%86&form=hpcapt&filters=HpDate:\"20260922_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260923_AutumnEquinoxY26"},"Ssd":"20260923","Name":"AutumnEquinoxY26","Market":"ZH-CN","Hash":"7957453091","FullDateString":"2026 9月 23"},{"ImageContent":{"Description":"在犹他州瓜兹曼山口附近，季节的变化以金色写满山坡。为美国西部染上色彩的山杨中，有许多是美洲山杨——北美分布最广的本土树种。眼前看似由一棵棵独立树木组成的森林，往往有着截然不同的真相：许多山杨形成彼此相连的无性系群落，树干从共享的根系网络中长出，并与相邻树干拥有相同的遗传密码。","Image":{"Url":"/th?id=OHR.FallAspens_ZH-CN7235054933_1920x1080.webp","Wallpaper":"/th?id=OHR.FallAspens_ZH-CN7235054933_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"金色时节","Title":"瓜兹曼山口附近的秋日山杨林，犹他州，美国","Copyright":"© Danita Delimont/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"犹他州的“潘多”（Pando）颤杨林被认为是世界上最大且最古老的生物体之一；它由超过40,000棵基因完全相同的树干组成，这些树干通过一个延伸超过100英亩的巨大地下根系紧密相连。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260922_FallAspens\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%93%9c%e5%85%b9%e6%9b%bc%e5%b1%b1%e5%8f%a3%e9%99%84%e8%bf%91%e7%9a%84%e7%a7%8b%e6%97%a5%e5%b1%b1%e6%9d%a8%e6%9e%97&form=hpcapt&filters=HpDate:\"20260921_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260922_FallAspens"},"Ssd":"20260922","Name":"FallAspens","Market":"ZH-CN","Hash":"7235054933","FullDateString":"2026 9月 22"},{"ImageContent":{"Description":"很少有动物既能称得上梳理皮毛的高手，又是水下森林的守护者。正因如此，每年9月最后一个完整周举行的海獭认知周鼓励人们进一步了解这些非凡的海洋哺乳动物，以及它们面临的种种挑战。","Image":{"Url":"/th?id=OHR.GroomingOtter_ZH-CN6969472572_1920x1080.webp","Wallpaper":"/th?id=OHR.GroomingOtter_ZH-CN6969472572_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"皮毛与海洋之间的生命","Title":"正在梳理皮毛的海獭，蒙特雷湾，加利福尼亚州，美国","Copyright":"© Suzi Eszterhas/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"海獭每平方英寸可长有多达100万根毛，因此拥有所有哺乳动物中最浓密的皮毛。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260921_GroomingOtter\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%b5%b7%e7%8d%ad%e8%ae%a4%e7%9f%a5%e5%91%a8&form=hpcapt&filters=HpDate:\"20260920_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260921_GroomingOtter"},"Ssd":"20260921","Name":"GroomingOtter","Market":"ZH-CN","Hash":"6969472572","FullDateString":"2026 9月 21"},{"ImageContent":{"Description":"几乎没有哪座城市像巴黎这样被赋予如此多的浪漫想象。然而，这座法国首都的历史并非始终像埃菲尔铁塔背后的落日霞光一样绚丽。铁塔为1889年世界博览会而建；这届世博会纪念法国大革命爆发一百周年，而铁塔最初计划作为博览会入口处的核心建筑。由工程师古斯塔夫·埃菲尔及其团队设计的这座钢铁地标，从战神广场拔地而起，高度接近1,000英尺，并成为当时世界上最高的建筑。","Image":{"Url":"/th?id=OHR.ParisSunset_ZH-CN6050686638_1920x1080.webp","Wallpaper":"/th?id=OHR.ParisSunset_ZH-CN6050686638_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"终获巴黎青睐的铁塔","Title":"日落时分的埃菲尔铁塔，巴黎，法国","Copyright":"© Alexander Spatari/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"如今埃菲尔铁塔高330米；2022年安装一根新的数字广播天线后，塔身增高了6米。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260920_ParisSunset\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b7%b4%e9%bb%8e&form=hpcapt&filters=HpDate:\"20260919_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260920_ParisSunset"},"Ssd":"20260920","Name":"ParisSunset","Market":"ZH-CN","Hash":"6050686638","FullDateString":"2026 9月 20"},{"ImageContent":{"Description":"慕尼黑啤酒节于今天开幕，抵达德国巴伐利亚州的游客或许会听到一种甚至比这一著名节日本身更古老的声音：阿尔卑斯长号深沉而浑厚的鸣响。这种传统的阿尔卑斯乐器与巴伐利亚、奥地利和瑞士的文化紧密相连；过去，牧羊人曾用它跨越山谷彼此传递信息。","Image":{"Url":"/th?id=OHR.AlphornBavaria_ZH-CN5896237112_1920x1080.webp","Wallpaper":"/th?id=OHR.AlphornBavaria_ZH-CN5896237112_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"慕尼黑啤酒节的阿尔卑斯之声","Title":"阿尔卑斯长号演奏者，巴伐利亚州，德国","Copyright":"© U. J. Alexander/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"已知最早提及瑞士阿尔卑斯长号的文字记录可追溯至1527年，见于圣乌尔班修道院的账簿。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260919_AlphornBavaria\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%85%95%e5%b0%bc%e9%bb%91%e5%95%a4%e9%85%92%e8%8a%82&form=hpcapt&filters=HpDate:\"20260918_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260919_AlphornBavaria"},"Ssd":"20260919","Name":"AlphornBavaria","Market":"ZH-CN","Hash":"5896237112","FullDateString":"2026 9月 19"},{"ImageContent":{"Description":"在英格兰峰区，一条蜿蜒的长路从已有3亿多年历史的岩石间穿过。如此漫长的地质时间尺度本就令人惊叹，而这条路还穿越了温纳茨山口：这是一道狭窄的石灰岩峡谷，高耸的峭壁展现出远古海洋曾经覆盖英国这一地区的痕迹。","Image":{"Url":"/th?id=OHR.WinnatsPassPeak_ZH-CN4443458412_1920x1080.webp","Wallpaper":"/th?id=OHR.WinnatsPassPeak_ZH-CN4443458412_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"穿越山口腹地","Title":"温纳茨山口，峰区国家公园，英格兰","Copyright":"© Daniel_Kay/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"温纳茨山口是峰区国家公园内一处壮观的石灰岩峡谷，位于卡斯尔顿附近，两侧峭壁陡峻嶙峋。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260918_WinnatsPassPeak\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b3%b0%e5%8c%ba%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20260917_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260918_WinnatsPassPeak"},"Ssd":"20260918","Name":"WinnatsPassPeak","Market":"ZH-CN","Hash":"4443458412","FullDateString":"2026 9月 18"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"每日一图","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"了解更多","LOC_HOMEPAGE_VERTICAL_SCROLL_DONATE_NOW":"立即捐赠","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"速览:","LOC_HOMEPAGE_GALLERY_CAR