{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"/rp/2P1v961xAkWrVG1OpTWrB7cXL38.gz.css","Postloaded":false},{"Path":"/rp/OC8smywqixnwKVFLjfHItA61BN4.gz.css","Postloaded":false},{"Path":"/rp/v-XCA5xwjvVzQ0P62S1BCFnh-m0.gz.css","Postloaded":false},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":false},{"Path":"/rp/hYhZb3rTk3plX-hOqaRO9UgrBOU.gz.css","Postloaded":true},{"Path":"/rp/TM07Ij5E_PzXpONg1yXcQCYhtK4.gz.css","Postloaded":true},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":true},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":true},{"Path":"/rp/C55hud04WRj662Ou8c3t6oJFAE0.gz.css","Postloaded":false},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableFeedPositionToggle":false,"EnableUnifiedTobFeedBackplate":true,"EnableUnifiedTobFeedBackplateProdPosition":false,"HideCopilot":true,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-10-20T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"稳扎稳打才能赢得比赛——而褐喉三趾树懒似乎很乐意彻底放弃比赛。在国际树懒日，这种三趾哺乳动物为生存之道带来了另一番启示：保存能量，牢牢抓住，慢慢来。","Image":{"Url":"/th?id=OHR.BrownSloth_ZH-CN5776383136_1920x1080.webp","Wallpaper":"/th?id=OHR.BrownSloth_ZH-CN5776383136_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"慢节奏生活","Title":"褐喉三趾树懒，塔拉曼卡旧港，哥斯达黎加","Copyright":"© Suzi Eszterhas/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"褐喉三趾树懒每天可能睡15至18小时，通常只在夜间短暂活动。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261020_BrownSloth\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%99%85%e6%a0%91%e6%87%92%e6%97%a5&form=hpcapt&filters=HpDate:\"20261019_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261020_BrownSloth"},"Ssd":"20261020","Name":"BrownSloth","Market":"ZH-CN","Hash":"5776383136","FullDateString":"2026 10月 20"},{"ImageContent":{"Description":"如果一座城市最繁忙的街道根本没有路，会是什么样？在意大利威尼斯，交通沿着大运河往来。这条长2.4英里的水道以巨大的反S形蜿蜒穿过城市。当地人称它为“大运河”，它是威尼斯主要的水上交通通道，水上巴士、水上出租车、贡多拉、警用艇和其他船只都在此穿行。大运河沿着一条古河道延伸，这条河过去曾流入威尼斯潟湖。","Image":{"Url":"/th?id=OHR.VeniceSunrise_ZH-CN5251815339_1920x1080.webp","Wallpaper":"/th?id=OHR.VeniceSunrise_ZH-CN5251815339_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"水上通衢","Title":"大运河，威尼斯，意大利","Copyright":"© Juan Romero/Cavan Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"威尼斯及其潟湖于1987年列入联合国教科文组织世界遗产名录，并符合该遗产地全部六项文化标准。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261019_VeniceSunrise\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a8%81%e5%b0%bc%e6%96%af%e5%a4%a7%e8%bf%90%e6%b2%b3&form=hpcapt&filters=HpDate:\"20261018_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261019_VeniceSunrise"},"Ssd":"20261019","Name":"VeniceSunrise","Market":"ZH-CN","Hash":"5251815339","FullDateString":"2026 10月 19"},{"ImageContent":{"Description":"如果公园也能写生日手记，威尔士斯诺登尼亚国家公园一定有许多精彩故事可讲。今天是这座公园成立75周年，纪念它于1951年获指定为国家公园。斯诺登尼亚占地823平方英里，拥有九条山脉和74英里海岸线，栖息地类型从泥炭地、原生林地到高地景观不一而足。斯诺登山海拔超过3,500英尺，是斯诺登尼亚的最高点。附近的卡内道山脉和格利德赖山脉群峰耸立，卡代尔伊德里斯山则矗立在南部。这些受保护的景观为野生动物提供了栖息地，其中包括17处国家级自然保护区和56处特殊科学价值地点。","Image":{"Url":"/th?id=OHR.DolbadarnWales_ZH-CN3649667806_1920x1080.webp","Wallpaper":"/th?id=OHR.DolbadarnWales_ZH-CN3649667806_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"75载，风华正茂","Title":"多巴达恩城堡，兰贝里斯，斯诺登尼亚国家公园，威尔士","Copyright":"© joe daniel price/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"2015年，斯诺登尼亚被认定为国际暗夜保护区，以表彰其卓越的夜空质量和限制光污染的努力。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261018_DolbadarnWales\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a8%81%e5%b0%94%e5%a3%ab%e6%96%af%e8%af%ba%e7%99%bb%e5%b0%bc%e4%ba%9a%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261017_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261018_DolbadarnWales"},"Ssd":"20261018","Name":"DolbadarnWales","Market":"ZH-CN","Hash":"3649667806","FullDateString":"2026 10月 18"},{"ImageContent":{"Description":"有些发现始于一把铲子，另一些则始于洞穴墙壁上的一幅图画。国际考古日既颂扬抽丝剥茧般的考古工作，也重视支撑发现的证据。这项年度活动由美国考古学会主办，始于2011年；随着参与范围扩展至全球，活动于2013年更名为“国际考古日”。如今，它通过讲座、博物馆项目、遗址参观、模拟发掘和动手实践活动，让公众更加贴近考古学。","Image":{"Url":"/th?id=OHR.ChauvetPaintingsFrance_ZH-CN3150703955_1920x1080.webp","Wallpaper":"/th?id=OHR.ChauvetPaintingsFrance_ZH-CN3150703955_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"发掘尘封的过去","Title":"肖维岩洞艺术作品等比例复制品，瓦隆蓬达尔克，法国","Copyright":"© Audrey Poree/Alamy","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"肖维岩洞保存着一名史前青少年的足迹，大约3万年前，这名青少年曾赤脚走过洞内通道。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261017_ChauvetPaintingsFrance\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%99%85%e8%80%83%e5%8f%a4%e6%97%a5&form=hpcapt&filters=HpDate:\"20261016_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261017_ChauvetPaintingsFrance"},"Ssd":"20261017","Name":"ChauvetPaintingsFrance","Market":"ZH-CN","Hash":"3150703955","FullDateString":"2026 10月 17"},{"ImageContent":{"Description":"有些山会让你付出一番努力才能欣赏到美景，而攀登斯奈费尔斯山，最考验人的则是最后几百英尺。它高耸于科罗拉多州的圣胡安山脉，海拔14,150英尺，是一座“十四峰”，在里奇韦、乌雷和特柳赖德一带十分醒目。它坐落在占地16,587英亩的斯奈费尔斯山荒野区内，这片保护区于1980年获指定。徒步者可以从多条路线登山，包括经扬基博伊盆地和蓝湖群地区的路线。","Image":{"Url":"/th?id=OHR.SneffelsAutumn_ZH-CN3002661429_1920x1080.webp","Wallpaper":"/th?id=OHR.SneffelsAutumn_ZH-CN3002661429_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"一窥科罗拉多群峰","Title":"斯奈费尔斯山，里奇韦附近的圣胡安山脉，科罗拉多州，美国","Copyright":"© lightphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"根据美国联邦荒野管理规定，斯奈费尔斯山荒野区通常禁止机动车辆和机械运输工具进入。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261016_SneffelsAutumn\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%96%af%e5%a5%88%e8%b4%b9%e5%b0%94%e6%96%af%e5%b1%b1&form=hpcapt&filters=HpDate:\"20261015_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261016_SneffelsAutumn"},"Ssd":"20261016","Name":"SneffelsAutumn","Market":"ZH-CN","Hash":"3002661429","FullDateString":"2026 10月 16"},{"ImageContent":{"Description":"暮色降临弗罗茨瓦夫，金色光芒洒满屋顶、教堂塔楼和中欧最引人注目的历史中心之一。这座位于波兰西南部的城市横跨多座岛屿和水道，由100多座桥梁连接，将中世纪建筑与充满活力的现代生活融为一体。城市中心是热闹的雷内克(Rynek)集市广场，该广场建于13世纪，哥特式老市政厅便坐落于此，它是弗罗茨瓦夫最易辨认的地标之一。","Image":{"Url":"/th?id=OHR.WroclawPoland_ZH-CN6042428292_1920x1080.webp","Wallpaper":"/th?id=OHR.WroclawPoland_ZH-CN6042428292_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"桥梁、屋顶与暮色","Title":"弗罗茨瓦夫集市广场景观，摄自女巫桥，弗罗茨瓦夫，波兰","Copyright":"© Piotr Mitelski/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"弗罗茨瓦夫百年厅于1913年建成时，拥有当时世界上最大的钢筋混凝土穹顶。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261015_WroclawPoland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%bc%97%e7%bd%97%e8%8c%a8%e7%93%a6%e5%a4%ab&form=hpcapt&filters=HpDate:\"20261014_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261015_WroclawPoland"},"Ssd":"20261015","Name":"WroclawPoland","Market":"ZH-CN","Hash":"6042428292","FullDateString":"2026 10月 15"},{"ImageContent":{"Description":"我们如何知道早在人类出现之前地球是什么样子？化石提供了许多线索。国家化石日旨在赞颂古生物学，以及那些帮助科学家重建过去环境、追溯生命演化并了解数百万年前消失生物的发现。从恐龙到微小的海洋生物，这些过去的遗存保存着早已不复存在的远古世界的一个个瞬间。","Image":{"Url":"/th?id=OHR.AmmoniteFossils_ZH-CN5825251327_1920x1080.webp","Wallpaper":"/th?id=OHR.AmmoniteFossils_ZH-CN5825251327_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"穿越时间的螺旋","Title":"侏罗纪时期的菊石化石","Copyright":"© J Nemchinova/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"化石不一定非得是骨骼。足迹、洞道、巢穴以及古代生命留下的其他痕迹也可以成为化石。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261014_AmmoniteFossils\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e5%ae%b6%e5%8c%96%e7%9f%b3%e6%97%a5&form=hpcapt&filters=HpDate:\"20261013_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261014_AmmoniteFossils"},"Ssd":"20261014","Name":"AmmoniteFossils","Market":"ZH-CN","Hash":"5825251327","FullDateString":"2026 10月 14"}],"PreloadMediaContents":[{"ImageContent":{"Description":"这片池杉林倒映在平静的水面上，在落日余晖中熠熠生辉，呈现出色彩与对称之美，令人叹为观止。池杉原产于美国东南部，通常生长在浅水池塘、洼地和湿地生境中。这张照片拍摄于乔治亚州，当地的奥克弗诺基沼泽及其他低洼湿地中均可见这些树木。","Image":{"Url":"/th?id=OHR.PondCypress_ZH-CN9472607734_1920x1080.webp","Wallpaper":"/th?id=OHR.PondCypress_ZH-CN9472607734_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"大自然的金色明镜","Title":"秋叶缤纷的池杉林，乔治亚州，美国","Copyright":"© Chris Moore/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"池杉会长出被称为“膝根”的瘤状根部结构，高出树木周围的水面或土壤。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261027_PondCypress\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%b1%a0%e6%9d%89&form=hpcapt&filters=HpDate:\"20261026_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261027_PondCypress"},"Ssd":"20261027","Name":"PondCypress","Market":"ZH-CN","Hash":"9472607734","FullDateString":"2026 10月 27"},{"ImageContent":{"Description":"在保加利亚的西罗多彼山脉，秋叶汇聚在奔腾的西托沃瀑布旁。瀑布位于普罗夫迪夫西南方向的西托沃村附近，从一座古老石桥下倾泻而下；桥拱如画框般圈住飞瀑，宛若童话书中的场景。覆满苔藓的石头和松树为秋日景观添上层层绿意，落叶则堆积在水边，或漂过一汪汪水潭。雨后和春季融雪期间，瀑布尤其奔涌欢腾，湍急水声回荡在周围的林地间。","Image":{"Url":"/th?id=OHR.SitovoWaterfall_ZH-CN8495214046_1920x1080.webp","Wallpaper":"/th?id=OHR.SitovoWaterfall_ZH-CN8495214046_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"大自然的秋日乐章","Title":"秋日瀑布，西托沃附近，普罗夫迪夫州，保加利亚","Copyright":"© Nadya85/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"西罗多彼山脉被认定为关键生物多样性区域，这是对全球生物多样性至关重要地点的一项全球认定。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261026_SitovoWaterfall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%bf%9d%e5%8a%a0%e5%88%a9%e4%ba%9a%e6%99%ae%e7%bd%97%e5%a4%ab%e8%bf%aa%e5%a4%ab%e8%a5%bf%e6%89%98%e6%b2%83&form=hpcapt&filters=HpDate:\"20261025_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261026_SitovoWaterfall"},"Ssd":"20261026","Name":"SitovoWaterfall","Market":"ZH-CN","Hash":"8495214046","FullDateString":"2026 10月 26"},{"ImageContent":{"Description":"夜幕降临加拿大艾伯塔省的贾斯珀国家公园时，群山便有了全新的背景。该公园于2011年被指定为暗夜天空保护区，面积超过11,000平方千米，并采取了减少光污染的措施。在这里，繁星、行星和银河系联袂上演天幕奇观，让游客不由得仰望天空。晨光到来后，视线又从头顶的天空转向脚下的景致。","Image":{"Url":"/th?id=OHR.MaligneFest_ZH-CN8343066766_1920x1080.webp","Wallpaper":"/th?id=OHR.MaligneFest_ZH-CN8343066766_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"群峰与宁静相遇之地","Title":"玛琳湖，贾斯珀国家公园，艾伯塔省，加拿大","Copyright":"© Andrey Popov/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"据加拿大公园管理局介绍，精灵岛距玛琳湖北岸14公里，只能乘船抵达。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261025_MaligneFest\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%8e%9b%e7%90%b3%e6%b9%96&form=hpcapt&filters=HpDate:\"20261024_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261025_MaligneFest"},"Ssd":"20261025","Name":"MaligneFest","Market":"ZH-CN","Hash":"8343066766","FullDateString":"2026 10月 25"},{"ImageContent":{"Description":"今天，我们走进巴西里约热内卢的皇家葡萄牙语阅览室。在这里，翻开一本书这一朴素举动，被赋予了宏伟的建筑抱负。巴西独立仅15年后，43名葡萄牙移民于1837年创办了这家机构；约半个世纪后，机构最终迁入眼前这座以华丽的新曼努埃尔式建成的建筑。书架环绕宽阔的阅览大厅，高逾70英尺；大厅上方覆盖着一扇巨型彩绘玻璃天窗，让自然光也成为设计的一部分。","Image":{"Url":"/th?id=OHR.PortugueseLibrary_ZH-CN7096893027_1920x1080.webp","Wallpaper":"/th?id=OHR.PortugueseLibrary_ZH-CN7096893027_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"书香里的极致华美","Title":"皇家葡萄牙语阅览室，里约热内卢，巴西","Copyright":"© Antonio Salaverry/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"据场馆官网介绍，皇家葡萄牙语阅览室工作日10时至17时免费开放参观。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261024_PortugueseLibrary\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%9a%87%e5%ae%b6%e8%91%a1%e8%90%84%e7%89%99%e8%af%ad%e9%98%85%e8%a7%88%e5%ae%a4&form=hpcapt&filters=HpDate:\"20261023_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261024_PortugueseLibrary"},"Ssd":"20261024","Name":"PortugueseLibrary","Market":"ZH-CN","Hash":"7096893027","FullDateString":"2026 10月 24"},{"ImageContent":{"Description":"两只灰狼穿行在怀俄明州黄石国家公园的山艾灌丛中，这里生活着北美洲一些最受密切关注的狼群。厚实的皮毛帮助它们抵御严冬，敏锐的感官则使它们成为技艺高超的猎手和交流者。","Image":{"Url":"/th?id=OHR.YellowstoneWolves_ZH-CN6767268961_1920x1080.webp","Wallpaper":"/th?id=OHR.YellowstoneWolves_ZH-CN6767268961_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"荒野伙伴","Title":"两只灰狼，黄石国家公园，怀俄明州，美国","Copyright":"© John Morrison/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"灰狼可以通过嚎叫、肢体语言、气味标记以及多种发声方式进行交流，包括吠叫、呜咽和低吼。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261023_YellowstoneWolves\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%81%b0%e7%8b%bc&form=hpcapt&filters=HpDate:\"20261022_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261023_YellowstoneWolves"},"Ssd":"20261023","Name":"YellowstoneWolves","Market":"ZH-CN","Hash":"6767268961","FullDateString":"2026 10月 23"},{"ImageContent":{"Description":"在韩国，很少有地方能像内藏山国立公园一样尽显秋日的魔力，这里的山坡闪耀着猩红、橙色、黄色和金色的绚丽光彩。公园位于韩国西南部，尤以鲜艳的枫叶色彩闻名，是韩国首屈一指的赏秋胜地之一。其名称意为“山中藏有许多秘密”，体现了这一地区丰富多样的景观。","Image":{"Url":"/th?id=OHR.NaejangsanNP_ZH-CN6538893004_1920x1080.webp","Wallpaper":"/th?id=OHR.NaejangsanNP_ZH-CN6538893004_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"静水映斑斓","Title":"内藏山国立公园的秋景，韩国","Copyright":"© Twenty47studio/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"内藏山于1971年获指定，成为韩国第八座国家公园，其山地景观由此受到国家公园制度保护。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261022_NaejangsanNP\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%86%85%e8%97%8f%e5%b1%b1%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261021_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261022_NaejangsanNP"},"Ssd":"20261022","Name":"NaejangsanNP","Market":"ZH-CN","Hash":"6538893004","FullDateString":"2026 10月 22"},{"ImageContent":{"Description":"阮潢桥弥合了新旧之间的距离，为顺化的天际线增添了一道崭新的纽带。这座横跨越南香江的现代钢拱地标于2025年3月26日通车。其设计名为“鹤望天姥”，灵感源自当地传说和附近的天姥寺。","Image":{"Url":"/th?id=OHR.VietnamBridge_ZH-CN6134321119_1920x1080.webp","Wallpaper":"/th?id=OHR.VietnamBridge_ZH-CN6134321119_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"飞掠河面","Title":"香江上的阮潢桥，顺化，越南","Copyright":"© VU PHAM VAN/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"阮黄桥长约380米、宽43米，设有六条机动车道和两条人行步道。","LinkUrl":"