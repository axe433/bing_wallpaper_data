{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"/rp/2P1v961xAkWrVG1OpTWrB7cXL38.gz.css","Postloaded":false},{"Path":"/rp/ZR1l8rQK_RYSnVi-OrJR2lRbZnY.gz.css","Postloaded":false},{"Path":"/rp/K6xKGnHZEyU5SW5t2WKBxy9hPY0.gz.css","Postloaded":false},{"Path":"/rp/Mj_F7RzA5PKfor_cwwls3CEyIeY.gz.css","Postloaded":false},{"Path":"/rp/hYhZb3rTk3plX-hOqaRO9UgrBOU.gz.css","Postloaded":true},{"Path":"/rp/ZV9dsO3iVMKIOojd34OhXJGrVZE.gz.css","Postloaded":true},{"Path":"/rp/WDeo3sMidMyGDVWwK9TkVeurXTI.gz.css","Postloaded":true},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":true},{"Path":"/rp/C55hud04WRj662Ou8c3t6oJFAE0.gz.css","Postloaded":false},{"Path":"/rp/WDeo3sMidMyGDVWwK9TkVeurXTI.gz.css","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableFeedPositionToggle":false,"EnableNewsAndTrending":true,"EnableUnifiedTobFeedBackplate":true,"EnableUnifiedTobFeedBackplateProdPosition":true,"HideCopilot":true,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-11-26T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"在夏威夷大岛的希洛，水流、阳光与葱郁绿意交汇于彩虹瀑布。威陆库河的河水从80英尺高的熔岩岩壁上奔流而下，落入下方的水潭时激起水雾。晴朗的早晨，阳光照进水雾，便可能映出为瀑布赋名的绚丽彩虹。这座壮观的瀑布在夏威夷语中称为瓦伊阿努埃努埃（Waiānuenue），意为“彩虹之水”；它四周环绕着热带植被，在夏威夷传说中也占有特殊地位。","Image":{"Url":"/th?id=OHR.RFHilo_ZH-CN5962114314_1920x1080.webp","Wallpaper":"/th?id=OHR.RFHilo_ZH-CN5962114314_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"彩虹落下的地方","Title":"怀卢库河上的彩虹瀑布，希洛市，夏威夷州，美国","Copyright":"© Peter Unger/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"根据夏威夷传说，彩虹瀑布下方的洞穴曾是希娜的居所；她是半神毛伊的母亲。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261126_RFHilo\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a4%8f%e5%a8%81%e5%a4%b7%e5%b7%9e%e6%80%80%e5%8d%a2%e5%ba%93%e6%b2%b3%e7%9a%84%e5%bd%a9%e8%99%b9%e7%80%91%e5%b8%83&form=hpcapt&filters=HpDate:\"20261125_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261126_RFHilo"},"Ssd":"20261126","Name":"RFHilo","Market":"ZH-CN","Hash":"5962114314","FullDateString":"2026 11月 26"},{"ImageContent":{"Description":"白雪让布莱斯峡谷国家公园焕然一新：大地披上银装，鲜艳的橙红色石林在雪地上拔地而起。从公园最著名的观景点之一——日落观景点望去，这些奇特的岩石造型属于克拉伦组。构成它们的石灰岩约在5000万年前沉积，后来又经风化和侵蚀塑造成形。由于公园大部分地区海拔超过8000英尺，早在10月就可能降雪。今天的照片中，积雪覆着峡谷的山脊和石柱，薄雾从崖壁间飘过，呈现出美国西南部标志性的冬日景象。","Image":{"Url":"/th?id=OHR.SunsetPoint_ZH-CN5737034685_1920x1080.webp","Wallpaper":"/th?id=OHR.SunsetPoint_ZH-CN5737034685_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"美国西南部的一场雪","Title":"日落观景点，布莱斯峡谷国家公园，犹他州","Copyright":"© Colin D. Young/Alamy","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"在布莱斯峡谷，一年中有超过170个夜晚的气温会跨越冰点。渗入岩缝的水结冰膨胀，帮助将岩石逐渐塑造成石林柱。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261125_SunsetPoint\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b8%83%e8%8e%b1%e6%96%af%e5%b3%a1%e8%b0%b7%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261124_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261125_SunsetPoint"},"Ssd":"20261125","Name":"SunsetPoint","Market":"ZH-CN","Hash":"5737034685","FullDateString":"2026 11月 25"},{"ImageContent":{"Description":"红松鼠是英国唯一的本土松鼠物种，在苏格兰的凯恩戈姆斯国家公园繁衍生息。这座公园是它们的重要庇护地：古老的喀里多尼亚欧洲赤松林和较新形成的针叶林，为松鼠提供了充足的栖息空间和食物，让它们一年四季都能觅食欧洲赤松的种子、坚果和其他美味。今天的照片中，一只红松鼠栖身于橙黄相间的秋叶间，仿佛与苏格兰高地的景色融为一体，正盘算着下一步要去哪里。","Image":{"Url":"/th?id=OHR.CairngormsSquirrel_ZH-CN0941302869_1920x1080.webp","Wallpaper":"/th?id=OHR.CairngormsSquirrel_ZH-CN0941302869_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"秋日的保护色","Title":"红松鼠，凯恩戈姆斯国家公园，苏格兰高地","Copyright":"© Scotland: The Big Picture/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"英国约八成的现存红松鼠生活在苏格兰；它们用树枝交织成巢，内部铺上树叶。这种巢称为“松鼠巢”（drey）。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261124_CairngormsSquirrel\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%ac%a7%e4%ba%9a%e7%ba%a2%e6%9d%be%e9%bc%a0&form=hpcapt&filters=HpDate:\"20261123_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261124_CairngormsSquirrel"},"Ssd":"20261124","Name":"CairngormsSquirrel","Market":"ZH-CN","Hash":"0941302869","FullDateString":"2026 11月 24"},{"ImageContent":{"Description":"今天的图片展示了一片蕨类嫩叶的顶端逐渐卷曲的样子，呼应着自然界随处可见的几何图案。在数学中，斐波那契数列也遵循类似的递进规律：每个数都是前两个数之和，即0、1、1、2、3、5、8，依此类推。今天是斐波那契日；选定这一天，是因为日期11/23中的数字与这一数列相呼应，以此向它致敬。图中的蕨类嫩叶终将随着生长而舒展开来，而在植物世界的其他地方，这一数列还会不断出现在向日葵花盘、松果、多肉植物和菠萝的螺旋排列中。","Image":{"Url":"/th?id=OHR.FibonacciFern_ZH-CN3882237848_1920x1080.webp","Wallpaper":"/th?id=OHR.FibonacciFern_ZH-CN3882237848_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"自然中的几何之美","Title":"蕨类植物的卷曲嫩叶","Copyright":"© Reza Saputra/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"斐波那契数列因一道关于兔子繁殖的13世纪数学题而广为人知。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261123_FibonacciFern\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%96%90%e6%b3%a2%e9%82%a3%e5%a5%91%e6%97%a5&form=hpcapt&filters=HpDate:\"20261122_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261123_FibonacciFern"},"Ssd":"20261123","Name":"FibonacciFern","Market":"ZH-CN","Hash":"3882237848","FullDateString":"2026 11月 23"},{"ImageContent":{"Description":"今天图片中的圣胡斯塔隐修院建于16世纪，坐落在西班牙坎塔布里亚自治区北部崎岖海岸的悬崖间，俯瞰坎塔布连海上翻涌的浪涛。这座小教堂部分嵌入岩石中，与圣胡斯塔与圣鲁菲娜的圣髑有关，后来成为一处朝圣地。它受到庇护的石墙，与四周汹涌的海浪和嶙峋的悬崖形成鲜明对比。","Image":{"Url":"/th?id=OHR.JustaHermitage_ZH-CN3751022621_1920x1080.webp","Wallpaper":"/th?id=OHR.JustaHermitage_ZH-CN3751022621_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海浪间的庇护所","Title":"西班牙坎塔布里亚自治区的圣胡斯塔隐修院与小教堂","Copyright":"© Tramont_ana/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"坎塔布里亚自治区的圣胡斯塔隐修院依崖而建，朝南的门上方有一扇小方窗，为堂内引入光线。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261122_JustaHermitage\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9c%a3%e8%83%a1%e6%96%af%e5%a1%94%e5%b0%8f%e6%95%99%e5%a0%82&form=hpcapt&filters=HpDate:\"20261121_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261122_JustaHermitage"},"Ssd":"20261122","Name":"JustaHermitage","Market":"ZH-CN","Hash":"3751022621","FullDateString":"2026 11月 22"},{"ImageContent":{"Description":"在今天的图片中，尼斯沐浴在温暖的阳光下：赤陶色屋顶、历史悠久的教堂和柔和色调的建筑外墙，拼成法国蔚蓝海岸的一幅斑斓图景。尼斯由古希腊人建立，长期与意大利王室萨伏依王朝有着渊源，并于1860年正式成为法国的一部分。如今，在这座位于法国南部的海滨城市，那段层层叠叠的历史依然随处可见：古老的建筑与蔚蓝的地中海海水、蔚蓝海岸阳光照耀的山丘交相辉映。","Image":{"Url":"/th?id=OHR.RedNice_ZH-CN3518429866_1920x1080.webp","Wallpaper":"/th?id=OHR.RedNice_ZH-CN3518429866_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"陶瓦屋顶下的梦","Title":"法国普罗旺斯-阿尔卑斯-蔚蓝海岸大区尼斯","Copyright":"© Siripong Kaewla-iad/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"1824年，英国游客在尼斯海滨开辟了一条小路，后来逐渐发展为享有盛誉的英国人步行大道（Promenade des Anglais）。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261121_RedNice\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%b3%95%e5%9b%bd%e5%b0%bc%e6%96%af&form=hpcapt&filters=HpDate:\"20261120_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261121_RedNice"},"Ssd":"20261121","Name":"RedNice","Market":"ZH-CN","Hash":"3518429866","FullDateString":"2026 11月 21"},{"ImageContent":{"Description":"在挪威北部特罗姆斯的克瓦尔岛近海，座头鲸穿行于寒冷的北极海水中，寻找一顿丰盛的美餐。冬季，它们追随迁徙的鲱鱼进入峡湾，来到这一地区。座头鲸以气泡网捕食闻名：这种非凡的狩猎技巧是鲸鱼吹出一圈圈气泡，将鱼群围拢，然后张开大嘴向上猛冲，捕获猎物。在今天的图片中，一头座头鲸在柔和的霞光下潜入冰冷的波浪，定格了挪威北部荒野中宁静的一刻。","Image":{"Url":"/th?id=OHR.Megaptera_ZH-CN3361807823_1920x1080.webp","Wallpaper":"/th?id=OHR.Megaptera_ZH-CN3361807823_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"在峡湾中大快朵颐","Title":"正在潜水的座头鲸，挪威北部特罗姆斯的克瓦尔岛","Copyright":"© Espen Bergersen/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"座头鲸尾鳍上的独特斑纹、形状和伤疤，能帮助研究人员识别不同个体，并长期追踪它们的行踪。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261120_Megaptera\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%ba%a7%e5%a4%b4%e9%b2%b8&form=hpcapt&filters=HpDate:\"20261119_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261120_Megaptera"},"Ssd":"20261120","Name":"Megaptera","Market":"ZH-CN","Hash":"3361807823","FullDateString":"2026 11月 20"}],"PreloadMediaContents":[{"ImageContent":{"Description":"在伦滕波尔国家公园深处，孟加拉榕扎下根来。其他树木从地面向上生长，而榕树的种子却由过往的鸟儿播撒，落在树枝、建筑或遗迹上萌发。随后，它们的气生根向地面伸展，逐渐长粗，成为支撑枝条的树干。这样，榕树便能向四周延展，覆盖广阔区域，为野生动物提供果实和栖身之所，也为人们带来荫凉。","Image":{"Url":"/th?id=OHR.FicasBenghalensis_ZH-CN3012138144_1920x1080.webp","Wallpaper":"/th?id=OHR.FicasBenghalensis_ZH-CN3012138144_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"扎根历史","Title":"拱门遗迹上的孟加拉榕，伦滕波尔国家公园，印度","Copyright":"© Vincent Grafhorst/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"孟加拉榕依靠微小的梅森榕小蜂（Eupristina masoni）传粉；除了醒目的气生根，它们还与这种昆虫有着密切的共生关系。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261203_FicasBenghalensis\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%bc%a6%e6%bb%95%e6%b3%a2%e5%b0%94%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261202_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261203_FicasBenghalensis"},"Ssd":"20261203","Name":"FicasBenghalensis","Market":"ZH-CN","Hash":"3012138144","FullDateString":"2026 12月 3"},{"ImageContent":{"Description":"堡垒之城瓦莱塔高踞马耳他海岸，四周雄伟的城墙从地中海边拔地而起。","Image":{"Url":"/th?id=OHR.ValettaSunrise_ZH-CN2806828520_1920x1080.webp","Wallpaper":"/th?id=OHR.ValettaSunrise_ZH-CN2806828520_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"瓦莱塔的黎明","Title":"瓦莱塔历史名城，马耳他","Copyright":"© RudyBalasko/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"尽管瓦莱塔地处多丘陵的半岛，16世纪的军事工程师仍为这座城市规划了整齐的网格状街道。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261202_ValettaSunrise\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%93%a6%e8%8e%b1%e5%a1%94+%e9%a9%ac%e8%80%b3%e4%bb%96&form=hpcapt&filters=HpDate:\"20261201_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261202_ValettaSunrise"},"Ssd":"20261202","Name":"ValettaSunrise","Market":"ZH-CN","Hash":"2806828520","FullDateString":"2026 12月 2"},{"ImageContent":{"Description":"还有谁比这群帝企鹅更适合向我们送上南极洲日的祝福？它们是这片冰封大陆最具代表性的物种之一。人类在这里的活动仅限于科考站和考察任务，而帝企鹅早已学会适应南极洲严酷的气候。浓密的羽毛和厚厚的脂肪层帮它们御寒。这群善于合作的伙伴还懂得分享温暖：它们挤成一团，不断轮换位置，让每只企鹅都有机会待在最暖和的中央。","Image":{"Url":"/th?id=OHR.EmperorAntarctica_ZH-CN2597241765_1920x1080.webp","Wallpaper":"/th?id=OHR.EmperorAntarctica_ZH-CN2597241765_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"帝企鹅的家园","Title":"帝企鹅，毛德皇后地，南极洲","Copyright":"© Stefan Christmann/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"雄性帝企鹅将唯一的一枚蛋放在脚上孵化65至75天，期间禁食，直到雏鸟破壳。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261201_EmperorAntarctica\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%8d%97%e6%9e%81%e6%b4%b2%e6%97%a5&form=hpcapt&filters=HpDate:\"20261130_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261201_EmperorAntarctica"},"Ssd":"20261201","Name":"EmperorAntarctica","Market":"ZH-CN","Hash":"2597241765","FullDateString":"2026 12月 1"},{"ImageContent":{"Description":"圣安德鲁日快乐！值此苏格兰节日，我们来欣赏斯凯岛上一片宛如异世的景观，它由古老的山体滑坡塑造。数百万年前，厚重的熔岩层覆盖在较软的黏土和岩石之上，随后逐渐向海边滑移，在斯凯岛最北端的特罗特尼什半岛留下陡坡、隐秘的高地和嶙峋的岩石。","Image":{"Url":"/th?id=OHR.QuiraingSkye_ZH-CN0793055710_1920x1080.webp","Wallpaper":"/th?id=OHR.QuiraingSkye_ZH-CN0793055710_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"滑移中的斯凯岛","Title":"奎雷英，特罗特尼什半岛，斯凯岛，苏格兰","Copyright":"© Matt Anderson Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"相传圣鲁尔将圣安德鲁的圣物从希腊带到苏格兰，并在如今圣安德鲁斯镇附近遭遇海难。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261130_QuiraingSkye\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%8b%8f%e6%a0%bc%e5%85%b0%e6%96%af%e5%87%af%e5%b2%9b%e7%89%b9%e7%bd%97%e7%89%b9%e5%b0%bc%e4%bb%80%e5%8d%8a%e5%b2%9b&form=hpcapt&filters=HpDate:\"20261129_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261130_QuiraingSkye"},"Ssd":"20261130","Name":"QuiraingSkye","Market":"ZH-CN","Hash":"0793055710","FullDateString":"2026 11月 30"},{"ImageContent":{"Description":"索马若伊大桥在路灯照耀下横跨狭窄的挪威海海峡，是通往同名渔岛的唯一公路。远远望去，白沙滩和碧绿海水或许会让你以为身处热带。但索马若伊岛位于北极圈以北，桥下流淌的是冰冷的海水。","Image":{"Url":"/th?id=OHR.SommaroyBridge_ZH-CN0060105443_1920x1080.webp","Wallpaper":"/th?id=OHR.SommaroyBridge_ZH-CN0060105443_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"掠过海面","Title":"俯瞰挪威特罗姆瑟的索马若伊大桥","Copyright":"© Roberto Moiola/Sysaworld/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"极光的淡绿色光芒来自受激的氧原子；氧原子发出的红光通常出现在大气层更高处。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261129_SommaroyBridge\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b4%a2%e9%a9%ac%e8%8b%a5%e4%bc%8a%e5%b2%9b+%e6%8c%aa%e5%a8%81&form=hpcapt&filters=HpDate:\"20261128_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261129_SommaroyBridge"},"Ssd":"20261129","Name":"SommaroyBridge","Market":"ZH-CN","Hash":"0060105443","FullDateString":"2026 11月 29"},{"ImageContent":{"Description":"从莱特纳公园望去，秋色中的布拉格沿捷克伏尔塔瓦河两岸铺展。照片中，河水穿过历史悠久的老城区和小城区，从前景的马内斯桥下流过。如今，伏尔塔瓦河上横跨着许多美丽的桥梁，但数百年间只有一座查理大桥，即照片中从下往上数第二座桥。1357年，查理四世在位期间，这座桥奠下第一块基石；直到1841年，它都是步行过河的唯一通道。如今，石拱、哥特式桥塔和桥上的雕像吸引大批游客，想拍到好照片，最好黎明时就来。也可以继续走到下一座军团桥，那里人少一些，还能欣赏布拉格国家剧院、布拉格城堡和热闹的查理大桥。","Image":{"Url":"/th?id=OHR.VltavaPrague_ZH-CN9898139716_1920x1080.webp","Wallpaper":"/th?id=OHR.VltavaPrague_ZH-CN9898139716_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"跨越时光的桥梁","Title":"捷克布拉格老城区与伏尔塔瓦河","Copyright":"© Lara_Uhryn/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"布拉格的查理大桥原称石桥或布拉格桥；自1870年起沿用如今的名称。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261128_VltavaPrague\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b8%83%e6%8b%89%e6%a0%bc%e7%9a%84%e6%a1%a5%e6%a2%81&form=hpcapt&filters=HpDate:\"20261127_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261128_VltavaPrague"},"Ssd":"20261128","Name":"VltavaPrague","Market":"ZH-CN","Hash":"9898139716","FullDateString":"2026 11月 28"},{"ImageContent":{"Description":"脸峡谷隐于古老的砂岩地貌之中，是美国犹他州南部鲍威尔湖沿岸96座峡谷之一。许多峡谷远离公路，若非1963年修建格伦峡谷大坝形成的湖水淹入，此前很难抵达。湖水沿溪流和峡谷向上游延伸约186英里（约300公里），你可以乘船、划皮划艇或驾驶摩托艇探索。","Image":{"Url":"/th?id=OHR.FaceCanyon_ZH-CN9505064248_1920x1080.webp","Wallpaper":"/th?id=OHR.FaceCanyon_ZH-CN9