{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"/rp/2P1v961xAkWrVG1OpTWrB7cXL38.gz.css","Postloaded":false},{"Path":"/rp/_8elqa9Kpc5HbdBlvRKkpnSPeFA.gz.css","Postloaded":false},{"Path":"/rp/v-XCA5xwjvVzQ0P62S1BCFnh-m0.gz.css","Postloaded":false},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":false},{"Path":"/rp/hYhZb3rTk3plX-hOqaRO9UgrBOU.gz.css","Postloaded":true},{"Path":"/rp/myXek4IvVkMpXSVAQAwsjywJcQ8.gz.css","Postloaded":true},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":true},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":true},{"Path":"/rp/C55hud04WRj662Ou8c3t6oJFAE0.gz.css","Postloaded":false},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableFeedPositionToggle":false,"EnableNewsAndTrending":false,"EnableUnifiedTobFeedBackplate":true,"EnableUnifiedTobFeedBackplateProdPosition":true,"HideCopilot":true,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-10-31T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"忘了烟雾机吧。德国法兰克福有更能烘托气氛的景物：一座哥特式大教堂，塔楼仿佛随时能上演一场午夜招魂会。画面中的圣巴尔多禄茂教堂有着中世纪风格的轮廓，简直像是万圣节特意挑选的布景。不过，这个节日本身的历史更加离奇。","Image":{"Url":"/th?id=OHR.FrankfurtHalloween_ZH-CN5998782698_1920x1080.webp","Wallpaper":"/th?id=OHR.FrankfurtHalloween_ZH-CN5998782698_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"往昔帝国的幽影","Title":"圣巴尔多禄茂教堂，法兰克福，德国","Copyright":"© AlxeyPnferov/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"1562年至1792年，神圣罗马帝国的当选皇帝曾在法兰克福的圣巴尔多禄茂教堂举行加冕仪式。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261031_FrankfurtHalloween\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%87%e5%9c%a3%e8%8a%82&form=hpcapt&filters=HpDate:\"20261030_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261031_FrankfurtHalloween"},"Ssd":"20261031","Name":"FrankfurtHalloween","Market":"ZH-CN","Hash":"5998782698","FullDateString":"2026 10月 31"},{"ImageContent":{"Description":"冬天为新墨西哥州的博斯克德尔阿帕奇国家野生动物保护区带来熟悉的节奏。沙丘鹤陆续飞来，湿地聚满鸟儿，这片区域成为季节性野生动物的聚集地。这座占地57,331英亩的保护区成立于1939年，旨在为迁徙的水鸟提供受保护的中途栖息地。如今，这里的湿地、田野和水道全年滋养着野生动物。画面中的沙丘鹤尤其是保护区冬季的标志性身影。","Image":{"Url":"/th?id=OHR.AutumnCranes_ZH-CN5772055404_1920x1080.webp","Wallpaper":"/th?id=OHR.AutumnCranes_ZH-CN5772055404_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"展翅高飞的时节","Title":"沙丘鹤，博斯克德尔阿帕奇国家野生动物保护区，新墨西哥州，美国","Copyright":"© Terry St.Louis/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"西班牙语“Bosque del Apache”意为“阿帕奇人的树林”，得名于曾在里奥格兰德河沿岸树林扎营的阿帕奇人。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261030_AutumnCranes\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%b2%99%e4%b8%98%e9%b9%a4&form=hpcapt&filters=HpDate:\"20261029_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261030_AutumnCranes"},"Ssd":"20261030","Name":"AutumnCranes","Market":"ZH-CN","Hash":"5772055404","FullDateString":"2026 10月 30"},{"ImageContent":{"Description":"晨雾在英格兰威尔特郡埃夫伯里的立石间飘荡，眼前景象仿佛超越了时间。这些古老的巨石构成了世界上最非凡的史前景观之一，其核心是一座约建于4500年前的宏大新石器时代纪念性建筑。埃夫伯里拥有世界上最大的史前石圈，还有一座巨型环形遗址，以及延伸至周围乡野的石列大道。它与附近的锡尔伯里山、西肯尼特大道等遗迹共同组成一处规模宏大的新石器时代遗址群，令一代又一代游客、研究人员和考古学家为之着迷。","Image":{"Url":"/th?id=OHR.AveburyStones_ZH-CN9127100951_1920x1080.webp","Wallpaper":"/th?id=OHR.AveburyStones_ZH-CN9127100951_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"薄雾邂逅千年时光","Title":"立石，埃夫伯里，威尔特郡，英格兰","Copyright":"© George W Johnson/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"20世纪30年代，考古学家亚历山大·凯勒重新竖起了许多倒伏的埃夫伯里巨石，并用混凝土标出缺失巨石的位置。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261029_AveburyStones\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a8%81%e5%b0%94%e7%89%b9%e9%83%a1%e5%9f%83%e5%a4%ab%e4%bc%af%e9%87%8c%e7%8e%af%e5%bd%a2%e9%81%97%e5%9d%80&form=hpcapt&filters=HpDate:\"20261028_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261029_AveburyStones"},"Ssd":"20261029","Name":"AveburyStones","Market":"ZH-CN","Hash":"9127100951","FullDateString":"2026 10月 29"},{"ImageContent":{"Description":"这些城墙会讲述怎样的故事？库涅季采山城堡高踞于捷克波希米亚东部，见证了数百年的历史。城堡的历史可追溯至14世纪末，后来逐渐发展为一座宏伟的要塞和贵族宅邸。它地势高耸，可俯瞰周围乡野，也因此成为一处重要据点。","Image":{"Url":"/th?id=OHR.KuneticeCastle_ZH-CN8895858920_1920x1080.webp","Wallpaper":"/th?id=OHR.KuneticeCastle_ZH-CN8895858920_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"历史守望之地","Title":"库涅季采山城堡，波希米亚，捷克","Copyright":"© Marek Saroch/Alamy","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"1645年，一支瑞典军队攻占库涅季采山城堡，并在撤离前将其焚毁，加速了城堡此后的长期衰败。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261028_KuneticeCastle\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%ba%93%e6%b6%85%e5%ad%a3%e9%87%87%e5%b1%b1%e5%9f%8e%e5%a0%a1&form=hpcapt&filters=HpDate:\"20261027_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261028_KuneticeCastle"},"Ssd":"20261028","Name":"KuneticeCastle","Market":"ZH-CN","Hash":"8895858920","FullDateString":"2026 10月 28"},{"ImageContent":{"Description":"这片池杉林倒映在平静的水面上，在落日余晖中熠熠生辉，呈现出色彩与对称之美，令人叹为观止。池杉原产于美国东南部，通常生长在浅水池塘、洼地和湿地生境中。这张照片拍摄于乔治亚州，当地的奥克弗诺基沼泽及其他低洼湿地中均可见这些树木。","Image":{"Url":"/th?id=OHR.PondCypress_ZH-CN9472607734_1920x1080.webp","Wallpaper":"/th?id=OHR.PondCypress_ZH-CN9472607734_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"大自然的金色明镜","Title":"秋叶缤纷的池杉林，乔治亚州，美国","Copyright":"© Chris Moore/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"池杉会长出被称为“膝根”的瘤状根部结构，高出树木周围的水面或土壤。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261027_PondCypress\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%b1%a0%e6%9d%89&form=hpcapt&filters=HpDate:\"20261026_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261027_PondCypress"},"Ssd":"20261027","Name":"PondCypress","Market":"ZH-CN","Hash":"9472607734","FullDateString":"2026 10月 27"},{"ImageContent":{"Description":"在保加利亚的西罗多彼山脉，秋叶汇聚在奔腾的西托沃瀑布旁。瀑布位于普罗夫迪夫西南方向的西托沃村附近，从一座古老石桥下倾泻而下；桥拱如画框般圈住飞瀑，宛若童话书中的场景。覆满苔藓的石头和松树为秋日景观添上层层绿意，落叶则堆积在水边，或漂过一汪汪水潭。雨后和春季融雪期间，瀑布尤其奔涌欢腾，湍急水声回荡在周围的林地间。","Image":{"Url":"/th?id=OHR.SitovoWaterfall_ZH-CN8495214046_1920x1080.webp","Wallpaper":"/th?id=OHR.SitovoWaterfall_ZH-CN8495214046_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"大自然的秋日乐章","Title":"秋日瀑布，西托沃附近，普罗夫迪夫州，保加利亚","Copyright":"© Nadya85/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"西罗多彼山脉被认定为关键生物多样性区域，这是对全球生物多样性至关重要地点的一项全球认定。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261026_SitovoWaterfall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%bf%9d%e5%8a%a0%e5%88%a9%e4%ba%9a%e6%99%ae%e7%bd%97%e5%a4%ab%e8%bf%aa%e5%a4%ab%e8%a5%bf%e6%89%98%e6%b2%83&form=hpcapt&filters=HpDate:\"20261025_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261026_SitovoWaterfall"},"Ssd":"20261026","Name":"SitovoWaterfall","Market":"ZH-CN","Hash":"8495214046","FullDateString":"2026 10月 26"},{"ImageContent":{"Description":"夜幕降临加拿大艾伯塔省的贾斯珀国家公园时，群山便有了全新的背景。该公园于2011年被指定为暗夜天空保护区，面积超过11,000平方千米，并采取了减少光污染的措施。在这里，繁星、行星和银河系联袂上演天幕奇观，让游客不由得仰望天空。晨光到来后，视线又从头顶的天空转向脚下的景致。","Image":{"Url":"/th?id=OHR.MaligneFest_ZH-CN8343066766_1920x1080.webp","Wallpaper":"/th?id=OHR.MaligneFest_ZH-CN8343066766_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"群峰与宁静相遇之地","Title":"玛琳湖，贾斯珀国家公园，艾伯塔省，加拿大","Copyright":"© Andrey Popov/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"据加拿大公园管理局介绍，精灵岛距玛琳湖北岸14公里，只能乘船抵达。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261025_MaligneFest\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%8e%9b%e7%90%b3%e6%b9%96&form=hpcapt&filters=HpDate:\"20261024_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261025_MaligneFest"},"Ssd":"20261025","Name":"MaligneFest","Market":"ZH-CN","Hash":"8343066766","FullDateString":"2026 10月 25"}],"PreloadMediaContents":[{"ImageContent":{"Description":"再艰难的环境，也挡不住野牛吃草的脚步。美国全国野牛日赞颂这种北美哺乳动物：它体重可达2000磅(约907千克)，奔跑时速却能达到35英里(约56千米)。这个节日定在每年11月的第一个星期六，旨在向2016年成为美国国家哺乳动物的野牛致敬。","Image":{"Url":"/th?id=OHR.DakotaBison_ZH-CN2302503868_1920x1080.webp","Wallpaper":"/th?id=OHR.DakotaBison_ZH-CN2302503868_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"归来的草原巨兽","Title":"草原上的一头野牛，西奥多·罗斯福国家公园，北达科他州，美国","Copyright":"© Tandem Stock/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"野牛在泥土中打滚形成的浅坑可能积水，为草原植物和动物提供栖息地。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261107_DakotaBison\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%be%8e%e6%b4%b2%e9%87%8e%e7%89%9b&form=hpcapt&filters=HpDate:\"20261106_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261107_DakotaBison"},"Ssd":"20261107","Name":"DakotaBison","Market":"ZH-CN","Hash":"2302503868","FullDateString":"2026 11月 7"},{"ImageContent":{"Description":"火山、雨林和竹林？毛伊岛上的哈莱亚卡拉国家公园三者兼有。公园的范围从毛伊岛上海拔10023英尺的山顶一直延伸到海岸，保护着随海拔、降雨量和气温变化而呈现迥异面貌的景观。它于1916年作为夏威夷国家公园的一部分设立，1961年成为独立的国家公园。哈莱阿卡拉意为“太阳之家”，这一名称呼应了夏威夷口述传说“moʻolelo”中毛伊捉住太阳、延长白昼的故事。","Image":{"Url":"/th?id=OHR.PipiwaiTrail_ZH-CN1811194311_1920x1080.webp","Wallpaper":"/th?id=OHR.PipiwaiTrail_ZH-CN1811194311_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"穿越毛伊岛的绿色隧道","Title":"竹林，皮皮维小径，哈莱亚卡拉国家公园，毛伊岛，夏威夷州，美国","Copyright":"© MNStudio/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"前往哈莱阿卡拉山顶观赏日出的游客须提前预约；名额最多提前60天开放。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261106_PipiwaiTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%93%88%e8%8e%b1%e4%ba%9a%e5%8d%a1%e6%8b%89%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20261105_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261106_PipiwaiTrail"},"Ssd":"20261106","Name":"PipiwaiTrail","Market":"ZH-CN","Hash":"1811194311","FullDateString":"2026 11月 6"},{"ImageContent":{"Description":"在安徽省宣城，人们划船穿过色彩斑斓的落羽杉林。秋天将这片被水淹没的林地变成由琥珀色、铜色和深铁锈色交织而成的锦绣景致。落羽杉的学名是“Taxodium distichum”，它在针叶树中颇为特别：每年秋季，柔软如羽毛的针叶会先变成红褐色，然后脱落。在北美洲，落羽杉因能生长在沼泽、河漫滩等湿地环境而闻名，常长出称为“膝状根”的瘤状根部突起，露出周围的泥土和水面。","Image":{"Url":"/th?id=OHR.StileCrossing_ZH-CN8034992776_1920x1080.webp","Wallpaper":"/th?id=OHR.StileCrossing_ZH-CN8034992776_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"泛舟如画秋林","Title":"五彩落羽杉间划船的人们，宣城，安徽省，中国","Copyright":"© Jackal Pan/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"落羽杉木材耐腐朽，历史上曾被用于制作木桶、铁路枕木和屋顶木瓦。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261105_StileCrossing\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%90%bd%e7%be%bd%e6%9d%89&form=hpcapt&filters=HpDate:\"20261104_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261105_StileCrossing"},"Ssd":"20261105","Name":"StileCrossing","Market":"ZH-CN","Hash":"8034992776","FullDateString":"2026 11月 5"},{"ImageContent":{"Description":"在安徽省宣城，人们划船穿过色彩斑斓的落羽杉林。秋天将这片被水淹没的林地变成由琥珀色、铜色和深铁锈色交织而成的锦绣景致。落羽杉的学名是“Taxodium distichum”，它在针叶树中颇为特别：每年秋季，柔软如羽毛的针叶会先变成红褐色，然后脱落。在北美洲，落羽杉因能生长在沼泽、河漫滩等湿地环境而闻名，常长出称为“膝状根”的瘤状根部突起，露出周围的泥土和水面。","Image":{"Url":"/th?id=OHR.AutumnChina_ZH-CN7665959692_1920x1080.webp","Wallpaper":"/th?id=OHR.AutumnChina_ZH-CN7665959692_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"泛舟如画秋林","Title":"五彩落羽杉间划船的人们，宣城，安徽省，中国","Copyright":"© Jackal Pan/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"落羽杉木材耐腐朽，历史上曾被用于制作木桶、铁路枕木和屋顶木瓦。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261104_AutumnChina\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%90%bd%e7%be%bd%e6%9d%89&form=hpcapt&filters=HpDate:\"20261103_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261104_AutumnChina"},"Ssd":"20261104","Name":"AutumnChina","Market":"ZH-CN","Hash":"7665959692","FullDateString":"2026 11月 4"},{"ImageContent":{"Description":"布莱埃斯湖坐落在意大利北部南蒂罗尔的多洛米蒂山脉，海拔近1500米。湖泊四周森林环绕，法内斯-塞内斯-布莱埃斯湖自然公园的壮丽群峰耸立其间，以动人的碧绿和湛蓝湖水闻名。一条3.5公里长的步道环绕湖岸，游客也可以乘坐传统木质划艇，从另一种视角欣赏风光。这里还是多条山间徒步路线的起点，包括多洛米蒂山脉著名的多洛米蒂高山步道1号。","Image":{"Url":"/th?id=OHR.AlpineBraies_ZH-CN7307997866_1920x1080.webp","Wallpaper":"/th?id=OHR.AlpineBraies_ZH-CN7307997866_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"群峰间的宁静","Title":"布莱埃斯湖，法内斯-塞内斯-布莱埃斯湖自然公园，多洛米蒂山脉，意大利","Copyright":"© leonid_tit/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"布莱埃斯湖最深处达36米，平均水深约17米。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261103_AlpineBraies\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a4%9a%e6%b4%9b%e7%b1%b3%e8%92%82%e5%b1%b1%e8%84%89&form=hpcapt&filters=HpDate:\"20261102_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261103_AlpineBraies"},"Ssd":"20261103","Name":"AlpineBraies","Market":"ZH-CN","Hash":"7307997866","FullDateString":"2026 11月 3"},{"ImageContent":{"Description":"11月也许让我们离节日季又近了一步，但北极熊有别的打算。它们聚集在加拿大马尼托巴省的哈得孙湾沿岸，等待海冰形成，以便重返冰面捕猎海豹。每年上演的这一幕催生了在11月第一周举行的北极熊周，以庆祝北极地区体型最大的陆生捕食者。北极熊是游泳健将、捕猎高手，也极其适应地球上最严酷的环境之一。然而，海冰不断缩减，意味着许多北极熊不得不在陆地上待更久，觅食更加困难，与人类相遇的风险也随之上升。","Image":{"Url":"/th?id=OHR.HudsonBear_ZH-CN6630706907_1920x1080.webp","Wallpaper":"/th?id=OHR.HudsonBear_ZH-CN6630706907_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"写在冰上的未来","Title":"北极熊和幼崽，哈得孙湾畔，马尼托巴省，加拿大","Copyright":"© Danita Delimont/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"为了寻找食物和合适的海冰，北极熊在一个季节里可能跋涉超过620英里。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261102_HudsonBear\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%8c%97%e6%9e%81%e7%86%8a%e5%91%a8&form=hpcapt&filters=HpDate:\"20261101_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261102_HudsonBear"},"Ssd":"20261102","Name":"HudsonBear","Market":"ZH-CN","Hash":"6630706907","FullDateString":"2026 11月 2"},{"ImageContent":{"Description":"今天，我们一起欣赏笼罩在黑森林上空的朦胧景色。黑森林绵延约160公里，横跨德国西南部，汇集了葱郁的山丘、幽深的山谷、湖泊和迷人的小镇。最高峰费尔德贝格山海拔1,493米；多瑙河和内卡河也发源于黑森林。这里同样不乏历史与传统。林业长期以来在当地占据重要地位，而延续数百年的钟表制造传统，更让别具特色的布谷鸟钟名扬德国以外。","Image":{"Url":"/th?id=OHR.SchwarzwaldAutumn_ZH-CN6323627599_1920x1080.webp","Wallpaper":"/th?id=OHR.SchwarzwaldAutumn_ZH-CN6323627599_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"林间迷雾","Title":"黑森林，巴登-符腾堡州，德国","Copyright":"© Britus/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":"