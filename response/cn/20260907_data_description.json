{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"/rp/9TkriH4GrVU3NK_oe63DAH_S4SQ.gz.css","Postloaded":false},{"Path":"/rp/fqeK6XvzgUe0xDTGK14KOsHsONA.gz.css","Postloaded":true},{"Path":"/rp/kRvQpUFDGnZ-qIQ0Bl0qAksxajE.gz.css","Postloaded":true},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":true},{"Path":"/rp/vYhrUWJwQuxFDxb-DJDTggEaBl4.gz.css","Postloaded":true},{"Path":"/rp/C55hud04WRj662Ou8c3t6oJFAE0.gz.css","Postloaded":false},{"Path":"/rp/MxZtC0CoIiRG3MJQlo26LVxmnBs.gz.css","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableHPV2ScrollBg":false,"EnableHPV2HeaderGrad":false,"EnableHPV2NoCopilot":false,"HideCopilot":false,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-07T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"班贝格老市政厅高踞于雷格尼茨河上，是德国班贝格最具代表性的地标之一。当地传说称，这座建筑之所以矗立在人工岛上，是因为城里的主教拒绝向市民提供修建市政厅的土地。据说居民于是自行在河中央造出一块地基，成就了这座建筑非凡的环境和历久弥新的魅力。","Image":{"Url":"/th?id=OHR.BambergTownhall_ZH-CN1407954732_1920x1080.webp","Wallpaper":"/th?id=OHR.BambergTownhall_ZH-CN1407954732_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"历史沿运河流淌之地","Title":"老市政厅，班贝格，德国","Copyright":"© SCStock/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"班贝格老市政厅内设路德维希收藏馆，收藏来自重要制造中心的巴洛克时期彩陶和瓷器。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260907_BambergTownhall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%8f%ad%e8%b4%9d%e6%a0%bc&form=hpcapt&filters=HpDate:\"20260906_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260907_BambergTownhall"},"Ssd":"20260907","Name":"BambergTownhall","Market":"ZH-CN","Hash":"1407954732","FullDateString":"2026 9月 7"},{"ImageContent":{"Description":"乍看之下，今天的画面更像一片被淹没的林地，而不是湖泊。光秃的树干从水中伸出，倒影横贯水面，远处的格兰屏群山熠熠生辉。这里是菲安斯湖，一座位于澳大利亚维多利亚州格兰屏（加里维德）国家公园边缘的人工水库。这里深受划船者、垂钓者、帆船爱好者和滑水者欢迎，也为人们提供了欣赏澳大利亚最壮美景观之一的绝佳前排视角。","Image":{"Url":"/th?id=OHR.LakeFyans_ZH-CN1067187791_1920x1080.webp","Wallpaper":"/th?id=OHR.LakeFyans_ZH-CN1067187791_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"倒影满湖的水库","Title":"菲安斯湖，格兰屏国家公园，维多利亚州，澳大利亚","Copyright":"© tracielouise/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"菲安斯湖为阿勒山、斯托尔和大西部镇供水，并服务于部分协议供水用户。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260906_LakeFyans\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%be%b3%e5%a4%a7%e5%88%a9%e4%ba%9a%e7%bb%b4%e5%a4%9a%e5%88%a9%e4%ba%9a%e5%b7%9e%e6%a0%bc%e5%85%b0%e5%b1%8f%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20260905_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260906_LakeFyans"},"Ssd":"20260906","Name":"LakeFyans","Market":"ZH-CN","Hash":"1067187791","FullDateString":"2026 9月 6"},{"ImageContent":{"Description":"全国蜂鸟日旨在赞颂自然界中最非凡的空中飞行专家。蜂鸟仅分布于美洲，这些小鸟能够原地悬停、向后飞行，翅膀每秒可拍动数十次。它们为寻找花蜜而造访花朵时，也充当重要的传粉者，帮助维系从高山草甸到热带雨林的各种生态系统。闪耀的羽毛、非凡的敏捷性和高能耗的生活方式，使它们成为世界上最迷人的鸟类之一。","Image":{"Url":"/th?id=OHR.GreenCrowned_ZH-CN0697075036_1920x1080.webp","Wallpaper":"/th?id=OHR.GreenCrowned_ZH-CN0697075036_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"小小鸟儿，巨大影响","Title":"龙虾爪花上取食的绿顶辉蜂鸟，哥斯达黎加","Copyright":"© Paul Hobson/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"蜂鸟的新陈代谢率在所有脊椎动物中最高，可能每10分钟就要进食一次。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260905_GreenCrowned\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%85%a8%e5%9b%bd%e8%9c%82%e9%b8%9f%e6%97%a5&form=hpcapt&filters=HpDate:\"20260904_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260905_GreenCrowned"},"Ssd":"20260905","Name":"GreenCrowned","Market":"ZH-CN","Hash":"0697075036","FullDateString":"2026 9月 5"},{"ImageContent":{"Description":"韦斯特黑弗桑德灯塔高耸于德国北海沿岸的盐沼之上，凭借醒目的红白条纹一眼便可辨认。灯塔建于1906年至1908年间，一个多世纪以来一直是艾德施泰特半岛的标志，为穿行北海水域的船只指引航向。如今，它仍是德国北部最著名的海岸地标之一。登上157级台阶的游客，可以饱览周围的壮阔景色。","Image":{"Url":"/th?id=OHR.Westerheversand_ZH-CN0517707643_1920x1080.webp","Wallpaper":"/th?id=OHR.Westerheversand_ZH-CN0517707643_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"地平线上的红与白","Title":"韦斯特黑弗的韦斯特黑弗桑德灯塔，石勒苏益格-荷尔斯泰因州，德国","Copyright":"© bluejayphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"韦斯特黑弗桑德灯塔是一座40米高的铸铁塔，左右两侧各有一座造型对称的原守塔人住宅。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260904_Westerheversand\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e9%9f%a6%e6%96%af%e7%89%b9%e9%bb%91%e5%bc%97%e6%a1%91%e5%be%b7%e7%81%af%e5%a1%94&form=hpcapt&filters=HpDate:\"20260903_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260904_Westerheversand"},"Ssd":"20260904","Name":"Westerheversand","Market":"ZH-CN","Hash":"0517707643","FullDateString":"2026 9月 4"},{"ImageContent":{"Description":"波浪通常属于海洋。但在亚利桑那州北部，它们却从沙漠中涌起。郊狼丘是朱红悬崖国家纪念区的一部分，其盘旋起伏的砂岩地貌由远古沙丘和数百万年的侵蚀共同塑造而成，造就了一片即使静止不动也仿佛泛着涟漪的景观。","Image":{"Url":"/th?id=OHR.AZWilderness_ZH-CN2664566131_1920x1080.webp","Wallpaper":"/th?id=OHR.AZWilderness_ZH-CN2664566131_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"一部守护荒野的法案","Title":"郊狼丘，朱红悬崖国家纪念区，亚利桑那州，美国","Copyright":"© James Hager/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"《荒野法》通常禁止在指定荒野地区修建永久性道路或开展商业活动。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260903_AZWilderness\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%9c%b1%e7%ba%a2%e6%82%ac%e5%b4%96%e5%9b%bd%e5%ae%b6%e7%ba%aa%e5%bf%b5%e5%8c%ba&form=hpcapt&filters=HpDate:\"20260902_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260903_AZWilderness"},"Ssd":"20260903","Name":"AZWilderness","Market":"ZH-CN","Hash":"2664566131","FullDateString":"2026 9月 3"},{"ImageContent":{"Description":"在英格兰东海岸，萨福克遗产海岸融合了风吹不息的石南荒原、湿地、砾石海滩和开阔的北海景观。索思沃尔德是这里最著名的城镇之一，水域与历史在此密不可分。小镇几乎被大海、布莱斯河和周围的湿地环绕，坐落在一片狭长的半岛上；数百年来的渔业、贸易和临水生活共同塑造了这里。","Image":{"Url":"/th?id=OHR.SuffolkHuts_ZH-CN2463818981_1920x1080.webp","Wallpaper":"/th?id=OHR.SuffolkHuts_ZH-CN2463818981_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海岸边的缤纷色彩","Title":"传统海滩小屋，索思沃尔德，萨福克遗产海岸，英格兰","Copyright":"© stevendocwra/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"索思沃尔德灯塔于1890年9月3日投入使用，如今其灯光射程可达24海里。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260902_SuffolkHuts\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%90%a8%e7%a6%8f%e5%85%8b%e9%83%a1%e7%b4%a2%e6%96%af%e6%b2%83%e5%b0%94%e5%be%b7&form=hpcapt&filters=HpDate:\"20260901_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260902_SuffolkHuts"},"Ssd":"20260902","Name":"SuffolkHuts","Market":"ZH-CN","Hash":"2463818981","FullDateString":"2026 9月 2"},{"ImageContent":{"Description":"九月的全国蘑菇月旨在赞颂一个常常不为人注意的世界。在森林地表、草坪和落叶下方，真菌网络循环利用养分，帮助生态系统蓬勃发展。我们看到的蘑菇只是这些隐秘生物的子实体，它们短暂现身释放孢子，随后又从视野中消失。它们并非植物；真菌自成一界，并在大自然的循环中发挥着至关重要的作用。","Image":{"Url":"/th?id=OHR.HorseHairShroom_ZH-CN2241458451_1920x1080.webp","Wallpaper":"/th?id=OHR.HorseHairShroom_ZH-CN2241458451_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"脚下的世界","Title":"马鬃小皮伞，白俄罗斯","Copyright":"© Máté/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"宾夕法尼亚州东南部的肯尼特广场享誉全球，被誉为“世界蘑菇之都”。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260901_HorseHairShroom\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e9%a9%ac%e9%ac%83%e5%b0%8f%e7%9a%ae%e4%bc%9e&form=hpcapt&filters=HpDate:\"20260831_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260901_HorseHairShroom"},"Ssd":"20260901","Name":"HorseHairShroom","Market":"ZH-CN","Hash":"2241458451","FullDateString":"2026 9月 1"}],"PreloadMediaContents":[{"ImageContent":{"Description":"在今天的画面中，中国大地上铺展着绿色与深红色的地肤。地肤原产于欧亚大陆部分地区，19世纪末作为观赏植物和制作扫帚的材料来源被引入美国。它耐旱、耐热、耐盐碱土壤和少雨环境的能力，帮助其扩散至美国大平原及美国西部大部分地区。","Image":{"Url":"/th?id=OHR.KochiaChina_ZH-CN4719995421_1920x1080.webp","Wallpaper":"/th?id=OHR.KochiaChina_ZH-CN4719995421_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"坚韧在此扎根","Title":"地肤田，中国","Copyright":"© lingqi xie/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"地肤属于苋科，与甜菜、菠菜和藜麦有植物学上的亲缘关系。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260914_KochiaChina\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9c%b0%e8%82%a4&form=hpcapt&filters=HpDate:\"20260913_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260914_KochiaChina"},"Ssd":"20260914","Name":"KochiaChina","Market":"ZH-CN","Hash":"4719995421","FullDateString":"2026 9月 14"},{"ImageContent":{"Description":"画面捕捉了意大利东北部威尼托大区米苏里纳群峰日出时的锯齿状天际线。前往附近三峰山的游客，往往本为那条著名路线而来，却发现自己的目光被米苏里纳群峰吸引。作为多洛米蒂山脉的一部分，这些针状山峰最高处超过9,300英尺，仿佛专为营造戏剧效果而雕琢。出人意料的是，它们最初是古老的珊瑚礁。","Image":{"Url":"/th?id=OHR.MisurinaPeak_ZH-CN3877105161_1920x1080.webp","Wallpaper":"/th?id=OHR.MisurinaPeak_ZH-CN3877105161_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"高处的珊瑚礁","Title":"米苏里纳群峰，多洛米蒂山脉，威尼托大区，意大利","Copyright":"© Vithun Khamsong/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"联合国教科文组织的多洛米蒂山脉遗产地由九个组成部分构成，其中有18座海拔超过3000米的山峰。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260913_MisurinaPeak\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a4%9a%e6%b4%9b%e7%b1%b3%e8%92%82%e5%b1%b1%e8%84%89%e7%b1%b3%e8%8b%8f%e9%87%8c%e7%ba%b3%e7%be%a4%e5%b3%b0&form=hpcapt&filters=HpDate:\"20260912_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260913_MisurinaPeak"},"Ssd":"20260913","Name":"MisurinaPeak","Market":"ZH-CN","Hash":"3877105161","FullDateString":"2026 9月 13"},{"ImageContent":{"Description":"加州海狮在场时，海滩上的一天很少会安静。洪亮的吠叫、顽皮的个性，再加上抢尽风头的本领，让这些海洋哺乳动物深谙如何上演一场好戏。","Image":{"Url":"/th?id=OHR.SardineBait_ZH-CN3256234033_1920x1080.webp","Wallpaper":"/th?id=OHR.SardineBait_ZH-CN3256234033_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海浪与海岸的高手","Title":"墨西哥近海围猎沙丁鱼饵球的加州海狮，太平洋","Copyright":"© Henley Spiers/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"它们能潜至1,000英尺深处，并可屏息长达10分钟。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260912_SardineBait\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%8a%a0%e5%b7%9e%e6%b5%b7%e7%8b%ae&form=hpcapt&filters=HpDate:\"20260911_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260912_SardineBait"},"Ssd":"20260912","Name":"SardineBait","Market":"ZH-CN","Hash":"3256234033","FullDateString":"2026 9月 12"},{"ImageContent":{"Description":"九月，法国里维埃拉沐浴在更柔和的光线中，地中海植被也逐渐恢复生机。山丘间弥漫着阿勒颇松、迷迭香和野百里香的芳香。内陆地区，百年橄榄树和山顶村庄讲述着一个由希腊、罗马和普罗旺斯影响共同塑造的故事。","Image":{"Url":"/th?id=OHR.FrenchRivieraVillage_ZH-CN2888811422_1920x1080.webp","Wallpaper":"/th?id=OHR.FrenchRivieraVillage_ZH-CN2888811422_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"地中海风情尽显","Title":"滨海自由城，法国里维埃拉，法国","Copyright":"© StockByM/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"滨海自由城的圣埃尔姆城堡奉萨伏依公爵埃马努埃莱·菲利贝托之命，于1557年建成，用于加强海岸防御。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260911_FrenchRivieraVillage\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%bb%a8%e6%b5%b7%e8%87%aa%e7%94%b1%e5%9f%8e&form=hpcapt&filters=HpDate:\"20260910_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260911_FrenchRivieraVillage"},"Ssd":"20260911","Name":"FrenchRivieraVillage","Market":"ZH-CN","Hash":"2888811422","FullDateString":"2026 9月 11"},{"ImageContent":{"Description":"你是否想过，安达卢西亚为何是西班牙最著名的地区之一？弗拉门戈、塔帕斯、摩尔式建筑和广阔的橄榄林都功不可没。在那些名城之外，还有奥尔韦拉这样的历史古镇。这座村庄被200多万棵橄榄树环绕，作为战略边境聚落发展而来，并在数百年的变迁中成形。奥尔韦拉城堡依然俯瞰着全镇，下方的化身圣母教堂则主导着天际线。前往拉西利亚文化中心，可以了解奥尔韦拉的中世纪历史与传统。","Image":{"Url":"/th?id=OHR.Olvera_ZH-CN2727093856_1920x1080.webp","Wallpaper":"/th?id=OHR.Olvera_ZH-CN2727093856_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"俯瞰大地拼图","Title":"奥尔韦拉航拍图，安达卢西亚，西班牙","Copyright":"© Marco Bottigelli/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"奥尔韦拉的摩尔式城堡建于12世纪末，坐落在海拔约623米的高处。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260910_Olvera\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%a5%bf%e7%8f%ad%e7%89%99%e5%ae%89%e8%be%be%e5%8d%a2%e8%a5%bf%e4%ba%9a%e5%a4%a7%e5%8c%ba%e5%a5%a5%e5%b0%94%e9%9f%a6%e6%8b%89&form=hpcapt&filters=HpDate:\"20260909_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260910_Olvera"},"Ssd":"20260910","Name":"Olvera","Market":"ZH-CN","Hash":"2727093856","FullDateString":"2026 9月 10"},{"ImageContent":{"Description":"提到印度南部，人们常会想到香料贸易路线、古典音乐、民间舞蹈，以及数百年来连接印度与世界的海岸线。沿着这条海岸向西进入卡纳塔克邦，便会抵达安科拉附近一处更宁静的停靠点：加比特凯尼海滩。这里的生活围绕阿拉伯海展开，渔船在黎明前出海，载着当天的渔获归来。","Image":{"Url":"/th?id=OHR.GabitKeni_ZH-CN2314122948_1920x1080.webp","Wallpaper":"/th?id=OHR.GabitKeni_ZH-CN2314122948_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"印度西海岸的生活","Title":"安科拉附近的加比特凯尼海滩，卡纳塔克邦，印度","Copyright":"© Amith Nag Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"安科拉主要种植的卡里伊沙德芒果于2023年获得地理标志（GI）认证。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260909_GabitKeni\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%8d%b0%e5%ba%a6%e5%8d%a1%e7%ba%b3%e5%a1%94%e5%85%8b%e9%82%a6%e5%ae%89%e7%a7%91%e6%8b%89&form=hpcapt&filters=HpDate:\"20260908_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260909_GabitKeni"},"Ssd":"20260909","Name":"GabitKeni","Market":"ZH-CN","Hash":"2314122948","FullDateString":"2026 9月 9"},{"ImageContent":{"Description":"在汉普郡东米恩附近的金色田野中，一棵山毛榉独自挺立，成为英格兰南唐斯国家公园起伏景观中的醒目焦点。数百年来，农业塑造着这些白垩丘陵；时至今日，耕作仍是该地区的重要组成部分。当地排水良好的白垩土壤支撑着大规模旱作农业，其中小麦和大麦是最常见的作物。整个夏季，作物在田间逐渐成熟，随后收获季将乡野变成金色田块与麦茬交织的拼图。","Image":{"Url":"/th?id=OHR.BeechEngland_ZH-CN1807343872_1920x1080.webp","Wallpaper":"/th?id=OHR.BeechEngland_ZH-CN1807343872_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"金色田野","Title":"东米恩南唐斯国家公园谷物田中的山毛榉树，汉普郡，英格兰","Copyright":"© Guy Edwardes/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"米恩河发源于东米恩村中心以南约一英里处，向前流淌约21英里后汇入索伦特海峡。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260908_BeechEngland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%8b%b1%e6%a0%bc%e5%85%b0%e6%b1%89%e6%99%ae%e9%83%a1&form=hpcapt&filters=HpDate:\"20260907_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20