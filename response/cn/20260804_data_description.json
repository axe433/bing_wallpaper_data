{"IsEnSearch":false,"EnableEnSearchSwitchTab":true,"Scripts":[{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2oj1ghqIss6hVFHavfOBXoLDKpE.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true},{"Path":"/rp/2jmj7l5rSw0yVb_vlWAYkK_YBwk.gz.js","Postloaded":true}],"Styles":[{"Path":"https://r.bing.com/rb/2E/cir3,cc,nc/62LADVHxQPW7NT_OJuZbSiwjv0g.css?bu=CfQB9wGYAqcCmwKbApsCmwLnAg&or=w","Postloaded":false},{"Path":"https://r.bing.com/rs/2E/7t/cir3,cc,nc/CUCSI1SFeWrmYnIaftq0iQdznqQ.css?or=w","Postloaded":true},{"Path":"https://r.bing.com/rb/2E/cir3,cc,nc/_S_hO16T1q81cdlQu_gFOlk1pfg.css?bu=CJcDmwKbAuECtwKbApsCmwI&or=w","Postloaded":true},{"Path":"https://r.bing.com/rs/2E/66/cc,nc/pZ5R_tJWe7QpulmAzB8Jp71qd-o.css?or=w","Postloaded":true},{"Path":"https://r.bing.com/rb/2E/cir3,cc,nc/zmTB4hEk3xeY-WDa-Zn8LizFCcg.css?bu=AvQCggM&or=w","Postloaded":false},{"Path":"https://r.bing.com/rs/2E/66/cc,nc/pZ5R_tJWe7QpulmAzB8Jp71qd-o.css?or=w","Postloaded":false}],"EnableTrendingOnBingBelowSearchbox":true,"HasTrendingOnBingClose":false,"EnableTrendingOnbingCNRefresh":true,"EnableHPSBHover2":true,"EnableNTPLikeBorder":false,"EnableNTPLikeShadow":false,"EnableASSearchButton":false,"HPSearchButtonNewStr":false,"EnableInlineSB":false,"EnableExpandedSB":true,"EnableEntireClick":true,"GLikeSB":false,"EnableHPPinSB":false,"EnableInPrivateInlineSB":false,"EnableLargerSB":true,"EnableHPV2":false,"EnableHPV2Search":false,"EnableHPV2Portal":false,"EnableHPV2PortalFullScreen":false,"EnableHPV2ScrollBg":false,"EnableHPV2HeaderGrad":false,"EnableHPV2NoCopilot":false,"EnableRubyFeed":false,"EnableInfiniteNav":false,"CustomFields":null,"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-08-04T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"除了南极洲，猫头鹰的足迹遍及各大洲；它们以朝向正前方的双眼、能汇聚声波的扁平脸盘以及敏锐独特的听觉而著称。许多猫头鹰拥有边缘柔软的羽毛，这使它们能够近乎无声地进行捕猎。由于眼球在眼窝内无法转动，它们依靠灵活的颈部来观察周围环境。从森林到沙漠，猫头鹰栖息于多种多样的环境中，在维持生态系统平衡方面发挥着重要作用。","Image":{"Url":"/th?id=OHR.AdorableOwlet_ZH-CN6929234033_1920x1080.webp","Wallpaper":"/th?id=OHR.AdorableOwlet_ZH-CN6929234033_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"呼呼，太棒了！","Title":"佛罗里达穴鸮幼鸟，开普科拉尔，佛罗里达州，美国","Copyright":"© mlorenzphotography/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"猫头鹰能将头部旋转多达270度，以弥补其眼睛在眼窝中无法转动的缺陷。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260804_AdorableOwlet\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%8c%ab%e5%a4%b4%e9%b9%b0&form=hpcapt&filters=HpDate:\"20260803_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260804_AdorableOwlet"},"Ssd":"20260804","Name":"AdorableOwlet","Market":"ZH-CN","Hash":"6929234033","FullDateString":"2026 8月 4"},{"ImageContent":{"Description":"色彩斑斓的“卢祖”（luzzu）——即马耳他的传统渔船——停满了马萨什洛克（Marsaxlokk）那避风港湾的水面；这座村庄坐落于马耳他东南沿海，距离首都瓦莱塔仅需短途车程。作为该国主要的渔业中心之一，这里的生活节奏始终与大海的律动保持着和谐的步调。村庄约有4000名居民，并以其充满活力的滨海区域而闻名——尤其是广受欢迎的周日鱼市，以及每天清晨满载新鲜渔获归来的船只。","Image":{"Url":"/th?id=OHR.BoatsMalta_ZH-CN4708255775_1920x1080.webp","Wallpaper":"/th?id=OHR.BoatsMalta_ZH-CN4708255775_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"色彩鲜艳的船只，历久弥新的传统","Title":"马尔萨什洛克港口五彩斑斓的渔船，马耳他","Copyright":"© Klubovy/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"鲁佐（Luzzu）渔船船头绘制的双眼被称为“荷鲁斯之眼”或“奥西里斯之眼”，这一传统源自古腓尼基和古埃及，代代相传，旨在驱散恶灵并为渔民带来好运。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260803_BoatsMalta\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e9%a9%ac%e8%80%b3%e4%bb%96%e9%a9%ac%e5%b0%94%e8%90%a8%e4%bb%80%e6%b4%9b%e5%85%8b&form=hpcapt&filters=HpDate:\"20260802_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260803_BoatsMalta"},"Ssd":"20260803","Name":"BoatsMalta","Market":"ZH-CN","Hash":"4708255775","FullDateString":"2026 8月 3"},{"ImageContent":{"Description":"色彩斑斓的“卢祖”（luzzu）——即马耳他的传统渔船——停满了马萨什洛克（Marsaxlokk）那避风港湾的水面；这座村庄坐落于马耳他东南沿海，距离首都瓦莱塔仅需短途车程。作为该国主要的渔业中心之一，这里的生活节奏始终与大海的律动保持着和谐的步调。村庄约有4000名居民，并以其充满活力的滨海区域而闻名——尤其是广受欢迎的周日鱼市，以及每天清晨满载新鲜渔获归来的船只。","Image":{"Url":"/th?id=OHR.HelsinkiBlue_ZH-CN3961551568_1920x1080.webp","Wallpaper":"/th?id=OHR.HelsinkiBlue_ZH-CN3961551568_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"色彩鲜艳的船只，历久弥新的传统","Title":"马尔萨什洛克港口五彩斑斓的渔船，马耳他","Copyright":"© Klubovy/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"鲁佐（Luzzu）渔船船头绘制的双眼被称为“荷鲁斯之眼”或“奥西里斯之眼”，这一传统源自古腓尼基和古埃及，代代相传，旨在驱散恶灵并为渔民带来好运。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260802_HelsinkiBlue\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e9%a9%ac%e8%80%b3%e4%bb%96%e9%a9%ac%e5%b0%94%e8%90%a8%e4%bb%80%e6%b4%9b%e5%85%8b&form=hpcapt&filters=HpDate:\"20260801_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260802_HelsinkiBlue"},"Ssd":"20260802","Name":"HelsinkiBlue","Market":"ZH-CN","Hash":"3961551568","FullDateString":"2026 8月 2"},{"ImageContent":{"Description":"大多数地貌的演变历时数千年，而火山却能在短短数小时内重塑地貌——在夏威夷大岛，这一过程至今仍在持续。为了保护这一不断变化的环境及其所蕴含的科学与自然价值，夏威夷火山国家公园于1916年8月1日正式成立。一个多世纪以来，该公园一直致力于保护这片占地超过35万英亩的区域，其中包括火山地貌、原生森林以及各类珍稀野生动植物。","Image":{"Url":"/th?id=OHR.HawaiiLava_ZH-CN3257621771_1920x1080.webp","Wallpaper":"/th?id=OHR.HawaiiLava_ZH-CN3257621771_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"基拉韦厄火山的威力","Title":"大批熔岩流涌入大洋，大岛，夏威夷州，美国","Copyright":"© Ken McCurdy/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"当温度高达约1093摄氏度的熔岩与冰冷的太平洋海水相遇时，会产生被称为“熔岩雾霭”的剧烈化学反应，形成包含盐酸烟雾和微小火山玻璃颗粒的有害气云。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260801_HawaiiLava\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a4%8f%e5%a8%81%e5%a4%b7%e7%81%ab%e5%b1%b1%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20260731_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260801_HawaiiLava"},"Ssd":"20260801","Name":"HawaiiLava","Market":"ZH-CN","Hash":"3257621771","FullDateString":"2026 8月 1"},{"ImageContent":{"Description":"有些铁路会退出历史舞台，而“弗吉尼亚爬山虎步道”则实现了华丽转身。这条步道全长34.3英里，横贯弗吉尼亚州西南部，沿用了一条昔日的铁路线——该线路曾用于在阿巴拉契亚山脉间运输木材和铁矿石。步道那独特的名字，源自20世纪初那些在陡峭坡道上艰难爬行的蒸汽机车。","Image":{"Url":"/th?id=OHR.VirginiaTrail_ZH-CN2299501599_1920x1080.webp","Wallpaper":"/th?id=OHR.VirginiaTrail_ZH-CN2299501599_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"穿越时光的足迹","Title":"鸟瞰弗吉尼亚爬山虎步道，达马斯克斯，弗吉尼亚州，美国","Copyright":"© Eifel Kreutz/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"这条步道的英文名字“Virginia creeper”（弗吉尼亚爬山虎）具有双重寓意：一是指沿铁轨茂盛生长的当地原生五叶爬山虎植物，二是指20世纪初蒸汽机车在攀爬陡峭山坡时如蜗牛爬行般缓慢的行驶速度。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260731_VirginiaTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%bc%97%e5%90%89%e5%b0%bc%e4%ba%9a%e7%88%ac%e5%b1%b1%e8%99%8e%e6%ad%a5%e9%81%93&form=hpcapt&filters=HpDate:\"20260730_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260731_VirginiaTrail"},"Ssd":"20260731","Name":"VirginiaTrail","Market":"ZH-CN","Hash":"2299501599","FullDateString":"2026 7月 31"},{"ImageContent":{"Description":"在纳瓦霍族保留地，亚利桑那州与犹他州交界处，美国，有些景观举世闻名，而纪念碑谷则堪称传奇。这一沙漠奇观横跨州界，其地貌由高耸的砂岩孤峰塑造而成，这些孤峰从谷底拔地而起，高度可达1000英尺。在纳瓦霍语中，该地区被称为 Tsé Bii' Ndzisgaii（意为“岩石之谷”），它将壮丽的地质构造与鲜活的民族文化完美融合。","Image":{"Url":"/th?id=OHR.NavajoNation_ZH-CN9274387505_1920x1080.webp","Wallpaper":"/th?id=OHR.NavajoNation_ZH-CN9274387505_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"旷野无声，活态传承之境","Title":"在纳瓦霍族保留地的纪念碑谷，亚利桑那州，美国","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"阿甘结束其跨国长跑的著名地点位于163号美国国道，这里拥有俯瞰山谷的最具标志性视野，在纪念碑谷，纳瓦霍族保留地，美国。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260730_NavajoNation\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%ba%aa%e5%bf%b5%e7%a2%91%e8%b0%b7&form=hpcapt&filters=HpDate:\"20260729_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260730_NavajoNation"},"Ssd":"20260730","Name":"NavajoNation","Market":"ZH-CN","Hash":"9274387505","FullDateString":"2026 7月 30"},{"ImageContent":{"Description":"在全球老虎日这一天，这群孟加拉虎迈着自信的步伐走过印度，拉贾斯坦邦，兰坦博尔国家公园，展现出顶级掠食者对自身在食物链中地位的精准认知。孟加拉虎兼具隐蔽性与力量：成年个体的体长从鼻尖到尾端可超过10英尺，体重约500磅，行走时却能悄无声息。在视觉可见度是一把“双刃剑”的自然生境中，它们的斑纹发挥了关键作用，通过复杂的图案模式在环境中进行伪装，使猎物难以辨识其身形。","Image":{"Url":"/th?id=OHR.TigerFamily_ZH-CN9064744163_1920x1080.webp","Wallpaper":"/th?id=OHR.TigerFamily_ZH-CN9064744163_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"虎啸归来，锐爪重临","Title":"孟加拉虎一家在兰坦博尔国家公园，拉贾斯坦邦，印度","Copyright":"© Archna Singh/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"老虎是卓越的游泳者，经常通过泡水来降温，这在大多数猫科动物中极为罕见，在兰坦博尔国家公园，拉贾斯坦邦，印度。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260729_TigerFamily\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%85%a8%e7%90%83%e8%80%81%e8%99%8e%e6%97%a5&form=hpcapt&filters=HpDate:\"20260728_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260729_TigerFamily"},"Ssd":"20260729","Name":"TigerFamily","Market":"ZH-CN","Hash":"9064744163","FullDateString":"2026 7月 29"}],"PreloadMediaContents":[{"ImageContent":{"Description":"哥本哈根新港运河是一条标志性水道，鲜艳色彩与深厚历史在此交融。它于17世纪70年代在克里斯蒂安五世统治时期挖建，曾是重要门户，货船可由此将货物直接卸入城市中心。远在成为今天明信片般完美的地标之前，这座港口曾以粗犷闻名：水手云集、酒馆喧闹，与色彩明快的山墙联排屋并立。","Image":{"Url":"/th?id=OHR.ColorfulCop_ZH-CN8015611442_1920x1080.webp","Wallpaper":"/th?id=OHR.ColorfulCop_ZH-CN8015611442_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"绚丽多彩的哥本哈根","Title":"哥本哈根新港运河沿岸的彩色房屋，首都大区，丹麦","Copyright":"© emicristea/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"汉斯·克里斯蒂安·安徒生一生中曾在新港的18号、20号和67号三个不同地址居住。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260811_ColorfulCop\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%93%a5%e6%9c%ac%e5%93%88%e6%a0%b9%e6%96%b0%e6%b8%af%e8%bf%90%e6%b2%b3&form=hpcapt&filters=HpDate:\"20260810_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260811_ColorfulCop"},"Ssd":"20260811","Name":"ColorfulCop","Market":"ZH-CN","Hash":"8015611442","FullDateString":"2026 8月 11"},{"ImageContent":{"Description":"两片大沙漠交汇之处，约书亚树国家公园展现出由风、时间和极端环境塑造的冷峻迷人景观。在南加利福尼亚州，海拔较高的莫哈韦沙漠与更炎热、地势更低的科罗拉多沙漠相融，形成独特的生态系统组合与非凡的生物多样性。","Image":{"Url":"/th?id=OHR.SandPath_ZH-CN7820825668_1920x1080.webp","Wallpaper":"/th?id=OHR.SandPath_ZH-CN7820825668_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"两片沙漠交汇之地","Title":"约书亚树国家公园，加利福尼亚州，美国","Copyright":"© JJ Landscapes/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"约书亚树地区的二长花岗岩最初是熔融岩体，在一亿多年前于地下冷却形成。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260810_SandPath\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%ba%a6%e4%b9%a6%e4%ba%9a%e6%a0%91%e5%9b%bd%e5%ae%b6%e5%85%ac%e5%9b%ad&form=hpcapt&filters=HpDate:\"20260809_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260810_SandPath"},"Ssd":"20260810","Name":"SandPath","Market":"ZH-CN","Hash":"7820825668","FullDateString":"2026 8月 10"},{"ImageContent":{"Description":"今天，世界土著人民国际日邀请我们更深入地了解那些历史远早于文字记载的社群。联合国于1994年设立这一纪念日，并于1995年首次举行活动；日期所纪念的是1982年一次致力于保护全球土著人民权利的重要会议。如今，约90个国家生活着超过4.76亿土著人民，他们延续着数千种文化，也传承着全球约7,000种语言中的大多数。","Image":{"Url":"/th?id=OHR.JMTjibaou_ZH-CN6992670356_1920x1080.webp","Wallpaper":"/th?id=OHR.JMTjibaou_ZH-CN6992670356_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"身份认同的建筑表达","Title":"让-马里·吉巴乌文化中心，新喀里多尼亚","Copyright":"© Fabien Astre/Alamy","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"文化中心的十座高耸“构筑体”高度各异，其中最高的一座在新喀里多尼亚的景观中高达28米。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260809_JMTjibaou\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e5%9c%9f%e8%91%97%e4%ba%ba%e6%b0%91%e5%9b%bd%e9%99%85%e6%97%a5&form=hpcapt&filters=HpDate:\"20260808_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260809_JMTjibaou"},"Ssd":"20260809","Name":"JMTjibaou","Market":"ZH-CN","Hash":"6992670356","FullDateString":"2026 8月 9"},{"ImageContent":{"Description":"8月8日，国际无限日让好奇心成为主角。这项庆祝活动的灵感来自横置的数字8——象征永无止境的无限符号。纽约哲学家让-皮埃尔·阿迪·费尼奥于1987年创立这一节日，邀请每个人通过科学、艺术和想象力探索宏大理念。它不只关乎数学，也关乎从浩瀚宇宙到人类创造力边界的种种可能。","Image":{"Url":"/th?id=OHR.StocktonInfinity_ZH-CN5941379745_1920x1080.webp","Wallpaper":"/th?id=OHR.StocktonInfinity_ZH-CN5941379745_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"迈向无限","Title":"蒂斯河畔斯托克顿无限桥，英格兰","Copyright":"© Bahadir Yeniceri/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"由于无法设置中央桥墩，无限桥采用不等高系杆拱和倒置鞍形结构，为180米长的桥身增强刚度。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260808_StocktonInfinity\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%99%85%e6%97%a0%e9%99%90%e6%97%a5&form=hpcapt&filters=HpDate:\"20260807_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260808_StocktonInfinity"},"Ssd":"20260808","Name":"StocktonInfinity","Market":"ZH-CN","Hash":"5941379745","FullDateString":"2026 8月 8"},{"ImageContent":{"Description":"每年的8月7日是“全国灯塔日”，这一节日旨在颂扬那些数百年来指引船只安全航行于美国沿海的灯塔。这一日期是为了纪念乔治·华盛顿总统签署生效的《1789年灯塔法案》。","Image":{"Url":"/th?id=OHR.LimeKiln_ZH-CN5664152522_1920x1080.webp","Wallpaper":"/th?id=OHR.LimeKiln_ZH-CN5664152522_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"指引船只穿越历史","Title":"圣胡安岛石灰窑灯塔，华盛顿州，美国","Copyright":"© Edmund Lowe Photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"石灰窑点州立公园被认为是全球最佳的陆基观鲸地点之一，因为这里的海岸水深急剧下降，使得虎鲸群能够游至非常靠近岩石绝壁的海域。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260807_LimeKiln\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%9f%b3%e7%81%b0%e7%aa%91%e7%81%af%e5%a1%94&form=hpcapt&filters=HpDate:\"20260806_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260807_LimeKiln"},"Ssd":"20260807","Name":"LimeKiln","Market":"ZH-CN","Hash":"5664152522","FullDateString":"2026 8月 7"},{"ImageContent":{"Description":"在肯尼亚的马赛马拉，大地仿佛在移动。成群结队的角马——这种拥有极强耐力的蹄类食草动物——在季节性降雨滋润出的鲜嫩青草与水源的吸引下，浩浩荡荡地迁徙着。","Image":{"Url":"/th?id=OHR.MaraCrossing_ZH-CN8816902094_1920x1080.webp","Wallpaper":"/th?id=OHR.MaraCrossing_ZH-CN8816902094_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"生死渡口，勇者的史诗","Title":"马赛马拉迁徙的角马群横渡马拉河, 肯尼亚","Copyright":"© Manoj Shah/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"成年角马体重可达600磅，属于体型较大的食草性羚羊。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260806_MaraCrossing\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%a7%92%e9%a9%ac&form=hpcapt&filters=HpDate:\"20260805_1600\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260806_MaraCrossing"},"Ssd":"20260806","Name":"MaraCrossing","Market":"ZH-CN","Hash":"8816902094","FullDateString":"2026 8月 6"},{"ImageContent":{"Description":"在摩洛哥的非斯，被称为“达尔·马赫赞”的王宫自13世纪以来一直是权力的中心；当时，摩洛哥的统治者围绕它建立了一座设防的皇城。其高墙之内，花园、庭院、清真寺和皇家住所错落分布于广阔的建筑群中，且至今仍供国王使用，使其既是历史古迹，又是仍在运作的活跃宫廷。","Image":{"Url":"/th?id=OHR.FezMorocco_ZH-CN7662339428_1920x1080.webp","Wallpaper":"/th?id=OHR.FezMorocco_ZH-CN7662339428_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"秘境之门，匠心传世","Title":"非斯皇宫装饰华丽的大门，摩洛哥","Copyright":"© cgst26/Shutterstock","Social