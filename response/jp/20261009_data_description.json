{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-10-09T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"フランス・コルシカ島の沖合に浮かぶサンギネール諸島。4 つの小さな島で構成された群島で、近隣の街アジャクシオからは、島の荒々しい岩肌と透明度の高い海が織りなす景観を眺めることができます。各島には海鳥や地中海特有の植物が生息しており、その自然環境保護のため、基本的に立ち入れるのは最も大きな島であるメズ・マレ島のみです。メズ・マレ島には、灯台が設置されているほか、遊歩道も整備されており、島の散策を楽しむことができます。","Image":{"Url":"/th?id=OHR.IlesSanguinaires_JA-JP1377358410_1920x1080.webp","Wallpaper":"/th?id=OHR.IlesSanguinaires_JA-JP1377358410_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"コルシカ島を彩る美しい夕日","Title":"サンギネール諸島, フランス","Copyright":"© Francesco Riccardo Iacomino/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.88166,8.59779/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=41.88166,8.59779;S9;サンギネール諸島, フランス&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261009_IlesSanguinaires%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261009_IlesSanguinaires\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b5%e3%83%b3%e3%82%ae%e3%83%8d%e3%83%bc%e3%83%ab%e8%ab%b8%e5%b3%b6&form=hpcapt&filters=HpDate:\"20261008_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261009_IlesSanguinaires"},"Ssd":"20261009","Name":"IlesSanguinaires","Market":"JA-JP","Hash":"1377358410","FullDateString":"2026 年 10月 月 9 日"},{"ImageContent":{"Description":"今日 10 月 8 日は二十四節気の寒露。朝晩の冷え込みが増し、秋の深まりを感じる頃です。秋は「食欲の秋」ともいわれるように、栗やしいたけ、秋サバなどさまざまな食べ物が旬を迎えます。そして画像は、秋の味覚の代表格である栗。栗は、実は定義によって野菜にも果物にも木の実にも分類される食材です。その歴史は古く、縄文時代の遺跡からも見つかっており、太古の昔から私たちの食生活に関わっていました。現在も、栗ご飯や甘露煮のほか、モンブランや渋皮煮などさまざまな料理や菓子に利用され、秋の食卓を彩っています。","Image":{"Url":"/th?id=OHR.Chestnut2026_JA-JP0900389061_1920x1080.webp","Wallpaper":"/th?id=OHR.Chestnut2026_JA-JP0900389061_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は寒露","Title":"栗の実","Copyright":"© y-studio/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"栗には 100g あたり約 33mg のビタミン C が含まれており、トマトの約 2 倍です。さらに、加熱しても壊れにくいです。","LinkUrl":"/search?q=%e6%a0%97%e3%81%ae%e3%83%93%e3%82%bf%e3%83%9f%e3%83%b3C%e3%81%8c%e5%8a%a0%e7%86%b1%e3%81%97%e3%81%a6%e3%82%82%e5%a3%8a%e3%82%8c%e3%81%ab%e3%81%8f%e3%81%84%e7%90%86%e7%94%b1%e3%81%af%ef%bc%9f&form=hpvsfa","LinkText":"栗のビタミンCが加熱しても壊れにくい理由は？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261008_Chestnut2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%af%92%e9%9c%b2&form=hpcapt&filters=HpDate:\"20261007_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261008_Chestnut2026"},"Ssd":"20261008","Name":"Chestnut2026","Market":"JA-JP","Hash":"0900389061","FullDateString":"2026 年 10月 月 8 日"},{"ImageContent":{"Description":"ここはパズルウッド。イングランドのグロスターシャー州にある「ディーンの森」に広がる古代森林地帯です。苔むした岩や「スカウル」と呼ばれる独特の地形で知られています。不規則で迷路状な窪みが特徴のスカウルは、数百万年にわたり、石灰岩にできた地下洞窟が隆起や浸食によって地表に現れることで形成されました。その後、鉄器時代からローマ時代にかけて、鉄鉱石の採掘に利用されたと考えられています。森の中には、約 1.6km の小道が張り巡らされ、奇岩や洞窟、古木が織りなす幻想的な景観が広がります。その神秘的な雰囲気から、「スター・ウォーズ／フォースの覚醒」をはじめ、さまざまな映画のロケ地としても使用されています。","Image":{"Url":"/th?id=OHR.ForestofDean_JA-JP0675230191_1920x1080.webp","Wallpaper":"/th?id=OHR.ForestofDean_JA-JP0675230191_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"苔むした森","Title":"パズルウッド, イングランド","Copyright":"© Fulcanelli_AOS/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/51.812183,-2.516615/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=51.812183,-2.516615;S9;ディーンの森のパズルウッド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261007_ForestofDean%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261007_ForestofDean\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%87%e3%82%a3%e3%83%bc%e3%83%b3%e3%81%ae%e6%a3%ae%e3%81%ae%e3%83%91%e3%82%ba%e3%83%ab%e3%82%a6%e3%83%83%e3%83%89&form=hpcapt&filters=HpDate:\"20261006_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261007_ForestofDean"},"Ssd":"20261007","Name":"ForestofDean","Market":"JA-JP","Hash":"0675230191","FullDateString":"2026 年 10月 月 7 日"},{"ImageContent":{"Description":"今日 10 月 6 日は国際ジオダイバーシティデー。鉱物や岩石、土壌など、非生物の自然の多様性について理解を深めることを目的にユネスコ総会が制定しました。そして、今日の画像は中国甘粛省の張掖国家地質公園に広がる丹霞地形です。色鮮やかな地層が重なり、虹のような独特の景観をつくり出しています。こうした色彩には、岩石に含まれる鉄などの鉱物が関係しています。さらに、長い年月にわたる地殻変動や風雨による侵食が加わることで、現在の壮大な地形が形成されました。公園は、地球の歴史と多様な地形の価値が認められ、2020 年にユネスコ世界ジオパークに認定されました。","Image":{"Url":"/th?id=OHR.DanxiaLandform_JA-JP9811731742_1920x1080.webp","Wallpaper":"/th?id=OHR.DanxiaLandform_JA-JP9811731742_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際ジオダイバーシティデー","Title":"張掖国家地質公園, 中国","Copyright":"© Weiquan Lin/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.966774,100.04408/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=38.966774,100.04408;S9;張掖国家地質公園, 中国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261006_DanxiaLandform%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261006_DanxiaLandform\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%9a%9b%e3%82%b8%e3%82%aa%e3%83%80%e3%82%a4%e3%83%90%e3%83%bc%e3%82%b7%e3%83%86%e3%82%a3%e3%83%87%e3%83%bc&form=hpcapt&filters=HpDate:\"20261005_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261006_DanxiaLandform"},"Ssd":"20261006","Name":"DanxiaLandform","Market":"JA-JP","Hash":"9811731742","FullDateString":"2026 年 10月 月 6 日"},{"ImageContent":{"Description":"今日の画像は、南極大陸周辺に生息するアデリーペンギンのグループ。アデリーペンギンは、体長 60 ～ 70cm、体重約 5kg という中型のペンギンです。海中を時速約 14kmで泳ぎ回りながら、餌を捕まえたり、捕食者から逃れたりします。地上の雪原を移動する際は、他のペンギン同様腹ばいになって氷上を滑って移動することがあります。この移動方法は「トボガン」と呼ばれており、北米の先住民が用いていたソリを意味する言葉にちなんで名づけられました。","Image":{"Url":"/th?id=OHR.AdelieTeacher_JA-JP9090254921_1920x1080.webp","Wallpaper":"/th?id=OHR.AdelieTeacher_JA-JP9090254921_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海へ飛び込もうとするペンギンたち","Title":"アデリーペンギンのグループ, 南極大陸","Copyright":"© Otto Plantema/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"ペンギンには歯がありません。","LinkUrl":"/search?q=%e3%83%9a%e3%83%b3%e3%82%ae%e3%83%b3%e3%81%ae%e5%8f%a3%e3%81%ae%e4%b8%ad%e3%81%ab%e3%81%82%e3%82%8b%e3%81%a8%e3%81%92%e7%8a%b6%e3%81%ae%e7%aa%81%e8%b5%b7%e3%81%ab%e3%81%af%e3%81%a9%e3%82%93%e3%81%aa%e5%bd%b9%e5%89%b2%e3%81%8c%e3%81%82%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"ペンギンの口の中にあるとげ状の突起にはどんな役割がある？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261005_AdelieTeacher\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%87%e3%83%aa%e3%83%bc%e3%83%9a%e3%83%b3%e3%82%ae%e3%83%b3&form=hpcapt&filters=HpDate:\"20261004_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261005_AdelieTeacher"},"Ssd":"20261005","Name":"AdelieTeacher","Market":"JA-JP","Hash":"9090254921","FullDateString":"2026 年 10月 月 5 日"},{"ImageContent":{"Description":"今日、10 月 4 日から 10 月 10 日までは、世界宇宙週間です。毎年テーマが定められており、今年のテーマは「ロケット革命」。そして、画像は米国フロリダ州のケネディ宇宙センターで打ち上げられたアルテミス I のロケットです。2022 年 11 月 16 日、NASA はアルテミス I ミッションとしてオリオン宇宙船を打ち上げました。これは、将来の有人月面探査に向けたシステムの安全性と信頼性を検証するための無人飛行試験でした。オリオン宇宙船は地球から約 43 万 km に到達し、月を周回する遠方逆行軌道を飛行した後、約 25 日間にわたるミッションを完了しました。","Image":{"Url":"/th?id=OHR.ArtemisRocket_JA-JP8925094178_1920x1080.webp","Wallpaper":"/th?id=OHR.ArtemisRocket_JA-JP8925094178_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"今日から世界宇宙週間","Title":"アルテミス I のロケット, 米国 フロリダ州","Copyright":"© EVA MARIE UZCATEGUI/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/28.522254,-80.68167/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=28.522254,-80.68167;S9;ケネディ宇宙センター, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261004_ArtemisRocket%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261004_ArtemisRocket\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e5%ae%87%e5%ae%99%e9%80%b1%e9%96%93&form=hpcapt&filters=HpDate:\"20261003_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261004_ArtemisRocket"},"Ssd":"20261004","Name":"ArtemisRocket","Market":"JA-JP","Hash":"8925094178","FullDateString":"2026 年 10月 月 4 日"},{"ImageContent":{"Description":"今日の画像は、アンモナイトの化石。アンモナイトは、約 4 億年前から 6600 万年前まで海に生息していた海洋軟体動物です。殻の内部が複数の部屋に分かれているなど、現生のオウムガイ類と似た特徴を持っていますが、イカやタコなどを含むグループにより近いと考えられています。多くの種類に見られる特徴的な螺旋形の殻から、古代生物の代表的な化石として広く知られています。また、世界各地で化石が発見されており、地層の年代決定や先史時代の海洋環境の研究に活用されています。","Image":{"Url":"/th?id=OHR.AmmoniteFossils_JA-JP8778940090_1920x1080.webp","Wallpaper":"/th?id=OHR.AmmoniteFossils_JA-JP8778940090_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"古代の海に生息していた動物の化石","Title":"アンモナイトの化石","Copyright":"© J Nemchinova/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"化石とは、過去の生物の体や活動の痕跡が長い時間を経て自然に保存されたものです。アンモナイトの殻もその一種です。","LinkUrl":"/search?q=%e5%8c%96%e7%9f%b3%e3%81%ab%e3%81%af%e3%81%a9%e3%81%ae%e3%82%88%e3%81%86%e3%81%aa%e3%82%82%e3%81%ae%e3%81%8c%e3%81%82%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"化石にはどのようなものがある？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261003_AmmoniteFossils\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%b3%e3%83%a2%e3%83%8a%e3%82%a4%e3%83%88&form=hpcapt&filters=HpDate:\"20261002_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261003_AmmoniteFossils"},"Ssd":"20261003","Name":"AmmoniteFossils","Market":"JA-JP","Hash":"8778940090","FullDateString":"2026 年 10月 月 3 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"今日の画像は、米国コロラド州南西部、サンファン山地にそびえるスネフェル山。標高約 4,300m を誇るロッキー山脈の名峰です。コロラド州には標高 14,000 フィート（約 4,267m ）以上の山が 58 座あり、これらは総称して「フォーティーナーズ (Fourteeners) 」と呼ばれています。スネフェル山はその中でも特に人気が高く、その美しい山容から、写真の被写体としても人気があります。秋には山麓に黄金色のアスペン林が広がり、雪をいただいた山頂との美しいコントラストが訪れる人々を魅了します。","Image":{"Url":"/th?id=OHR.SneffelsAutumn_JA-JP1327078827_1920x1080.webp","Wallpaper":"/th?id=OHR.SneffelsAutumn_JA-JP1327078827_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"黄金色の森の先にそびえる山","Title":"スネフェル山, 米国 コロラド州","Copyright":"© lightphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.00354,-107.792695/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=38.00354,-107.792695;S9;スネフェル山, 米国 コロラド州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261016_SneffelsAutumn%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261016_SneffelsAutumn\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b9%e3%83%8d%e3%83%95%e3%82%a7%e3%83%ab%e5%b1%b1+%e3%82%b3%e3%83%ad%e3%83%a9%e3%83%89%e5%b7%9e&form=hpcapt&filters=HpDate:\"20261015_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261016_SneffelsAutumn"},"Ssd":"20261016","Name":"SneffelsAutumn","Market":"JA-JP","Hash":"1327078827","FullDateString":"2026 年 10月 月 16 日"},{"ImageContent":{"Description":"夕暮れ時になると、ヴロツワフの歴史ある街並みが黄金色の光に包まれます。ポーランド南西部に位置するこの都市は、同国で最も古い都市の一つです。100 以上の橋で結ばれた水の都として知られ、中世の面影と現代の活気が調和しています。中心部には、13 世紀に開かれたリネク広場と旧市庁舎があり、多くの人でにぎわいます。画像は、聖マリア・マグダレーナ教会の「魔女の橋」から望んだ眺めです。旧市街や広場を一望でき、やわらかな灯りに照らされた街の幻想的な美しさを楽しむことができます。","Image":{"Url":"/th?id=OHR.WroclawPoland_JA-JP4298283472_1920x1080.webp","Wallpaper":"/th?id=OHR.WroclawPoland_JA-JP4298283472_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"黄金色に輝く旧市街","Title":"ヴロツワフ, ポーランド","Copyright":"© Piotr Mitelski/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/51.10977,17.034634/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=51.10977,17.034634;S9;ヴロツワフ, ポーランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261015_WroclawPoland%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261015_WroclawPoland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%b4%e3%83%ad%e3%83%84%e3%83%af%e3%83%95&form=hpcapt&filters=HpDate:\"20261014_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261015_WroclawPoland"},"Ssd":"20261015","Name":"WroclawPoland","Market":"JA-JP","Hash":"4298283472","FullDateString":"2026 年 10月 月 15 日"},{"ImageContent":{"Description":"10 月 14 日は「鉄道の日」。1872年の今日、初代新橋駅〜横浜駅（現 桜木町駅）間で日本初の鉄道が正式に開業したことにちなみ、1994 年に運輸省（現 国土交通省）が定めました。そして、今日の画像は京都・嵐山を走るトロッコ列車。秋の嵐山では、色づいた山々の間を嵯峨野トロッコ列車がゆっくりと走り抜けます。渓谷を流れる保津川と紅葉が織りなす風景は、多くの人々を魅了する秋の風物詩となっています。","Image":{"Url":"/th?id=OHR.RailwayDay2026_JA-JP4058067313_1920x1080.webp","Wallpaper":"/th?id=OHR.RailwayDay2026_JA-JP4058067313_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は鉄道の日","Title":"嵯峨野トロッコ列車, 京都府京都市","Copyright":"© giggsy25/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.009881,135.666763/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.009881,135.666763;S9;嵐山&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261014_RailwayDay2026 %22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261014_RailwayDay2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e9%89%84%e9%81%93%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20261013_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261014_RailwayDay2026"},"Ssd":"20261014","Name":"RailwayDay2026","Market":"JA-JP","Hash":"4058067313","FullDateString":"2026 年 10月 月 14 日"},{"ImageContent":{"Description":"ここはクロアチア中部に位置するプリトヴィツェ湖群国立公園。高低差のある 16 の湖と、それを繋ぐ 92 の滝や瀑布という壮大な景観が特徴です。湖水は、含まれるミネラルの組成や太陽光の反射によって、エメラルドグリーンから深い青までさまざまな色合いを見せます。園内には木製の遊歩道が整備されており、滝が流れ落ちる様子や澄んだ湖面、木々に囲まれた岸辺などを間近に眺めることができます。こうした圧倒的な自然美と豊かな生態系が評価され、1979年にユネスコ世界遺産に登録されました。","Image":{"Url":"/th?id=OHR.PlitviceAutumn_JA-JP3930294400_1920x1080.webp","Wallpaper":"/th?id=OHR.PlitviceAutumn_JA-JP3930294400_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"紅葉に彩られた湖と滝","Title":"プリトヴィツェ湖群国立公園, クロアチア","Copyright":"© Jan Wlodarczyk/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/44.866465,15.581867/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=44.866465,15.581867;S9;プリトヴィツェ湖群国立公園, クロアチア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261013_PlitviceAutumn%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261013_PlitviceAutumn\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%97%e3%83%aa%e3%83%88%e3%83%b4%e3%82%a3%e3%83%84%e3%82%a7%e6%b9%96%e7%be%a4%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9c%92&form=hpcapt&filters=HpDate:\"20261012_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261013_PlitviceAutumn"},"Ssd":"20261013","Name":"PlitviceAutumn","Market":"JA-JP","Hash":"3930294400","FullDateString":"2026 年 10月 月 13 日"},{"ImageContent":{"Description":"ベニコンゴウインコは、主に南米大陸北部の森林に分布している鳥です。鮮やかな赤い体色に緑や青色の入った美しい翼で知られています。全長は 90 ～ 95cm ほどで、コンゴウインコ類の中でも最大級の大きさを誇ります。また、一夫一婦制の習性があり、ほとんどの場合つがいの関係は一生続くとされています。さらに、鳥類の中でも高い知能をもち、状況によって異なる鳴き声を発するなど、豊かなコミュニケーション能力を備えています。","Image":{"Url":"/th?id=OHR.RedMacawsFlight_JA-JP3781300138_1920x1080.webp","Wallpaper":"/th?id=OHR.RedMacawsFlight_JA-JP3781300138_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"熱帯の森を舞う極彩色の鳥たち","Title":"ベニコンゴウインコのペア","Copyright":"© markes51/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"ベニコンゴウインコは、人間の噛む力を大きく上回る咬合力を持ち、硬いナッツや種子を割ることができます。","LinkUrl":"/search?q=%e3%83%99%e3%83%8b%e3%82%b3%e3%83%b3%e3%82%b4%e3%82%a6%e3%82%a4%e3%83%b3%e3%82%b3%e3%81%ae%e5%92%ac%e5%90%88%e5%8a%9b&form=hpvsfa","LinkText":"ベニコンゴウインコの咬合力は？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261012_RedMacawsFlight\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%99%e3%83%8b%e3%82%b3%e3%83%b3%e3%82%b4%e3%82%a6%e3%82%a4%e3%83%b3%e3%82%b3&form=hpcapt&filters=HpDate:\"20261011_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261012_RedMacawsFlight"},"Ssd":"20261012","Name":"RedMacawsFlight","Market":"JA-JP","Hash":"3781300138","FullDateString":"2026 年 10月 月 12 日"},{"ImageContent":{"Description":"今日の画像は、グレイド・クリーク・グリスト・ミル。米国ウェストバージニア州のバブコック州立公園を代表するランドマークです。この製粉所は、かつて近隣にあった製粉所を再現したもので、州内にあった 3 か所の製粉所の部材を組み合わせて、1976 年に造られました。現在も稼働している現役の製粉所であり、かつてウェストバージニア州内に存在した数多の製粉所の歴史を今に伝えています。","Image":{"Url":"/th?id=OHR.BabcockSP_JA-JP1996620132_1920x1080.webp","Wallpaper":"/th?id=OHR.BabcockSP_JA-JP1996620132_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"紅葉に包まれた水車小屋","Title":"グレイド・クリーク・グリスト・ミル, 米国 ウェストバージニア州","Copyright":"© dszc/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.996698,-80.977125/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=37.996698,-80.977125;S9;バブコック州立公園, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261011_BabcockSP%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey: