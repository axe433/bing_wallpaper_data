{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-07-17T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"今日の画像は、幻想的で美しい「魔橋」とも呼ばれるラコツ橋。ドイツのクロムラウ・ツツジシャクナゲ公園内にあるこの橋は、玄武岩などを利用して 1860 年代に造られました。水面に映ると円を描くように見える独特の設計が特徴です。その神秘的な姿から人気の写真スポットとなっているほか、人気映画シリーズ「マトリックス」の四作目、「マトリックス レザレクションズ」のロケ地としても使用されました。その緻密な構造を保護するため、現在、橋を渡ることは禁止されています。","Image":{"Url":"/th?id=OHR.DevilsBridge_JA-JP0713285567_1920x1080.webp","Wallpaper":"/th?id=OHR.DevilsBridge_JA-JP0713285567_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"水面に映る幻想的な石橋","Title":"ラコツ橋, ドイツ","Copyright":"© Mike Mareen/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/51.53661,14.640453/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=51.53661,14.640453;S9;ラコツ橋, ドイツ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260718_DevilsBridge%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260718_DevilsBridge\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%a9%e3%82%b3%e3%83%84%e6%a9%8b&form=hpcapt&filters=HpDate:\"20260717_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260718_DevilsBridge"},"Ssd":"20260718","Name":"DevilsBridge","Market":"JA-JP","Hash":"0713285567","FullDateString":"2026 年 7月 月 18 日"},{"ImageContent":{"Description":"7 月 1 日から 31 日まで、一ヶ月に渡る京都の神事・祇園祭。そして、今日 7 月 17 日に行われるのが、前祭の山鉾巡行です。釘を一本も使わず、「縄がらみ」と呼ばれる伝統技法で組み立てられた山鉾が、京都の町を練り歩くというもので、この「京都祇園祭の山鉾行事」はユネスコ無形文化遺産にも登録されています。7 月 24 日の後祭の二度行われる山鉾巡行ですが、前祭の見どころの一つが「生稚児」です。現在、生稚児と呼ばれる実際の子どもが乗るのは、前祭の先頭を進む「長刀鉾」のみで、巡行中に注連縄切りや稚児舞を披露し、祭の始まりと道中の清めを担います。また、山鉾の御神体や、懸装品が飾られた町会所では、子どもたちがわらべ唄を歌いながらお守りを販売する姿も見られます。","Image":{"Url":"/th?id=OHR.GionFestival2026_JA-JP0488381919_1920x1080.webp","Wallpaper":"/th?id=OHR.GionFestival2026_JA-JP0488381919_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は祇園祭、前祭の山鉾巡行","Title":"八坂神社の神紋が描かれた提灯, 京都府 京都市","Copyright":"© Felix Choo/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.004076,135.778506/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.004076,135.778506;S9;八坂神社&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260717_GionFestival2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260717_GionFestival2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%a5%87%e5%9c%92%e7%a5%ad%e3%80%81%e5%89%8d%e7%a5%ad%e3%81%ae%e5%b1%b1%e9%89%be%e5%b7%a1%e8%a1%8c&form=hpcapt&filters=HpDate:\"20260716_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260717_GionFestival2026"},"Ssd":"20260717","Name":"GionFestival2026","Market":"JA-JP","Hash":"0488381919","FullDateString":"2026 年 7月 月 17 日"},{"ImageContent":{"Description":"ここは、ネイビー・ピア。米国イリノイ州シカゴの、ミシガン湖岸に延びる全長約 1km の桟橋です。1914 年にシカゴ都市計画の一環として建設が始まり、1916 年に一般公開されました。当初は貨物輸送などを担う公共インフラでしたが、第二次世界大戦中には米国海軍の訓練拠点としても利用されていました。現在は、公園やイベントスペース、レストランなどが並ぶ観光名所となり、日々多くの人々が訪れています。","Image":{"Url":"/th?id=OHR.NavyPier_JA-JP0160307645_1920x1080.webp","Wallpaper":"/th?id=OHR.NavyPier_JA-JP0160307645_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"活気あふれる桟橋の夜景","Title":"ネイビー・ピア, 米国イリノイ州","Copyright":"© Christopher.F Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.892227,-87.605187/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=41.892227,-87.605187;S9;ネイビー・ピア, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260716_NavyPier%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260716_NavyPier\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8d%e3%82%a4%e3%83%93%e3%83%bc%e3%83%bb%e3%83%94%e3%82%a2&form=hpcapt&filters=HpDate:\"20260715_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260716_NavyPier"},"Ssd":"20260716","Name":"NavyPier","Market":"JA-JP","Hash":"0160307645","FullDateString":"2026 年 7月 月 16 日"},{"ImageContent":{"Description":"ジョン・ミュア・ウィルダネスは、1964 年に設立された約 2600km² の面積を誇る広大な原生自然の保護区域です。米国カリフォルニア州のシエラネバダ山脈中央部に位置しています。4000m を超える山々が連なる米国最大級の高地原生地域の一つであり、多くのハイカーを惹きつけています。そして、今日の画像は、保護区域内の標高約 3200m に位置するマリー・レイク。静かな高山湖として、バックパッカーに人気の撮影スポットです。","Image":{"Url":"/th?id=OHR.MarieLake_JA-JP9898730602_1920x1080.webp","Wallpaper":"/th?id=OHR.MarieLake_JA-JP9898730602_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"山々に囲まれた湖","Title":"マリー・レイク, 米国 カリフォルニア州","Copyright":"© Steve Dunleavy/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.97615,-118.812278/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.97615,-118.812278;S9;ジョン・ミュア・ウィルダネス, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260715_MarieLake%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260715_MarieLake\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b8%e3%83%a7%e3%83%b3%e3%83%bb%e3%83%9f%e3%83%a5%e3%82%a2%e3%83%bb%e3%82%a6%e3%82%a3%e3%83%ab%e3%83%80%e3%83%8d%e3%82%b9&form=hpcapt&filters=HpDate:\"20260714_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260715_MarieLake"},"Ssd":"20260715","Name":"MarieLake","Market":"JA-JP","Hash":"9898730602","FullDateString":"2026 年 7月 月 15 日"},{"ImageContent":{"Description":"今日 7 月 14 日はサメ啓発の日。サメは 4 億年以上前から存在しているといわれており、頂点捕食者として海洋生態系のバランスを保つ重要な役割を果たしています。そういったサメについての知識を広め、映画などによって植え付けられたイメージを払拭するとともに、保護について考えるための日です。そして、今日の画像は、バハマのエレウテラ島のマングローブ林を泳ぐレモンザメの幼魚。幼いうちは天敵も多いため、マングローブ林にとどまり、大型の捕食者から身を守ります。しかし、繁殖力の低さに加え、乱獲や環境破壊などによって個体数が減少しており、危急種 (VU) に指定されています。","Image":{"Url":"/th?id=OHR.LemonShark_JA-JP9266528977_1920x1080.webp","Wallpaper":"/th?id=OHR.LemonShark_JA-JP9266528977_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日はサメ啓発の日","Title":"レモンザメの幼魚, バハマ","Copyright":"© Shane Gross/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/25.471191,-76.725555/10?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=25.471191,-76.725555;S9;エリューセラ島, バハマ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260714_LemonShark%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260714_LemonShark\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b5%e3%83%a1%e5%95%93%e7%99%ba%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260713_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260714_LemonShark"},"Ssd":"20260714","Name":"LemonShark","Market":"JA-JP","Hash":"9266528977","FullDateString":"2026 年 7月 月 14 日"},{"ImageContent":{"Description":"今日 7 月 13 日は国際岩の日 (International Rock Day) 。岩石が人類の歴史や地球の形成に果たしてきた重要な役割を称える日です。そして、今日の画像は、米国アリゾナ州ペイジ近郊のナバホ族の土地に位置するアンテロープ・キャニオン。水による浸食や堆積物などにより、何百万年もの時間をかけてナバホ砂岩が削り出されることで形成されました。滑らかにうねる独特な岩肌が、地球と岩石の雄大な歴史を象徴しています。","Image":{"Url":"/th?id=OHR.NavajoSandstone_JA-JP6458327046_1920x1080.webp","Wallpaper":"/th?id=OHR.NavajoSandstone_JA-JP6458327046_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際岩の日","Title":"アンテロープ・キャニオン, 米国 アリゾナ州","Copyright":"© Mark Skalny/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.952764,-111.441278/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.952764,-111.441278;S9;アンテロープ・キャニオン, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260713_NavajoSandstone%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260713_NavajoSandstone\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%9a%9b%e5%b2%a9%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260712_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260713_NavajoSandstone"},"Ssd":"20260713","Name":"NavajoSandstone","Market":"JA-JP","Hash":"6458327046","FullDateString":"2026 年 7月 月 13 日"},{"ImageContent":{"Description":"ここは、カタディン・ウッズ・アンド・ウォーターズ国定記念物。2016 年に設立された保護区で、約 350km² の面積を誇ります。米国メイン州ペノブスコット郡北部の山地と森林地帯に広がっており、ヘラジカやクロクマ、カナダオオヤマネコなどのほか、多様な魚類が生息しています。また、人里から遠く光害が少ないことから、星空観察に適しているとして、国際ダークスカイ・サンクチュアリに指定されています。","Image":{"Url":"/th?id=OHR.KatahdinWWNM_JA-JP6177719073_1920x1080.webp","Wallpaper":"/th?id=OHR.KatahdinWWNM_JA-JP6177719073_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"静かな池に映る鬱蒼とした森","Title":"カタディン・ウッズ・アンド・ウォーターズ国定記念物, 米国 メイン州","Copyright":"© Cavan Images/Offset/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/45.880128,-68.558319/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=45.880128,-68.558319;S9;カタディン・ウッズ・アンド・ウォーターズ国定記念物&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260712_KatahdinWWNM%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260712_KatahdinWWNM\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%82%bf%e3%83%87%e3%82%a3%e3%83%b3%e3%83%bb%e3%82%a6%e3%83%83%e3%82%ba%e3%83%bb%e3%82%a2%e3%83%b3%e3%83%89%e3%83%bb%e3%82%a6%e3%82%a9%e3%83%bc%e3%82%bf%e3%83%bc%e3%82%ba%e5%9b%bd%e5%ae%9a%e8%a8%98%e5%bf%b5%e7%89%a9&form=hpcapt&filters=HpDate:\"20260711_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260712_KatahdinWWNM"},"Ssd":"20260712","Name":"KatahdinWWNM","Market":"JA-JP","Hash":"6177719073","FullDateString":"2026 年 7月 月 12 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"スペインのガリシア州は大西洋に面しており、その海岸線には、長い年月をかけて形成された断崖や入り江、波の浸食作用によって削り取られた波食台地が連なっています。そして、今日の画像は、ガリシア州北部に位置するカテドラル・ビーチ（プライア・ダス・カテドライス）の干潮時の姿。高さ 30m を誇る粘板岩と珪岩のアーチが大聖堂（カテドラル）を思わせることが名前の由来です。干潮時という限られた時間帯にのみ、海食によって形成された岩のアーチの間を歩くことができます。","Image":{"Url":"/th?id=OHR.GaliciaBeach_JA-JP2958100609_1920x1080.webp","Wallpaper":"/th?id=OHR.GaliciaBeach_JA-JP2958100609_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"干潮に現れる奇岩海岸","Title":"カテドラル・ビーチ, スペイン","Copyright":"© Tui De Roy/Amazing Aerial Agency/Abobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/43.554486,-7.157243/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=43.554486,-7.157243;S9;カテドラル・ビーチ, スペイン&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260725_GaliciaBeach%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260725_GaliciaBeach\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%83%86%e3%83%89%e3%83%a9%e3%83%ab%e3%83%bb%e3%83%93%e3%83%bc%e3%83%81&form=hpcapt&filters=HpDate:\"20260724_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260725_GaliciaBeach"},"Ssd":"20260725","Name":"GaliciaBeach","Market":"JA-JP","Hash":"2958100609","FullDateString":"2026 年 7月 月 25 日"},{"ImageContent":{"Description":"今日 7 月 24 日は米国いとこの日。兄弟姉妹のようでありながら、友人のような存在でもある「いとこ」という繋がりを祝う日です。そして画像は、エクアドルのガラパゴス諸島に生息するフラミンゴの群れ。彼らは、単独で行動するのではなく、群れをなして集まり、一緒に餌を食べ、仲間と動きを揃えて移動します。直接的な血の繋がりがなくとも「家族」のように繋がっているという、いとこという関係性を思わせる光景です。","Image":{"Url":"/th?id=OHR.GalapagosFlamingos_JA-JP2749729014_1920x1080.webp","Wallpaper":"/th?id=OHR.GalapagosFlamingos_JA-JP2749729014_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国いとこの日","Title":"ベニイロフラミンゴ, エクアドル","Copyright":"© Tui De Roy/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-0.858929,-91.215883/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-0.858929,-91.215883;S9;イサベラ島, エクアドル&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260724_GalapagosFlamingos%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260724_GalapagosFlamingos\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b1%b3%e5%9b%bd%e3%81%ae%e3%81%84%e3%81%a8%e3%81%93%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260723_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260724_GalapagosFlamingos"},"Ssd":"20260724","Name":"GalapagosFlamingos","Market":"JA-JP","Hash":"2749729014","FullDateString":"2026 年 7月 月 24 日"},{"ImageContent":{"Description":"庭を静かに彩る花もあれば、ダリアのように、まるで主役のように目を引く花もあります。ダリアは、メキシコ原産のキク科の植物で、「 8 倍体」と呼ばれる染色体が特徴です。これによって多様な品種が作りやすく、数万にも及ぶ品種が生まれており、様々な色や大きさで花を咲かせます。かつてアステカでは食用や薬として利用され、茎は水を通す道具としても使われていました。1963 年にはメキシコの国花に指定されています。","Image":{"Url":"/th?id=OHR.PinkDahlia_JA-JP3415436544_1920x1080.webp","Wallpaper":"/th?id=OHR.PinkDahlia_JA-JP3415436544_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"華やかに開くダリアの花びら","Title":"ピンクのダリア","Copyright":"© Harald Biebel/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"ダリアの花は、一枚の花びらでできているように見えますが、実は多くの小さな花が集まってできています。","LinkUrl":"/search?q=%e3%83%80%e3%83%aa%e3%82%a2%e3%81%ae%e5%a4%96%e5%81%b4%e3%81%ae%e5%a4%a7%e3%81%8d%e3%81%8f%e7%9b%ae%e7%ab%8b%e3%81%a4%e8%8a%b1%e3%81%b3%e3%82%89%e3%81%ae%e3%82%88%e3%81%86%e3%81%aa%e9%83%a8%e5%88%86%e3%81%af%e4%bd%95%e3%81%a8%e5%91%bc%e3%81%b0%e3%82%8c%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"ダリアの外側の大きく目立つ花びらのような部分は何と呼ばれる？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260723_PinkDahlia\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%94%e3%83%b3%e3%82%af%e3%81%ae%e3%83%80%e3%83%aa%e3%82%a2&form=hpcapt&filters=HpDate:\"20260722_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260723_PinkDahlia"},"Ssd":"20260723","Name":"PinkDahlia","Market":"JA-JP","Hash":"3415436544","FullDateString":"2026 年 7月 月 23 日"},{"ImageContent":{"Description":"今週は米国のサンゴ礁啓発週間。サンゴ礁は、太陽の光に輝き、多くの生き物でにぎわう海の中の街のような存在です。地球の海洋面積に対してサンゴ礁が占めている割合は約 1% 未満ですが、海洋生物全体の約 25% を支えています。一見すると岩のようですが、実はサンゴポリプと呼ばれる小さな動物が集まって形作られています。そして、今日の画像は、インドネシアのラジャ・アンパット諸島で撮影されたサンゴ礁。この地域には既知のサンゴ種の 75％ 以上が生息し、多種多様な海洋生物が暮らす豊かな生態系が広がっています。","Image":{"Url":"/th?id=OHR.CoralAwareness_JA-JP2408708579_1920x1080.webp","Wallpaper":"/th?id=OHR.CoralAwareness_JA-JP2408708579_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今週は米国のサンゴ礁啓発週間","Title":"サンゴ礁, インドネシア","Copyright":"© SergeUWPhoto/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/1.050448,131.267654/14?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=1.050448,131.267654;S9;アンパット諸島, インドネシア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260722_CoralAwareness%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260722_CoralAwareness\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b1%b3%e5%9b%bd%e3%81%ae%e3%82%b5%e3%83%b3%e3%82%b4%e7%a4%81%e5%95%93%e7%99%ba%e9%80%b1%e9%96%93&form=hpcapt&filters=HpDate:\"20260721_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260722_CoralAwareness"},"Ssd":"20260722","Name":"CoralAwareness","Market":"JA-JP","Hash":"2408708579","FullDateString":"2026 年 7月 月 22 日"},{"ImageContent":{"Description":"照りつける夏の日差しの中、埼玉県川越市にある氷川神社では「縁結び風鈴」が開催されています。今年 2026 年は、6 月 26 日から 9 月 6 日までの間、神社の境内には、およそ 2000 個の江戸風鈴が飾られ、涼やかな音色を響かせています。風鈴に願い事を書いた短冊を結びつけることで、縁結びの神様へ風に乗って思いが運ばれていく、とされています。","Image":{"Url":"/th?id=OHR.Kawagoe2026_JA-JP2060864918_1920x1080.webp","Wallpaper":"/th?id=OHR.Kawagoe2026_JA-JP2060864918_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"「縁結び風鈴」開催中","Title":"川越氷川神社, 埼玉県 川越市","Copyright":"© kudosstudio/Adobe","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.927586,139.488525/20?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.927586,139.488525;S9;川越氷川神社&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260721_ Kawagoe2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260721_Kawagoe2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b8%81%e7%b5%90%e3%81%b3%e3%81%b5%e9%a2%a8%e9%88%b4&form=hpcapt&filters=HpDate:\"20260720_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260721_Kawagoe2026"},"Ssd":"20260721","Name":"Kawagoe2026","Market":"JA-JP","Hash":"2060864918","FullDateString":"2026 年 7月 月 21 日"},{"ImageContent":{"Description":"今日、7 月 20 日は「国際月の日」。1969 年にアポロ 11 号の乗組員が、人類初の月面着陸を行った日です。2021 年に国連総会の決議により採択されたもので、月探査のこれまでの成果や、将来の探査・国際協力に向けた取り組みへの理解を深める日です。そして、今日の画像は月から眺めた地球。クレーターに覆われた月から見ることで、逆に地球が「三日月」のように見えています。月のこの荒涼とした風景は、数十億年にわたる隕石の衝突によって形づくられたもので、人類が誕生する以前からの太陽系の歴史を今に伝えています。","Image":{"Url":"/th?id=OHR.Artemis_JA-JP1736021856_1920x1080.webp","Wallpaper":"/th?id=OHR.Artemis_JA-JP1736021856_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際月の日","Title":"月から見た地球","Copyright":"© NASA","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"月の引力は遠くにあるにもかかわらず地球の海水を引き寄せ、1日におよそ2回の満潮と干潮を生み出しています。","LinkUrl":"/search?q=%e6%9c%88%e3%81%a8%e5%9c%b0%e7%90%83%e3%81%ae%e8%b7%9d%e9%9b%a2%e3%81%af%ef%bc%9f&form=hpvsfa","LinkText":"月と地球の距離は？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260720_Artemis\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%9a%9b%e6%9c%88%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260719_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260720_Artemis"},"Ssd":"20260720","Name":"Artemis","Market":"JA-JP","Hash":"1736021856","FullDateString":"2026 年 7月 月 20 日"},{"ImageContent":{"Description":"一般的によく知られるツバメは、黒い背中と白い腹、二又に分かれた長い尾が目立つ小鳥で、アクロバティックかつ素早い飛行で知られ、飛行中の昆虫を空中で巧みに捕らえます。その多くは、ヨーロッパやアジア、北米などの広い地域で繁殖し、冬になると南方の温暖な地域で過ごしますが、地域によっては渡りを行わない種類もあり、羽色にも違いが見られます。今日の画像では、腹部がやや橙赤色の個体が写っています。","Image":{"Url":"/th?id=OHR.HirundoRustica_JA-JP1327555795_1920x1080.webp","Wallpaper":"/th?id=OHR.HirundoRustica_JA-JP1327555795_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"枯れ草にとまる小鳥の群れ","Title":"ツバメ","Copyright":"© Oscar Dominguez/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"ツバメは、人の暮らしにとても近い場所で見られる鳥です。山奥の静かな森よりも、住宅地や農村、駅や商店街、学校、工場、農地、河川敷など、人の生活圏に近い環境をよく利用します。","LinkUrl":"/search?q=%e3%83%84%e3%83%90%e3%83%a1%e3%81%8c%e4%ba%ba%e3%81%ae%e6%9a%ae%e3%82%89%e3%81%97%e3%81%ab%e3%81%a8%e3%81%a6%e3%82%82%e8%bf%91%e3%81%84%e5%a0%b4%e6%89%80%e3%81%a7%e5%b7%a3%e3%82%92%e4%bd%9c%e3%82%8b%e7%90%86%e7%94%b1%e3%81%af%ef%bc%9f&form=hpvsfa","LinkText":"ツバメが人の暮らしにとても近い場所で巣を作る理由は？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260719_HirundoRustica\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%84%e3%83%90%e3%83%a1&form=hpcapt&filters=HpDate:\"20260718_1500\"+mgzv3configlist:\"BingQA