{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-07-12T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"ここは、カタディン・ウッズ・アンド・ウォーターズ国定記念物。2016 年に設立された保護区で、約 350km² の面積を誇ります。米国メイン州ペノブスコット郡北部の山地と森林地帯に広がっており、ヘラジカやクロクマ、カナダオオヤマネコなどのほか、多様な魚類が生息しています。また、人里から遠く光害が少ないことから、星空観察に適しているとして、国際ダークスカイ・サンクチュアリに指定されています。","Image":{"Url":"/th?id=OHR.KatahdinWWNM_JA-JP6177719073_1920x1080.webp","Wallpaper":"/th?id=OHR.KatahdinWWNM_JA-JP6177719073_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"静かな池に映る鬱蒼とした森","Title":"カタディン・ウッズ・アンド・ウォーターズ国定記念物, 米国 メイン州","Copyright":"© Cavan Images/Offset/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/45.880128,-68.558319/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=45.880128,-68.558319;S9;カタディン・ウッズ・アンド・ウォーターズ国定記念物&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260712_KatahdinWWNM%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260712_KatahdinWWNM\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%82%bf%e3%83%87%e3%82%a3%e3%83%b3%e3%83%bb%e3%82%a6%e3%83%83%e3%82%ba%e3%83%bb%e3%82%a2%e3%83%b3%e3%83%89%e3%83%bb%e3%82%a6%e3%82%a9%e3%83%bc%e3%82%bf%e3%83%bc%e3%82%ba%e5%9b%bd%e5%ae%9a%e8%a8%98%e5%bf%b5%e7%89%a9&form=hpcapt&filters=HpDate:\"20260711_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260712_KatahdinWWNM"},"Ssd":"20260712","Name":"KatahdinWWNM","Market":"JA-JP","Hash":"6177719073","FullDateString":"2026 年 7月 月 12 日"},{"ImageContent":{"Description":"ここは、サン＝グスタン港。フランスのブルターニュ地域圏にある港町オーレーの港です。その歴史は 12 世紀にまでさかのぼり、当時のブルターニュ公が橋や港、さらに城塞を築いたことに始まります。1776 年には、米国建国の父ともいわれるベンジャミン・フランクリンが訪れており、埠頭の一つは、「フランクリン・ドック」と呼ばれるようになりました。港は 19 世紀まで船の入港が可能でしたが、現在ではツアーの寄港地やマリーナとして利用されています。","Image":{"Url":"/th?id=OHR.AurayBrittany_JA-JP5965695214_1920x1080.webp","Wallpaper":"/th?id=OHR.AurayBrittany_JA-JP5965695214_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"港に停泊する観光船","Title":"サン＝グスタン港, フランス","Copyright":"© Rolf E. Staerk/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/47.664311,-2.977482/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=47.664311,-2.977482;S9;サン＝グスタン港, フランス&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260711_AurayBrittany%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260711_AurayBrittany\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b5%e3%83%b3%ef%bc%9d%e3%82%b0%e3%82%b9%e3%82%bf%e3%83%b3%e6%b8%af&form=hpcapt&filters=HpDate:\"20260710_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260711_AurayBrittany"},"Ssd":"20260711","Name":"AurayBrittany","Market":"JA-JP","Hash":"5965695214","FullDateString":"2026 年 7月 月 11 日"},{"ImageContent":{"Description":"ここは、オーストラリア南東部に位置するビクトリア州。南極海に面しており、2000km 以上に渡る海岸線には、ターコイズブルーの海と切り立った崖が織りなす壮大な景観が広がっています。特に、海岸線に沿って走る絶景ドライブコース「グレート・オーシャン・ロード」は、「世界で最も美しい海岸道路」として有名です。全長約 250km にも及ぶドライブルートで、人気のサーフスポットや緑豊かな岬、個性豊かな街並みなど、移り変わる海岸の風景を楽しむことができます。","Image":{"Url":"/th?id=OHR.VictoriaBeach_JA-JP5622574083_1920x1080.webp","Wallpaper":"/th?id=OHR.VictoriaBeach_JA-JP5622574083_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"浜辺に打ち寄せる波","Title":"ビクトリア州にあるビーチ, オーストラリア","Copyright":"© Nearmap/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-36.850086,144.304291/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-36.850086,144.304291;S9;ビクトリア州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260710_ VictoriaBeach%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260710_VictoriaBeach\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%93%e3%82%af%e3%83%88%e3%83%aa%e3%82%a2%e5%b7%9e%e3%81%ab%e3%81%82%e3%82%8b%e3%83%93%e3%83%bc%e3%83%81&form=hpcapt&filters=HpDate:\"20260709_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260710_VictoriaBeach"},"Ssd":"20260710","Name":"VictoriaBeach","Market":"JA-JP","Hash":"5622574083","FullDateString":"2026 年 7月 月 10 日"},{"ImageContent":{"Description":"今日の画像は、ベトナム北部ラオカイ省に位置する「サパ」です。モン族などの少数民族の人々が何世代にもわたって急な斜面を切り開き、水を巧みに引きながら棚田を築いてきました。標高は 1600m で、夏は雨が多いものの、冬は冷たい霧に包まれ、幻想的な風景が広がります。近年は観光地としても注目され、訪れる人々はその美しさと、今も息づく伝統を実感することができます。","Image":{"Url":"/th?id=OHR.SapaVietnam_JA-JP3354489397_1920x1080.webp","Wallpaper":"/th?id=OHR.SapaVietnam_JA-JP3354489397_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"光差す山岳地帯の棚田","Title":"サパの棚田, ベトナム","Copyright":"© Anujak Jaimook/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/22.374456,103.842076/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=22.374456,103.842076;S9;サパ, ベトナム ラオカイ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260709_SapaVietnam%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260709_SapaVietnam\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b5%e3%83%91%e3%81%ae%e6%a3%9a%e7%94%b0&form=hpcapt&filters=HpDate:\"20260708_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260709_SapaVietnam"},"Ssd":"20260709","Name":"SapaVietnam","Market":"JA-JP","Hash":"3354489397","FullDateString":"2026 年 7月 月 9 日"},{"ImageContent":{"Description":"グアテマラ西部高地に位置するアティトラン湖は、約 8 万 4 千年前の大噴火によって形成された火山カルデラ湖です。深い青色の湖面は、切り立った火口壁とアティトラン山・トリマン山・サンペドロ山といった火山に囲まれており、湖の静けさと火山の荒々しい地形が、対照的な美しい景観を生み出しています。水深は中米でも有数の深さを誇り、湖底には 1500 年以上前のマヤ遺跡が沈んでいます。周辺では今もカクチケル族やツトゥヒル族などのマヤ系住民が暮らし、言語や織物の伝統を守り受け継ぎながら、この豊かな自然と深く結びついた生活を続けています。","Image":{"Url":"/th?id=OHR.LakeAtitlan_JA-JP9857275970_1920x1080.webp","Wallpaper":"/th?id=OHR.LakeAtitlan_JA-JP9857275970_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"静けさにしずむ湖","Title":"アティトラン湖, グアテマラ","Copyright":"© shayes17/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/14.702858,-91.194628/13?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=14.702858,-91.194628;S9;アティトラン湖, グアテマラ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260708_LakeAtitlan%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260708_LakeAtitlan\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%86%e3%82%a3%e3%83%88%e3%83%a9%e3%83%b3%e6%b9%96&form=hpcapt&filters=HpDate:\"20260707_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260708_LakeAtitlan"},"Ssd":"20260708","Name":"LakeAtitlan","Market":"JA-JP","Hash":"9857275970","FullDateString":"2026 年 7月 月 8 日"},{"ImageContent":{"Description":"今日 7 月 7 日は七夕。全国各地で七夕飾りの豪華さを競う七夕まつりが行われますが、なかでも有名なのが仙台七夕まつりです。旧暦の七夕行事を受け継いでいるため、現在の暦では毎年8月に開催されています。商店街や街の通りには、色鮮やかな吹き流しや豪華な七夕飾りが並び、夏の風に揺れる幻想的な景色が広がります。願いを書いた短冊や繊細な和紙細工は、日本ならではの伝統文化と職人技が感じられるとして、海外の観光客にも人気です。歴史と美しさに彩られた、仙台の夏を象徴する祭りとして知られています。","Image":{"Url":"/th?id=OHR.Tanabata2026_JA-JP9678732410_1920x1080.webp","Wallpaper":"/th?id=OHR.Tanabata2026_JA-JP9678732410_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"七夕の伝統行事","Title":"七夕まつりの吹き流し, 宮城県 仙台市","Copyright":"© kororokerokero/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.267952,140.869537/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=38.267952,140.869537;S9;仙台市&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260707_Tanabata2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260707_Tanabata2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%bb%99%e5%8f%b0%e3%81%ae%e4%b8%83%e5%a4%95%e3%81%be%e3%81%a4%e3%82%8a&form=hpcapt&filters=HpDate:\"20260706_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260707_Tanabata2026"},"Ssd":"20260707","Name":"Tanabata2026","Market":"JA-JP","Hash":"9678732410","FullDateString":"2026 年 7月 月 7 日"},{"ImageContent":{"Description":"ここは、イタリア・シチリア島にある都市シラクサです。紀元前 734 年頃、ギリシャのコリントスから来た人々によって築かれ、古代地中海世界を代表する大都市の一つへと発展しました。古代ギリシャの数学者、アルキメデスの生誕地としても知られ、歴史的な遺跡をはじめ、多くの見どころがあります。2005年には、市内と周辺の遺跡が「シラクサとパンターリカの岩壁墓地遺跡」の名でユネスコの世界遺産に登録されました。","Image":{"Url":"/th?id=OHR.SyracuseItaly_JA-JP9524720514_1920x1080.webp","Wallpaper":"/th?id=OHR.SyracuseItaly_JA-JP9524720514_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"夕焼けに染まる海に突き出た石造要塞","Title":"シラクサ, イタリア","Copyright":"© Balate Dorin/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.067122,15.285311/12?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=37.067122,15.285311;S9;シラクサ, イタリア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260706_SyracuseItaly%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260706_SyracuseItaly\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b7%e3%83%a9%e3%82%af%e3%82%b5&form=hpcapt&filters=HpDate:\"20260705_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260706_SyracuseItaly"},"Ssd":"20260706","Name":"SyracuseItaly","Market":"JA-JP","Hash":"9524720514","FullDateString":"2026 年 7月 月 6 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"一般的によく知られるツバメは、黒い背中と白い腹、二又に分かれた長い尾が目立つ小鳥で、アクロバティックかつ素早い飛行で知られ、飛行中の昆虫を空中で巧みに捕らえます。その多くは、ヨーロッパやアジア、北米などの広い地域で繁殖し、冬になると南方の温暖な地域で過ごしますが、地域によっては渡りを行わない種類もあり、羽色にも違いが見られます。今日の画像では、腹部がやや橙赤色の個体が写っています。","Image":{"Url":"/th?id=OHR.HirundoRustica_JA-JP1327555795_1920x1080.webp","Wallpaper":"/th?id=OHR.HirundoRustica_JA-JP1327555795_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"枯れ草にとまる小鳥の群れ","Title":"ツバメ","Copyright":"© Oscar Dominguez/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"ツバメは、人の暮らしにとても近い場所で見られる鳥です。山奥の静かな森よりも、住宅地や農村、駅や商店街、学校、工場、農地、河川敷など、人の生活圏に近い環境をよく利用します。","LinkUrl":"/search?q=%e3%83%84%e3%83%90%e3%83%a1%e3%81%8c%e4%ba%ba%e3%81%ae%e6%9a%ae%e3%82%89%e3%81%97%e3%81%ab%e3%81%a8%e3%81%a6%e3%82%82%e8%bf%91%e3%81%84%e5%a0%b4%e6%89%80%e3%81%a7%e5%b7%a3%e3%82%92%e4%bd%9c%e3%82%8b%e7%90%86%e7%94%b1%e3%81%af%ef%bc%9f&form=hpvsfa","LinkText":"ツバメが人の暮らしにとても近い場所で巣を作る理由は？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260719_HirundoRustica\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%84%e3%83%90%e3%83%a1&form=hpcapt&filters=HpDate:\"20260718_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260719_HirundoRustica"},"Ssd":"20260719","Name":"HirundoRustica","Market":"JA-JP","Hash":"1327555795","FullDateString":"2026 年 7月 月 19 日"},{"ImageContent":{"Description":"今日の画像は、幻想的で美しい「魔橋」とも呼ばれるラコツ橋。ドイツのクロムラウ・ツツジシャクナゲ公園内にあるこの橋は、玄武岩などを利用して 1860 年代に造られました。水面に映ると円を描くように見える独特の設計が特徴です。その神秘的な姿から人気の写真スポットとなっているほか、人気映画シリーズ「マトリックス」の四作目、「マトリックス レザレクションズ」のロケ地としても使用されました。その緻密な構造を保護するため、現在、橋を渡ることは禁止されています。","Image":{"Url":"/th?id=OHR.DevilsBridge_JA-JP0713285567_1920x1080.webp","Wallpaper":"/th?id=OHR.DevilsBridge_JA-JP0713285567_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"水面に映る幻想的な石橋","Title":"ラコツ橋, ドイツ","Copyright":"© Mike Mareen/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/51.53661,14.640453/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=51.53661,14.640453;S9;ラコツ橋, ドイツ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260718_DevilsBridge%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260718_DevilsBridge\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%a9%e3%82%b3%e3%83%84%e6%a9%8b&form=hpcapt&filters=HpDate:\"20260717_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260718_DevilsBridge"},"Ssd":"20260718","Name":"DevilsBridge","Market":"JA-JP","Hash":"0713285567","FullDateString":"2026 年 7月 月 18 日"},{"ImageContent":{"Description":"7 月 1 日から 31 日まで、一ヶ月に渡る京都の神事・祇園祭。そして、今日 7 月 17 日に行われるのが、前祭の山鉾巡行です。釘を一本も使わず、「縄がらみ」と呼ばれる伝統技法で組み立てられた山鉾が、京都の町を練り歩くというもので、この「京都祇園祭の山鉾行事」はユネスコ無形文化遺産にも登録されています。7 月 24 日の後祭の二度行われる山鉾巡行ですが、前祭の見どころの一つが「生稚児」です。現在、生稚児と呼ばれる実際の子どもが乗るのは、前祭の先頭を進む「長刀鉾」のみで、巡行中に注連縄切りや稚児舞を披露し、祭の始まりと道中の清めを担います。また、山鉾の御神体や、懸装品が飾られた町会所では、子どもたちがわらべ唄を歌いながらお守りを販売する姿も見られます。","Image":{"Url":"/th?id=OHR.GionFestival2026_JA-JP0488381919_1920x1080.webp","Wallpaper":"/th?id=OHR.GionFestival2026_JA-JP0488381919_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は祇園祭、前祭の山鉾巡行","Title":"八坂神社の神紋が描かれた提灯, 京都府 京都市","Copyright":"© Felix Choo/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.004076,135.778506/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.004076,135.778506;S9;八坂神社&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260717_GionFestival2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260717_GionFestival2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%a5%87%e5%9c%92%e7%a5%ad%e3%80%81%e5%89%8d%e7%a5%ad%e3%81%ae%e5%b1%b1%e9%89%be%e5%b7%a1%e8%a1%8c&form=hpcapt&filters=HpDate:\"20260716_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260717_GionFestival2026"},"Ssd":"20260717","Name":"GionFestival2026","Market":"JA-JP","Hash":"0488381919","FullDateString":"2026 年 7月 月 17 日"},{"ImageContent":{"Description":"ここは、ネイビー・ピア。米国イリノイ州シカゴの、ミシガン湖岸に延びる全長約 1km の桟橋です。1914 年にシカゴ都市計画の一環として建設が始まり、1916 年に一般公開されました。当初は貨物輸送などを担う公共インフラでしたが、第二次世界大戦中には米国海軍の訓練拠点としても利用されていました。現在は、公園やイベントスペース、レストランなどが並ぶ観光名所となり、日々多くの人々が訪れています。","Image":{"Url":"/th?id=OHR.NavyPier_JA-JP0160307645_1920x1080.webp","Wallpaper":"/th?id=OHR.NavyPier_JA-JP0160307645_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"活気あふれる桟橋の夜景","Title":"ネイビー・ピア, 米国イリノイ州","Copyright":"© Christopher.F Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.892227,-87.605187/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=41.892227,-87.605187;S9;ネイビー・ピア, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260716_NavyPier%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260716_NavyPier\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8d%e3%82%a4%e3%83%93%e3%83%bc%e3%83%bb%e3%83%94%e3%82%a2&form=hpcapt&filters=HpDate:\"20260715_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260716_NavyPier"},"Ssd":"20260716","Name":"NavyPier","Market":"JA-JP","Hash":"0160307645","FullDateString":"2026 年 7月 月 16 日"},{"ImageContent":{"Description":"ジョン・ミュア・ウィルダネスは、1964 年に設立された約 2600km² の面積を誇る広大な原生自然の保護区域です。米国カリフォルニア州のシエラネバダ山脈中央部に位置しています。4000m を超える山々が連なる米国最大級の高地原生地域の一つであり、多くのハイカーを惹きつけています。そして、今日の画像は、保護区域内の標高約 3200m に位置するマリー・レイク。静かな高山湖として、バックパッカーに人気の撮影スポットです。","Image":{"Url":"/th?id=OHR.MarieLake_JA-JP9898730602_1920x1080.webp","Wallpaper":"/th?id=OHR.MarieLake_JA-JP9898730602_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"山々に囲まれた湖","Title":"マリー・レイク, 米国 カリフォルニア州","Copyright":"© Steve Dunleavy/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.97615,-118.812278/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.97615,-118.812278;S9;ジョン・ミュア・ウィルダネス, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260715_MarieLake%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260715_MarieLake\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b8%e3%83%a7%e3%83%b3%e3%83%bb%e3%83%9f%e3%83%a5%e3%82%a2%e3%83%bb%e3%82%a6%e3%82%a3%e3%83%ab%e3%83%80%e3%83%8d%e3%82%b9&form=hpcapt&filters=HpDate:\"20260714_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260715_MarieLake"},"Ssd":"20260715","Name":"MarieLake","Market":"JA-JP","Hash":"9898730602","FullDateString":"2026 年 7月 月 15 日"},{"ImageContent":{"Description":"今日 7 月 14 日はサメ啓発の日。サメは 4 億年以上前から存在しているといわれており、頂点捕食者として海洋生態系のバランスを保つ重要な役割を果たしています。そういったサメについての知識を広め、映画などによって植え付けられたイメージを払拭するとともに、保護について考えるための日です。そして、今日の画像は、バハマのエレウテラ島のマングローブ林を泳ぐレモンザメの幼魚。幼いうちは天敵も多いため、マングローブ林にとどまり、大型の捕食者から身を守ります。しかし、繁殖力の低さに加え、乱獲や環境破壊などによって個体数が減少しており、危急種 (VU) に指定されています。","Image":{"Url":"/th?id=OHR.LemonShark_JA-JP9266528977_1920x1080.webp","Wallpaper":"/th?id=OHR.LemonShark_JA-JP9266528977_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日はサメ啓発の日","Title":"レモンザメの幼魚, バハマ","Copyright":"© Shane Gross/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/25.471191,-76.725555/10?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=25.471191,-76.725555;S9;エリューセラ島, バハマ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260714_LemonShark%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260714_LemonShark\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b5%e3%83%a1%e5%95%93%e7%99%ba%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260713_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260714_LemonShark"},"Ssd":"20260714","Name":"LemonShark","Market":"JA-JP","Hash":"9266528977","FullDateString":"2026 年 7月 月 14 日"},{"ImageContent":{"Description":"今日 7 月 13 日は国際岩の日 (International Rock Day) 。岩石が人類の歴史や地球の形成に果たしてきた重要な役割を称える日です。そして、今日の画像は、米国アリゾナ州ペイジ近郊のナバホ族の土地に位置するアンテロープ・キャニオン。水による浸食や堆積物などにより、何百万年もの時間をかけてナバホ砂岩が削り出されることで形成されました。滑らかにうねる独特な岩肌が、地球と岩石の雄大な歴史を象徴しています。","Image":{"Url":"/th?id=OHR.NavajoSandstone_JA-JP6458327046_1920x1080.webp","Wallpaper":"/th?id=OHR.NavajoSandstone_JA-JP6458327046_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際岩の日","Title":"アンテロープ・キャニオン, 米国 アリゾナ州","Copyright":"© Mark Skalny/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.952764,-111.441278/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.952764,-111.441278;S9;アンテロープ・キャニオン, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa