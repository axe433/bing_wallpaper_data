{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-11-12T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"ユタ州モアブの北に広がるアーチーズ国立公園には、2,000を超える天然の砂岩アーチがあり、世界でもっともアーチが集まっている場所として知られています。写真のノース・ウィンドウは、巨大な石の門のような姿で知られる、園内を代表する景観の一つです。しかし、この壮大な造形を手がけたのは建築家ではありません。水や氷、気温の変化、重力が長い年月をかけてやわらかい岩を削り、自然ならではの建築美をつくり上げました。","Image":{"Url":"/th?id=OHR.NorthWindow_JA-JP8307735119_1920x1080.webp","Wallpaper":"/th?id=OHR.NorthWindow_JA-JP8307735119_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"自然が生んだ建築美","Title":"ノース・ウィンドウ、アーチーズ国立公園、モアブ、ユタ州、アメリカ","Copyright":"© lightphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.6857117,-109.5328291/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=38.6857117,-109.5328291;S9;アーチーズ国立公園、モアブ、ユタ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261112_NorthWindow\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%bc%e3%83%81%e3%83%bc%e3%82%ba%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9c%92&form=hpcapt&filters=HpDate:\"20261111_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261112_NorthWindow"},"Ssd":"20261112","Name":"NorthWindow","Market":"JA-JP","Hash":"8307735119","FullDateString":"2026 年 11月 月 12 日"},{"ImageContent":{"Description":"大西洋岸森林は、世界有数の生物多様性を誇る地域の一つです。ブラジルの大西洋沿岸からアルゼンチンやパラグアイにまで広がり、熱帯・亜熱帯の森林やマングローブなど、さまざまな環境が見られます。約2万種の植物が生育し、ジャガーやゴールデンライオンタマリンをはじめ、多彩な野生動物が暮らしています。長い年月の間に森林の多くが失われましたが、現在も炭素を蓄え、地域の多くの人々に淡水をもたらすなど、大切な役割を果たしています。","Image":{"Url":"/th?id=OHR.Atlantica_JA-JP3902829738_1920x1080.webp","Wallpaper":"/th?id=OHR.Atlantica_JA-JP3902829738_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"驚きに満ちた森","Title":"大西洋岸森林、ブラジル","Copyright":"© FG Trade/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"大西洋岸森林には約1億5,000万人が暮らしており、これは南米の総人口のおよそ3分の1にあたります。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261111_Atlantica\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a4%a7%e8%a5%bf%e6%b4%8b%e5%b2%b8%e6%a3%ae%e6%9e%97+%e3%83%96%e3%83%a9%e3%82%b8%e3%83%ab&form=hpcapt&filters=HpDate:\"20261110_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261111_Atlantica"},"Ssd":"20261111","Name":"Atlantica","Market":"JA-JP","Hash":"3902829738","FullDateString":"2026 年 11月 月 11 日"},{"ImageContent":{"Description":"上空から眺めるローズ島は、さまざまな青に囲まれた緑のひと筆のように見えます。バハマのパラダイス島から東へ約5キロの場所にある細長い島で、砂浜や浅瀬、島内のラグーンが広がっています。この穏やかな島は、1965年のジェームズ・ボンド映画「007 サンダーボール作戦」のロケ地として使われたほか、泳ぐ豚でも知られています。透明な海と白い砂が織りなすターコイズブルーや深い青のグラデーションは、真上から見下ろすといっそう鮮やかです。","Image":{"Url":"/th?id=OHR.RoseIsland_JA-JP3257968381_1920x1080.webp","Wallpaper":"/th?id=OHR.RoseIsland_JA-JP3257968381_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"楽園でひと休み","Title":"ローズ島の空撮、バハマ","Copyright":"© Abstract Aerial Art/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/25.088243,-77.225304/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=25.088243,-77.225304;S9;ローズ島、バハマ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261110_RoseIsland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%ad%e3%83%bc%e3%82%ba%e5%b3%b6+%e3%83%90%e3%83%8f%e3%83%9e&form=hpcapt&filters=HpDate:\"20261109_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261110_RoseIsland"},"Ssd":"20261110","Name":"RoseIsland","Market":"JA-JP","Hash":"3257968381","FullDateString":"2026 年 11月 月 10 日"},{"ImageContent":{"Description":"スペイン南部アンダルシア州の州都セビリアで、グアダルキビール川を渡ると、街の表情が少し変わります。対岸のトリアナは、フラメンコや昔ながらの文化が息づく色彩豊かな地区で、19世紀に架けられたイサベル2世橋（トリアナ橋）で歴史地区とつながっています。古くから陶器作りが盛んで、今も色鮮やかなタイルが建物や工房を彩っています。職人や市場、音楽、細い路地が織りなす独特の雰囲気こそ、トリアナならではの魅力です。","Image":{"Url":"/th?id=OHR.TrianaSpain_JA-JP2076026093_1920x1080.webp","Wallpaper":"/th?id=OHR.TrianaSpain_JA-JP2076026093_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"芸術がリズムを刻む街","Title":"セビリアの歴史地区トリアナ、スペイン","Copyright":"© Andrzej Rostek/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.382904,-6.006341/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=37.382904,-6.006341;S9;トリアナ、セビリア、スペイン&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261109_TrianaSpain\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%bb%e3%83%93%e3%83%aa%e3%82%a2+%e3%82%b9%e3%83%9a%e3%82%a4%e3%83%b3&form=hpcapt&filters=HpDate:\"20261108_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261109_TrianaSpain"},"Ssd":"20261109","Name":"TrianaSpain","Market":"JA-JP","Hash":"2076026093","FullDateString":"2026 年 11月 月 9 日"},{"ImageContent":{"Description":"ディーワーリーは、新月の暗い夜を明るく照らす「光の祭典」です。世界中で多くの人々が祝い、ディヤーと呼ばれる小さな灯明やランタンをともし、色鮮やかなランゴーリーで辺りを飾り、家族でお菓子を分け合います。ヒンドゥー教をはじめ、ジャイナ教やシク教でも大切にされている祝祭で、名前はサンスクリット語で「光の列」を意味する「ディーパーヴァリ」に由来します。","Image":{"Url":"/th?id=OHR.DiwaliLamps_JA-JP0443643151_1920x1080.webp","Wallpaper":"/th?id=OHR.DiwaliLamps_JA-JP0443643151_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"光に包まれる祝祭","Title":"ディーワーリーを彩るランタン、ムンバイ、マハーラーシュトラ州、インド","Copyright":"© Dinodia Photo/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/18.969048,72.821182/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=18.969048,72.821182;S9;ムンバイ、マハーラーシュトラ州、インド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261108_DiwaliLamps\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%87%e3%82%a3%e3%83%bc%e3%83%af%e3%83%bc%e3%83%aa%e3%83%bc&form=hpcapt&filters=HpDate:\"20261107_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261108_DiwaliLamps"},"Ssd":"20261108","Name":"DiwaliLamps","Market":"JA-JP","Hash":"0443643151","FullDateString":"2026 年 11月 月 8 日"},{"ImageContent":{"Description":"北米の草原に暮らすアメリカバイソンは、世界でも最大級の陸上哺乳類です。体重は900キロほどにもなりますが、時速約65キロで走ることができます。「バッファロー」と呼ばれることもありますが、アフリカやアジアにすむ本来のバッファローとは別の動物です。肩の大きなこぶは発達した筋肉で、冬は頭を左右に振って雪をかき分け、その下の草を探します。しっぽを見れば気分もわかり、ゆったり揺れていれば落ち着いているサイン、ピンと立っていたら興奮しているのかもしれません。一時は絶滅寸前まで追い込まれましたが、保護活動によって少しずつ数を取り戻してきました。","Image":{"Url":"/th?id=OHR.DakotaBison_JA-JP7700625518_1920x1080.webp","Wallpaper":"/th?id=OHR.DakotaBison_JA-JP7700625518_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"よみがえった草原の巨人","Title":"セオドア・ルーズベルト国立公園の草原にいるバイソン、ノースダコタ州、アメリカ","Copyright":"© Tandem Stock/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/47.275714,-103.463282/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=47.275714,-103.463282;S9;セオドア・ルーズベルト国立公園&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261107_DakotaBison\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%a1%e3%83%aa%e3%82%ab%e3%83%90%e3%82%a4%e3%82%bd%e3%83%b3&form=hpcapt&filters=HpDate:\"20261106_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261107_DakotaBison"},"Ssd":"20261107","Name":"DakotaBison","Market":"JA-JP","Hash":"7700625518","FullDateString":"2026 年 11月 月 7 日"},{"ImageContent":{"Description":"マウイ島のハレアカラ国立公園は、標高約3,055メートルの山頂から海岸まで、火山や熱帯雨林など変化に富んだ自然が広がっています。キパフル地区にあるピピワイ・トレイルをたどると、緑豊かな森の先に見事な竹林が現れます。歩き始めて約1.6キロ進むと、頭上を覆うように竹が生い茂り、まるで緑のトンネルの中を歩いているようです。風が吹くと竹同士が触れ合い、独特の音が辺りに響きます。","Image":{"Url":"/th?id=OHR.PipiwaiTrail_JA-JP1383562325_1920x1080.webp","Wallpaper":"/th?id=OHR.PipiwaiTrail_JA-JP1383562325_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"マウイ島を抜ける緑のトンネル","Title":"ピピワイ・トレイルの竹林、ハレアカラ国立公園、マウイ島、ハワイ、アメリカ","Copyright":"© MNStudio/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/20.760987,-156.155095/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=20.760987,-156.155095;S9;ハレアカラ国立公園、マウイ島、ハワイ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261106_PipiwaiTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8f%e3%83%ac%e3%82%a2%e3%82%ab%e3%83%a9%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9c%92&form=hpcapt&filters=HpDate:\"20261105_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261106_PipiwaiTrail"},"Ssd":"20261106","Name":"PipiwaiTrail","Market":"JA-JP","Hash":"1383562325","FullDateString":"2026 年 11月 月 6 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"今日は世界哲学の日です。ドイツ・フランクフルトのゲーテ大学には、8種類の文字を組み合わせて人の姿をかたどった金属の彫刻「ボディ・オブ・ノレッジ」が置かれています。スペイン出身のアーティスト、ジャウメ・プレンサは「私たちの体は精神の住まいであり、アイデアが息づく場所です」と語っています。簡単な答えに飛びつかず、自分や世界を形づくる問いに向き合ってみませんか。","Image":{"Url":"/th?id=OHR.KnowledgeSculpture_JA-JP6514822082_1920x1080.webp","Wallpaper":"/th?id=OHR.KnowledgeSculpture_JA-JP6514822082_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"アイデアが形になる場所","Title":"ジャウメ・プレンサの彫刻「ボディ・オブ・ノレッジ」、ゲーテ大学、フランクフルト、ドイツ","Copyright":"© Todamo/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/50.127805,8.667807/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=50.127805,8.667807;S9;ゲーテ大学、フランクフルト&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261119_KnowledgeSculpture\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e5%93%b2%e5%ad%a6%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20261118_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261119_KnowledgeSculpture"},"Ssd":"20261119","Name":"KnowledgeSculpture","Market":"JA-JP","Hash":"6514822082","FullDateString":"2026 年 11月 月 19 日"},{"ImageContent":{"Description":"夕暮れの光に包まれたメンフクロウが、狩りの始まりをじっと待っています。夜になると、草や落ち葉の中でネズミが動くわずかな音も聞き逃しません。ハート形の顔が音を集めるアンテナの役目を果たし、真っ暗闇でも獲物の位置をぴたりと突き止められるのです。しかも羽音を立てずに飛ぶので、獲物は気づく間もありません。秋は若いメンフクロウが巣立つ季節です。夜が長くなるこの時期は、夕方の早い時間から野原の上をすべるように飛ぶ姿が見られるかもしれません。","Image":{"Url":"/th?id=OHR.BarnOwlsUnite_JA-JP5990292316_1920x1080.webp","Wallpaper":"/th?id=OHR.BarnOwlsUnite_JA-JP5990292316_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"夕暮れから始まる狩り","Title":"メンフクロウのつがい","Copyright":"© Zahoor Salmi/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"メンフクロウは「ホーホー」とは鳴かず、不気味な金切り声を上げます。そのせいか、不吉な鳥と見られることもあります。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261118_BarnOwlsUnite\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%a1%e3%83%b3%e3%83%95%e3%82%af%e3%83%ad%e3%82%a6&form=hpcapt&filters=HpDate:\"20261117_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261118_BarnOwlsUnite"},"Ssd":"20261118","Name":"BarnOwlsUnite","Market":"JA-JP","Hash":"5990292316","FullDateString":"2026 年 11月 月 18 日"},{"ImageContent":{"Description":"モンタナ州のグレイシャー国立公園にある「トレイル・オブ・ザ・シーダーズ」は、約1.4kmの周回コースです。ベイスギやベイツガの原生林の中を木道が通り、樹齢500年を超える巨木も見られます。コースの中ほどにある橋からは、アバランチ・クリークが削った渓谷を見下ろせます。短くて歩きやすく、車いすでも楽しめるので、気軽に森の空気を味わいたいときにぴったりです。","Image":{"Url":"/th?id=OHR.TrailCedars_JA-JP3850490248_1920x1080.webp","Wallpaper":"/th?id=OHR.TrailCedars_JA-JP3850490248_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"さあ、大自然の中へ","Title":"トレイル・オブ・ザ・シーダーズ、グレイシャー国立公園、モンタナ州、アメリカ","Copyright":"© DBushue Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.706957,-113.817235/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=48.706957,-113.817235;S9;グレイシャー国立公園、モンタナ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261117_TrailCedars\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b0%e3%83%ac%e3%82%a4%e3%82%b7%e3%83%a3%e3%83%bc%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9c%92&form=hpcapt&filters=HpDate:\"20261116_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261117_TrailCedars"},"Ssd":"20261117","Name":"TrailCedars","Market":"JA-JP","Hash":"3850490248","FullDateString":"2026 年 11月 月 17 日"},{"ImageContent":{"Description":"ニューメキシコ州の断崖の洞窟には、先住民モゴヨン族が住んでいた跡が残っています。13世紀後半、洞窟に部屋をつくった人々は、土器を焼き、眼下に広がる谷で作物を育てたり狩りをしたりしていたと考えられています。ところが1300年ごろ、モゴヨン族は理由もわからないままこの地を去りました。今ではアメリカ南西部でも特に重要な遺跡の一つとして知られています。","Image":{"Url":"/th?id=OHR.GilaCliff_JA-JP2766300250_1920x1080.webp","Wallpaper":"/th?id=OHR.GilaCliff_JA-JP2766300250_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"時を超える崖の住まい","Title":"ヒラ・クリフ・ドウェリングス国定記念物、ニューメキシコ州、アメリカ","Copyright":"© Chiara Salvadori/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/33.254028,-108.272634/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=33.254028,-108.272634;S9;ヒラ・クリフ・ドウェリングス国定記念物&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261116_GilaCliff\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%92%e3%83%a9%e3%83%bb%e3%82%af%e3%83%aa%e3%83%95%e3%83%bb%e3%83%89%e3%82%a6%e3%82%a7%e3%83%aa%e3%83%b3%e3%82%b0%e3%82%b9%e5%9b%bd%e5%ae%9a%e8%a8%98%e5%bf%b5%e7%89%a9&form=hpcapt&filters=HpDate:\"20261115_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261116_GilaCliff"},"Ssd":"20261116","Name":"GilaCliff","Market":"JA-JP","Hash":"2766300250","FullDateString":"2026 年 11月 月 16 日"},{"ImageContent":{"Description":"初霜が降りると、常緑低木のツツジの葉に氷の結晶ができます。気温が下がると、緑の葉は赤や紫に色づきます。このときつくられる新しい色素が、葉を寒さから守っているのです。白い霜をまとった赤い葉は、秋の庭をひときわ鮮やかに彩ります。春になれば新しい葉が出て、また緑に包まれます。","Image":{"Url":"/th?id=OHR.FirstFrost_JA-JP1519167944_1920x1080.webp","Wallpaper":"/th?id=OHR.FirstFrost_JA-JP1519167944_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"霜化粧の葉","Title":"赤い葉に霜が降りたツツジ","Copyright":"© avoferten/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"ツツジの葉を赤や紫に染める色素は、アントシアニンと呼ばれています。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261115_FirstFrost\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%84%e3%83%84%e3%82%b8&form=hpcapt&filters=HpDate:\"20261114_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261115_FirstFrost"},"Ssd":"20261115","Name":"FirstFrost","Market":"JA-JP","Hash":"1519167944","FullDateString":"2026 年 11月 月 15 日"},{"ImageContent":{"Description":"超高層ビルの数が世界一の街、香港へようこそ。ビクトリア・ハーバー沿いにビルがひしめくのは、港と山の間に平地がほとんどなく、戦後の建設ラッシュで上に伸びるしかなかったためです。2026年現在、高さ150m以上のビルは569棟にのぼり、世界のどの都市よりも多くなっています。","Image":{"Url":"/th?id=OHR.BlueHK_JA-JP0477081186_1920x1080.webp","Wallpaper":"/th?id=OHR.BlueHK_JA-JP0477081186_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"上へ上へと伸びる街","Title":"ビクトリア・ハーバー、香港、中国","Copyright":"© Juan Romero/Cavan Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/22.285,114.165/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=22.285,114.165;S9;ビクトリア・ハーバー、香港&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261114_BlueHK\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%93%e3%82%af%e3%83%88%e3%83%aa%e3%82%a2%e3%83%bb%e3%83%8f%e3%83%bc%e3%83%90%e3%83%bc+%e9%a6%99%e6%b8%af&form=hpcapt&filters=HpDate:\"20261113_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261114_BlueHK"},"Ssd":"20261114","Name":"BlueHK","Market":"JA-JP","Hash":"0477081186","FullDateString":"2026 年 11月 月 14 日"},{"ImageContent":{"Description":"ロッキー山脈に抱かれたカナダ・アルバータ州のアブラハム湖は、冬になるとメタンガスの気泡が凍って氷の下に閉じ込められる光景で知られています。強風で雪が吹き飛ばされるため、冬の間ずっとその気泡を眺められるのも魅力です。実は1972年のダム建設でできた人造湖で、夏はターコイズブルーの湖面が美しく、一年を通して人気のフォトスポットです。","Image":{"Url":"/th?id=OHR.AbrahamCanada_JA-JP9609532400_1920x1080.webp","Wallpaper":"/th?id=OHR.AbrahamCanada_JA-JP9609532400_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"氷の下の神秘","Title":"アブラハム湖、アルバータ州、カナダ","Copyright":"© Guang Cao/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery