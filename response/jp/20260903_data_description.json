{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-03T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"今日の画像は米国アリゾナ州バーミリオン・クリフ国定公園に位置するコヨーテ・ビュート。砂漠に波が押し寄せたような独特の景観は、風や水が長い年月をかけて砂丘を浸食することで生まれました。こうした原生的な自然を守るため、米国では 1964 年 9 月 3 日に「原生自然法」が制定されました。当初は 54 か所、約 3 万 6,800km² が保護対象でしたが、現在ではその 10 倍を超える面積が指定され、手つかずの森や砂漠など大自然の魅力を未来へ受け継いでいます。","Image":{"Url":"/th?id=OHR.AZWilderness_JA-JP3309055326_1920x1080.webp","Wallpaper":"/th?id=OHR.AZWilderness_JA-JP3309055326_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国原生自然法制定の記念日","Title":"コヨーテ・ビュート, 米国 アリゾナ州","Copyright":"© James Hager/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.862603,-111.826977/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.862603,-111.826977;S9;バーミリオン・クリフ国定公園, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260903_AZWilderness%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260903_AZWilderness\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b3%e3%83%a8%e3%83%bc%e3%83%86%e3%83%bb%e3%83%93%e3%83%a5%e3%83%bc%e3%83%88&form=hpcapt&filters=HpDate:\"20260902_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260903_AZWilderness"},"Ssd":"20260903","Name":"AZWilderness","Market":"JA-JP","Hash":"3309055326","FullDateString":"2026 年 9月 月 3 日"},{"ImageContent":{"Description":"サウスウォルドは、イングランド東部サフォーク州の美しい海辺の町です。北海やブライス川、広大な湿地に囲まれた細長い半島に位置し、古くから漁業や交易で栄えてきました。海岸沿いには約 300 棟の色鮮やかな木造の小屋が並んでいます。この小屋はビーチハットと呼ばれ、もともとは海水浴客や漁師のための簡易的な休憩所として利用されていましたが、現在はレジャーや休暇を楽しむための施設として親しまれています。","Image":{"Url":"/th?id=OHR.SuffolkHuts_JA-JP3115171778_1920x1080.webp","Wallpaper":"/th?id=OHR.SuffolkHuts_JA-JP3115171778_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海岸に並ぶカラフルな小屋","Title":"ビーチハット, イングランド","Copyright":"© stevendocwra/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.326221,1.678968/13?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=52.326221,1.678968;S9;サウスウォルド, イングランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260902_SuffolkHuts%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260902_SuffolkHuts\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b5%e3%82%a6%e3%82%b9%e3%82%a6%e3%82%a9%e3%83%ab%e3%83%89%e3%82%b5%e3%83%95%e3%82%a9%e3%83%bc%e3%82%af%e5%b7%9e&form=hpcapt&filters=HpDate:\"20260901_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260902_SuffolkHuts"},"Ssd":"20260902","Name":"SuffolkHuts","Market":"JA-JP","Hash":"3115171778","FullDateString":"2026 年 9月 月 2 日"},{"ImageContent":{"Description":"9 月は米国のキノコ月間。キノコの多様性や健康への効果について理解を深めるための啓発月間です。私たちが「キノコ」と呼ぶものは、菌類が作り出した「子実体」と呼ばれるもので、胞子形成のために菌糸が組み合わさり複雑な構造になったものを指します。そして、今日の画像は、オチバタケという小さなキノコ。落ち葉の積もる林床などに生え、黒色の馬の毛状菌糸束を持っています。","Image":{"Url":"/th?id=OHR.HorseHairShroom_JA-JP2550807968_1920x1080.webp","Wallpaper":"/th?id=OHR.HorseHairShroom_JA-JP2550807968_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"9 月は米国のキノコ月間","Title":"オチバタケ, ベラルーシ","Copyright":"© Máté/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/53.42506,27.697136/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=53.42506,27.697136;S9;ベラルーシ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260901_HorseHairShroom%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260901_HorseHairShroom\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b1%b3%e5%9b%bd%e3%81%ae%e3%82%ad%e3%83%8e%e3%82%b3%e6%9c%88%e9%96%93&form=hpcapt&filters=HpDate:\"20260831_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260901_HorseHairShroom"},"Ssd":"20260901","Name":"HorseHairShroom","Market":"JA-JP","Hash":"2550807968","FullDateString":"2026 年 9月 月 1 日"},{"ImageContent":{"Description":"レギスタン広場は、ウズベキスタンの古代都市サマルカンドの中心に位置する歴史的な広場です。 3 つのマドラサ（イスラムの神学校）に囲まれ、それぞれに独自の装飾が施されています。今日の画像は、マドラサ内部の天井に施された芸術的な装飾の一端です。釉薬を施したタイル、幾何学模様、花柄、そして美しく装飾された文字（カリグラフィー）が、驚くほどの精緻さで調和しています。こうした建築群を含むサマルカンドの歴史地区は、2001 年に世界遺産に登録されました。","Image":{"Url":"/th?id=OHR.SamarkandCeiling_JA-JP0717876578_1920x1080.webp","Wallpaper":"/th?id=OHR.SamarkandCeiling_JA-JP0717876578_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"精緻な幾何学模様が彩る天井","Title":"レギスタン広場のマドラサ, ウズベキスタン","Copyright":"© Piero M. Bianchi/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/39.654785,66.975616/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=39.654785,66.975616;S9;レギスタン広場, ウズベキスタン&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260831_SamarkandCeiling%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260831_SamarkandCeiling\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%ac%e3%82%ae%e3%82%b9%e3%82%bf%e3%83%b3%e5%ba%83%e5%a0%b4%e3%81%ae%e3%83%9e%e3%83%89%e3%83%a9%e3%82%b5&form=hpcapt&filters=HpDate:\"20260830_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260831_SamarkandCeiling"},"Ssd":"20260831","Name":"SamarkandCeiling","Market":"JA-JP","Hash":"0717876578","FullDateString":"2026 年 8月 月 31 日"},{"ImageContent":{"Description":"今日、8 月 30 日は国際ジンベエザメの日。そして今日の画像は、インドネシアのチェンデラワシ湾で撮影されたジンベエザメです。ジンベエザメは、現生の魚類では最大の種であり、体長は最大で約 20m、体重は 20 トン前後にまで達します。世界中の熱帯・亜熱帯・温帯の海に広く分布しており、プランクトンや小魚を主食としています。穏やかな性格で知られていますが、乱獲や混獲、船との衝突などの影響で世界的に個体数が減少しており、絶滅危惧種に指定されています。","Image":{"Url":"/th?id=OHR.YellowShark_JA-JP0572284773_1920x1080.webp","Wallpaper":"/th?id=OHR.YellowShark_JA-JP0572284773_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際ジンベエザメの日","Title":"ジンベエザメ, インドネシア","Copyright":"© Pete Oxford/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-2.499488,135.299988/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-2.499488,135.299988;S9;チェンデラワシ湾, インドネシア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260830_YellowShark%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260830_YellowShark\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%9a%9b%e3%82%b8%e3%83%b3%e3%83%99%e3%82%a8%e3%82%b6%e3%83%a1%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260829_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260830_YellowShark"},"Ssd":"20260830","Name":"YellowShark","Market":"JA-JP","Hash":"0572284773","FullDateString":"2026 年 8月 月 30 日"},{"ImageContent":{"Description":"今日 8 月 29 日は全国花火競技大会の開催日。秋田県大仙市で行われるこの大会は、「大曲の花火」とも呼ばれ、日本三大花火大会の一つとして知られており、全国から選抜された花火師が、「昼花火の部」と「夜花火の部」で技を競います。昼花火とは、光ではなく煙で美しさを表現する花火です。また、大曲の花火最大の特徴であり、大会を象徴する競技が、夜花火の部で行われる「創造花火」。既成概念に囚われず、形や色、大きさなど全てがオリジナルの花火を、音楽にあわせて披露する競技です。","Image":{"Url":"/th?id=OHR.OmagariFireworks2026_JA-JP0416831919_1920x1080.webp","Wallpaper":"/th?id=OHR.OmagariFireworks2026_JA-JP0416831919_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は大曲の花火の開催日","Title":"全国花火競技大会, 秋田県, 大仙市","Copyright":"© Toru Hanai/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/39.453094,140.475449/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=39.453094,140.475449;S9;秋田県, 大仙市&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260829_OmagariFireworks2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260829_OmagariFireworks2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%85%a8%e5%9b%bd%e8%8a%b1%e7%81%ab%e7%ab%b6%e6%8a%80%e5%a4%a7%e4%bc%9a&form=hpcapt&filters=HpDate:\"20260828_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260829_OmagariFireworks2026"},"Ssd":"20260829","Name":"OmagariFireworks2026","Market":"JA-JP","Hash":"0416831919","FullDateString":"2026 年 8月 月 29 日"},{"ImageContent":{"Description":"フランス・ノルマンディーの海に浮かぶモン・サン＝ミシェルが、夕陽に照らされて幻想的な姿を見せています。岩山の上にそびえ立つこの修道院は、ヨーロッパでも屈指の海岸景観で知られており、潮が引くと広大な干潟が現れ、満潮になると周囲を海に囲まれた島のような景観となります。その起源は 708 年にさかのぼるとされ、長い歴史の中でヨーロッパを代表するカトリックの巡礼地のひとつへと発展しました。そして、1979 年には「モン＝サン＝ミシェルとその湾」として、ユネスコの世界遺産に登録されました。","Image":{"Url":"/th?id=OHR.MichelSunset_JA-JP0274204340_1920x1080.webp","Wallpaper":"/th?id=OHR.MichelSunset_JA-JP0274204340_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海岸風景の中にそびえる修道院","Title":"モン・サン＝ミシェル, フランス","Copyright":"© Clement LEONARD/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.635078,-1.51064/15?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=48.635078,-1.51064;S9;モン・サン＝ミシェル, フランス&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260828_MichelSunset%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260828_MichelSunset\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%a2%e3%83%b3%e3%83%bb%e3%82%b5%e3%83%b3%ef%bc%9d%e3%83%9f%e3%82%b7%e3%82%a7%e3%83%ab&form=hpcapt&filters=HpDate:\"20260827_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260828_MichelSunset"},"Ssd":"20260828","Name":"MichelSunset","Market":"JA-JP","Hash":"0274204340","FullDateString":"2026 年 8月 月 28 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"ここは、スペイン南部アンダルシア州にある町、オルベラです。白い壁と赤や茶色の瓦屋根の家が丘の斜面に連なる光景は、アンダルシアに点在している「白い村（プエブロ・ブランコ）」の一つとして知られています。町は、広大なオリーブ畑に囲まれた丘の上に広がり、古くから戦略的な要地として発展してきました。丘の頂にそびえるムーア人の城塞とエンカルナシオン教会は、オルベラのランドマークであり、イスラム文化とキリスト教文化が交錯した歴史を今に伝えています。","Image":{"Url":"/th?id=OHR.Olvera_JA-JP5093791420_1920x1080.webp","Wallpaper":"/th?id=OHR.Olvera_JA-JP5093791420_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"赤茶色の屋根が映えるアンダルシアの街","Title":"オルベラ, スペイン","Copyright":"© Marco Bottigelli/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.935253,-5.267688/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.935253,-5.267688;S9;オルベラ, スペイン&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260910_Olvera%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260910_Olvera\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%aa%e3%83%ab%e3%83%99%e3%83%a9&form=hpcapt&filters=HpDate:\"20260909_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260910_Olvera"},"Ssd":"20260910","Name":"Olvera","Market":"JA-JP","Hash":"5093791420","FullDateString":"2026 年 9月 月 10 日"},{"ImageContent":{"Description":"今日 9 月 9 日は「重陽の節句」です。七草の節句、桃の節句、端午の節句、笹の節句（七夕）と並ぶ五節句の一つで、その起源は古代中国に遡ります。中国の陰陽五行説では、奇数が重なる縁起のよい日とされ、厄除けや長寿を願う行事が行われます。これが日本に伝わり、旧暦の 9 月 9 日頃は菊の花が咲き誇る季節でもあったことから、日本では「菊の節句」とも呼ばれるようになりました。平安時代には、貴族たちが菊の宴を催しました。また、菊の花に宿った露を真綿に移した「菊の被綿（きせわた）」で体をぬぐい、無病息災や長寿を祈ったといわれています。","Image":{"Url":"/th?id=OHR.ChungYang2026_JA-JP4920316432_1920x1080.webp","Wallpaper":"/th?id=OHR.ChungYang2026_JA-JP4920316432_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は重陽の節句","Title":"菊の花","Copyright":"© yanjf/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"日本の皇室の紋章は「菊花紋章」。16枚の花びらを持つ菊を図案化したもので、パスポートの表紙にも描かれています。","LinkUrl":"/search?q=%e7%9a%87%e5%ae%a4%e3%81%ae%e7%b4%8b%e7%ab%a0%e3%81%a8%e3%81%97%e3%81%a6%e8%8f%8a%e8%8a%b1%e7%b4%8b%e7%ab%a0%e3%81%8c%e4%bd%bf%e3%82%8f%e3%82%8c%e3%81%a6%e3%81%84%e3%82%8b&form=hpvsfa","LinkText":"皇室の紋章として菊花紋章が使われている理由"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260909_ChungYang2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e9%87%8d%e9%99%bd%e3%81%ae%e7%af%80%e5%8f%a5&form=hpcapt&filters=HpDate:\"20260908_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260909_ChungYang2026"},"Ssd":"20260909","Name":"ChungYang2026","Market":"JA-JP","Hash":"4920316432","FullDateString":"2026 年 9月 月 9 日"},{"ImageContent":{"Description":"ここはイングランドのハンプシャー州、サウス・ダウンズ国立公園にあるイースト・ミーオンという村です。水はけの良い白亜質の土壌が大規模な耕作に適していたため、この白亜の丘陵地帯では何世紀にもわたり農業が行われ、小麦や大麦といった作物が栽培されてきました。収穫期を迎えると、黄金色の畑が広がる美しい風景へと変わります。","Image":{"Url":"/th?id=OHR.BeechEngland_JA-JP4737159434_1920x1080.webp","Wallpaper":"/th?id=OHR.BeechEngland_JA-JP4737159434_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"黄金色の麦畑に立つブナの木","Title":"イースト・ミーオン, イングランド","Copyright":"© Guy Edwardes/Minden Pictures","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/50.998574,-1.033569/13?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=50.998574,-1.033569;S9;イースト・ミーオン, イングランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260908_BeechEngland %22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260908_BeechEngland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8f%e3%83%b3%e3%83%97%e3%82%b7%e3%83%a3%e3%83%bc&form=hpcapt&filters=HpDate:\"20260907_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260908_BeechEngland"},"Ssd":"20260908","Name":"BeechEngland","Market":"JA-JP","Hash":"4737159434","FullDateString":"2026 年 9月 月 8 日"},{"ImageContent":{"Description":"ここは、ドイツ・バイエルン州バンベルクの旧市街です。画像の中心にある旧市庁舎は、街を象徴するランドマークとして知られており、ゴシック様式とバロック様式が調和した美しい建物と石橋が、印象的な景観をつくり出しています。伝承によると、司教が市庁舎を建てるための土地を与えなかったため、市民がレーグニッツ川に人工島を築き、その上に建設したとされています。この建物を含む旧市街は、中世の街並みをよく残す歴史都市として評価され、1993 年に世界遺産に登録されました。","Image":{"Url":"/th?id=OHR.BambergTownhall_JA-JP4474746509_1920x1080.webp","Wallpaper":"/th?id=OHR.BambergTownhall_JA-JP4474746509_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"川の上に建つ旧市庁舎","Title":"バンベルク市街, ドイツ","Copyright":"© SCStock/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/49.894218,10.885527/13?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=49.894218,10.885527;S9;バンベルク市街, ドイツ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260907_BambergTownhall%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260907_BambergTownhall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%90%e3%83%b3%e3%83%99%e3%83%ab%e3%82%af%e5%b8%82%e8%a1%97&form=hpcapt&filters=HpDate:\"20260906_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260907_BambergTownhall"},"Ssd":"20260907","Name":"BambergTownhall","Market":"JA-JP","Hash":"4474746509","FullDateString":"2026 年 9月 月 7 日"},{"ImageContent":{"Description":"ここは、ファイアンズ湖。オーストラリア・ビクトリア州のグランピアンズ国立公園の麓に位置する人工貯水池で、ボートや釣り、セーリング、水上スキーなどで人気です。そして湖の向こうには、グランピアンズ国立公園の砂岩の山並みが広がっています。公園は壮大な景観や美しい滝、先住民の文化遺産で知られ、トレイルではカンガルーやエミューなどの野生動物を観察することもできます。","Image":{"Url":"/th?id=OHR.LakeFyans_JA-JP2778092364_1920x1080.webp","Wallpaper":"/th?id=OHR.LakeFyans_JA-JP2778092364_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"空を映す静かな人工貯水池","Title":"ファイアンズ湖, オーストラリア","Copyright":"© tracielouise/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-37.142867,142.612567/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-37.142867,142.612567;S9;ファイアンズ湖, オーストラリア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260906_LakeFyans%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260906_LakeFyans\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Fyans+Lake+%e3%82%aa%e3%83%bc%e3%82%b9%e3%83%88%e3%83%a9%e3%83%aa%e3%82%a2&form=hpcapt&filters=HpDate:\"20260905_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260906_LakeFyans"},"Ssd":"20260906","Name":"LakeFyans","Market":"JA-JP","Hash":"2778092364","FullDateString":"2026 年 9月 月 6 日"},{"ImageContent":{"Description":"9 月の第 1 土曜日は、米国の「ハチドリの日」。ハチドリの保護に対する意識向上と支援を目的に毎年祝われています。ハチドリは、南北米大陸に生息する美しい羽を持つ小鳥です。花の蜜を主な餌とし、ホバリングしながら花にくちばしを差し込んで蜜を吸います。そして画像は、コスタリカで撮影されたヘリコニアの花の蜜を吸うミドリボウシテリハチドリ。中米に生息する大型のハチドリの一種で、虹色に輝くエメラルドグリーンの羽と、わずかに湾曲した長いくちばしが特徴です。","Image":{"Url":"/th?id=OHR.GreenCrowned_JA-JP4075782685_1920x1080.webp","Wallpaper":"/th?id=OHR.GreenCrowned_JA-JP4075782685_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国のハチドリの日","Title":"ミドリボウシテリハチドリ, コスタリカ","Copyright":"© Paul Hobson/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/9.979021,-84.195129/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=9.979021,-84.195129;S