{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-26T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"ここはシーダーメサ。米国ユタ州にあるベアーズ・イヤーズ国定公園の南部に位置する台地です。標高は約 2,000m で、考古学上の宝庫として知られるグランド・ガルチをはじめ、深い峡谷が数多く存在しています。南側にはミューリー・ポイントと呼ばれる岬があり、ここからサンファン川やバレー・オブ・ザ・ゴッズ、モニュメント・バレー、ナバホ・マウンテンといった素晴らしい景観を一望できます。また、シーダーメサの向こうには 2 つの丘がそびえており、これがクマの耳（ベアーズイヤーズ）に似ていることが、公園の名前の由来となっています。","Image":{"Url":"/th?id=OHR.BearsEars_JA-JP8214752036_1920x1080.webp","Wallpaper":"/th?id=OHR.BearsEars_JA-JP8214752036_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"標高約2,000mから見渡す大峡谷","Title":"シーダーメサ, 米国 ユタ州","Copyright":"© Jeff Clay/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.433414,-109.916978/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=37.433414,-109.916978;S9;シーダーメサ, 米国 ユタ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260926_BearsEars%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260926_BearsEars\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b7%e3%83%bc%e3%83%80%e3%83%bc%e3%83%a1%e3%82%b5&form=hpcapt&filters=HpDate:\"20260925_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260926_BearsEars"},"Ssd":"20260926","Name":"BearsEars","Market":"JA-JP","Hash":"8214752036","FullDateString":"2026 年 9月 月 26 日"},{"ImageContent":{"Description":"2026 年は、今日 9 月 25 日が中秋の名月。お団子やススキなどをお供えしてお月見を楽しむ日であるとともに、秋の実りに感謝し、翌年の豊穣を祈願する日です。旧暦の 8 月 15 日にあたり、中国の中秋節に由来しています。日本ではお団子が主流ですが、中国では「月餅」という丸いお菓子を食べます。この月餅は、満月をかたどっているとともに、家族の円満や団らんを象徴しており、家族で集まって食べることで、全員の幸せを祈ります。","Image":{"Url":"/th?id=OHR.MidAutumn2026_JA-JP8034446964_1920x1080.webp","Wallpaper":"/th?id=OHR.MidAutumn2026_JA-JP8034446964_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は中秋の名月","Title":"中秋節用の中国提灯","Copyright":"© LeeYiuTung/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"中国では、月には「玉兎（ぎょくと）」というウサギが住み、不老不死の薬を作っていると伝えられています。","LinkUrl":"/search?q=%e6%97%a5%e6%9c%ac%e3%81%a7%e3%81%af%e3%80%81%e6%9c%88%e3%81%ae%e3%82%a6%e3%82%b5%e3%82%ae%e3%81%af%e4%bd%95%e3%82%92%e3%81%97%e3%81%a6%e3%81%84%e3%82%8b%e3%81%a8%e8%a8%80%e3%82%8f%e3%82%8c%e3%81%a6%e3%81%84%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"日本では、月のウサギは何をしていると言われている？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260925_MidAutumn2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%ad%e7%a7%8b%e3%81%ae%e5%90%8d%e6%9c%88&form=hpcapt&filters=HpDate:\"20260924_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260925_MidAutumn2026"},"Ssd":"20260925","Name":"MidAutumn2026","Market":"JA-JP","Hash":"8034446964","FullDateString":"2026 年 9月 月 25 日"},{"ImageContent":{"Description":"ここは、スペインのカナリア諸島に位置するランサローテ島にあるビーチ。黒い砂浜、ターコイズブルーの海、そして険しい断崖が織りなす独特の景観で知られています。1730 年から 1736 年にかけての大噴火によって、島の広い範囲が溶岩に覆われ、特徴的な黒い海岸線が形成されました。近くには鮮やかな緑色のクリコス湖があり、黒い砂浜、緑の湖、青い海が織りなすコントラストは、訪れる人々を魅了します。","Image":{"Url":"/th?id=OHR.ElGolfo_JA-JP7674043520_1920x1080.webp","Wallpaper":"/th?id=OHR.ElGolfo_JA-JP7674043520_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"黒い海岸に寄せる白波","Title":"ランサローテ島, スペイン","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/28.978999,-13.829368/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=28.978999,-13.829368;S9;エル・ゴルフォ, スペイン&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260924_ElGolfo%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260924_ElGolfo\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%a9%e3%83%b3%e3%82%b5%e3%83%ad%e3%83%bc%e3%83%86%e5%b3%b6&form=hpcapt&filters=HpDate:\"20260923_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260924_ElGolfo"},"Ssd":"20260924","Name":"ElGolfo","Market":"JA-JP","Hash":"7674043520","FullDateString":"2026 年 9月 月 24 日"},{"ImageContent":{"Description":"今日 9 月 23 日は秋分の日。国民の祝日の一つであり、昼と夜の長さがほぼ同じになる「秋分点」を迎える日です。また、秋のお彼岸の中日でもあり、お墓におはぎをお供えするなどして故人を偲びます。そして画像は、「秋の七草」の一つとして知られるナデシコ（撫子）です。世界中に約 300 種存在する耐寒性の多年草で、色はピンクや紫、赤、白など豊富です。主な花言葉は「純愛」で、色によっては「大胆」「才能」といった意味を持ちます。","Image":{"Url":"/th?id=OHR.Japan7Flower2026_JA-JP7430731593_1920x1080.webp","Wallpaper":"/th?id=OHR.Japan7Flower2026_JA-JP7430731593_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は秋分の日","Title":"秋の七草のナデシコ","Copyright":"© igaguri_1/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"秋の七草には、生薬として使われてきた植物が含まれています。","LinkUrl":"/search?q=%e9%a2%a8%e9%82%aa%e8%96%ac%e3%81%ae%e5%8e%9f%e6%96%99%e3%81%ab%e3%81%aa%e3%81%a3%e3%81%a6%e3%81%84%e3%82%8b%e7%a7%8b%e3%81%ae%e4%b8%83%e8%8d%89%e3%81%af%ef%bc%9f&form=hpvsfa","LinkText":"風邪薬の原料になっている秋の七草は？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260923_Japan7Flower2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%a7%8b%e5%88%86%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260922_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260923_Japan7Flower2026"},"Ssd":"20260923","Name":"Japan7Flower2026","Market":"JA-JP","Hash":"7430731593","FullDateString":"2026 年 9月 月 23 日"},{"ImageContent":{"Description":"今日の画像は、米国ユタ州ガーズマン・パス付近に広がるアスペンの森です。毎年秋になると、山々を鮮やかな黄金色に染め上げます。アスペンはヤマナラシ類の樹木で、白い樹皮と、わずかな風にも揺れて音を立てる葉で知られています。多くのアスペンは、地下でつながった根から新しい木を伸ばすため、隣接する木々が同じ遺伝情報を持つことがあります。その繁殖方法や成長の速さ、環境への高い適応力により、アスペンは山火事や伐採、地震の後にも素早く森林を再生させてくれる樹木としても知られています。","Image":{"Url":"/th?id=OHR.FallAspens_JA-JP7201900997_1920x1080.webp","Wallpaper":"/th?id=OHR.FallAspens_JA-JP7201900997_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"黄金色に染まる秋の森","Title":"アスペンの森, 米国 ユタ州","Copyright":"© Danita Delimont/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/40.609956,-111.52843/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=40.609956,-111.52843;S9;ガーズマン・パス, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260922_FallAspens%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260922_FallAspens\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%82%b9%e3%83%9a%e3%83%b3%e3%81%ae%e6%a3%ae&form=hpcapt&filters=HpDate:\"20260921_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260922_FallAspens"},"Ssd":"20260922","Name":"FallAspens","Market":"JA-JP","Hash":"7201900997","FullDateString":"2026 年 9月 月 22 日"},{"ImageContent":{"Description":"今日の画像は、米国カリフォルニア州のモントレー湾で毛づくろいをするラッコ。アザラシやクジラは、皮下脂肪によって海でも体温を保ちますが、ラッコには皮下脂肪がほとんどありません。その代わり、全身を約 8 億本もの体毛が覆っており、その密な体毛の間に空気の層を作ることで、体温を保っています。かつては毛皮目的の乱獲によって個体数が大きく減少しましたが、保護活動によって徐々に回復しています。","Image":{"Url":"/th?id=OHR.GroomingOtter_JA-JP7012183872_1920x1080.webp","Wallpaper":"/th?id=OHR.GroomingOtter_JA-JP7012183872_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今週はラッコ啓蒙週間","Title":"ラッコ, 米国 カリフォルニア州","Copyright":"© Suzi Eszterhas/Minden Pictures","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.800739,-121.947311/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.800739,-121.947311;S9;モントレー湾, 米国 カリフォルニア州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260921_GroomingOtter%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260921_GroomingOtter\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%a9%e3%83%83%e3%82%b3%e5%95%93%e8%92%99%e9%80%b1%e9%96%93&form=hpcapt&filters=HpDate:\"20260920_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260921_GroomingOtter"},"Ssd":"20260921","Name":"GroomingOtter","Market":"JA-JP","Hash":"7012183872","FullDateString":"2026 年 9月 月 21 日"},{"ImageContent":{"Description":"ここはフランス最大の都市パリ。そして、中央にそびえるのがエッフェル塔です。フランス革命 100 周年を記念する 1889 年のパリ万国博覧会に合わせて建設されました。塔の名前は、設計者であるギュスターヴ・エッフェルに由来します。完成当初の高さは 300m で、1930 年に米国でクライスラー・ビルディングが建設されるまでは、世界で最も高い建造物でした。現在も多くの観光客が訪れる名所として親しまれており、フランスの創造性や技術力を象徴しています。","Image":{"Url":"/th?id=OHR.ParisSunset_JA-JP6560235841_1920x1080.webp","Wallpaper":"/th?id=OHR.ParisSunset_JA-JP6560235841_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"夕焼けに染まるエッフェル塔","Title":"パリ, フランス","Copyright":"© Alexander Spatari/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.856895,2.350849/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=48.856895,2.350849;S9;パリ, フランス&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260920_ParisSunset%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260920_ParisSunset\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%91%e3%83%aa&form=hpcapt&filters=HpDate:\"20260919_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260920_ParisSunset"},"Ssd":"20260920","Name":"ParisSunset","Market":"JA-JP","Hash":"6560235841","FullDateString":"2026 年 9月 月 20 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"今日の画像は、アンモナイトの化石。アンモナイトは、約 4 億年前から 6600 万年前まで海に生息していた海洋軟体動物です。殻の内部が複数の部屋に分かれているなど、現生のオウムガイ類と似た特徴を持っていますが、イカやタコなどを含むグループにより近いと考えられています。多くの種類に見られる特徴的な螺旋形の殻から、古代生物の代表的な化石として広く知られています。また、世界各地で化石が発見されており、地層の年代決定や先史時代の海洋環境の研究に活用されています。","Image":{"Url":"/th?id=OHR.AmmoniteFossils_JA-JP8778940090_1920x1080.webp","Wallpaper":"/th?id=OHR.AmmoniteFossils_JA-JP8778940090_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"古代の海に生息していた動物の化石","Title":"アンモナイトの化石","Copyright":"© J Nemchinova/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"化石とは、過去の生物の体や活動の痕跡が長い時間を経て自然に保存されたものです。アンモナイトの殻もその一種です。","LinkUrl":"/search?q=%e5%8c%96%e7%9f%b3%e3%81%ab%e3%81%af%e3%81%a9%e3%81%ae%e3%82%88%e3%81%86%e3%81%aa%e3%82%82%e3%81%ae%e3%81%8c%e3%81%82%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"化石にはどのようなものがある？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261003_AmmoniteFossils\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%b3%e3%83%a2%e3%83%8a%e3%82%a4%e3%83%88&form=hpcapt&filters=HpDate:\"20261002_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261003_AmmoniteFossils"},"Ssd":"20261003","Name":"AmmoniteFossils","Market":"JA-JP","Hash":"8778940090","FullDateString":"2026 年 10月 月 3 日"},{"ImageContent":{"Description":"ここはチャトゥーガ川。米国ノースカロライナ州のアパラチア山脈を源流とし、サウスカロライナ州とジョージア州の州境を流れる川です。長さは約 92km で、米国南東部で最も長い自由流河川の一つです。美しい景観と豊かな生態系で知られているほか、ラフティングやカヤック、カヌーといったアクティビティを楽しむことができます。","Image":{"Url":"/th?id=OHR.ChattoogaRiver_JA-JP8558662500_1920x1080.webp","Wallpaper":"/th?id=OHR.ChattoogaRiver_JA-JP8558662500_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"川面を流れる紅葉","Title":"チャトゥーガ川, 米国 ノースカロライナ州","Copyright":"© mtilghma/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.080936,-83.109932/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.080936,-83.109932;S9;チャトゥーガ川, 米国 ノースカロライナ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261002_ChattoogaRiver%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261002_ChattoogaRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%81%e3%83%a3%e3%83%88%e3%82%a5%e3%83%bc%e3%82%ac%e5%b7%9d&form=hpcapt&filters=HpDate:\"20261001_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261002_ChattoogaRiver"},"Ssd":"20261002","Name":"ChattoogaRiver","Market":"JA-JP","Hash":"8558662500","FullDateString":"2026 年 10月 月 2 日"},{"ImageContent":{"Description":"1890 年 10 月 1 日、ヨセミテは米国で 3 番目の国立公園となりました。そして、今日の画像は公園内にあるビュースポット、「オルムステッド・ポイント」です。この場所からは、ハーフドームの切り立った北側やテナヤ峡谷、テナヤ湖といった公園を代表する名所を見渡すことができます。その名前は、米国の国立公園設立運動に貢献した造園家・フレデリック・ロー・オルムステッドとその息子に由来しています。ヨセミテを代表する絶景スポットであり、数百万年にわたる地殻変動や氷河作用が生み出した大地の歴史を私たちに伝えてくれます。","Image":{"Url":"/th?id=OHR.OlmstedPoint_JA-JP0098463265_1920x1080.webp","Wallpaper":"/th?id=OHR.OlmstedPoint_JA-JP0098463265_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"夕日に染まるヨセミテの岩峰","Title":"オルムステッド・ポイント, 米国 カリフォルニア州","Copyright":"© Robb Hirsch/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.850924,-119.572719/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=37.850924,-119.572719;S9;ヨセミテ国立公園, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261001_OlmstedPoint%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261001_OlmstedPoint\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%aa%e3%83%ab%e3%83%a0%e3%82%b9%e3%83%86%e3%83%83%e3%83%89%e3%83%bb%e3%83%9d%e3%82%a4%e3%83%b3%e3%83%88&form=hpcapt&filters=HpDate:\"20260930_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261001_OlmstedPoint"},"Ssd":"20261001","Name":"OlmstedPoint","Market":"JA-JP","Hash":"0098463265","FullDateString":"2026 年 10月 月 1 日"},{"ImageContent":{"Description":"今日の画像は、イングランド・ノーフォークで撮影されたオスのヒゲガラ。イギリスやヨーロッパに分布するスズメ目の鳥で、主に河川や湖沼などの湿地帯に生息しています。春から夏にかけては昆虫を、秋から冬にかけてはヨシやスゲの種子を主に食べ、ほとんど渡りをせずに同じ生息地で暮らします。オスは頭部の羽毛が灰色で、くちばしの基部から下方へ伸びるひげ状の黒斑があり、その特徴が名前の由来となっています。メスの頭部の羽毛は淡褐色で、オスのような黒斑はありません。","Image":{"Url":"/th?id=OHR.BeardReedling_JA-JP9843863193_1920x1080.webp","Wallpaper":"/th?id=OHR.BeardReedling_JA-JP9843863193_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"枯れ草にとまる小鳥","Title":"ヒゲガラ, イングランド","Copyright":"© Andrew Sproule/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.930101,0.952909/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=52.930101,0.952909;S9;ノーフォーク, イングランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260930_BeardReedling%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260930_BeardReedling\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%92%e3%82%b2%e3%82%ac%e3%83%a9&form=hpcapt&filters=HpDate:\"20260929_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260930_BeardReedling"},"Ssd":"20260930","Name":"BeardReedling","Market":"JA-JP","Hash":"9843863193","FullDateString":"2026 年 9月 月 30 日"},{"ImageContent":{"Description":"今日の画像は、米国アラスカ州南部のキナイ半島を流れるカシロフ川。水源であるツツメナ氷河から運ばれる氷河岩粉によって、水の色は鮮やかなミルキーブルーとなっています。川は約 27km にわたって流れ、クック湾へと注ぎ込みます。この川には、サケやマスが豊富に生息し、人気の釣りスポットとして知られています。また、周辺ではキャンプや自然遊歩道の散策も楽しめます。","Image":{"Url":"/th?id=OHR.KasilofRiver_JA-JP7219675730_1920x1080.webp","Wallpaper":"/th?id=OHR.KasilofRiver_JA-JP7219675730_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"氷河の恵みをたたえる川","Title":"カシロフ川, 米国 アラスカ州","Copyright":"© jared lloyd/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/60.386498,-151.301832/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=60.386498,-151.301832;S9;カシロフ川, 米国 アラスカ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260929_KasilofRiver%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260929_KasilofRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%82%b7%e3%83%ad%e3%83%95%e5%b7%9d&form=hpcapt&filters=HpDate:\"20260928_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260929_KasilofRiver"},"Ssd":"20260929","Name":"KasilofRiver","Market":"JA-JP","Hash":"7219675730","FullDateString":"2026 年 9月 月 29 日"},{"ImageContent":{"Description":"アンベール城は、インドのラージャスターン州ジャイプル郊外にある宮殿要塞です。1592年、ラージャ・マーン・シング 1 世が築城を始め、以後、カッチワハ朝の歴代統治者によって拡張されていきました。1727 年に王族はジャイプルへと移りましたが、アンベール城はその後も儀礼の場として使用されていました。ヒンドゥー、ラージプート、ムガルの建築様式が融合した壮麗な城で、現在はジャイプルを代表する観光名所の一つとして知られています。そして、今日の画像は城内にあるサッタイス・カチェリで、「 27 本の柱の宮殿」を意味する建造物です。","Image":{"Url":"/th?id=OHR.AmberHall_JA-JP9172458689_1920x1080.webp","Wallpaper":"/th?id=OHR.AmberHall_JA-JP9172458689_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"優美な柱が並ぶ宮殿","Title":"アンベール城, インド","Copyright":"© R.M. Nunes/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/26.986382,75.851341/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=26.986382,75.851341;S9;アンベール城, インド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260928_AmberHall%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260928_AmberHall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%b3%e3%83%99%e3%83%bc%e3%83%ab%e5%9f%8e&form=hpcapt&filters=HpDate:\"20260927_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260928_AmberHall"},"Ssd":"20260928","Name":"AmberHall","Market":"JA-JP","Hash":"9172458689","FullDateString":"2026 年 9月 月 28 日"},{"ImageContent":{"Description":"1989 年の今日、9 月 27 日に、横浜ベイブリッジは開通しました。横浜市の中区と鶴見区を結ぶ全長 860m の橋で、完成当時は日本最長の斜張橋でした。上層部は首都高速湾岸線、下層部は国道 357 号という 2 層構造になっています。美しい夜景スポットとして知られており、近隣の横浜港大さん橋国際客船ターミナルから月と共に撮影された姿は、日本百名月にも選ばれています。また、優れた技術力と美しいデザインが評価され、日本百名橋の一つにも選ばれています。","Image":{"Url":"/th?id=OHR.YokohamaBayBridge_JA-JP8812921625_1920x1080.webp","Wallpaper":"/th?id=OHR.YokohamaBayBridge_JA-JP8812921625_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は横浜ベイブリッジ開通日","Title":"横浜ベイブリッジ, 神奈川県 横浜市","Copyright":"© Yuga Kurita/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.454465,139.673569/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.454465,139.673569;S9;横浜ベイブリッジ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260927_YokohamaBayBridge%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260927_YokohamaBayBridge\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%a8%aa%e6%b5%9c%e3%83%99%e3%82%a4%e3%83%96%e3%83%aa%e3%83%83%e3%82%b8%e9%96%8b%e9%80%9a%e6%97%a5&form=hpcapt&filters=HpDate:\"20260926_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260927_YokohamaBayBridge"},"Ssd":"20260927","Name":"YokohamaBayBridge","Market":"JA-JP","Hash":"8812921625","FullDateString":"2026 年 9月 月 27 日"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"今日の画像","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"詳細情報","LOC_HOMEPAGE_VERTICAL_SCROLL_DONATE_NOW":"今すぐ寄付","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"基本データ:","LOC_HOMEPAGE_GALLERY_CARD_TITLE":"最近のホームページの画像","LOC_HOMEPAGE_VERTICAL_SCROLL_GALLERY_IMAGE_ARIALABEL":"{0} のホームページ画像","LOC_HOMEPAGE_ON_THIS_