{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-08-29T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"今日 8 月 29 日は全国花火競技大会の開催日。秋田県大仙市で行われるこの大会は、「大曲の花火」とも呼ばれ、日本三大花火大会の一つとして知られており、全国から選抜された花火師が、「昼花火の部」と「夜花火の部」で技を競います。昼花火とは、光ではなく煙で美しさを表現する花火です。また、大曲の花火最大の特徴であり、大会を象徴する競技が、夜花火の部で行われる「創造花火」。既成概念に囚われず、形や色、大きさなど全てがオリジナルの花火を、音楽にあわせて披露する競技です。","Image":{"Url":"/th?id=OHR.OmagariFireworks2026_JA-JP0416831919_1920x1080.webp","Wallpaper":"/th?id=OHR.OmagariFireworks2026_JA-JP0416831919_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は大曲の花火の開催日","Title":"全国花火競技大会, 秋田県, 大仙市","Copyright":"© Toru Hanai/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/39.453094,140.475449/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=39.453094,140.475449;S9;秋田県, 大仙市&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260829_OmagariFireworks2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260829_OmagariFireworks2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%85%a8%e5%9b%bd%e8%8a%b1%e7%81%ab%e7%ab%b6%e6%8a%80%e5%a4%a7%e4%bc%9a&form=hpcapt&filters=HpDate:\"20260828_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260829_OmagariFireworks2026"},"Ssd":"20260829","Name":"OmagariFireworks2026","Market":"JA-JP","Hash":"0416831919","FullDateString":"2026 年 8月 月 29 日"},{"ImageContent":{"Description":"フランス・ノルマンディーの海に浮かぶモン・サン＝ミシェルが、夕陽に照らされて幻想的な姿を見せています。岩山の上にそびえ立つこの修道院は、ヨーロッパでも屈指の海岸景観で知られており、潮が引くと広大な干潟が現れ、満潮になると周囲を海に囲まれた島のような景観となります。その起源は 708 年にさかのぼるとされ、長い歴史の中でヨーロッパを代表するカトリックの巡礼地のひとつへと発展しました。そして、1979 年には「モン＝サン＝ミシェルとその湾」として、ユネスコの世界遺産に登録されました。","Image":{"Url":"/th?id=OHR.MichelSunset_JA-JP0274204340_1920x1080.webp","Wallpaper":"/th?id=OHR.MichelSunset_JA-JP0274204340_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海岸風景の中にそびえる修道院","Title":"モン・サン＝ミシェル, フランス","Copyright":"© Clement LEONARD/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.635078,-1.51064/15?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=48.635078,-1.51064;S9;モン・サン＝ミシェル, フランス&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260828_MichelSunset%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260828_MichelSunset\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%a2%e3%83%b3%e3%83%bb%e3%82%b5%e3%83%b3%ef%bc%9d%e3%83%9f%e3%82%b7%e3%82%a7%e3%83%ab&form=hpcapt&filters=HpDate:\"20260827_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260828_MichelSunset"},"Ssd":"20260828","Name":"MichelSunset","Market":"JA-JP","Hash":"0274204340","FullDateString":"2026 年 8月 月 28 日"},{"ImageContent":{"Description":"今日8月27日は「世界湖沼の日」。湖沼の重要性と保全への意識を高めるため、2024 年に国連総会で制定されました。湖沼は貴重な淡水資源であり、多様な生物を支える重要な存在です。しかし、都市化や気候変動などの影響により、その存続が脅かされています。そして、今日の画像は、ケニア南西部のマガディ湖に集まるコフラミンゴの群れ。マガディ湖は強アルカリ性で魚はほとんどいないものの、藻類が豊富であり、フラミンゴはそれを求めて集まっています。","Image":{"Url":"/th?id=OHR.LakeMagadi_JA-JP0125683063_1920x1080.webp","Wallpaper":"/th?id=OHR.LakeMagadi_JA-JP0125683063_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は世界湖沼の日","Title":"マガディ湖, ケニア","Copyright":"© Denis-Huot/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-1.902409,36.265224/12?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-1.902409,36.265224;S9;マガディ湖, ケニア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260827_LakeMagadi%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260827_LakeMagadi\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e6%b9%96%e6%b2%bc%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260826_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260827_LakeMagadi"},"Ssd":"20260827","Name":"LakeMagadi","Market":"JA-JP","Hash":"0125683063","FullDateString":"2026 年 8月 月 27 日"},{"ImageContent":{"Description":"アイスランドでは秋の訪れとともに夜が長くなり、オーロラ観測に適した季節が近づいています。オーロラで見られる青や緑、紫などに揺らめく光は、太陽から飛来した電気を帯びた粒子（プラズマ）が地球の高層大気中のガスと衝突することで発生します。そして、今日の画像はその幻想的な光の下にそびえるキルキュフェットル山。「教会の山」を意味する山で、晴れた夜には、この山と滝、そしてオーロラが織りなす絶景が多くの人々を魅了します。","Image":{"Url":"/th?id=OHR.AurorasIceland_JA-JP9970815507_1920x1080.webp","Wallpaper":"/th?id=OHR.AurorasIceland_JA-JP9970815507_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"オーロラが描く幻想の空","Title":"オーロラ, アイスランド","Copyright":"© Cavan Images/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/64.947731,-23.310894/14?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=64.947731,-23.310894;S9;キルキュフェットル山, アイスランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260826_AurorasIceland%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260826_AurorasIceland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%aa%e3%83%bc%e3%83%ad%e3%83%a9&form=hpcapt&filters=HpDate:\"20260825_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260826_AurorasIceland"},"Ssd":"20260826","Name":"AurorasIceland","Market":"JA-JP","Hash":"9970815507","FullDateString":"2026 年 8月 月 26 日"},{"ImageContent":{"Description":"今日 8 月 25 日は、米国国立公園局の創立記念日です。1916 年に野生生物や自然、史跡などを保護することを目的として設立されて以降、多くの国立公園や史跡を管理しています。そして画像は、カリフォルニア州にあるレッドウッド国立州立公園。地球上で最も高い木のひとつとされるセコイアメスギの原生林が広がるこの公園も、国立公園局が管理しており、古くから伝わる貴重な自然環境を現在、そして未来へと伝えています。","Image":{"Url":"/th?id=OHR.RedwoodPark_JA-JP9805095528_1920x1080.webp","Wallpaper":"/th?id=OHR.RedwoodPark_JA-JP9805095528_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国国立公園局の創立記念日","Title":"レッドウッド国立州立公園, 米国 カリフォルニア州","Copyright":"© HadelProductions/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.401718,-124.04171/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=41.401718,-124.04171;S9;レッドウッド国立州立公園, 米国 カリフォルニア州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260825_RedwoodPark%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260825_RedwoodPark\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b1%b3%e5%9b%bd%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9c%92%e5%b1%80%e3%81%ae%e5%89%b5%e7%ab%8b%e8%a8%98%e5%bf%b5%e6%97%a5&form=hpcapt&filters=HpDate:\"20260824_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260825_RedwoodPark"},"Ssd":"20260825","Name":"RedwoodPark","Market":"JA-JP","Hash":"9805095528","FullDateString":"2026 年 8月 月 25 日"},{"ImageContent":{"Description":"今日の画像は、米国・ニューヨークのランドマークとして親しまれているブルックリン橋。設計者はジョン・A・ローブリングで、彼の死後、その遺志を継いだ息子夫婦が、14年の歳月をかけて 1883 年に完成させました。世界初の鋼鉄製吊り橋であり、ニューヨーク市のマンハッタン区とブルックリン区を結ぶ米国内で最も古い吊橋の一つです。その美しい景観から人気の観光地・撮影スポットとして知られるほか、古くから様々な映画のロケ地としても使用されています。","Image":{"Url":"/th?id=OHR.BKBridge_JA-JP9540004516_1920x1080.webp","Wallpaper":"/th?id=OHR.BKBridge_JA-JP9540004516_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"イースト川を彩る歴史の架け橋","Title":"ブルックリン橋, 米国 ニューヨーク州","Copyright":"© shayes17/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/40.706496,-73.996869/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=40.706496,-73.996869;S9;ブルックリン橋, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260824_BKBridge%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260824_BKBridge\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%96%e3%83%ab%e3%83%83%e3%82%af%e3%83%aa%e3%83%b3%e6%a9%8b&form=hpcapt&filters=HpDate:\"20260823_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260824_BKBridge"},"Ssd":"20260824","Name":"BKBridge","Market":"JA-JP","Hash":"9540004516","FullDateString":"2026 年 8月 月 24 日"},{"ImageContent":{"Description":"今日 8 月 23 日は二十四節気の一つ、「処暑」です。次の二十四節気である「白露」までの期間を指す言葉でもあり、厳しい夏の暑さが峠を越え、少しずつ秋の気配が感じられる頃とされています。そして、今日の画像は、静岡県内を流れる川の風景。自然豊かな川辺は真夏でも涼しさを感じることができ、夏の終わりにキャンプや散策を楽しむのにもぴったりの場所です。","Image":{"Url":"/th?id=OHR.ShizuokaSummer2026_JA-JP8848642076_1920x1080.webp","Wallpaper":"/th?id=OHR.ShizuokaSummer2026_JA-JP8848642076_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は処暑","Title":"夏の森を潤す清流, 静岡県","Copyright":"© Keiji Komatsu/AFLO/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.117672,138.114624/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.117672,138.114624;S9;静岡県&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260823_ShizuokaSummer2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260823_ShizuokaSummer2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%a4%8f%e3%81%ae%e6%a3%ae%e3%82%92%e6%bd%a4%e3%81%99%e6%b8%85%e6%b5%81&form=hpcapt&filters=HpDate:\"20260822_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260823_ShizuokaSummer2026"},"Ssd":"20260823","Name":"ShizuokaSummer2026","Market":"JA-JP","Hash":"8848642076","FullDateString":"2026 年 8月 月 23 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"9 月の第 1 土曜日は、米国の「ハチドリの日」。ハチドリの保護に対する意識向上と支援を目的に毎年祝われています。ハチドリは、南北米大陸に生息する美しい羽を持つ小鳥です。花の蜜を主な餌とし、ホバリングしながら花にくちばしを差し込んで蜜を吸います。そして画像は、コスタリカで撮影されたヘリコニアの花の蜜を吸うミドリボウシテリハチドリ。中米に生息する大型のハチドリの一種で、虹色に輝くエメラルドグリーンの羽と、わずかに湾曲した長いくちばしが特徴です。","Image":{"Url":"/th?id=OHR.GreenCrowned_JA-JP4075782685_1920x1080.webp","Wallpaper":"/th?id=OHR.GreenCrowned_JA-JP4075782685_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国のハチドリの日","Title":"ミドリボウシテリハチドリ, コスタリカ","Copyright":"© Paul Hobson/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/9.979021,-84.195129/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=9.979021,-84.195129;S9;コスタリカ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260905_GreenCrowned%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260905_GreenCrowned\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8f%e3%83%81%e3%83%89%e3%83%aa%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260904_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260905_GreenCrowned"},"Ssd":"20260905","Name":"GreenCrowned","Market":"JA-JP","Hash":"4075782685","FullDateString":"2026 年 9月 月 5 日"},{"ImageContent":{"Description":"ドイツ北海沿岸に広がる塩性湿地帯の中にそびえ立つヴェスターヘーファーザント灯台。赤と白の縞模様が特徴的なこの鋳鉄製灯台は、ユネスコ世界自然遺産に登録されているワッデン海の一部であるワッデン海国立公園内にあります。1906 年から 1908 年にかけて建設され、1 世紀以上にわたり北海を航行する船舶の安全を見守ってきました。現在は、ドイツ北部沿岸のランドマークの一つとして親しまれています。","Image":{"Url":"/th?id=OHR.Westerheversand_JA-JP0136915036_1920x1080.webp","Wallpaper":"/th?id=OHR.Westerheversand_JA-JP0136915036_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"草原の先にたたずむ灯台","Title":"ヴェスターヘーファーザント灯台, ドイツ","Copyright":"© bluejayphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/54.373718,8.639927/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=54.373718,8.639927;S9;ヴェスターヘーファーザント灯台, ドイツ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260904_Westerheversand%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260904_Westerheversand\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%b4%e3%82%a7%e3%82%b9%e3%82%bf%e3%83%bc%e3%83%98%e3%83%bc%e3%83%95%e3%82%a1%e3%83%bc%e3%82%b6%e3%83%b3%e3%83%88%e7%81%af%e5%8f%b0&form=hpcapt&filters=HpDate:\"20260903_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260904_Westerheversand"},"Ssd":"20260904","Name":"Westerheversand","Market":"JA-JP","Hash":"0136915036","FullDateString":"2026 年 9月 月 4 日"},{"ImageContent":{"Description":"今日の画像は米国アリゾナ州バーミリオン・クリフ国定公園に位置するコヨーテ・ビュート。砂漠に波が押し寄せたような独特の景観は、風や水が長い年月をかけて砂丘を浸食することで生まれました。こうした原生的な自然を守るため、米国では 1964 年 9 月 3 日に「原生自然法」が制定されました。当初は 54 か所、約 3 万 6,800km² が保護対象でしたが、現在ではその 10 倍を超える面積が指定され、手つかずの森や砂漠など大自然の魅力を未来へ受け継いでいます。","Image":{"Url":"/th?id=OHR.AZWilderness_JA-JP3309055326_1920x1080.webp","Wallpaper":"/th?id=OHR.AZWilderness_JA-JP3309055326_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国原生自然法制定の記念日","Title":"コヨーテ・ビュート, 米国 アリゾナ州","Copyright":"© James Hager/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.862603,-111.826977/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.862603,-111.826977;S9;バーミリオン・クリフ国定公園, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260903_AZWilderness%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260903_AZWilderness\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b3%e3%83%a8%e3%83%bc%e3%83%86%e3%83%bb%e3%83%93%e3%83%a5%e3%83%bc%e3%83%88&form=hpcapt&filters=HpDate:\"20260902_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260903_AZWilderness"},"Ssd":"20260903","Name":"AZWilderness","Market":"JA-JP","Hash":"3309055326","FullDateString":"2026 年 9月 月 3 日"},{"ImageContent":{"Description":"サウスウォルドは、イングランド東部サフォーク州の美しい海辺の町です。北海やブライス川、広大な湿地に囲まれた細長い半島に位置し、古くから漁業や交易で栄えてきました。海岸沿いには約 300 棟の色鮮やかな木造の小屋が並んでいます。この小屋はビーチハットと呼ばれ、もともとは海水浴客や漁師のための簡易的な休憩所として利用されていましたが、現在はレジャーや休暇を楽しむための施設として親しまれています。","Image":{"Url":"/th?id=OHR.SuffolkHuts_JA-JP3115171778_1920x1080.webp","Wallpaper":"/th?id=OHR.SuffolkHuts_JA-JP3115171778_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海岸に並ぶカラフルな小屋","Title":"ビーチハット, イングランド","Copyright":"© stevendocwra/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.326221,1.678968/13?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=52.326221,1.678968;S9;サウスウォルド, イングランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260902_SuffolkHuts%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260902_SuffolkHuts\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b5%e3%82%a6%e3%82%b9%e3%82%a6%e3%82%a9%e3%83%ab%e3%83%89%e3%82%b5%e3%83%95%e3%82%a9%e3%83%bc%e3%82%af%e5%b7%9e&form=hpcapt&filters=HpDate:\"20260901_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260902_SuffolkHuts"},"Ssd":"20260902","Name":"SuffolkHuts","Market":"JA-JP","Hash":"3115171778","FullDateString":"2026 年 9月 月 2 日"},{"ImageContent":{"Description":"9 月は米国のキノコ月間。キノコの多様性や健康への効果について理解を深めるための啓発月間です。私たちが「キノコ」と呼ぶものは、菌類が作り出した「子実体」と呼ばれるもので、胞子形成のために菌糸が組み合わさり複雑な構造になったものを指します。そして、今日の画像は、オチバタケという小さなキノコ。落ち葉の積もる林床などに生え、黒色の馬の毛状菌糸束を持っています。","Image":{"Url":"/th?id=OHR.HorseHairShroom_JA-JP2550807968_1920x1080.webp","Wallpaper":"/th?id=OHR.HorseHairShroom_JA-JP2550807968_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"9 月は米国のキノコ月間","Title":"オチバタケ, ベラルーシ","Copyright":"© Máté/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/53.42506,27.697136/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=53.42506,27.697136;S9;ベラルーシ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260901_HorseHairShroom%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260901_HorseHairShroom\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b1%b3%e5%9b%bd%e3%81%ae%e3%82%ad%e3%83%8e%e3%82%b3%e6%9c%88%e9%96%93&form=hpcapt&filters=HpDate:\"20260831_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260901_HorseHairShroom"},"Ssd":"20260901","Name":"HorseHairShroom","Market":"JA-JP","Hash":"2550807968","FullDateString":"2026 年 9月 月 1 日"},{"ImageContent":{"Description":"レギスタン広場は、ウズベキスタンの古代都市サマルカンドの中心に位置する歴史的な広場です。 3 つのマドラサ（イスラムの神学校）に囲まれ、それぞれに独自の装飾が施されています。今日の画像は、マドラサ内部の天井に施された芸術的な装飾の一端です。釉薬を施したタイル、幾何学模様、花柄、そして美しく装飾された文字（カリグラフィー）が、驚くほどの精緻さで調和しています。こうした建築群を含むサマルカンドの歴史地区は、2001 年に世界遺産に登録されました。","Image":{"Url":"/th?id=OHR.SamarkandCeiling_JA-JP0717876578_1920x1080.webp","Wallpaper":"/th?id=OHR.SamarkandCeiling_JA-JP0717876578_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"精緻な幾何学模様が彩る天井","Title":"レギスタン広場のマドラサ, ウズベキスタン","Copyright":"© Piero M. Bianchi/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/39.654785,66.975616/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=39.654785,66.975616;S9;レギスタン広場, ウズベキスタン&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260831_SamarkandCeiling%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260831_SamarkandCeiling\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%ac%e3%82%ae%e3%82%b9%e3%82%bf%e3%83%b3%e5%ba%83%e5%a0%b4%e3%81%ae%e3%83%9e%e3%83%89%e3%83%a9%e3%82%b5&form=hpcapt&filters=HpDate:\"20260830_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260831_SamarkandCeiling"},"Ssd":"20260831","Name":"SamarkandCeiling","Market":"JA-JP","Hash":"0717876578","FullDateString":"2026 年 8月 月 31 日"},{"ImageContent":{"Description":"今日、8 月 30 日は国際ジンベエザメの日。そして今日の画像は、インドネシアのチェンデラワシ湾で撮影されたジンベエザメです。ジンベエザメは、現生の魚類では最大の種であり、体長は最大で約 20m、体重は 20 トン前後にまで達します。世界中の熱帯・亜熱帯・温帯の海に広く分布しており、プランクトンや小魚を主食としています。穏やかな性格で知られていますが、乱獲や混獲、船との衝突などの影響で世界的に個体数が減少しており、絶滅危惧種に指定されています。","Image":{"Url":"/th?id=OHR.YellowShark_JA-JP0572284773_1920x1080.webp","Wallpaper":"/th?id=OHR.YellowShark_JA-JP0572284773_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際ジンベエザメの日","Title":"ジンベエザメ, インドネシア","Copyright":"© Pete Oxford/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-2.499488,135.299988/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-2.499488,135.299988;S9;チェンデラワシ湾, インドネシア&st=pp|v:false;lv:false_trs|v