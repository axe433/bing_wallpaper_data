{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-07-31T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"今日の画像は、米国バージニア州ダマスカス周辺を走るバージニア・クリーパー・トレイル。かつてアパラチア山脈を越えて木材や鉄鉱石を運んでいた鉄道の旧線路です。1957 年に蒸気機関車が引退した後、米国森林局によってレクリエーション・トレイルとして整備されました。全長 56km のトレイルは国有林を通り、美しい山々の風景の中、約 50 基の木製桁橋を渡ることができます。","Image":{"Url":"/th?id=OHR.VirginiaTrail_JA-JP5506669178_1920x1080.webp","Wallpaper":"/th?id=OHR.VirginiaTrail_JA-JP5506669178_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"深緑の森を貫く木道","Title":"バージニア・クリーパー・トレイル, 米国 バージニア州","Copyright":"© Eifel Kreutz/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.631287,-81.783826/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.631287,-81.783826;S9;バージニア・クリーパー・トレイル, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260731_VirginiaTrail%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260731_VirginiaTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%90%e3%83%bc%e3%82%b8%e3%83%8b%e3%82%a2%e3%83%bb%e3%82%af%e3%83%aa%e3%83%bc%e3%83%91%e3%83%bc%e3%83%bb%e3%83%88%e3%83%ac%e3%82%a4%e3%83%ab&form=hpcapt&filters=HpDate:\"20260730_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260731_VirginiaTrail"},"Ssd":"20260731","Name":"VirginiaTrail","Market":"JA-JP","Hash":"5506669178","FullDateString":"2026 年 7月 月 31 日"},{"ImageContent":{"Description":"ここはモニュメント・バレー。米国のアリゾナ州とユタ州にまたがるナバホ族の準自治領「ナバホ・ネイション」内に広がる地域です。テーブル状の台地「メサ」や、侵食によって形成された「ビュート」という孤立丘が点在しているのが特徴です。これらが独特の景観を生み出し、世界中から観光客が訪れる景勝地となっています。また、西部劇映画の定番のロケ地として知られており、映画監督ジョン・フォードが撮影を行った場所は「ジョン・フォード・ポイント」と呼ばれる人気の写真撮影スポットとなっています。","Image":{"Url":"/th?id=OHR.NavajoNation_JA-JP5174852282_1920x1080.webp","Wallpaper":"/th?id=OHR.NavajoNation_JA-JP5174852282_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"夕暮れの砂漠を貫く道","Title":"モニュメント・バレー, 米国 アリゾナ州","Copyright":"© Westend61/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.938513,-110.091637/20?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.938513,-110.091637;S9;モニュメント・バレー, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260730_NavajoNation%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260730_NavajoNation\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%a2%e3%83%8b%e3%83%a5%e3%83%a1%e3%83%b3%e3%83%88%e3%83%bb%e3%83%90%e3%83%ac%e3%83%bc&form=hpcapt&filters=HpDate:\"20260729_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260730_NavajoNation"},"Ssd":"20260730","Name":"NavajoNation","Market":"JA-JP","Hash":"5174852282","FullDateString":"2026 年 7月 月 30 日"},{"ImageContent":{"Description":"今日 7 月 29 日は世界トラの日。トラの保全を呼びかける国際記念日です。20 世紀初めには、野生のトラは約 10 万頭いると推定されていましたが、環境破壊や密猟などにより、2010 年時点では約 3,000 頭にまで激減しました。その後、各国でのさまざまな保全活動により一部個体数は回復したものの、世界全体での生息数は未だ 6,000 頭程度と推定されています。画像は、インドのランタンボール国立公園に姿を現したベンガルトラの家族。 かつて王族の狩猟地であったこの公園は、1974 年にトラの保護区へと変わりました。","Image":{"Url":"/th?id=OHR.TigerFamily_JA-JP4965219864_1920x1080.webp","Wallpaper":"/th?id=OHR.TigerFamily_JA-JP4965219864_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は世界トラの日","Title":"ベンガルトラの家族, インド","Copyright":"© Archna Singh/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/25.978019,76.553253/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=25.978019,76.553253;S9;ランタンボール国立公園, インド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260729_TigerFamily%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260729_TigerFamily\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e3%83%88%e3%83%a9%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260728_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260729_TigerFamily"},"Ssd":"20260729","Name":"TigerFamily","Market":"JA-JP","Hash":"4965219864","FullDateString":"2026 年 7月 月 29 日"},{"ImageContent":{"Description":"ここはフランス・アルザス地方に位置するケゼルスベール（カイゼルスベルグ）。ワイス川沿い、ヴォージュ山脈東斜面に広がる歴史ある町です。町の名前は「皇帝の山」を意味し、1227 年、神聖ローマ皇帝フリードリヒ 2 世が谷を見張るため城を築いたことに由来します。町のあらゆる所に歴史の面影があり、石畳の通りや木組みの家並み、石造の橋、サンクロワ教会のステンドグラスなど、時代を感じる景色を楽しむことができます。","Image":{"Url":"/th?id=OHR.KaysersbergVillage_JA-JP4774929635_1920x1080.webp","Wallpaper":"/th?id=OHR.KaysersbergVillage_JA-JP4774929635_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"渓谷に息づく美しい村","Title":"ケゼルスベール, フランス","Copyright":"© Federica Gentile/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.138779,7.263868/13?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=48.138779,7.263868;S9;ケゼルスベール（カイゼルスベルグ）, フランス&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260728_KaysersbergVillage%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260728_KaysersbergVillage\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%82%a4%e3%82%bc%e3%83%ab%e3%82%b9%e3%83%99%e3%83%ab%e3%82%b0&form=hpcapt&filters=HpDate:\"20260727_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260728_KaysersbergVillage"},"Ssd":"20260728","Name":"KaysersbergVillage","Market":"JA-JP","Hash":"4774929635","FullDateString":"2026 年 7月 月 28 日"},{"ImageContent":{"Description":"ここは米国のシカゴ文化センターにあるプレストン・ブラッドリー・ホール。一歩足を踏み入れれば、視線はたちまちティファニー・ドームの輝く天蓋へと引き寄せられます。ドームの直径はおよそ 11m で、魚の鱗のような形をしたティファニー製ガラス片を約 3 万個組み合わせて作られています。シカゴ文化センターは、1897 年にシカゴ初の公共図書館として開館しました。1978 年に芸術文化センターとなり、以降現在まで何度か改修されながら、地域の文化拠点として親しまれています。","Image":{"Url":"/th?id=OHR.ChicagoTiffany_JA-JP4240566318_1920x1080.webp","Wallpaper":"/th?id=OHR.ChicagoTiffany_JA-JP4240566318_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"灯りゆれる大空間","Title":"シカゴ文化センター, 米国 イリノイ州","Copyright":"© Felix Lipov/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.884043,-87.624956/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=41.884043,-87.624956;S9;ティファニー・ドーム, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260727_ChicagoTiffany%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260727_ChicagoTiffany\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b7%e3%82%ab%e3%82%b4%e6%96%87%e5%8c%96%e3%82%bb%e3%83%b3%e3%82%bf%e3%83%bc&form=hpcapt&filters=HpDate:\"20260726_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260727_ChicagoTiffany"},"Ssd":"20260727","Name":"ChicagoTiffany","Market":"JA-JP","Hash":"4240566318","FullDateString":"2026 年 7月 月 27 日"},{"ImageContent":{"Description":"今日 7 月 26 日は国際マングローブの日。そして画像は、ホンジュラスのピッグ・キーズにあるアカマングローブです。マングローブは、海水と陸地が交わる沿岸に根を張る木々の総称です。その密に張り巡らされた根は、波の力を和らげ、海岸の浸食を防ぐだけでなく、魚や甲殻類のすみかにもなるなど、生態系において重要な役割を果たしています。しかし近年、東南アジアを中心とする熱帯地域では、マングローブ林が急速に減少しており、その保全が重要な課題となっています。","Image":{"Url":"/th?id=OHR.RedMangroveSunrise_JA-JP3991738335_1920x1080.webp","Wallpaper":"/th?id=OHR.RedMangroveSunrise_JA-JP3991738335_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際マングローブの日","Title":"アカマングローブ, ホンジュラス","Copyright":"© Mac Stone/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/14.822356,-86.5979/8?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=14.822356,-86.5979;S9;ホンジュラス&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260726_RedMangrove%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260726_RedMangroveSunrise\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%9a%9b%e3%83%9e%e3%83%b3%e3%82%b0%e3%83%ad%e3%83%bc%e3%83%96%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260725_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260726_RedMangroveSunrise"},"Ssd":"20260726","Name":"RedMangroveSunrise","Market":"JA-JP","Hash":"3991738335","FullDateString":"2026 年 7月 月 26 日"},{"ImageContent":{"Description":"スペインのガリシア州は大西洋に面しており、その海岸線には、長い年月をかけて形成された断崖や入り江、波の浸食作用によって削り取られた波食台地が連なっています。そして、今日の画像は、ガリシア州北部に位置するカテドラル・ビーチ（プライア・ダス・カテドライス）の干潮時の姿。高さ 30m を誇る粘板岩と珪岩のアーチが大聖堂（カテドラル）を思わせることが名前の由来です。干潮時という限られた時間帯にのみ、海食によって形成された岩のアーチの間を歩くことができます。","Image":{"Url":"/th?id=OHR.GaliciaBeach_JA-JP2958100609_1920x1080.webp","Wallpaper":"/th?id=OHR.GaliciaBeach_JA-JP2958100609_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"干潮に現れる奇岩海岸","Title":"カテドラル・ビーチ, スペイン","Copyright":"© Tui De Roy/Amazing Aerial Agency/Abobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/43.554486,-7.157243/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=43.554486,-7.157243;S9;カテドラル・ビーチ, スペイン&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260725_GaliciaBeach%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260725_GaliciaBeach\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%83%86%e3%83%89%e3%83%a9%e3%83%ab%e3%83%bb%e3%83%93%e3%83%bc%e3%83%81&form=hpcapt&filters=HpDate:\"20260724_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260725_GaliciaBeach"},"Ssd":"20260725","Name":"GaliciaBeach","Market":"JA-JP","Hash":"2958100609","FullDateString":"2026 年 7月 月 25 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"今日 8 月 7 日は米国灯台の日。ジョージ・ワシントン大統領の署名によって 1789 年に成立した「灯台法」を記念して制定された日であり、灯台の歴史と役割をたたえる日です。そして画像は、米国ワシントン州のサンファン島にあるライム・キルン灯台。1919 年に建設され、現在も船舶を導き続けています。航行技術の発展とともに進化を続けてきた灯台は、歴史的建造物や絶景スポットとしても親しまれながら、今もなお、安全と不屈の精神、そして大海原への冒険を象徴する存在であり続けています。","Image":{"Url":"/th?id=OHR.LimeKiln_JA-JP2506397292_1920x1080.webp","Wallpaper":"/th?id=OHR.LimeKiln_JA-JP2506397292_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国灯台の日","Title":"ライム・キルン灯台, 米国 ワシントン州","Copyright":"© Edmund Lowe Photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.515855,-123.152649/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=48.515855,-123.152649;S9;ライム・キルン灯台, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260807_ LimeKiln%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260807_LimeKiln\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b1%b3%e5%9b%bd%e7%81%af%e5%8f%b0%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260806_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260807_LimeKiln"},"Ssd":"20260807","Name":"LimeKiln","Market":"JA-JP","Hash":"2506397292","FullDateString":"2026 年 8月 月 7 日"},{"ImageContent":{"Description":"今日、8 月 6 日は広島平和記念日。広島に投下された原子爆弾は、10 数万人もの人々の命を奪い、5 万を超える建物を破壊しました。毎年この日に、原爆ドームそばの元安川では、とうろう流しが行われます。川面に浮かぶ無数のとうろうには、原爆で失われた尊い命への追悼と、未来への平和の願いが込められています。この光景は、悲しみの記憶を受け継ぎながらも、希望を忘れない人々の思いの象徴です。今日という日は、平和な世界の維持と「核なき世界」の実現に向けて、一人ひとりが再認識し、考えるべき日です。","Image":{"Url":"/th?id=OHR.HiroshimaPeaceMemorial2026_JA-JP7778121397_1920x1080.webp","Wallpaper":"/th?id=OHR.HiroshimaPeaceMemorial2026_JA-JP7778121397_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は広島平和記念日","Title":"広島平和記念公園のとうろう流し, 広島県 広島市","Copyright":"© Buddhika Weerasinghe/Stringer/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.392708,132.452194/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=34.392708,132.452194;S9;広島平和記念公園&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260806_HiroshimaPeaceMemorial2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260806_HiroshimaPeaceMemorial2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%ba%83%e5%b3%b6%e5%b9%b3%e5%92%8c%e8%a8%98%e5%bf%b5%e6%97%a5&form=hpcapt&filters=HpDate:\"20260805_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260806_HiroshimaPeaceMemorial2026"},"Ssd":"20260806","Name":"HiroshimaPeaceMemorial2026","Market":"JA-JP","Hash":"7778121397","FullDateString":"2026 年 8月 月 6 日"},{"ImageContent":{"Description":"モロッコの古都フェズにある王宮「ダル・アル・マフゼン」は、13 世紀に建設された歴史ある宮殿です。写真に映る宮殿の門は、精巧な真鍮細工と色鮮やかな幾何学模様のタイルで彩られ、モロッコ建築の美しさを象徴しています。現在も王族の居住地として使用されているため、内部は一般公開されていませんが、この壮麗な門の前には近づくことができるため、長い歴史と王室文化の重みを間近に感じることができます。","Image":{"Url":"/th?id=OHR.FezMorocco_JA-JP7567982886_1920x1080.webp","Wallpaper":"/th?id=OHR.FezMorocco_JA-JP7567982886_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"宮殿の門","Title":"フェズ王宮, モロッコ","Copyright":"© cgst26/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.034653,-5.016192/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=34.034653,-5.016192;S9;フェズ王宮, モロッコ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260805_FezMorocco%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260805_FezMorocco\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%95%e3%82%a7%e3%82%ba%e7%8e%8b%e5%ae%ae&form=hpcapt&filters=HpDate:\"20260804_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260805_FezMorocco"},"Ssd":"20260805","Name":"FezMorocco","Market":"JA-JP","Hash":"7567982886","FullDateString":"2026 年 8月 月 5 日"},{"ImageContent":{"Description":"今日 8 月 4 日は国際フクロウの日。フクロウは平たいお面のような顔と、首を約 270 度回せる点が特徴です。そして画像は、米国フロリダ州に生息するアナホリフクロウのひな。アナホリフクロウは広大な草原や牧草地などの開けた環境を好み、樹上ではなく地上に巣穴を作って暮らします。多くのフクロウとは異なり昼行性で、獲物を見つけると走って追いかけることもあります。そのため、ほかのフクロウに比べて足が長いのが特徴です。","Image":{"Url":"/th?id=OHR.AdorableOwlet_JA-JP7246946497_1920x1080.webp","Wallpaper":"/th?id=OHR.AdorableOwlet_JA-JP7246946497_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際フクロウの日","Title":"アナホリフクロウのひな, 米国 フロリダ州","Copyright":"© mlorenzphotography/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/26.726665,-81.99716/12?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=26.726665,-81.99716;S9;ケープコーラル, 米国 フロリダ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260804_AdorableOwlet%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260804_AdorableOwlet\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%9a%9b%e3%83%95%e3%82%af%e3%83%ad%e3%82%a6%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260803_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260804_AdorableOwlet"},"Ssd":"20260804","Name":"AdorableOwlet","Market":"JA-JP","Hash":"7246946497","FullDateString":"2026 年 8月 月 4 日"},{"ImageContent":{"Description":"マルタ本島最大の漁師町、マルサシュロック。マルタ島の南東部に位置し、日曜日に開催されるフィッシュマーケットで知られています。そして画像は、町の港に並ぶ伝統的な漁船「ルッツ」です。青や黄、赤などの鮮やかな色で彩られた木製の船で、船首には「オシリスの目」と呼ばれる装飾が施されています。これは、航海の安全を見守るお守りとされ、2000 年以上前から受け継がれています。地中海の青い海と長い歴史が息づく町並みが調和する風景は、訪れる人々を魅了します。","Image":{"Url":"/th?id=OHR.BoatsMalta_JA-JP6685221242_1920x1080.webp","Wallpaper":"/th?id=OHR.BoatsMalta_JA-JP6685221242_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"エメラルドの海に浮かぶ色とりどりの船","Title":"マルサシュロック, マルタ","Copyright":"© Klubovy/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.841105,14.544731/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.841105,14.544731;S9;マルサシュロック, マルタ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260803_BoatsMalta%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260803_BoatsMalta\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%9e%e3%83%ab%e3%82%b5%e3%82%b7%e3%83%a5%e3%83%ad%e3%83%83%e3%82%af&form=hpcapt&filters=HpDate:\"20260802_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260803_BoatsMalta"},"Ssd":"20260803","Name":"BoatsMalta","Market":"JA-JP","Hash":"6685221242","FullDateString":"2026 年 8月 月 3 日"},{"ImageContent":{"Description":"ここはフィンランドの首都ヘルシンキ。1550 年、当時のスウェーデン国王グスタフ 1 世によって交易の街として整備され、1812 年に首都となりました。フィンランド湾沿岸に位置し、300 以上の島々を有しているため、街の総面積の約 7 割が海域となっていますが、同時に緑豊かな森にも恵まれています。フィンランドには「自然享受権」という権利があるため、誰でも気軽に森を散策することが可能であり、ベリーやキノコなどを自由に採集することができます。","Image":{"Url":"/th?id=OHR.HelsinkiBlue_JA-JP6468131752_1920x1080.webp","Wallpaper":"/th?id=OHR.HelsinkiBlue_JA-JP6468131752_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"ブルーアワーに輝く湾岸の街","Title":"ヘルシンキ, フィンランド","Copyright":"© Miemo Penttinen/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/60.166622,24.943541/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=60.166622,24.943541;S9;ヘルシンキ, フィンランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260802_HelsinkiBlue%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260802_HelsinkiBlue\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%98%e3%83%ab%e3%82%b7%e3%83%b3%e3%82%ad&form=hpcapt&filters=HpDate:\"20260801_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260802_HelsinkiBlue"},"Ssd":"20260802","Name":"HelsinkiBlue","Market":"JA-JP","Hash":"6468131752","FullDateString":"2026 年 8月 月 2 日"},{"ImageContent":{"Description":"今日 8 月 1 日から 7 日まで、青森県弘前市では「弘前ねぷたまつり」が開催されます。「ヤーヤドー」の掛け声とともに、大小約 80 台の山車が市内を練り歩くというもので、「弘前四大まつり」の一つにも数えられています。「ねぷた」という言葉の由来は諸説ありますが、かつて農民たちが夏に行っていた「眠り流し」という行事から生まれたといわれています。そして、様々なねぷたのなかでも、欠かすことのできないものの一つが金魚ねぷた。江戸時代、金魚は高級魚であり、庶民にとっては憧れの存在であったため、それをねぷたにしてお祭りで子どもたちに持たせたとされています。近年は、祭りのみならずお土産としても人気となっています。","Image":{"Url":"/th?id=OHR.HirosakiNeputa2026_JA-JP5726503053_1920x1080.webp","Wallpaper":"/th?id=OHR.HirosakiNeputa2026_JA-JP5726503053_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日から弘前ねぷたまつり","Title":"変わり種の金魚ねぷた, 青森県 弘前市","Copyright":"© David Parker/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/40.603123,140.463928/16