{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-10-31T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"ドイツ・フランクフルトのフランクフルト大聖堂は、ゴシック様式の塔と中世を思わせるシルエットが印象的で、この時期らしい神秘的な雰囲気を醸し出しています。ハロウィンの風習には、収穫期の終わりと冬の始まりを告げる古代ケルトの祭り「サウィン」に由来するものがあるといわれています。当時は、この時期になると生者と死者の世界の境界が曖昧になり、超自然的な存在が現れると信じられていました。その後、11月1日が「諸聖人の日（万聖節）」と定められると、その前夜は「万聖節前夜」と呼ばれ、やがて「ハロウィン」という呼び名へと変わっていきました。","Image":{"Url":"/th?id=OHR.FrankfurtHalloween_JA-JP4785085446_1920x1080.webp","Wallpaper":"/th?id=OHR.FrankfurtHalloween_JA-JP4785085446_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"帝国の面影","Title":"聖バルトロメウス大聖堂、フランクフルト、ドイツ","Copyright":"© AlxeyPnferov/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/50.110766,8.68539/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=50.110766,8.68539;S9;聖バルトロメウス大聖堂、フランクフルト&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261031_FrankfurtHalloween\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8f%e3%83%ad%e3%82%a6%e3%82%a3%e3%83%b3&form=hpcapt&filters=HpDate:\"20261030_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261031_FrankfurtHalloween"},"Ssd":"20261031","Name":"FrankfurtHalloween","Market":"JA-JP","Hash":"4785085446","FullDateString":"2026 年 10月 月 31 日"},{"ImageContent":{"Description":"冬を迎えるニューメキシコ州のボスケ・デル・アパッチ国立野生動物保護区には、多くの渡り鳥が飛来します。この保護区は1939年に、渡り鳥の重要な中継地として設立されました。約232平方キロメートルに及ぶこの地域には、湿地や草地、水辺が広がり、一年を通して多様な野生動物が暮らしています。写真のカナダヅルは例年10月下旬ごろから姿を見せ、冬の間、ここで過ごします。夜は浅瀬で休み、日の出ごろになると餌を求めて近くの野原へと飛び立ちます。","Image":{"Url":"/th?id=OHR.AutumnCranes_JA-JP2456396404_1920x1080.webp","Wallpaper":"/th?id=OHR.AutumnCranes_JA-JP2456396404_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"大空へ羽ばたく","Title":"カナダヅル、ボスケ・デル・アパッチ国立野生動物保護区、ニューメキシコ州、アメリカ","Copyright":"© Terry St.Louis/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.384147,-106.900263/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=34.384147,-106.900263;S9;ボスケ・デル・アパッチ、ニューメキシコ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261030_AutumnCranes\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%83%8a%e3%83%80%e3%83%85%e3%83%ab&form=hpcapt&filters=HpDate:\"20261029_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261030_AutumnCranes"},"Ssd":"20261030","Name":"AutumnCranes","Market":"JA-JP","Hash":"2456396404","FullDateString":"2026 年 10月 月 30 日"},{"ImageContent":{"Description":"イングランド南西部ウィルトシャーにあるエーヴベリー。朝霧に包まれた巨石群は、約 4500 年前の新石器時代に築かれた遺跡の一部です。世界最大の先史時代の環状列石をはじめ、巨大な環状遺構や列石が残されており、シルベリー・ヒルなど周辺の遺跡とともに広大な遺跡群を形成し、ユネスコ世界遺産にも登録されています。訪れる人は巨石の間を歩くことで、現代の田園風景に溶け込む古代遺跡を間近に体感することができます。","Image":{"Url":"/th?id=OHR.AveburyStones_JA-JP4031336786_1920x1080.webp","Wallpaper":"/th?id=OHR.AveburyStones_JA-JP4031336786_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"草原に立ち並ぶ巨石群","Title":"エーヴベリー 巨石群, イングランド","Copyright":"© George W Johnson/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/51.42898,-1.854909/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=51.42898,-1.854909;S9;エーヴベリー, イングランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261029_AveburyStones%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261029_AveburyStones\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a8%e3%83%bc%e3%83%b4%e3%83%99%e3%83%aa%e3%83%bc+%e5%b7%a8%e7%9f%b3%e7%be%a4&form=hpcapt&filters=HpDate:\"20261028_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261029_AveburyStones"},"Ssd":"20261029","Name":"AveburyStones","Market":"JA-JP","Hash":"4031336786","FullDateString":"2026 年 10月 月 29 日"},{"ImageContent":{"Description":"チェコ東部のボヘミア地方にそびえるクネティツカー・ホラ城は、14 世紀なかば頃には、すでにこの地に城が存在していたとされています。時代の流れとともに、要塞や貴族の居城として発展し、16 世紀には当時有力だったペルンシュテイン家によって、後期ゴシック様式とルネサンス様式の壮大な城へと改築されました。その後は荒廃し、採石によって一部が失われましたが、20 世紀初めから修復が始まりました。現在は、城内で展示や当時使用されていた部屋を見学することが可能であり、塔からは周囲の雄大な景色を一望できます。中世ボヘミアの歴史を今に伝える印象的な城です。","Image":{"Url":"/th?id=OHR.KuneticeCastle_JA-JP3914699688_1920x1080.webp","Wallpaper":"/th?id=OHR.KuneticeCastle_JA-JP3914699688_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"夕暮れに佇む古城","Title":"クネティツカー・ホラ城, チェコ","Copyright":"© Marek Saroch/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/50.080287,15.811615/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=50.080287,15.811615;S9;クネティツカー・ホラ城, チェコ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261028_KuneticeCastle%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261028_KuneticeCastle\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Kun%c4%9btick%c3%a1+hora+Castle+&form=hpcapt&filters=HpDate:\"20261027_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261028_KuneticeCastle"},"Ssd":"20261028","Name":"KuneticeCastle","Market":"JA-JP","Hash":"3914699688","FullDateString":"2026 年 10月 月 28 日"},{"ImageContent":{"Description":"今日の画像は、米国ジョージア州で見られるポンドサイプレス。ヒノキ科、ヌマスギ属の樹木で、細い葉が小枝に沿うようにつくのが特徴です。秋から冬にかけて球果が成熟します。水辺では「膝根（しっこん）」と呼ばれる根の突起を形成することがあり、米国南東部の池や沼地などの湿地に分布しています。こうした湿地林は、さまざまな生物の重要な生息地となっています。","Image":{"Url":"/th?id=OHR.PondCypress_JA-JP5777656593_1920x1080.webp","Wallpaper":"/th?id=OHR.PondCypress_JA-JP5777656593_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"水面に映る秋の森","Title":"ポンドサイプレス, 米国 ジョージア州","Copyright":"© Chris Moore/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/32.648285,-83.444374/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=32.648285,-83.444374;S9;米国 ジョージア州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261027_PondCypress%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261027_PondCypress\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%9d%e3%83%b3%e3%83%89%e3%82%b5%e3%82%a4%e3%83%97%e3%83%ac%e3%82%b9&form=hpcapt&filters=HpDate:\"20261026_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261027_PondCypress"},"Ssd":"20261027","Name":"PondCypress","Market":"JA-JP","Hash":"5777656593","FullDateString":"2026 年 10月 月 27 日"},{"ImageContent":{"Description":"今日の画像は、ブルガリア南部のロドピ山脈を流れるシトヴォ滝です。色づいた木々と流れ落ちる滝の組み合わせが、絵画のような美しさを演出します。この自然風景に加え、歴史もこの地域の魅力です。近くのシトヴォ村にはロドピ山脈の伝統的な家屋が残っているほか、近隣には石に刻まれた「シトヴォの碑文」があります。1928 年に初めて記録されたこの碑文は、現在も解読されておらず、その起源や意味はいまだ謎に包まれています。","Image":{"Url":"/th?id=OHR.SitovoWaterfall_JA-JP3524382726_1920x1080.webp","Wallpaper":"/th?id=OHR.SitovoWaterfall_JA-JP3524382726_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"紅葉の中を流れ落ちる滝","Title":"シトヴォ滝, ブルガリア","Copyright":"© Nadya85/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.950514,24.60924/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=41.950514,24.60924;S9;シトヴォ滝, ブルガリア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261026_SitovoWaterfall%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261026_SitovoWaterfall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Sitovo+waterfall&form=hpcapt&filters=HpDate:\"20261025_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261026_SitovoWaterfall"},"Ssd":"20261026","Name":"SitovoWaterfall","Market":"JA-JP","Hash":"3524382726","FullDateString":"2026 年 10月 月 26 日"},{"ImageContent":{"Description":"今日の画像は、米国ワイオミング州のイエローストーン国立公園内を歩く 2 頭のハイイロオオカミです。ユーラシア大陸と北米に広く生息しており、分厚い毛皮によって厳しい冬の寒さにも耐えることができます。家族単位の群れ（パック）で生活し、協力して狩りや子育て、縄張りの防衛を行います。20 世紀初頭に、イエローストーン国立公園からは一度姿を消しましたが、1995 年に再導入が開始されました。現在公園は、野生のハイイロオオカミを観察できる世界有数の場所として知られています。","Image":{"Url":"/th?id=OHR.YellowstoneWolves_JA-JP3378091323_1920x1080.webp","Wallpaper":"/th?id=OHR.YellowstoneWolves_JA-JP3378091323_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"冬の大地を進むオオカミたち","Title":"ハイイロオオカミ, 米国 ワイオミング州","Copyright":"© John Morrison/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/44.600378,-110.559997/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=44.600378,-110.559997;S9;イエローストーン国立公園, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261025_YellowstoneWolves%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261025_YellowstoneWolves\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8f%e3%82%a4%e3%82%a4%e3%83%ad%e3%82%aa%e3%82%aa%e3%82%ab%e3%83%9f&form=hpcapt&filters=HpDate:\"20261024_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261025_YellowstoneWolves"},"Ssd":"20261025","Name":"YellowstoneWolves","Market":"JA-JP","Hash":"3378091323","FullDateString":"2026 年 10月 月 25 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"北米の草原に暮らすアメリカバイソンは、世界でも最大級の陸上哺乳類です。体重は900キロほどにもなりますが、時速約65キロで走ることができます。「バッファロー」と呼ばれることもありますが、アフリカやアジアにすむ本来のバッファローとは別の動物です。肩の大きなこぶは発達した筋肉で、冬は頭を左右に振って雪をかき分け、その下の草を探します。しっぽを見れば気分もわかり、ゆったり揺れていれば落ち着いているサイン、ピンと立っていたら興奮しているのかもしれません。一時は絶滅寸前まで追い込まれましたが、保護活動によって少しずつ数を取り戻してきました。","Image":{"Url":"/th?id=OHR.DakotaBison_JA-JP7930713717_1920x1080.webp","Wallpaper":"/th?id=OHR.DakotaBison_JA-JP7930713717_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"よみがえった草原の巨人","Title":"セオドア・ルーズベルト国立公園の草原にいるバイソン、ノースダコタ州、アメリカ","Copyright":"© Tandem Stock/Adobe Stock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/47.275714,-103.463282/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=47.275714,-103.463282;S9;セオドア・ルーズベルト国立公園&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261107_DakotaBison\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%a1%e3%83%aa%e3%82%ab%e3%83%90%e3%82%a4%e3%82%bd%e3%83%b3&form=hpcapt&filters=HpDate:\"20261106_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261107_DakotaBison"},"Ssd":"20261107","Name":"DakotaBison","Market":"JA-JP","Hash":"7930713717","FullDateString":"2026 年 11月 月 7 日"},{"ImageContent":{"Description":"マウイ島のハレアカラ国立公園は、標高約3,055メートルの山頂から海岸まで、火山や熱帯雨林など変化に富んだ自然が広がっています。キパフル地区にあるピピワイ・トレイルをたどると、緑豊かな森の先に見事な竹林が現れます。歩き始めて約1.6キロ進むと、頭上を覆うように竹が生い茂り、まるで緑のトンネルの中を歩いているようです。風が吹くと竹同士が触れ合い、独特の音が辺りに響きます。","Image":{"Url":"/th?id=OHR.PipiwaiTrail_JA-JP1383562325_1920x1080.webp","Wallpaper":"/th?id=OHR.PipiwaiTrail_JA-JP1383562325_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"マウイ島を抜ける緑のトンネル","Title":"ピピワイ・トレイルの竹林、ハレアカラ国立公園、マウイ島、ハワイ、アメリカ","Copyright":"© MNStudio/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/20.760987,-156.155095/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=20.760987,-156.155095;S9;ハレアカラ国立公園、マウイ島、ハワイ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261106_PipiwaiTrail\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8f%e3%83%ac%e3%82%a2%e3%82%ab%e3%83%a9%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9c%92&form=hpcapt&filters=HpDate:\"20261105_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261106_PipiwaiTrail"},"Ssd":"20261106","Name":"PipiwaiTrail","Market":"JA-JP","Hash":"1383562325","FullDateString":"2026 年 11月 月 6 日"},{"ImageContent":{"Description":"木製の踏み越し段の先に広がるのは、ユネスコ世界遺産に登録されたイングランド屈指の景勝地、湖水地方です。ブラック・フェルの岩山の山頂「ブラック・クラッグ」は、標高約323メートルとそれほど高くはありませんが、ウィンダミア湖やコニストン・ウォーター、ラングデール・パイクスを見渡せる絶景スポットです。風光明媚なターン・ハウズをめぐって山頂を目指すルートのほか、トム・ギル経由なら森の中を流れ落ちる滝にも出会えます。","Image":{"Url":"/th?id=OHR.StileCrossing_JA-JP3443452365_1920x1080.webp","Wallpaper":"/th?id=OHR.StileCrossing_JA-JP3443452365_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"山頂へ、もう一歩","Title":"石垣に設けられた木製の踏み越し段、ブラック・クラッグ、湖水地方、イギリス","Copyright":"© Alex Treadway/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/54.460861,-3.08875/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=54.460861,-3.08875;S9;湖水地方、イギリス&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261105_StileCrossing\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%b9%96%e6%b0%b4%e5%9c%b0%e6%96%b9&form=hpcapt&filters=HpDate:\"20261104_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261105_StileCrossing"},"Ssd":"20261105","Name":"StileCrossing","Market":"JA-JP","Hash":"3443452365","FullDateString":"2026 年 11月 月 5 日"},{"ImageContent":{"Description":"中国・安徽省宣城市では、秋になると水に浸かったラクウショウの森が、琥珀色や銅色、深いさび色に染まります。ラクウショウは針葉樹でありながら、秋に柔らかな葉が赤褐色に変わって落ちる珍しい木です。北米では湿地に育ち、地面や水面から「膝根」と呼ばれる呼吸根を突き出すことでも知られ、樹齢1,000年を超える木の記録もあります。晩秋には葉が燃えるような色に変わり、ボートでゆったり進むと、水面にその色がきらめいて、まるで生きた絵画のようです。","Image":{"Url":"/th?id=OHR.AutumnChina_JA-JP2275105446_1920x1080.webp","Wallpaper":"/th?id=OHR.AutumnChina_JA-JP2275105446_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"秋色の森を水上散歩","Title":"色鮮やかなラクウショウの森をボートで進む人々、安徽省宣城市、中国","Copyright":"© Jackal Pan/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/30.9525,118.75528/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=30.9525,118.75528;S9;安徽省宣城市、中国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261104_AutumnChina\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%a9%e3%82%af%e3%82%a6%e3%82%b7%e3%83%a7%e3%82%a6&form=hpcapt&filters=HpDate:\"20261103_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261104_AutumnChina"},"Ssd":"20261104","Name":"AutumnChina","Market":"JA-JP","Hash":"2275105446","FullDateString":"2026 年 11月 月 4 日"},{"ImageContent":{"Description":"イタリア北部、南チロル地方のドロミテにあるブライエス湖は、標高約1,500メートルに位置しています。ファネス・セネス・ブライエス自然公園の森と雄大な山々に囲まれ、緑と青が織りなす美しい湖面が魅力です。湖畔には約3.5キロメートルの遊歩道があり、伝統的な木造ボートに乗って景色を楽しむこともできます。また、ドロミテの有名なトレイル「アルタ・ヴィア1」をはじめ、さまざまなハイキングコースの出発点にもなっています。","Image":{"Url":"/th?id=OHR.AlpineBraies_JA-JP1334653956_1920x1080.webp","Wallpaper":"/th?id=OHR.AlpineBraies_JA-JP1334653956_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"山々に抱かれた静けさ","Title":"ブライエス湖、ファネス・セネス・ブラーイエス自然公園、ドロミテ、イタリア","Copyright":"© leonid_tit/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/46.693566,12.084606/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=46.693566,12.084606;S9;ブライエス湖&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261103_AlpineBraies\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%96%e3%83%a9%e3%82%a4%e3%82%a8%e3%82%b9%e6%b9%96+%e3%83%89%e3%83%ad%e3%83%9f%e3%83%86&form=hpcapt&filters=HpDate:\"20261102_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261103_AlpineBraies"},"Ssd":"20261103","Name":"AlpineBraies","Market":"JA-JP","Hash":"1334653956","FullDateString":"2026 年 11月 月 3 日"},{"ImageContent":{"Description":"カナダ・マニトバ州のハドソン湾沿岸では、ホッキョクグマたちが、海氷が張るのを待っています。海氷ができると、再び氷の上でアザラシを狩れるようになります。11月の第1週には「ホッキョクグマ週間」が行われます。泳ぎも狩りも得意な彼らは、地球上でも指折りの厳しい環境に適応して暮らしています。しかし、海氷の減少によって陸上で過ごす時間が長くなり、餌を確保しにくくなるなどの影響が出ています。写真に写っているのは、ハドソン湾近くで暮らす母グマと子グマたちです。この愛らしい親子の姿は、北極の美しい自然と、ホッキョクグマが生きるために欠かせない海氷を守る大切さを伝えています。","Image":{"Url":"/th?id=OHR.HudsonBear_JA-JP9155678647_1920x1080.webp","Wallpaper":"/th?id=OHR.HudsonBear_JA-JP9155678647_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"氷がつなぐ未来","Title":"ホッキョクグマの親子、ハドソン湾、マニトバ州、カナダ","Copyright":"© Danita Delimont/Adobe Stock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"ホッキョクグマは、餌を捕りやすく、生息に適した氷を求めて、1シーズンに1,000キロメートル以上移動することがあります。","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261102_HudsonBear\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%9b%e3%83%83%e3%82%ad%e3%83%a7%e3%82%af%e3%82%b0%e3%83%9e%e9%80%b1%e9%96%93&form=hpcapt&filters=HpDate:\"20261101_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261102_HudsonBear"},"Ssd":"20261102","Name":"HudsonBear","Market":"JA-JP","Hash":"9155678647","FullDateString":"2026 年 11月 月 2 日"},{"ImageContent":{"Description":"ドイツ南西部には、シュヴァルツヴァルト（黒い森）が広がっています。霧に包まれた森や丘、深い谷、湖、美しい町々が織りなす風景が魅力です。南北約160キロメートルに及び、最高峰のフェルトベルクは標高1,493メートルです。ドナウ川とネッカー川の源流域としても知られています。古くから林業が盛んで、時計作りの伝統も息づいています。なかでも鳩時計（カッコー時計）は、ドイツ国外でも広く知られています。","Image":{"Url":"/th?id=OHR.SchwarzwaldAutumn_JA-JP7556408951_1920x1080.webp","Wallpaper":"/th?id=OHR.SchwarzwaldAutumn_JA-JP7556408951_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"木々を包む霧","Title":"シュヴァルツヴァルト、バーデン＝ヴュルテンベルク州、ドイツ","Copyright":"© Britus/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.286722,8.215281/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&