{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-09-07T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"ここは、ドイツ・バイエルン州バンベルクの旧市街です。画像の中心にある旧市庁舎は、街を象徴するランドマークとして知られており、ゴシック様式とバロック様式が調和した美しい建物と石橋が、印象的な景観をつくり出しています。伝承によると、司教が市庁舎を建てるための土地を与えなかったため、市民がレーグニッツ川に人工島を築き、その上に建設したとされています。この建物を含む旧市街は、中世の街並みをよく残す歴史都市として評価され、1993 年に世界遺産に登録されました。","Image":{"Url":"/th?id=OHR.BambergTownhall_JA-JP4474746509_1920x1080.webp","Wallpaper":"/th?id=OHR.BambergTownhall_JA-JP4474746509_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"川の上に建つ旧市庁舎","Title":"バンベルク市街, ドイツ","Copyright":"© SCStock/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/49.894218,10.885527/13?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=49.894218,10.885527;S9;バンベルク市街, ドイツ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260907_BambergTownhall%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260907_BambergTownhall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%90%e3%83%b3%e3%83%99%e3%83%ab%e3%82%af%e5%b8%82%e8%a1%97&form=hpcapt&filters=HpDate:\"20260906_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260907_BambergTownhall"},"Ssd":"20260907","Name":"BambergTownhall","Market":"JA-JP","Hash":"4474746509","FullDateString":"2026 年 9月 月 7 日"},{"ImageContent":{"Description":"ここは、ファイアンズ湖。オーストラリア・ビクトリア州のグランピアンズ国立公園の麓に位置する人工貯水池で、ボートや釣り、セーリング、水上スキーなどで人気です。そして湖の向こうには、グランピアンズ国立公園の砂岩の山並みが広がっています。公園は壮大な景観や美しい滝、先住民の文化遺産で知られ、トレイルではカンガルーやエミューなどの野生動物を観察することもできます。","Image":{"Url":"/th?id=OHR.LakeFyans_JA-JP2778092364_1920x1080.webp","Wallpaper":"/th?id=OHR.LakeFyans_JA-JP2778092364_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"空を映す静かな人工貯水池","Title":"ファイアンズ湖, オーストラリア","Copyright":"© tracielouise/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-37.142867,142.612567/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-37.142867,142.612567;S9;ファイアンズ湖, オーストラリア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260906_LakeFyans%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260906_LakeFyans\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Fyans+Lake+%e3%82%aa%e3%83%bc%e3%82%b9%e3%83%88%e3%83%a9%e3%83%aa%e3%82%a2&form=hpcapt&filters=HpDate:\"20260905_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260906_LakeFyans"},"Ssd":"20260906","Name":"LakeFyans","Market":"JA-JP","Hash":"2778092364","FullDateString":"2026 年 9月 月 6 日"},{"ImageContent":{"Description":"9 月の第 1 土曜日は、米国の「ハチドリの日」。ハチドリの保護に対する意識向上と支援を目的に毎年祝われています。ハチドリは、南北米大陸に生息する美しい羽を持つ小鳥です。花の蜜を主な餌とし、ホバリングしながら花にくちばしを差し込んで蜜を吸います。そして画像は、コスタリカで撮影されたヘリコニアの花の蜜を吸うミドリボウシテリハチドリ。中米に生息する大型のハチドリの一種で、虹色に輝くエメラルドグリーンの羽と、わずかに湾曲した長いくちばしが特徴です。","Image":{"Url":"/th?id=OHR.GreenCrowned_JA-JP4075782685_1920x1080.webp","Wallpaper":"/th?id=OHR.GreenCrowned_JA-JP4075782685_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国のハチドリの日","Title":"ミドリボウシテリハチドリ, コスタリカ","Copyright":"© Paul Hobson/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/9.979021,-84.195129/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=9.979021,-84.195129;S9;コスタリカ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260905_GreenCrowned%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260905_GreenCrowned\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8f%e3%83%81%e3%83%89%e3%83%aa%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260904_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260905_GreenCrowned"},"Ssd":"20260905","Name":"GreenCrowned","Market":"JA-JP","Hash":"4075782685","FullDateString":"2026 年 9月 月 5 日"},{"ImageContent":{"Description":"ドイツ北海沿岸に広がる塩性湿地帯の中にそびえ立つヴェスターヘーファーザント灯台。赤と白の縞模様が特徴的なこの鋳鉄製灯台は、ユネスコ世界自然遺産に登録されているワッデン海の一部であるワッデン海国立公園内にあります。1906 年から 1908 年にかけて建設され、1 世紀以上にわたり北海を航行する船舶の安全を見守ってきました。現在は、ドイツ北部沿岸のランドマークの一つとして親しまれています。","Image":{"Url":"/th?id=OHR.Westerheversand_JA-JP0136915036_1920x1080.webp","Wallpaper":"/th?id=OHR.Westerheversand_JA-JP0136915036_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"草原の先にたたずむ灯台","Title":"ヴェスターヘーファーザント灯台, ドイツ","Copyright":"© bluejayphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/54.373718,8.639927/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=54.373718,8.639927;S9;ヴェスターヘーファーザント灯台, ドイツ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260904_Westerheversand%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260904_Westerheversand\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%b4%e3%82%a7%e3%82%b9%e3%82%bf%e3%83%bc%e3%83%98%e3%83%bc%e3%83%95%e3%82%a1%e3%83%bc%e3%82%b6%e3%83%b3%e3%83%88%e7%81%af%e5%8f%b0&form=hpcapt&filters=HpDate:\"20260903_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260904_Westerheversand"},"Ssd":"20260904","Name":"Westerheversand","Market":"JA-JP","Hash":"0136915036","FullDateString":"2026 年 9月 月 4 日"},{"ImageContent":{"Description":"今日の画像は米国アリゾナ州バーミリオン・クリフ国定公園に位置するコヨーテ・ビュート。砂漠に波が押し寄せたような独特の景観は、風や水が長い年月をかけて砂丘を浸食することで生まれました。こうした原生的な自然を守るため、米国では 1964 年 9 月 3 日に「原生自然法」が制定されました。当初は 54 か所、約 3 万 6,800km² が保護対象でしたが、現在ではその 10 倍を超える面積が指定され、手つかずの森や砂漠など大自然の魅力を未来へ受け継いでいます。","Image":{"Url":"/th?id=OHR.AZWilderness_JA-JP3309055326_1920x1080.webp","Wallpaper":"/th?id=OHR.AZWilderness_JA-JP3309055326_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国原生自然法制定の記念日","Title":"コヨーテ・ビュート, 米国 アリゾナ州","Copyright":"© James Hager/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.862603,-111.826977/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.862603,-111.826977;S9;バーミリオン・クリフ国定公園, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260903_AZWilderness%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260903_AZWilderness\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b3%e3%83%a8%e3%83%bc%e3%83%86%e3%83%bb%e3%83%93%e3%83%a5%e3%83%bc%e3%83%88&form=hpcapt&filters=HpDate:\"20260902_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260903_AZWilderness"},"Ssd":"20260903","Name":"AZWilderness","Market":"JA-JP","Hash":"3309055326","FullDateString":"2026 年 9月 月 3 日"},{"ImageContent":{"Description":"サウスウォルドは、イングランド東部サフォーク州の美しい海辺の町です。北海やブライス川、広大な湿地に囲まれた細長い半島に位置し、古くから漁業や交易で栄えてきました。海岸沿いには約 300 棟の色鮮やかな木造の小屋が並んでいます。この小屋はビーチハットと呼ばれ、もともとは海水浴客や漁師のための簡易的な休憩所として利用されていましたが、現在はレジャーや休暇を楽しむための施設として親しまれています。","Image":{"Url":"/th?id=OHR.SuffolkHuts_JA-JP3115171778_1920x1080.webp","Wallpaper":"/th?id=OHR.SuffolkHuts_JA-JP3115171778_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海岸に並ぶカラフルな小屋","Title":"ビーチハット, イングランド","Copyright":"© stevendocwra/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.326221,1.678968/13?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=52.326221,1.678968;S9;サウスウォルド, イングランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260902_SuffolkHuts%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260902_SuffolkHuts\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b5%e3%82%a6%e3%82%b9%e3%82%a6%e3%82%a9%e3%83%ab%e3%83%89%e3%82%b5%e3%83%95%e3%82%a9%e3%83%bc%e3%82%af%e5%b7%9e&form=hpcapt&filters=HpDate:\"20260901_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260902_SuffolkHuts"},"Ssd":"20260902","Name":"SuffolkHuts","Market":"JA-JP","Hash":"3115171778","FullDateString":"2026 年 9月 月 2 日"},{"ImageContent":{"Description":"9 月は米国のキノコ月間。キノコの多様性や健康への効果について理解を深めるための啓発月間です。私たちが「キノコ」と呼ぶものは、菌類が作り出した「子実体」と呼ばれるもので、胞子形成のために菌糸が組み合わさり複雑な構造になったものを指します。そして、今日の画像は、オチバタケという小さなキノコ。落ち葉の積もる林床などに生え、黒色の馬の毛状菌糸束を持っています。","Image":{"Url":"/th?id=OHR.HorseHairShroom_JA-JP2550807968_1920x1080.webp","Wallpaper":"/th?id=OHR.HorseHairShroom_JA-JP2550807968_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"9 月は米国のキノコ月間","Title":"オチバタケ, ベラルーシ","Copyright":"© Máté/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/53.42506,27.697136/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=53.42506,27.697136;S9;ベラルーシ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260901_HorseHairShroom%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260901_HorseHairShroom\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b1%b3%e5%9b%bd%e3%81%ae%e3%82%ad%e3%83%8e%e3%82%b3%e6%9c%88%e9%96%93&form=hpcapt&filters=HpDate:\"20260831_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260901_HorseHairShroom"},"Ssd":"20260901","Name":"HorseHairShroom","Market":"JA-JP","Hash":"2550807968","FullDateString":"2026 年 9月 月 1 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"今日 9 月 14 日はコスモスの日。「愛情」や、「優美」、「謙虚」、「調和」など、コスモスにはさまざまな花言葉があり、ホワイトデーからちょうど半年となるこの日に、恋人や家族にコスモスの花を贈り感謝や愛情を伝える日とされています。「秋桜」とも書かれるコスモスは、秋を代表する花として親しまれています。早咲きや遅咲きなどでいくつかの品種があるものの、一般的には 9 月から 10 月中旬ごろまでが見頃の時期です。","Image":{"Url":"/th?id=OHR.Cosmos2026_JA-JP5810317842_1920x1080.webp","Wallpaper":"/th?id=OHR.Cosmos2026_JA-JP5810317842_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日はコスモスの日","Title":"川辺のコスモス","Copyright":"© iplan/a.collectionRF/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"コスモスの代表的な花色は、ピンクや白ですが、なかには濃い赤褐色の花を咲かせる品種「チョコレートコスモス」もあります。","LinkUrl":"/search?q=%e3%82%b3%e3%82%b9%e3%83%a2%e3%82%b9%e3%81%ab%e3%81%af%e3%81%a9%e3%81%ae%e3%81%8f%e3%82%89%e3%81%84%e3%81%ae%e7%a8%ae%e9%a1%9e%e3%81%8c%e3%81%82%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"コスモスにはどのくらいの種類がある？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260914_Cosmos2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b3%e3%82%b9%e3%83%a2%e3%82%b9%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260913_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260914_Cosmos2026"},"Ssd":"20260914","Name":"Cosmos2026","Market":"JA-JP","Hash":"5810317842","FullDateString":"2026 年 9月 月 14 日"},{"ImageContent":{"Description":"ギザギザとした峰が連なる今日の画像は、イタリア北東部のドロミーティ山脈にあるカディーニ・ディ・ミズリーナ山塊です。岸壁には海洋生物の化石が存在していますが、これは約 2 億 5,000 万年前、この地域が温暖な熱帯の海に覆われていたためです。長い年月の間にプレートの衝突による隆起と侵食が進み、かつて海底だった地層が現在の険しい山並みとして姿を現しました。ユネスコ世界遺産に登録されているドロミーティは、壮大な山岳風景と地球の歴史を伝える場所です。","Image":{"Url":"/th?id=OHR.MisurinaPeak_JA-JP5655621348_1920x1080.webp","Wallpaper":"/th?id=OHR.MisurinaPeak_JA-JP5655621348_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"雲間にそびえる鋭い峰々","Title":"カディーニ・ディ・ミズリーナ山塊, イタリア","Copyright":"© Vithun Khamsong/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/46.573411,12.276033/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=46.573411,12.276033;S9;カディーニ・ディ・ミズリーナ山塊, イタリア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260913_MisurinaPeak %22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260913_MisurinaPeak\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%83%87%e3%82%a3%e3%83%bc%e3%83%8b%e3%83%bb%e3%83%87%e3%82%a3%e3%83%bb%e3%83%9f%e3%82%ba%e3%83%aa%e3%83%bc%e3%83%8a%e5%b1%b1%e5%a1%8a&form=hpcapt&filters=HpDate:\"20260912_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260913_MisurinaPeak"},"Ssd":"20260913","Name":"MisurinaPeak","Market":"JA-JP","Hash":"5655621348","FullDateString":"2026 年 9月 月 13 日"},{"ImageContent":{"Description":"今日の画像は、カリフォルニアアシカ。主にアラスカ南東部からメキシコ中部にかけての北米大陸西海岸に生息する海洋哺乳類です。ひれ状の足は太く丈夫で、海では前足を使って力強く泳ぎ、陸上では前足と後ろ足で体を支えて歩くことができます。また、オスとメスでは見た目が異なり、オスは濃い色の体毛と盛り上がった頭頂部、メスは明るい色合いが特徴です。","Image":{"Url":"/th?id=OHR.SardineBait_JA-JP5540649445_1920x1080.webp","Wallpaper":"/th?id=OHR.SardineBait_JA-JP5540649445_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"イワシの群れを狙うカリフォルニアアシカ","Title":"カリフォルニアアシカ, メキシコ沖","Copyright":"© Henley Spiers/Nature Picture Library","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"カリフォルニアアシカは優れた潜水能力を持ち、最大で約 10 分間も息を止めて潜ることができます。","LinkUrl":"/search?q=%e3%82%ab%e3%83%aa%e3%83%95%e3%82%a9%e3%83%ab%e3%83%8b%e3%82%a2%e3%82%a2%e3%82%b7%e3%82%ab%e3%81%af%e3%80%81%e6%9c%80%e5%a4%a7%e3%81%a7%e3%81%a9%e3%82%8c%e3%81%8f%e3%82%89%e3%81%84%e3%81%ae%e6%b7%b1%e3%81%95%e3%81%be%e3%81%a7%e6%bd%9c%e3%82%8b%e3%81%93%e3%81%a8%e3%81%8c%e3%81%a7%e3%81%8d%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"カリフォルニアアシカは、最大でどれくらいの深さまで潜ることができる？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260912_SardineBait\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%83%aa%e3%83%95%e3%82%a9%e3%83%ab%e3%83%8b%e3%82%a2%e3%82%a2%e3%82%b7%e3%82%ab&form=hpcapt&filters=HpDate:\"20260911_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260912_SardineBait"},"Ssd":"20260912","Name":"SardineBait","Market":"JA-JP","Hash":"5540649445","FullDateString":"2026 年 9月 月 12 日"},{"ImageContent":{"Description":"アンコラは、インド南西部カルナータカ州のウッタラ・カンナダ県にある海辺の町です。アラビア海に面しており、美しい自然のビーチが多数点在しています。今日の画像に写るガビット・ケニ・ビーチもそのひとつです。このビーチの名前は、地元の漁業コミュニティである「ガビット」に由来しており、ビーチとしてだけでなく、漁業が盛んな地域としても知られています。地元の飲食店では、新鮮な魚介を使った料理が人気です。","Image":{"Url":"/th?id=OHR.GabitKeni_JA-JP3823379916_1920x1080.webp","Wallpaper":"/th?id=OHR.GabitKeni_JA-JP3823379916_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"美しい海辺の風景","Title":"ガビット・ケニ・ビーチ, インド","Copyright":"© Amith Nag Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/14.66311,74.278195/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=14.66311,74.278195;S9;ガビット・ケニ・ビーチ, インド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260911_GabitKeni %22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260911_GabitKeni\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Gabit+Keni+%e3%83%93%e3%83%bc%e3%83%81&form=hpcapt&filters=HpDate:\"20260910_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260911_GabitKeni"},"Ssd":"20260911","Name":"GabitKeni","Market":"JA-JP","Hash":"3823379916","FullDateString":"2026 年 9月 月 11 日"},{"ImageContent":{"Description":"ここは、スペイン南部アンダルシア州にある町、オルベラです。白い壁と赤や茶色の瓦屋根の家が丘の斜面に連なる光景は、アンダルシアに点在している「白い村（プエブロ・ブランコ）」の一つとして知られています。町は、広大なオリーブ畑に囲まれた丘の上に広がり、古くから戦略的な要地として発展してきました。丘の頂にそびえるムーア人の城塞とエンカルナシオン教会は、オルベラのランドマークであり、イスラム文化とキリスト教文化が交錯した歴史を今に伝えています。","Image":{"Url":"/th?id=OHR.Olvera_JA-JP5093791420_1920x1080.webp","Wallpaper":"/th?id=OHR.Olvera_JA-JP5093791420_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"赤茶色の屋根が映えるアンダルシアの街","Title":"オルベラ, スペイン","Copyright":"© Marco Bottigelli/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.935253,-5.267688/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.935253,-5.267688;S9;オルベラ, スペイン&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260910_Olvera%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260910_Olvera\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%aa%e3%83%ab%e3%83%99%e3%83%a9&form=hpcapt&filters=HpDate:\"20260909_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260910_Olvera"},"Ssd":"20260910","Name":"Olvera","Market":"JA-JP","Hash":"5093791420","FullDateString":"2026 年 9月 月 10 日"},{"ImageContent":{"Description":"今日 9 月 9 日は「重陽の節句」です。七草の節句、桃の節句、端午の節句、笹の節句（七夕）と並ぶ五節句の一つで、その起源は古代中国に遡ります。中国の陰陽五行説では、奇数が重なる縁起のよい日とされ、厄除けや長寿を願う行事が行われます。これが日本に伝わり、旧暦の 9 月 9 日頃は菊の花が咲き誇る季節でもあったことから、日本では「菊の節句」とも呼ばれるようになりました。平安時代には、貴族たちが菊の宴を催しました。また、菊の花に宿った露を真綿に移した「菊の被綿（きせわた）」で体をぬぐい、無病息災や長寿を祈ったといわれています。","Image":{"Url":"/th?id=OHR.ChungYang2026_JA-JP4920316432_1920x1080.webp","Wallpaper":"/th?id=OHR.ChungYang2026_JA-JP4920316432_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は重陽の節句","Title":"菊の花","Copyright":"© yanjf/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"日本の皇室の紋章は「菊花紋章」。16枚の花びらを持つ菊を図案化したもので、パスポートの表紙にも描かれています。","LinkUrl":"/search?q=%e7%9a%87%e5%ae%a4%e3%81%ae%e7%b4%8b%e7%ab%a0%e3%81%a8%e3%81%97%e3%81%a6%e8%8f%8a%e8%8a%b1%e7%b4%8b%e7%ab%a0%e3%81%8c%e4%bd%bf%e3%82%8f%e3%82%8c%e3%81%a6%e3%81%84%e3%82%8b&form=hpvsfa","LinkText":"皇室の紋章として菊花紋章が使われている理由"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260909_Chung