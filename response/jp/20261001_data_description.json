{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-10-01T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"1890 年 10 月 1 日、ヨセミテは米国で 3 番目の国立公園となりました。そして、今日の画像は公園内にあるビュースポット、「オルムステッド・ポイント」です。この場所からは、ハーフドームの切り立った北側やテナヤ峡谷、テナヤ湖といった公園を代表する名所を見渡すことができます。その名前は、米国の国立公園設立運動に貢献した造園家・フレデリック・ロー・オルムステッドとその息子に由来しています。ヨセミテを代表する絶景スポットであり、数百万年にわたる地殻変動や氷河作用が生み出した大地の歴史を私たちに伝えてくれます。","Image":{"Url":"/th?id=OHR.OlmstedPoint_JA-JP0098463265_1920x1080.webp","Wallpaper":"/th?id=OHR.OlmstedPoint_JA-JP0098463265_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"夕日に染まるヨセミテの岩峰","Title":"オルムステッド・ポイント, 米国 カリフォルニア州","Copyright":"© Robb Hirsch/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.850924,-119.572719/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=37.850924,-119.572719;S9;ヨセミテ国立公園, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261001_OlmstedPoint%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261001_OlmstedPoint\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%aa%e3%83%ab%e3%83%a0%e3%82%b9%e3%83%86%e3%83%83%e3%83%89%e3%83%bb%e3%83%9d%e3%82%a4%e3%83%b3%e3%83%88&form=hpcapt&filters=HpDate:\"20260930_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261001_OlmstedPoint"},"Ssd":"20261001","Name":"OlmstedPoint","Market":"JA-JP","Hash":"0098463265","FullDateString":"2026 年 10月 月 1 日"},{"ImageContent":{"Description":"今日の画像は、イングランド・ノーフォークで撮影されたオスのヒゲガラ。イギリスやヨーロッパに分布するスズメ目の鳥で、主に河川や湖沼などの湿地帯に生息しています。春から夏にかけては昆虫を、秋から冬にかけてはヨシやスゲの種子を主に食べ、ほとんど渡りをせずに同じ生息地で暮らします。オスは頭部の羽毛が灰色で、くちばしの基部から下方へ伸びるひげ状の黒斑があり、その特徴が名前の由来となっています。メスの頭部の羽毛は淡褐色で、オスのような黒斑はありません。","Image":{"Url":"/th?id=OHR.BeardReedling_JA-JP9843863193_1920x1080.webp","Wallpaper":"/th?id=OHR.BeardReedling_JA-JP9843863193_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"枯れ草にとまる小鳥","Title":"ヒゲガラ, イングランド","Copyright":"© Andrew Sproule/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.930101,0.952909/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=52.930101,0.952909;S9;ノーフォーク, イングランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260930_BeardReedling%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260930_BeardReedling\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%92%e3%82%b2%e3%82%ac%e3%83%a9&form=hpcapt&filters=HpDate:\"20260929_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260930_BeardReedling"},"Ssd":"20260930","Name":"BeardReedling","Market":"JA-JP","Hash":"9843863193","FullDateString":"2026 年 9月 月 30 日"},{"ImageContent":{"Description":"今日の画像は、米国アラスカ州南部のキナイ半島を流れるカシロフ川。水源であるツツメナ氷河から運ばれる氷河岩粉によって、水の色は鮮やかなミルキーブルーとなっています。川は約 27km にわたって流れ、クック湾へと注ぎ込みます。この川には、サケやマスが豊富に生息し、人気の釣りスポットとして知られています。また、周辺ではキャンプや自然遊歩道の散策も楽しめます。","Image":{"Url":"/th?id=OHR.KasilofRiver_JA-JP7219675730_1920x1080.webp","Wallpaper":"/th?id=OHR.KasilofRiver_JA-JP7219675730_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"氷河の恵みをたたえる川","Title":"カシロフ川, 米国 アラスカ州","Copyright":"© jared lloyd/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/60.386498,-151.301832/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=60.386498,-151.301832;S9;カシロフ川, 米国 アラスカ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260929_KasilofRiver%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260929_KasilofRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%82%b7%e3%83%ad%e3%83%95%e5%b7%9d&form=hpcapt&filters=HpDate:\"20260928_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260929_KasilofRiver"},"Ssd":"20260929","Name":"KasilofRiver","Market":"JA-JP","Hash":"7219675730","FullDateString":"2026 年 9月 月 29 日"},{"ImageContent":{"Description":"アンベール城は、インドのラージャスターン州ジャイプル郊外にある宮殿要塞です。1592年、ラージャ・マーン・シング 1 世が築城を始め、以後、カッチワハ朝の歴代統治者によって拡張されていきました。1727 年に王族はジャイプルへと移りましたが、アンベール城はその後も儀礼の場として使用されていました。ヒンドゥー、ラージプート、ムガルの建築様式が融合した壮麗な城で、現在はジャイプルを代表する観光名所の一つとして知られています。そして、今日の画像は城内にあるサッタイス・カチェリで、「 27 本の柱の宮殿」を意味する建造物です。","Image":{"Url":"/th?id=OHR.AmberHall_JA-JP9172458689_1920x1080.webp","Wallpaper":"/th?id=OHR.AmberHall_JA-JP9172458689_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"優美な柱が並ぶ宮殿","Title":"アンベール城, インド","Copyright":"© R.M. Nunes/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/26.986382,75.851341/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=26.986382,75.851341;S9;アンベール城, インド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260928_AmberHall%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260928_AmberHall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%b3%e3%83%99%e3%83%bc%e3%83%ab%e5%9f%8e&form=hpcapt&filters=HpDate:\"20260927_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260928_AmberHall"},"Ssd":"20260928","Name":"AmberHall","Market":"JA-JP","Hash":"9172458689","FullDateString":"2026 年 9月 月 28 日"},{"ImageContent":{"Description":"1989 年の今日、9 月 27 日に、横浜ベイブリッジは開通しました。横浜市の中区と鶴見区を結ぶ全長 860m の橋で、完成当時は日本最長の斜張橋でした。上層部は首都高速湾岸線、下層部は国道 357 号という 2 層構造になっています。美しい夜景スポットとして知られており、近隣の横浜港大さん橋国際客船ターミナルから月と共に撮影された姿は、日本百名月にも選ばれています。また、優れた技術力と美しいデザインが評価され、日本百名橋の一つにも選ばれています。","Image":{"Url":"/th?id=OHR.YokohamaBayBridge_JA-JP8812921625_1920x1080.webp","Wallpaper":"/th?id=OHR.YokohamaBayBridge_JA-JP8812921625_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は横浜ベイブリッジ開通日","Title":"横浜ベイブリッジ, 神奈川県 横浜市","Copyright":"© Yuga Kurita/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.454465,139.673569/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.454465,139.673569;S9;横浜ベイブリッジ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260927_YokohamaBayBridge%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260927_YokohamaBayBridge\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e6%a8%aa%e6%b5%9c%e3%83%99%e3%82%a4%e3%83%96%e3%83%aa%e3%83%83%e3%82%b8%e9%96%8b%e9%80%9a%e6%97%a5&form=hpcapt&filters=HpDate:\"20260926_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260927_YokohamaBayBridge"},"Ssd":"20260927","Name":"YokohamaBayBridge","Market":"JA-JP","Hash":"8812921625","FullDateString":"2026 年 9月 月 27 日"},{"ImageContent":{"Description":"ここはシーダーメサ。米国ユタ州にあるベアーズ・イヤーズ国定公園の南部に位置する台地です。標高は約 2,000m で、考古学上の宝庫として知られるグランド・ガルチをはじめ、深い峡谷が数多く存在しています。南側にはミューリー・ポイントと呼ばれる岬があり、ここからサンファン川やバレー・オブ・ザ・ゴッズ、モニュメント・バレー、ナバホ・マウンテンといった素晴らしい景観を一望できます。また、シーダーメサの向こうには 2 つの丘がそびえており、これがクマの耳（ベアーズイヤーズ）に似ていることが、公園の名前の由来となっています。","Image":{"Url":"/th?id=OHR.BearsEars_JA-JP8214752036_1920x1080.webp","Wallpaper":"/th?id=OHR.BearsEars_JA-JP8214752036_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"標高約2,000mから見渡す大峡谷","Title":"シーダーメサ, 米国 ユタ州","Copyright":"© Jeff Clay/Tandem Stills + Motion","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.433414,-109.916978/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=37.433414,-109.916978;S9;シーダーメサ, 米国 ユタ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260926_BearsEars%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260926_BearsEars\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b7%e3%83%bc%e3%83%80%e3%83%bc%e3%83%a1%e3%82%b5&form=hpcapt&filters=HpDate:\"20260925_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260926_BearsEars"},"Ssd":"20260926","Name":"BearsEars","Market":"JA-JP","Hash":"8214752036","FullDateString":"2026 年 9月 月 26 日"},{"ImageContent":{"Description":"2026 年は、今日 9 月 25 日が中秋の名月。お団子やススキなどをお供えしてお月見を楽しむ日であるとともに、秋の実りに感謝し、翌年の豊穣を祈願する日です。旧暦の 8 月 15 日にあたり、中国の中秋節に由来しています。日本ではお団子が主流ですが、中国では「月餅」という丸いお菓子を食べます。この月餅は、満月をかたどっているとともに、家族の円満や団らんを象徴しており、家族で集まって食べることで、全員の幸せを祈ります。","Image":{"Url":"/th?id=OHR.MidAutumn2026_JA-JP8034446964_1920x1080.webp","Wallpaper":"/th?id=OHR.MidAutumn2026_JA-JP8034446964_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は中秋の名月","Title":"中秋節用の中国提灯","Copyright":"© LeeYiuTung/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"中国では、月には「玉兎（ぎょくと）」というウサギが住み、不老不死の薬を作っていると伝えられています。","LinkUrl":"/search?q=%e6%97%a5%e6%9c%ac%e3%81%a7%e3%81%af%e3%80%81%e6%9c%88%e3%81%ae%e3%82%a6%e3%82%b5%e3%82%ae%e3%81%af%e4%bd%95%e3%82%92%e3%81%97%e3%81%a6%e3%81%84%e3%82%8b%e3%81%a8%e8%a8%80%e3%82%8f%e3%82%8c%e3%81%a6%e3%81%84%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"日本では、月のウサギは何をしていると言われている？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260925_MidAutumn2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%ad%e7%a7%8b%e3%81%ae%e5%90%8d%e6%9c%88&form=hpcapt&filters=HpDate:\"20260924_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260925_MidAutumn2026"},"Ssd":"20260925","Name":"MidAutumn2026","Market":"JA-JP","Hash":"8034446964","FullDateString":"2026 年 9月 月 25 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"今日 10 月 8 日は二十四節気の寒露。朝晩の冷え込みが増し、秋の深まりを感じる頃です。秋は「食欲の秋」ともいわれるように、栗やしいたけ、秋サバなどさまざまな食べ物が旬を迎えます。そして画像は、秋の味覚の代表格である栗。栗は、実は定義によって野菜にも果物にも木の実にも分類される食材です。その歴史は古く、縄文時代の遺跡からも見つかっており、太古の昔から私たちの食生活に関わっていました。現在も、栗ご飯や甘露煮のほか、モンブランや渋皮煮などさまざまな料理や菓子に利用され、秋の食卓を彩っています。","Image":{"Url":"/th?id=OHR.Chestnut2026_JA-JP0900389061_1920x1080.webp","Wallpaper":"/th?id=OHR.Chestnut2026_JA-JP0900389061_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は寒露","Title":"栗の実","Copyright":"© y-studio/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"栗には 100g あたり約 33mg のビタミン C が含まれており、トマトの約 2 倍です。さらに、加熱しても壊れにくいです。","LinkUrl":"/search?q=%e6%a0%97%e3%81%ae%e3%83%93%e3%82%bf%e3%83%9f%e3%83%b3C%e3%81%8c%e5%8a%a0%e7%86%b1%e3%81%97%e3%81%a6%e3%82%82%e5%a3%8a%e3%82%8c%e3%81%ab%e3%81%8f%e3%81%84%e7%90%86%e7%94%b1%e3%81%af%ef%bc%9f&form=hpvsfa","LinkText":"栗のビタミンCが加熱しても壊れにくい理由は？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261008_Chestnut2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%af%92%e9%9c%b2&form=hpcapt&filters=HpDate:\"20261007_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261008_Chestnut2026"},"Ssd":"20261008","Name":"Chestnut2026","Market":"JA-JP","Hash":"0900389061","FullDateString":"2026 年 10月 月 8 日"},{"ImageContent":{"Description":"ここはパズルウッド。イングランドのグロスターシャー州にある「ディーンの森」に広がる古代森林地帯です。苔むした岩や「スカウル」と呼ばれる独特の地形で知られています。不規則で迷路状な窪みが特徴のスカウルは、数百万年にわたり、石灰岩にできた地下洞窟が隆起や浸食によって地表に現れることで形成されました。その後、鉄器時代からローマ時代にかけて、鉄鉱石の採掘に利用されたと考えられています。森の中には、約 1.6km の小道が張り巡らされ、奇岩や洞窟、古木が織りなす幻想的な景観が広がります。その神秘的な雰囲気から、「スター・ウォーズ／フォースの覚醒」をはじめ、さまざまな映画のロケ地としても使用されています。","Image":{"Url":"/th?id=OHR.ForestofDean_JA-JP0675230191_1920x1080.webp","Wallpaper":"/th?id=OHR.ForestofDean_JA-JP0675230191_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"苔むした森","Title":"パズルウッド, イングランド","Copyright":"© Fulcanelli_AOS/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/51.812183,-2.516615/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=51.812183,-2.516615;S9;ディーンの森のパズルウッド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261007_ForestofDean%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261007_ForestofDean\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%87%e3%82%a3%e3%83%bc%e3%83%b3%e3%81%ae%e6%a3%ae%e3%81%ae%e3%83%91%e3%82%ba%e3%83%ab%e3%82%a6%e3%83%83%e3%83%89&form=hpcapt&filters=HpDate:\"20261006_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261007_ForestofDean"},"Ssd":"20261007","Name":"ForestofDean","Market":"JA-JP","Hash":"0675230191","FullDateString":"2026 年 10月 月 7 日"},{"ImageContent":{"Description":"今日 10 月 6 日は国際ジオダイバーシティデー。鉱物や岩石、土壌など、非生物の自然の多様性について理解を深めることを目的にユネスコ総会が制定しました。そして、今日の画像は中国甘粛省の張掖国家地質公園に広がる丹霞地形です。色鮮やかな地層が重なり、虹のような独特の景観をつくり出しています。こうした色彩には、岩石に含まれる鉄などの鉱物が関係しています。さらに、長い年月にわたる地殻変動や風雨による侵食が加わることで、現在の壮大な地形が形成されました。公園は、地球の歴史と多様な地形の価値が認められ、2020 年にユネスコ世界ジオパークに認定されました。","Image":{"Url":"/th?id=OHR.DanxiaLandform_JA-JP9811731742_1920x1080.webp","Wallpaper":"/th?id=OHR.DanxiaLandform_JA-JP9811731742_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際ジオダイバーシティデー","Title":"張掖国家地質公園, 中国","Copyright":"© Weiquan Lin/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.966774,100.04408/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=38.966774,100.04408;S9;張掖国家地質公園, 中国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261006_DanxiaLandform%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261006_DanxiaLandform\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%9a%9b%e3%82%b8%e3%82%aa%e3%83%80%e3%82%a4%e3%83%90%e3%83%bc%e3%82%b7%e3%83%86%e3%82%a3%e3%83%87%e3%83%bc&form=hpcapt&filters=HpDate:\"20261005_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261006_DanxiaLandform"},"Ssd":"20261006","Name":"DanxiaLandform","Market":"JA-JP","Hash":"9811731742","FullDateString":"2026 年 10月 月 6 日"},{"ImageContent":{"Description":"今日の画像は、南極大陸周辺に生息するアデリーペンギンのグループ。アデリーペンギンは、体長 60 ～ 70cm、体重約 5kg という中型のペンギンです。海中を時速約 14kmで泳ぎ回りながら、餌を捕まえたり、捕食者から逃れたりします。地上の雪原を移動する際は、他のペンギン同様腹ばいになって氷上を滑って移動することがあります。この移動方法は「トボガン」と呼ばれており、北米の先住民が用いていたソリを意味する言葉にちなんで名づけられました。","Image":{"Url":"/th?id=OHR.AdelieTeacher_JA-JP9090254921_1920x1080.webp","Wallpaper":"/th?id=OHR.AdelieTeacher_JA-JP9090254921_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"海へ飛び込もうとするペンギンたち","Title":"アデリーペンギンのグループ, 南極大陸","Copyright":"© Otto Plantema/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"ペンギンには歯がありません。","LinkUrl":"/search?q=%e3%83%9a%e3%83%b3%e3%82%ae%e3%83%b3%e3%81%ae%e5%8f%a3%e3%81%ae%e4%b8%ad%e3%81%ab%e3%81%82%e3%82%8b%e3%81%a8%e3%81%92%e7%8a%b6%e3%81%ae%e7%aa%81%e8%b5%b7%e3%81%ab%e3%81%af%e3%81%a9%e3%82%93%e3%81%aa%e5%bd%b9%e5%89%b2%e3%81%8c%e3%81%82%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"ペンギンの口の中にあるとげ状の突起にはどんな役割がある？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261005_AdelieTeacher\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%87%e3%83%aa%e3%83%bc%e3%83%9a%e3%83%b3%e3%82%ae%e3%83%b3&form=hpcapt&filters=HpDate:\"20261004_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261005_AdelieTeacher"},"Ssd":"20261005","Name":"AdelieTeacher","Market":"JA-JP","Hash":"9090254921","FullDateString":"2026 年 10月 月 5 日"},{"ImageContent":{"Description":"今日、10 月 4 日から 10 月 10 日までは、世界宇宙週間です。毎年テーマが定められており、今年のテーマは「ロケット革命」。そして、画像は米国フロリダ州のケネディ宇宙センターで打ち上げられたアルテミス I のロケットです。2022 年 11 月 16 日、NASA はアルテミス I ミッションとしてオリオン宇宙船を打ち上げました。これは、将来の有人月面探査に向けたシステムの安全性と信頼性を検証するための無人飛行試験でした。オリオン宇宙船は地球から約 43 万 km に到達し、月を周回する遠方逆行軌道を飛行した後、約 25 日間にわたるミッションを完了しました。","Image":{"Url":"/th?id=OHR.ArtemisRocket_JA-JP8925094178_1920x1080.webp","Wallpaper":"/th?id=OHR.ArtemisRocket_JA-JP8925094178_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"今日から世界宇宙週間","Title":"アルテミス I のロケット, 米国 フロリダ州","Copyright":"© EVA MARIE UZCATEGUI/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/28.522254,-80.68167/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=28.522254,-80.68167;S9;ケネディ宇宙センター, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261004_ArtemisRocket%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261004_ArtemisRocket\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e5%ae%87%e5%ae%99%e9%80%b1%e9%96%93&form=hpcapt&filters=HpDate:\"20261003_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261004_ArtemisRocket"},"Ssd":"20261004","Name":"ArtemisRocket","Market":"JA-JP","Hash":"8925094178","FullDateString":"2026 年 10月 月 4 日"},{"ImageContent":{"Description":"今日の画像は、アンモナイトの化石。アンモナイトは、約 4 億年前から 6600 万年前まで海に生息していた海洋軟体動物です。殻の内部が複数の部屋に分かれているなど、現生のオウムガイ類と似た特徴を持っていますが、イカやタコなどを含むグループにより近いと考えられています。多くの種類に見られる特徴的な螺旋形の殻から、古代生物の代表的な化石として広く知られています。また、世界各地で化石が発見されており、地層の年代決定や先史時代の海洋環境の研究に活用されています。","Image":{"Url":"/th?id=OHR.AmmoniteFossils_JA-JP8778940090_1920x1080.webp","Wallpaper":"/th?id=OHR.AmmoniteFossils_JA-JP8778940090_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"古代の海に生息していた動物の化石","Title":"アンモナイトの化石","Copyright":"© J Nemchinova/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"化石とは、過去の生物の体や活動の痕跡が長い時間を経て自然に保存されたものです。アンモナイトの殻もその一種です。","LinkUrl":"/search?q=%e5%8c%96%e7%9f%b3%e3%81%ab%e3%81%af%e3%81%a9%e3%81%ae%e3%82%88%e3%81%86%e3%81%aa%e3%82%82%e3%81%ae%e3%81%8c%e3%81%82%e3%82%8b%ef%bc%9f&form=hpvsfa","LinkText":"化石にはどのようなものがある？"},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261003_AmmoniteFossils\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a2%e3%83%b3%e3%83%a2%e3%83%8a%e3%82%a4%e3%83%88&form=hpcapt&filters=HpDate:\"20261002_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261003_AmmoniteFossils"},"Ssd":"20261003","Name":"AmmoniteFossils","Market":"JA-JP","Hash":"8778940090","FullDateString":"2026 年 10月 月 3 日"},{"ImageContent":{"Description":"ここはチャトゥーガ川。米国ノースカロライナ州のアパラチア山脈を源流とし、サウスカロライナ州とジョージア州の州境を流れる川です。長さは約 92km で、米国南東部で最も長い自由流河川の一つです。美しい景観と豊かな生態系で知られているほか、ラフティングやカヤック、カヌーといったアクティビティを楽しむことができます。","Image":{"Url":"/th?id=OHR.ChattoogaRiver_JA-JP8558662500_1920x1080.webp","Wallpaper":"/th?id=OHR.ChattoogaRiver_JA-JP8558662500_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"川面を流れる紅葉","Title":"チャトゥーガ川, 米国 ノースカロライナ州","Copyright":"© mtilghma/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.080936,-83.109932/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.080936,-83.109932;S9;チャトゥーガ川, 米国 ノースカロライナ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261002_ChattoogaRiver%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261002_ChattoogaRiver\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%81%e3%83%a3%e3%83%88%e3%82%a5%e3%83%bc%e3%82%ac%e5%b7%9d&form=hpcapt&filters=HpDate:\"20261001_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261002_ChattoogaRiver"},"Ssd":"20261002","Name":"ChattoogaRiver","Market":"JA-JP","Hash":"8558662500","FullDateString":"2026 年 10月 月 2 