{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-08-07T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"今日 8 月 7 日は米国灯台の日。ジョージ・ワシントン大統領の署名によって 1789 年に成立した「灯台法」を記念して制定された日であり、灯台の歴史と役割をたたえる日です。そして画像は、米国ワシントン州のサンファン島にあるライム・キルン灯台。1919 年に建設され、現在も船舶を導き続けています。航行技術の発展とともに進化を続けてきた灯台は、歴史的建造物や絶景スポットとしても親しまれながら、今もなお、安全と不屈の精神、そして大海原への冒険を象徴する存在であり続けています。","Image":{"Url":"/th?id=OHR.LimeKiln_JA-JP2506397292_1920x1080.webp","Wallpaper":"/th?id=OHR.LimeKiln_JA-JP2506397292_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は米国灯台の日","Title":"ライム・キルン灯台, 米国 ワシントン州","Copyright":"© Edmund Lowe Photography/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.515855,-123.152649/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=48.515855,-123.152649;S9;ライム・キルン灯台, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260807_ LimeKiln%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260807_LimeKiln\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%b1%b3%e5%9b%bd%e7%81%af%e5%8f%b0%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260806_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260807_LimeKiln"},"Ssd":"20260807","Name":"LimeKiln","Market":"JA-JP","Hash":"2506397292","FullDateString":"2026 年 8月 月 7 日"},{"ImageContent":{"Description":"今日、8 月 6 日は広島平和記念日。広島に投下された原子爆弾は、10 数万人もの人々の命を奪い、5 万を超える建物を破壊しました。毎年この日に、原爆ドームそばの元安川では、とうろう流しが行われます。川面に浮かぶ無数のとうろうには、原爆で失われた尊い命への追悼と、未来への平和の願いが込められています。この光景は、悲しみの記憶を受け継ぎながらも、希望を忘れない人々の思いの象徴です。今日という日は、平和な世界の維持と「核なき世界」の実現に向けて、一人ひとりが再認識し、考えるべき日です。","Image":{"Url":"/th?id=OHR.HiroshimaPeaceMemorial2026_JA-JP7778121397_1920x1080.webp","Wallpaper":"/th?id=OHR.HiroshimaPeaceMemorial2026_JA-JP7778121397_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は広島平和記念日","Title":"広島平和記念公園のとうろう流し, 広島県 広島市","Copyright":"© Buddhika Weerasinghe/Stringer/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.392708,132.452194/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=34.392708,132.452194;S9;広島平和記念公園&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260806_HiroshimaPeaceMemorial2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260806_HiroshimaPeaceMemorial2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%ba%83%e5%b3%b6%e5%b9%b3%e5%92%8c%e8%a8%98%e5%bf%b5%e6%97%a5&form=hpcapt&filters=HpDate:\"20260805_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260806_HiroshimaPeaceMemorial2026"},"Ssd":"20260806","Name":"HiroshimaPeaceMemorial2026","Market":"JA-JP","Hash":"7778121397","FullDateString":"2026 年 8月 月 6 日"},{"ImageContent":{"Description":"モロッコの古都フェズにある王宮「ダル・アル・マフゼン」は、13 世紀に建設された歴史ある宮殿です。写真に映る宮殿の門は、精巧な真鍮細工と色鮮やかな幾何学模様のタイルで彩られ、モロッコ建築の美しさを象徴しています。現在も王族の居住地として使用されているため、内部は一般公開されていませんが、この壮麗な門の前には近づくことができるため、長い歴史と王室文化の重みを間近に感じることができます。","Image":{"Url":"/th?id=OHR.FezMorocco_JA-JP7567982886_1920x1080.webp","Wallpaper":"/th?id=OHR.FezMorocco_JA-JP7567982886_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"宮殿の門","Title":"フェズ王宮, モロッコ","Copyright":"© cgst26/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.034653,-5.016192/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=34.034653,-5.016192;S9;フェズ王宮, モロッコ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260805_FezMorocco%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260805_FezMorocco\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%95%e3%82%a7%e3%82%ba%e7%8e%8b%e5%ae%ae&form=hpcapt&filters=HpDate:\"20260804_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260805_FezMorocco"},"Ssd":"20260805","Name":"FezMorocco","Market":"JA-JP","Hash":"7567982886","FullDateString":"2026 年 8月 月 5 日"},{"ImageContent":{"Description":"今日 8 月 4 日は国際フクロウの日。フクロウは平たいお面のような顔と、首を約 270 度回せる点が特徴です。そして画像は、米国フロリダ州に生息するアナホリフクロウのひな。アナホリフクロウは広大な草原や牧草地などの開けた環境を好み、樹上ではなく地上に巣穴を作って暮らします。多くのフクロウとは異なり昼行性で、獲物を見つけると走って追いかけることもあります。そのため、ほかのフクロウに比べて足が長いのが特徴です。","Image":{"Url":"/th?id=OHR.AdorableOwlet_JA-JP7246946497_1920x1080.webp","Wallpaper":"/th?id=OHR.AdorableOwlet_JA-JP7246946497_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は国際フクロウの日","Title":"アナホリフクロウのひな, 米国 フロリダ州","Copyright":"© mlorenzphotography/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/26.726665,-81.99716/12?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=26.726665,-81.99716;S9;ケープコーラル, 米国 フロリダ州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260804_AdorableOwlet%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260804_AdorableOwlet\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%9b%bd%e9%9a%9b%e3%83%95%e3%82%af%e3%83%ad%e3%82%a6%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260803_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260804_AdorableOwlet"},"Ssd":"20260804","Name":"AdorableOwlet","Market":"JA-JP","Hash":"7246946497","FullDateString":"2026 年 8月 月 4 日"},{"ImageContent":{"Description":"マルタ本島最大の漁師町、マルサシュロック。マルタ島の南東部に位置し、日曜日に開催されるフィッシュマーケットで知られています。そして画像は、町の港に並ぶ伝統的な漁船「ルッツ」です。青や黄、赤などの鮮やかな色で彩られた木製の船で、船首には「オシリスの目」と呼ばれる装飾が施されています。これは、航海の安全を見守るお守りとされ、2000 年以上前から受け継がれています。地中海の青い海と長い歴史が息づく町並みが調和する風景は、訪れる人々を魅了します。","Image":{"Url":"/th?id=OHR.BoatsMalta_JA-JP6685221242_1920x1080.webp","Wallpaper":"/th?id=OHR.BoatsMalta_JA-JP6685221242_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"エメラルドの海に浮かぶ色とりどりの船","Title":"マルサシュロック, マルタ","Copyright":"© Klubovy/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.841105,14.544731/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.841105,14.544731;S9;マルサシュロック, マルタ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260803_BoatsMalta%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260803_BoatsMalta\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%9e%e3%83%ab%e3%82%b5%e3%82%b7%e3%83%a5%e3%83%ad%e3%83%83%e3%82%af&form=hpcapt&filters=HpDate:\"20260802_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260803_BoatsMalta"},"Ssd":"20260803","Name":"BoatsMalta","Market":"JA-JP","Hash":"6685221242","FullDateString":"2026 年 8月 月 3 日"},{"ImageContent":{"Description":"ここはフィンランドの首都ヘルシンキ。1550 年、当時のスウェーデン国王グスタフ 1 世によって交易の街として整備され、1812 年に首都となりました。フィンランド湾沿岸に位置し、300 以上の島々を有しているため、街の総面積の約 7 割が海域となっていますが、同時に緑豊かな森にも恵まれています。フィンランドには「自然享受権」という権利があるため、誰でも気軽に森を散策することが可能であり、ベリーやキノコなどを自由に採集することができます。","Image":{"Url":"/th?id=OHR.HelsinkiBlue_JA-JP6468131752_1920x1080.webp","Wallpaper":"/th?id=OHR.HelsinkiBlue_JA-JP6468131752_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"ブルーアワーに輝く湾岸の街","Title":"ヘルシンキ, フィンランド","Copyright":"© Miemo Penttinen/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/60.166622,24.943541/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=60.166622,24.943541;S9;ヘルシンキ, フィンランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260802_HelsinkiBlue%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260802_HelsinkiBlue\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%98%e3%83%ab%e3%82%b7%e3%83%b3%e3%82%ad&form=hpcapt&filters=HpDate:\"20260801_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260802_HelsinkiBlue"},"Ssd":"20260802","Name":"HelsinkiBlue","Market":"JA-JP","Hash":"6468131752","FullDateString":"2026 年 8月 月 2 日"},{"ImageContent":{"Description":"今日 8 月 1 日から 7 日まで、青森県弘前市では「弘前ねぷたまつり」が開催されます。「ヤーヤドー」の掛け声とともに、大小約 80 台の山車が市内を練り歩くというもので、「弘前四大まつり」の一つにも数えられています。「ねぷた」という言葉の由来は諸説ありますが、かつて農民たちが夏に行っていた「眠り流し」という行事から生まれたといわれています。そして、様々なねぷたのなかでも、欠かすことのできないものの一つが金魚ねぷた。江戸時代、金魚は高級魚であり、庶民にとっては憧れの存在であったため、それをねぷたにしてお祭りで子どもたちに持たせたとされています。近年は、祭りのみならずお土産としても人気となっています。","Image":{"Url":"/th?id=OHR.HirosakiNeputa2026_JA-JP5726503053_1920x1080.webp","Wallpaper":"/th?id=OHR.HirosakiNeputa2026_JA-JP5726503053_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日から弘前ねぷたまつり","Title":"変わり種の金魚ねぷた, 青森県 弘前市","Copyright":"© David Parker/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/40.603123,140.463928/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=40.603123,140.463928;S9;青森県弘前市&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260801_HirosakiNeputa2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260801_HirosakiNeputa2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%bc%98%e5%89%8d%e3%81%ad%e3%81%b7%e3%81%9f%e3%81%be%e3%81%a4%e3%82%8a&form=hpcapt&filters=HpDate:\"20260731_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260801_HirosakiNeputa2026"},"Ssd":"20260801","Name":"HirosakiNeputa2026","Market":"JA-JP","Hash":"5726503053","FullDateString":"2026 年 8月 月 1 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"下田港は、静岡県伊豆半島の南端に位置する歴史ある港です。幕末にペリー艦隊が来航した港でもあり、1854 年の日米和親条約により函館港とともに日本初の開港地となりました。山と海に囲まれた美しい景観が魅力で、現在は観光港や漁港として親しまれています。毎年 8 月 14 日と 15 日に約 400 年の歴史を誇る「下田八幡神社例大祭（下田太鼓祭り）」が開催され、勇壮な太鼓の音とともに町全体が活気に包まれます。夕暮れには港町の灯りが水面に映り、歴史、自然、そして伝統文化が織りなす魅力的な風景が広がります。","Image":{"Url":"/th?id=OHR.Shimoda2026_JA-JP6266826592_1920x1080.webp","Wallpaper":"/th?id=OHR.Shimoda2026_JA-JP6266826592_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"灯りに彩られた歴史ある港町","Title":"下田港, 静岡県 下田市","Copyright":"© Sean Pavone/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.67457,138.956552/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=34.67457,138.956552;S9;下田港&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260814_Shimoda2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260814_Shimoda2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%8b%e7%94%b0%e6%b8%af&form=hpcapt&filters=HpDate:\"20260813_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260814_Shimoda2026"},"Ssd":"20260814","Name":"Shimoda2026","Market":"JA-JP","Hash":"6266826592","FullDateString":"2026 年 8月 月 14 日"},{"ImageContent":{"Description":"三大流星群の一つであるペルセウス座流星群が見頃を迎えています。多くの流星が流れると予想されるのは 8 月 12 日の夜から 13 日の未明と、13 日夜から 14 日の未明です。特に、本日 13 日は新月で月明かりの影響がないため、星空観察には好条件の日となっています。そして画像は、スペインのテイデ国立公園にあるテイデ天文台で以前撮影されたペルセウス座流星群。テイデ国立公園は、標高約 2400m の高地にあり、澄んだ空気と光害の少ない環境から、世界有数の天体観測地として知られています。","Image":{"Url":"/th?id=OHR.PerseidasTenerife_JA-JP5992050152_1920x1080.webp","Wallpaper":"/th?id=OHR.PerseidasTenerife_JA-JP5992050152_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"ペルセウス座流星群が輝く夜空","Title":"テイデ天文台, スペイン","Copyright":"© Westend61/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/28.299148,-16.510563/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=28.299148,-16.510563;S9;テイデ天文台, スペイン&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260813_ PerseidasTenerife (in tool)%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260813_PerseidasTenerife\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%9a%e3%83%ab%e3%82%bb%e3%82%a6%e3%82%b9%e5%ba%a7%e6%b5%81%e6%98%9f%e7%be%a4&form=hpcapt&filters=HpDate:\"20260812_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260813_PerseidasTenerife"},"Ssd":"20260813","Name":"PerseidasTenerife","Market":"JA-JP","Hash":"5992050152","FullDateString":"2026 年 8月 月 13 日"},{"ImageContent":{"Description":"今日 8 月 12 日は世界ゾウの日。密猟や生息地の破壊などによって絶滅の危機に瀕しているゾウの保護を呼びかける日として、2012 年に制定されました。画像は、ケニアのアンボセリ国立公園で暮らすゾウの群れ。ゾウは、年長のメスを中心とした群れで生活しており、オスは 12 ～ 15 歳程度の時期に群れを離れます。また、巨大な体に加え、高い知能と優れた記憶力を持つのもゾウの特徴です。そのため、リーダーである母ゾウが、長年の記憶を頼りに、群れを各地の水場へと導いています。","Image":{"Url":"/th?id=OHR.ElephantDay_JA-JP5660368264_1920x1080.webp","Wallpaper":"/th?id=OHR.ElephantDay_JA-JP5660368264_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は世界ゾウの日","Title":"ゾウの群れ, ケニア","Copyright":"© Ibrahim Suha Derbent/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-2.637773,37.228507/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-2.637773,37.228507;S9;アンボセリ国立公園, ケニア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260812_ ElephantDay%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260812_ElephantDay\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e3%82%be%e3%82%a6%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260811_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260812_ElephantDay"},"Ssd":"20260812","Name":"ElephantDay","Market":"JA-JP","Hash":"5660368264","FullDateString":"2026 年 8月 月 12 日"},{"ImageContent":{"Description":"今日 8 月 11 日は山の日。「山に親しむ機会を得て、山の恩恵に感謝する」ことを趣旨として、2014 年に制定、2016 年から施行された国民の祝日です。そして画像は、中部山岳国立公園に属する、日本屈指の鋭く険しい岩峰が連なる、息を呑むような大絶景が広がる日本有数の山岳エリアで、多くの登山者を魅了しています。","Image":{"Url":"/th?id=OHR.MountainDay2026_JA-JP4675980762_1920x1080.webp","Wallpaper":"/th?id=OHR.MountainDay2026_JA-JP4675980762_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は山の日","Title":"日本アルプス","Copyright":"© Sergey Alimov/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/36.000423,136.999957/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=36.000423,136.999957;S9;日本アルプス&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260811_ MountainDay2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260811_MountainDay2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b1%b1%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20260810_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260811_MountainDay2026"},"Ssd":"20260811","Name":"MountainDay2026","Market":"JA-JP","Hash":"4675980762","FullDateString":"2026 年 8月 月 11 日"},{"ImageContent":{"Description":"ニューハウンは、デンマークの首都コペンハーゲンにある運河沿いの地区です。カラフルな建物と歴史ある木造船が織りなす風景は、コペンハーゲンを代表する景観として親しまれています。「新港」を意味するこの地域は、デンマーク国王クリスチャン5世の命によって17 世紀に建設され、貿易・商業の中心地として栄えました。現在は、運河沿いにカフェやレストランが並ぶ人気の観光地として知られています。","Image":{"Url":"/th?id=OHR.ColorfulCop_JA-JP4331289983_1920x1080.webp","Wallpaper":"/th?id=OHR.ColorfulCop_JA-JP4331289983_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"静かな水面に映るカラフルな街並み","Title":"ニューハウン, デンマーク","Copyright":"© emicristea/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/55.679795,12.590698/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=55.679795,12.590698;S9;ニューハウン, デンマーク&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260810_ ColorfulCop%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260810_ColorfulCop\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8b%e3%83%a5%e3%83%bc%e3%83%8f%e3%82%a6%e3%83%b3&form=hpcapt&filters=HpDate:\"20260809_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260810_ColorfulCop"},"Ssd":"20260810","Name":"ColorfulCop","Market":"JA-JP","Hash":"4331289983","FullDateString":"2026 年 8月 月 10 日"},{"ImageContent":{"Description":"今日 8 月 9 日は世界の先住民の国際デー。先住民の権利の保護と推進を目的として、1994 年に国連総会で制定されました。現在、約 90 の国や地域に、およそ 4 億 7600 万人の先住民が暮らしており、それぞれの地域に根ざした独自の言語、文化、伝統を受け継いでいます。今日の画像、ニューカレドニアのティナ半島にあるチバウ文化センターは、そうした文化遺産を象徴する施設です。イタリアの建築家レンゾ・ピアノによって設計されたこの建造物は、島の先住民族である「カナック族」の伝統や文化などを紹介する複合施設として、1998 年にオープンしました。カナック族の伝統家屋「カーズ」をモチーフに設計されており、巻貝のような形が特徴です。","Image":{"Url":"/th?id=OHR.JMTjibaou_JA-JP3637480935_1920x1080.webp","Wallpaper":"/th?id=OHR.JMTjibaou_JA-JP3637480935_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は世界の先住民の国際デー","Title":"チバウ文化センター, ニューカレドニア","Copyright":"© Fabien Astre/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-22.256211,166.481917/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-22.256211,166.481917;S9;チバウ文化センター, ニューカレドニア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20260809_ JMTjibaou%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260809_JMTjibaou\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e4%b8%96%e7%95%8c%e3%81%ae%e5%85%88%e4%bd%8f%e6%b0%91%e3%81%ae%e5%9b%bd%e9%9a%9b%e3%83%87%e3%83%bc&form=hpcapt&filters=HpDate:\"20260808_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260809_JMTjibaou"},"Ssd":"20260809","Name":"JMTjibaou","Market":"JA-JP","Hash":"3637480935","FullDateString":"2026 年 8月 月 9 日"},{"ImageContent":{"Description":"今日 8 月 8 日は国際無限大の日 (International Infinity Day) 。ニューヨークの哲学者ジャン＝ピエール・アディ・フェニョによって創設されたもので、哲学や科学、芸術を通じて無限の可能性を探求する日です。そして画像は、イングランドの都市、ストックトン＝オン＝ティーズに架かるインフィニティ・ブリッジ。この独特な形状が特徴的な歩道橋は、橋本体と水面に反射した橋が一体となることで、無限大記号「∞」の形を描き出します。また、夜はライトアップされ、人が渡るたびに色が変化し、ダイナミックかつ近未来的な雰囲気を醸し出します。","Image":{"Url":"/th?id=OHR.StocktonInfinity_JA-JP6357248728_1920x1080.webp","Wallpaper":"/th?id=OHR.StocktonInfinity_JA-JP6357248728_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は無限大の日","Title":"インフィニティ・ブリッジ, イングランド","Copyright":"© Bahadir Yeniceri/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/54.564794,-1.299192/11?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=54.564794,-1.299192;S9;インフィニティ・ブリッジ, イングランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Base