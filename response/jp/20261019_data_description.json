{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-10-19T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"今日の画像は、イタリア・ヴェネツィアにあるカナル・グランデ。全長は約 3.8km で、S字形を描きながら街を二分する大運河です。水上バス「ヴァポレット」や水上タクシー、ゴンドラなどが行き交う主要な水上交通路で、ヴェネツィアの「メインストリート」となっています。運河沿いには 13 世紀から 18 世紀にかけて建てられた歴史的な建造物が数多く残されており、カナル・グランデは、世界文化遺産「ヴェネツィアとその潟」を代表する景観のひとつとして知られています。","Image":{"Url":"/th?id=OHR.VeniceSunrise_JA-JP2535499489_1920x1080.webp","Wallpaper":"/th?id=OHR.VeniceSunrise_JA-JP2535499489_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"夕焼けに染まるヴェネツィアの大運河","Title":"カナル・グランデ, イタリア","Copyright":"© Juan Romero/Cavan Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/45.435337,12.32783/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=45.435337,12.32783;S9;カナル・グランデ, イタリア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261019_VeniceSunrise%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261019_VeniceSunrise\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%ab%e3%83%8a%e3%83%ab%e3%83%bb%e3%82%b0%e3%83%a9%e3%83%b3%e3%83%87&form=hpcapt&filters=HpDate:\"20261018_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261019_VeniceSunrise"},"Ssd":"20261019","Name":"VeniceSunrise","Market":"JA-JP","Hash":"2535499489","FullDateString":"2026 年 10月 月 19 日"},{"ImageContent":{"Description":"エリリ国立公園（旧スノードニア国立公園）は、面積約 2,130km² を誇るウェールズ最大の国立公園です。1951 年の今日、10 月 18 日に国立公園に指定されました。公園内には、ウェールズ最高峰のイール・ウィドファ（旧スノードン山）がそびえるなど、雄大な山岳風景が広がっています。そして画像は、公園内にあるドルバダーン城。13 世紀に築かれたウェールズを代表する城のひとつで、特徴的な円塔が美しい景観の中にたたずんでいます。","Image":{"Url":"/th?id=OHR.DolbadarnWales_JA-JP2361140889_1920x1080.webp","Wallpaper":"/th?id=OHR.DolbadarnWales_JA-JP2361140889_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"丘の上に佇む城跡","Title":"ドルバダーン城, ウェールズ","Copyright":"© joe daniel price/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.927253,-4.077652/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=52.927253,-4.077652;S9;エリリ国立公園, ウェールズ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261018_DolbadarnWales%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261018_DolbadarnWales\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%a8%e3%83%aa%e3%83%aa%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9c%92&form=hpcapt&filters=HpDate:\"20261017_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261018_DolbadarnWales"},"Ssd":"20261018","Name":"DolbadarnWales","Market":"JA-JP","Hash":"2361140889","FullDateString":"2026 年 10月 月 18 日"},{"ImageContent":{"Description":"柿は、秋を代表する果物のひとつです。生で食べるほか、干し柿などに加工して古くから親しまれてきました。そして画像は、長野県の妻籠宿で見られる干し柿の様子。秋から冬にかけて、鮮やかな柿の色が歴史ある街並みを彩ります。干し柿は、主に渋柿の皮をむいて乾燥させた伝統的な保存食です。干すことで渋みが感じられなくなり、水分が減ることで甘みが凝縮されます。作り方は地域や種類によって異なり、乾燥の途中や仕上げの段階で柿をもむなど、さまざまな工夫が受け継がれています。独特の食感と濃厚な甘みを楽しめる、秋から冬ならではの味覚です。","Image":{"Url":"/th?id=OHR.Persimmons2026_JA-JP2192858733_1920x1080.webp","Wallpaper":"/th?id=OHR.Persimmons2026_JA-JP2192858733_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"秋の風に揺れる干し柿","Title":"ずらりと並ぶ干し柿, 長野県 妻籠宿","Copyright":"© wayfarer2020/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.57494,137.595245/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.57494,137.595245;S9;妻籠宿&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261017_Persimmons2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261017_Persimmons2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%b9%b2%e3%81%97%e6%9f%bf&form=hpcapt&filters=HpDate:\"20261016_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261017_Persimmons2026"},"Ssd":"20261017","Name":"Persimmons2026","Market":"JA-JP","Hash":"2192858733","FullDateString":"2026 年 10月 月 17 日"},{"ImageContent":{"Description":"今日の画像は、米国コロラド州南西部、サンファン山地にそびえるスネフェル山。標高約 4,300m を誇るロッキー山脈の名峰です。コロラド州には標高 14,000 フィート（約 4,267m ）以上の山が 58 座あり、これらは総称して「フォーティーナーズ (Fourteeners) 」と呼ばれています。スネフェル山はその中でも特に人気が高く、その美しい山容から、写真の被写体としても人気があります。秋には山麓に黄金色のアスペン林が広がり、雪をいただいた山頂との美しいコントラストが訪れる人々を魅了します。","Image":{"Url":"/th?id=OHR.SneffelsAutumn_JA-JP1327078827_1920x1080.webp","Wallpaper":"/th?id=OHR.SneffelsAutumn_JA-JP1327078827_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"黄金色の森の先にそびえる山","Title":"スネフェル山, 米国 コロラド州","Copyright":"© lightphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.00354,-107.792695/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=38.00354,-107.792695;S9;スネフェル山, 米国 コロラド州&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261016_SneffelsAutumn%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261016_SneffelsAutumn\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b9%e3%83%8d%e3%83%95%e3%82%a7%e3%83%ab%e5%b1%b1+%e3%82%b3%e3%83%ad%e3%83%a9%e3%83%89%e5%b7%9e&form=hpcapt&filters=HpDate:\"20261015_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261016_SneffelsAutumn"},"Ssd":"20261016","Name":"SneffelsAutumn","Market":"JA-JP","Hash":"1327078827","FullDateString":"2026 年 10月 月 16 日"},{"ImageContent":{"Description":"夕暮れ時になると、ヴロツワフの歴史ある街並みが黄金色の光に包まれます。ポーランド南西部に位置するこの都市は、同国で最も古い都市の一つです。100 以上の橋で結ばれた水の都として知られ、中世の面影と現代の活気が調和しています。中心部には、13 世紀に開かれたリネク広場と旧市庁舎があり、多くの人でにぎわいます。画像は、聖マリア・マグダレーナ教会の「魔女の橋」から望んだ眺めです。旧市街や広場を一望でき、やわらかな灯りに照らされた街の幻想的な美しさを楽しむことができます。","Image":{"Url":"/th?id=OHR.WroclawPoland_JA-JP4298283472_1920x1080.webp","Wallpaper":"/th?id=OHR.WroclawPoland_JA-JP4298283472_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"黄金色に輝く旧市街","Title":"ヴロツワフ, ポーランド","Copyright":"© Piotr Mitelski/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/51.10977,17.034634/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=51.10977,17.034634;S9;ヴロツワフ, ポーランド&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261015_WroclawPoland%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261015_WroclawPoland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%b4%e3%83%ad%e3%83%84%e3%83%af%e3%83%95&form=hpcapt&filters=HpDate:\"20261014_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261015_WroclawPoland"},"Ssd":"20261015","Name":"WroclawPoland","Market":"JA-JP","Hash":"4298283472","FullDateString":"2026 年 10月 月 15 日"},{"ImageContent":{"Description":"10 月 14 日は「鉄道の日」。1872年の今日、初代新橋駅〜横浜駅（現 桜木町駅）間で日本初の鉄道が正式に開業したことにちなみ、1994 年に運輸省（現 国土交通省）が定めました。そして、今日の画像は京都・嵐山を走るトロッコ列車。秋の嵐山では、色づいた山々の間を嵯峨野トロッコ列車がゆっくりと走り抜けます。渓谷を流れる保津川と紅葉が織りなす風景は、多くの人々を魅了する秋の風物詩となっています。","Image":{"Url":"/th?id=OHR.RailwayDay2026_JA-JP4058067313_1920x1080.webp","Wallpaper":"/th?id=OHR.RailwayDay2026_JA-JP4058067313_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は鉄道の日","Title":"嵯峨野トロッコ列車, 京都府京都市","Copyright":"© giggsy25/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.009881,135.666763/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.009881,135.666763;S9;嵐山&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261014_RailwayDay2026 %22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261014_RailwayDay2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e9%89%84%e9%81%93%e3%81%ae%e6%97%a5&form=hpcapt&filters=HpDate:\"20261013_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261014_RailwayDay2026"},"Ssd":"20261014","Name":"RailwayDay2026","Market":"JA-JP","Hash":"4058067313","FullDateString":"2026 年 10月 月 14 日"},{"ImageContent":{"Description":"ここはクロアチア中部に位置するプリトヴィツェ湖群国立公園。高低差のある 16 の湖と、それを繋ぐ 92 の滝や瀑布という壮大な景観が特徴です。湖水は、含まれるミネラルの組成や太陽光の反射によって、エメラルドグリーンから深い青までさまざまな色合いを見せます。園内には木製の遊歩道が整備されており、滝が流れ落ちる様子や澄んだ湖面、木々に囲まれた岸辺などを間近に眺めることができます。こうした圧倒的な自然美と豊かな生態系が評価され、1979年にユネスコ世界遺産に登録されました。","Image":{"Url":"/th?id=OHR.PlitviceAutumn_JA-JP3930294400_1920x1080.webp","Wallpaper":"/th?id=OHR.PlitviceAutumn_JA-JP3930294400_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"紅葉に彩られた湖と滝","Title":"プリトヴィツェ湖群国立公園, クロアチア","Copyright":"© Jan Wlodarczyk/Alamy","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/44.866465,15.581867/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=44.866465,15.581867;S9;プリトヴィツェ湖群国立公園, クロアチア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261013_PlitviceAutumn%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261013_PlitviceAutumn\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%97%e3%83%aa%e3%83%88%e3%83%b4%e3%82%a3%e3%83%84%e3%82%a7%e6%b9%96%e7%be%a4%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9c%92&form=hpcapt&filters=HpDate:\"20261012_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261013_PlitviceAutumn"},"Ssd":"20261013","Name":"PlitviceAutumn","Market":"JA-JP","Hash":"3930294400","FullDateString":"2026 年 10月 月 13 日"}],"PreloadMediaContents":[{"ImageContent":{"Description":"今日の画像は、ブルガリア南部のロドピ山脈を流れるシトヴォ滝です。色づいた木々と流れ落ちる滝の組み合わせが、絵画のような美しさを演出します。この自然風景に加え、歴史もこの地域の魅力です。近くのシトヴォ村にはロドピ山脈の伝統的な家屋が残っているほか、近隣には石に刻まれた「シトヴォの碑文」があります。1928 年に初めて記録されたこの碑文は、現在も解読されておらず、その起源や意味はいまだ謎に包まれています。","Image":{"Url":"/th?id=OHR.SitovoWaterfall_JA-JP3524382726_1920x1080.webp","Wallpaper":"/th?id=OHR.SitovoWaterfall_JA-JP3524382726_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"紅葉の中を流れ落ちる滝","Title":"シトヴォ滝, ブルガリア","Copyright":"© Nadya85/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/41.950514,24.60924/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=41.950514,24.60924;S9;シトヴォ滝, ブルガリア&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261026_SitovoWaterfall%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261026_SitovoWaterfall\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Sitovo+waterfall&form=hpcapt&filters=HpDate:\"20261025_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261026_SitovoWaterfall"},"Ssd":"20261026","Name":"SitovoWaterfall","Market":"JA-JP","Hash":"3524382726","FullDateString":"2026 年 10月 月 26 日"},{"ImageContent":{"Description":"今日の画像は、米国ワイオミング州のイエローストーン国立公園内を歩く 2 頭のハイイロオオカミです。ユーラシア大陸と北米に広く生息しており、分厚い毛皮によって厳しい冬の寒さにも耐えることができます。家族単位の群れ（パック）で生活し、協力して狩りや子育て、縄張りの防衛を行います。20 世紀初頭に、イエローストーン国立公園からは一度姿を消しましたが、1995 年に再導入が開始されました。現在公園は、野生のハイイロオオカミを観察できる世界有数の場所として知られています。","Image":{"Url":"/th?id=OHR.YellowstoneWolves_JA-JP3378091323_1920x1080.webp","Wallpaper":"/th?id=OHR.YellowstoneWolves_JA-JP3378091323_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"冬の大地を進むオオカミたち","Title":"ハイイロオオカミ, 米国 ワイオミング州","Copyright":"© John Morrison/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/44.600378,-110.559997/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=44.600378,-110.559997;S9;イエローストーン国立公園, 米国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261025_YellowstoneWolves%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261025_YellowstoneWolves\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%83%8f%e3%82%a4%e3%82%a4%e3%83%ad%e3%82%aa%e3%82%aa%e3%82%ab%e3%83%9f&form=hpcapt&filters=HpDate:\"20261024_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261025_YellowstoneWolves"},"Ssd":"20261025","Name":"YellowstoneWolves","Market":"JA-JP","Hash":"3378091323","FullDateString":"2026 年 10月 月 25 日"},{"ImageContent":{"Description":"ここはブラジルのリオデジャネイロにある王立ポルトガル図書館。ブラジルがポルトガルから独立した後、ポルトガルの言語と文化の保存・振興を目的として 1837 年に設立されました。約 35 万冊の蔵書を有し、ポルトガル国外では最大級のポルトガル語文献コレクションを誇ります。広大な閲覧室には、20m 以上の高さを誇る巨大な本棚が設置され、ステンドグラスの天窓や、アーミラリー天球儀で美しく装飾されています。設立から2世紀近くが経った今も、ブラジルとポルトガルの文化的な結びつきを伝え続けています。","Image":{"Url":"/th?id=OHR.PortugueseLibrary_JA-JP3230226750_1920x1080.webp","Wallpaper":"/th?id=OHR.PortugueseLibrary_JA-JP3230226750_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"図書館の天窓から差し込む自然光","Title":"王立ポルトガル図書館, ブラジル","Copyright":"© Antonio Salaverry/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-22.905431,-43.182116/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=-22.905431,-43.182116;S9;王立ポルトガル図書館, ブラジル&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261024_PortugueseLibrary%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261024_PortugueseLibrary\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e7%8e%8b%e7%ab%8b%e3%83%9d%e3%83%ab%e3%83%88%e3%82%ac%e3%83%ab%e5%9b%b3%e6%9b%b8%e9%a4%a8&form=hpcapt&filters=HpDate:\"20261023_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261024_PortugueseLibrary"},"Ssd":"20261024","Name":"PortugueseLibrary","Market":"JA-JP","Hash":"3230226750","FullDateString":"2026 年 10月 月 24 日"},{"ImageContent":{"Description":"今日 10 月 23 日は、二十四節気の「霜降」。朝晩の冷え込みが一層厳しくなり、木々の紅葉が進む時期でもあります。そしてここは、青森県十和田市の蔦温泉の近くにある蔦沼。十和田八幡平国立公園内にある景勝地で、「蔦七沼」の一つとして知られています。ブナの天然林に囲まれた蔦沼は、蔦温泉から徒歩約 10 分の場所にあり、四季折々の美しい風景を気軽に楽しめます。最大の魅力は、風のない朝に現れる「水鏡」で、周囲のブナ林が水面に映り込み、幻想的な風景が広がります。","Image":{"Url":"/th?id=OHR.TsutanumaMomiji2026_JA-JP3102211799_1920x1080.webp","Wallpaper":"/th?id=OHR.TsutanumaMomiji2026_JA-JP3102211799_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"今日は霜降","Title":"蔦沼, 青森県 十和田市","Copyright":"© MASATO SAITO/Getty images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/40.61325,40.61325/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=40.61325,40.61325;S9;蔦沼&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261023_TsutanumaMomiji2026%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261023_TsutanumaMomiji2026\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e8%94%a6%e6%b2%bc&form=hpcapt&filters=HpDate:\"20261022_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261023_TsutanumaMomiji2026"},"Ssd":"20261023","Name":"TsutanumaMomiji2026","Market":"JA-JP","Hash":"3102211799","FullDateString":"2026 年 10月 月 23 日"},{"ImageContent":{"Description":"ここは韓国南西部に位置する内蔵山（ネジャンサン）国立公園。内蔵山は「内蔵九峰」と呼ばれる 9 つの峰からなり、その最高峰は標高 763m の神仙峰（シンソンボン）です。公園は韓国を代表する紅葉の名所として知られ、秋には山々が鮮やかに色づきます。「内蔵山」という名前には、「山の中に隠された宝が尽きることなくある」という意味が込められています。そして画像は、公園を代表する風景のひとつとして親しまれている羽化亭（ウファジョン）と呼ばれる東屋です。","Image":{"Url":"/th?id=OHR.NaejangsanNP_JA-JP2962795317_1920x1080.webp","Wallpaper":"/th?id=OHR.NaejangsanNP_JA-JP2962795317_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"紅葉に彩られた東屋","Title":"内蔵山国立公園, 韓国","Copyright":"© Twenty47studio/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/35.481191,126.889374/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=35.481191,126.889374;S9;内蔵山国立公園, 韓国&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261022_NaejangsanNP%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261022_NaejangsanNP\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e5%86%85%e8%94%b5%e5%b1%b1%e5%9b%bd%e7%ab%8b%e5%85%ac%e5%9c%92&form=hpcapt&filters=HpDate:\"20261021_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261022_NaejangsanNP"},"Ssd":"20261022","Name":"NaejangsanNP","Market":"JA-JP","Hash":"2962795317","FullDateString":"2026 年 10月 月 22 日"},{"ImageContent":{"Description":"今日の画像は、ベトナム・フエ市の香水川に架かるグエン・ホアン橋。全長約 380m の近代的なアーチ橋で、フー・スアン区とトゥアン・ホア区を結んでいます。2025 年 3 月 26 日に開通したもので、自動車用の車線と歩道が整備されています。地域の重要な交通インフラであり、フエの文化を取り入れたデザインが特徴です。橋の照明は王宮の天蓋をイメージしてデザインされており、伝統と現代建築が調和した美しい景観を演出しています。","Image":{"Url":"/th?id=OHR.VietnamBridge_JA-JP2833280767_1920x1080.webp","Wallpaper":"/th?id=OHR.VietnamBridge_JA-JP2833280767_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"ライトアップされたアーチ橋","Title":"グエン・ホアン橋, ベトナム","Copyright":"© VU PHAM VAN/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/16.455292,107.55998/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=16.455292,107.55998;S9;グエン・ホアン橋, ベトナム&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":"/search?q=Bing+%e3%83%88%e3%83%aa%e3%83%93%e3%82%a2%e3%82%af%e3%82%a4%e3%82%ba&setmkt=JA-JP&filters=IsConversation%3a%22True%22+WQOskey:%22HPQuiz_20261021_VietnamBridge%22+WQId:%221%22&form=hpbal1"},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261021_VietnamBridge\"&FORM=HPQUIZ","BackstageUrl":"/search?q=%e3%82%b0%e3%82%a8%e3%83%b3%e3%83%bb%e3%83%9b%e3%82%a2%e3%83%b3%e6%a9%8b&form=hpcapt&filters=HpDate:\"20261020_1500\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261021_VietnamBridge"},"Ssd":"20261021","Name":"VietnamBridge","Market":"JA-JP","Hash":"2833280767","FullDateString":"2026 年 10月 月 21 日"},{"ImageContent":{"Description":"今日の画像は、ゆったりとした動作が特徴のナマケモノ。中南米の森林に生息し、生活のほとんどを樹上で過ごします。地上での動きはとても遅いものの、実は泳ぐのが得意という特徴があり、地上よりも数倍速く動くことが可能です。また、毛に藻が生えることがあるものの、その緑色が天敵から身を隠す保護色の役割を果たします。さらに、その毛には「ナマケモノガ」と呼ばれる蛾の仲間など、さまざまな生物も暮らしており、独自の「微小生態系」が形成されています。","Image":{"Url":"/th?id=OHR.BrownSloth_JA-JP2697515435_1920x1080.webp","Wallpaper":"/th?id=OHR.BrownSloth_JA-JP2697515435_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"木の枝にぶら下がるナマケモノ","Title":"木の枝にぶら下がるナマケモノ, コスタリカ","Copyright":"© Suzi Eszterhas/Minden Pictures","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/9.65531,-82.755699/16?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=ja-JP&od=2&shading=flat&pp=9.65531,-82.755699;S9;プエルトビエホ, リモン, コスタリカ&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks