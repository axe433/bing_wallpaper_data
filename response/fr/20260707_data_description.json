{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-07-07T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"Un bec multifonction et un plumage aux couleurs chatoyantes : le toucan montagnard est l’un des oiseaux les plus emblématiques des Andes. Il vit dans les forêts humides d’altitude d’Équateur et du sud-ouest de la Colombie, parfaitement adapté à la vie dans la canopée.","Image":{"Url":"/th?id=OHR.MountainToucanOrchids_FR-FR9785340325_1920x1080.webp","Wallpaper":"/th?id=OHR.MountainToucanOrchids_FR-FR9785340325_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Un bec pas si plat","Title":"Toucan montagnard à bec plat avec des orchidées, Équateur","Copyright":"© Murray Cooper/Minden Pictures","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Le toucan montagnard à bec plat possède un bec coloré orné d'une « plaque » jaune pâle, une caractéristique rare qui donne son nom à cette espèce.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260707_MountainToucanOrchids\"&FORM=HPQUIZ","BackstageUrl":"/search?q=toucan+montagnard&form=hpcapt&filters=HpDate:\"20260706_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260707_MountainToucanOrchids"},"Ssd":"20260707","Name":"MountainToucanOrchids","Market":"FR-FR","Hash":"9785340325","FullDateString":"7 juil. 2026"},{"ImageContent":{"Description":"Fondée par des colons grecs de Corinthe vers 734 avant J.C., Syracuse (Sicile, Italie) fut l’une des grandes puissances de la Méditerranée antique. Aujourd’hui inscrite au patrimoine mondial de l’UNESCO avec la nécropole rocheuse de Pantalica, la ville reste associée à Archimède et à Platon, qui y séjourna dans l’espoir de rapprocher philosophie et pouvoir.","Image":{"Url":"/th?id=OHR.SyracuseItaly_FR-FR9604430573_1920x1080.webp","Wallpaper":"/th?id=OHR.SyracuseItaly_FR-FR9604430573_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Des siècles d'Histoire","Title":"Syracuse au coucher du soleil, Sicile, Italie","Copyright":"© Balate Dorin/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.067122,15.285311/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=37.067122,15.285311;S9;Syracuse, Sicile, Italie&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260706_SyracuseItaly\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Syracuse+Sicile&form=hpcapt&filters=HpDate:\"20260705_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260706_SyracuseItaly"},"Ssd":"20260706","Name":"SyracuseItaly","Market":"FR-FR","Hash":"9604430573","FullDateString":"6 juil. 2026"},{"ImageContent":{"Description":"Au cœur de la Provence, sur le plateau de Valensole, l’été s’accorde aux tons violets. Situé dans le Parc naturel régional du Verdon, entre les vallées de la Durance et de l’Asse, ce vaste plateau offre, de mi-juin à début juillet, l’un des paysages les plus emblématiques de Provence. Lorsque la lavande et le lavandin fleurissent, l’air se charge de leurs parfums caractéristiques.","Image":{"Url":"/th?id=OHR.LavenderRows_FR-FR9535531184_1920x1080.webp","Wallpaper":"/th?id=OHR.LavenderRows_FR-FR9535531184_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Les mers pourpres","Title":"Champs de lavande, Plateau de Valensole, Provence","Copyright":"© Robert Harding/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/43.857636,5.974437/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=43.857636,5.974437;S9;Plateau de Valensole, Provence&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260705_LavenderRows\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Lavande&form=hpcapt&filters=HpDate:\"20260704_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260705_LavenderRows"},"Ssd":"20260705","Name":"LavenderRows","Market":"FR-FR","Hash":"9535531184","FullDateString":"5 juil. 2026"},{"ImageContent":{"Description":"C’est le Grand Départ pour le Tour de France 2026 ! Le parcours s’élance depuis Barcelone, mais au fil des étapes, il traverse de nombreux villages français. Nous avons choisi l’Alsace avec Kaysersberg, niché sur les rives de la Weiss, près de Colmar et au pied des Vosges. Ce bourg historique semble suspendu entre rivière et montagnes.","Image":{"Url":"/th?id=OHR.KaysersbergVillage_FR-FR8479653154_1920x1080.webp","Wallpaper":"/th?id=OHR.KaysersbergVillage_FR-FR8479653154_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Faire un Tour au village","Title":"Kaysersberg, Alsace","Copyright":"© Federica Gentile/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.18747,7.215853/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=48.18747,7.215853;S9;Kaysersberg&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260704_KaysersbergVillage\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Kaysersberg+Alsace&form=hpcapt&filters=HpDate:\"20260703_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260704_KaysersbergVillage"},"Ssd":"20260704","Name":"KaysersbergVillage","Market":"FR-FR","Hash":"8479653154","FullDateString":"4 juil. 2026"},{"ImageContent":{"Description":"Dans la préfecture d'Okayama, au Japon, lorsque l'air humide flotte au-dessus des cours d'eau, les hotaru, les lucioles japonaises, se mettent à clignoter. Elles s'illuminent souvent environ deux heures après le coucher du soleil, invitant au silence au bord de l'eau.","Image":{"Url":"/th?id=OHR.FirefliesJapan_FR-FR8593158782_1920x1080.webp","Wallpaper":"/th?id=OHR.FirefliesJapan_FR-FR8593158782_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"La féerie des lucioles","Title":"Lucioles scintillant au-dessus d'un ruisseau, Okayama, Japon","Copyright":"© tdub303/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/34.822845,133.813507/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=34.822845,133.813507;S9;Préfecture d’Okayama, Japon&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260703_FirefliesJapan\"&FORM=HPQUIZ","BackstageUrl":"/search?q=luciole&form=hpcapt&filters=HpDate:\"20260702_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260703_FirefliesJapan"},"Ssd":"20260703","Name":"FirefliesJapan","Market":"FR-FR","Hash":"8593158782","FullDateString":"3 juil. 2026"},{"ImageContent":{"Description":"Au sud de Louxor, en Égypte, le temple d’Esna plonge les visiteurs dans le culte de Khnoum, dieu à tête de bélier associé à la création de l’Humanité à partir de l’argile du Nil. Principalement construit à l’époque ptolémaïque puis romaine, il possède une salle hypostyle remarquablement conservée, grâce à la poussière qui l’a couvert pendant des siècles.","Image":{"Url":"/th?id=OHR.TempleEsna_FR-FR7122811032_1920x1080.webp","Wallpaper":"/th?id=OHR.TempleEsna_FR-FR7122811032_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Dans l'univers sacré d'Esna","Title":"Plafond du temple d'Esna, Égypte","Copyright":"© Nick Brundle Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/25.293581,32.556398/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=25.293581,32.556398;S9;Temple d'Esna, Égypte&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260702_TempleEsna\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Temple+Khnoum+Esna+Egypte&form=hpcapt&filters=HpDate:\"20260701_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260702_TempleEsna"},"Ssd":"20260702","Name":"TempleEsna","Market":"FR-FR","Hash":"7122811032","FullDateString":"2 juil. 2026"},{"ImageContent":{"Description":"Puisque nos amis canadiens fêtent aujourd’hui leur grand jour, rendons-leur visite ! Direction le Parc provincial de Dungeon, sur la côte sauvage de Terre-Neuve-et-Labrador, où les falaises abruptes dominent un littoral battu par l’Atlantique.","Image":{"Url":"/th?id=OHR.DungeonPark_FR-FR7667168923_1920x1080.webp","Wallpaper":"/th?id=OHR.DungeonPark_FR-FR7667168923_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Le Canada, sculpté par l'Atlantique","Title":"Parc provincial de Dungeon, Terre-Neuve-et-Labrador, Canada","Copyright":"© Kaitlyn McLachlan/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.666842,-53.084148/2?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=48.666842,-53.084148;S9;Parc provincial de Dungeon, Terre-Neuve-et-Labrador, Canada&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260701_DungeonPark\"&FORM=HPQUIZ","BackstageUrl":"/search?q=F%c3%aate+du+Canada&form=hpcapt&filters=HpDate:\"20260630_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260701_DungeonPark"},"Ssd":"20260701","Name":"DungeonPark","Market":"FR-FR","Hash":"7667168923","FullDateString":"1 juil. 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"Chaque année, le 14 juillet, la nuit s’illumine aux quatre coins du pays. Des plus petits villages aux grandes métropoles, les feux d’artifice rassemblent des millions de personnes venues célébrer la Fête nationale, souvenir de la prise de la Bastille en 1789, événement fondateur de la Révolution française.","Image":{"Url":"/th?id=OHR.BastilleSacreCoeur_FR-FR3878699722_1920x1080.webp","Wallpaper":"/th?id=OHR.BastilleSacreCoeur_FR-FR3878699722_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Allons, enfants sur le parvis","Title":"Feux d’artifice face à la basilique du Sacré-Cœur, Montmartre, Paris","Copyright":"© marc_land/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.886379,2.343062/7?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=48.886379,2.343062;S9;Basilique du Sacré-Cœur, Montmartre, Paris&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260714_BastilleSacreCoeur\"&FORM=HPQUIZ","BackstageUrl":"/search?q=F%c3%aate+nationale+fran%c3%a7aise&form=hpcapt&filters=HpDate:\"20260713_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260714_BastilleSacreCoeur"},"Ssd":"20260714","Name":"BastilleSacreCoeur","Market":"FR-FR","Hash":"3878699722","FullDateString":"14 juil. 2026"},{"ImageContent":{"Description":"À l’est de Page, en Arizona, États-Unis, sur les terres de la Nation Navajo, Antelope Canyon se dévoile comme une rivière figée dans la pierre. Ses parois de grès rouge et orangé ondulent en courbes douces, sculptées par des crues soudaines qui, siècle après siècle, ont creusé ce passage étroit.","Image":{"Url":"/th?id=OHR.NavajoSandstone_FR-FR2547131354_1920x1080.webp","Wallpaper":"/th?id=OHR.NavajoSandstone_FR-FR2547131354_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Ondes minérales","Title":"Antelope Canyon, territoire Navajo, Arizona, États-Unis","Copyright":"© Mark Skalny/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/40.837774,-118.280526/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=40.837774,-118.280526;S9;Antelope Canyon, Arizona, États-Unis&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260713_NavajoSandstone\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Antelope+canyon+fente&form=hpcapt&filters=HpDate:\"20260712_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260713_NavajoSandstone"},"Ssd":"20260713","Name":"NavajoSandstone","Market":"FR-FR","Hash":"2547131354","FullDateString":"13 juil. 2026"},{"ImageContent":{"Description":"Pour découvrir le Maine (États-Unis) dans ce qu’il a de plus sauvage, il faut venir ici. Le monument national des Bois et des Eaux de Katahdin couvre près de 35 000 hectares de forêts profondes, où étangs silencieux et pistes isolées composent un paysage brut et préservé.","Image":{"Url":"/th?id=OHR.KatahdinWWNM_FR-FR2337328139_1920x1080.webp","Wallpaper":"/th?id=OHR.KatahdinWWNM_FR-FR2337328139_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Le côté sauvage du Maine","Title":"Monument national des bois et des eaux de Katahdin, Maine, États-Unis","Copyright":"© Cavan Images/Offset/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/46.156481,-68.717751/2?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=46.156481,-68.717751;S9;Monument national de Katahdin, Maine, États-Unis&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260712_KatahdinWWNM\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Monument+des+bois+et+des+eaux+Katahdin&form=hpcapt&filters=HpDate:\"20260711_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260712_KatahdinWWNM"},"Ssd":"20260712","Name":"KatahdinWWNM","Market":"FR-FR","Hash":"2337328139","FullDateString":"12 juil. 2026"},{"ImageContent":{"Description":"Au sud d’Auray, le port de Saint-Goustan s’étend là où le Loc’h rejoint la rivière d’Auray avant de s’ouvrir vers le golfe du Morbihan. Ce havre pittoresque, protégé par les méandres de l’estuaire, conserve l’atmosphère d’un ancien port breton. Dès le XIIIᵉ siècle, les ducs de Bretagne y firent bâtir un pont, un port et une forteresse aujourd’hui disparue, mais les quais pavés, les ruelles étroites et les maisons à pans de bois témoignent encore de ce passé.","Image":{"Url":"/th?id=OHR.AurayBrittany_FR-FR2151221761_1920x1080.webp","Wallpaper":"/th?id=OHR.AurayBrittany_FR-FR2151221761_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Niché au creux du Loc'h","Title":"Port de Saint-Goustan, Auray, Bretagne","Copyright":"© Rolf E. Staerk/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/47.664311,-2.977482/6?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=47.664311,-2.977482;S9;Port de Saint-Goustan, Auray&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260711_AurayBrittany\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Auray+Saint-Goustan+France&form=hpcapt&filters=HpDate:\"20260710_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260711_AurayBrittany"},"Ssd":"20260711","Name":"AurayBrittany","Market":"FR-FR","Hash":"2151221761","FullDateString":"11 juil. 2026"},{"ImageContent":{"Description":"Vue du ciel, la côte de Victoria déploie de longues plages dorées, des eaux turquoise et des falaises sculptées par les vents du puissant océan Austral. Sur plus de 1 800 kilomètres de littoral, la terre et la mer façonnent depuis des millénaires les paysages du sud‑est australien.","Image":{"Url":"/th?id=OHR.VictoriaBeach_FR-FR3702097800_1920x1080.webp","Wallpaper":"/th?id=OHR.VictoriaBeach_FR-FR3702097800_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Le pays des rivages mouvants","Title":"Vue aérienne des terres et de l'océan, Victoria, Australie","Copyright":"© Nearmap/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/-36.850086,144.304291/3?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=-36.850086,144.304291;S9;Victoria, Australie&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260710_VictoriaBeach\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Victoria+Australie&form=hpcapt&filters=HpDate:\"20260709_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260710_VictoriaBeach"},"Ssd":"20260710","Name":"VictoriaBeach","Market":"FR-FR","Hash":"3702097800","FullDateString":"10 juil. 2026"},{"ImageContent":{"Description":"La lumière du soleil perce les nuages et éclaire les rizières en terrasses de Sapa, qui dévalent les montagnes comme un immense escalier vivant. Située dans la province de Lào Cai, au Vietnam, cette région spectaculaire a été façonnée au fil des siècles par les communautés ethniques locales, notamment les Hmong. Génération après génération, elles ont aménagé ces terrasses et mis au point un ingénieux réseau d'irrigation permettant de cultiver le riz sur des pentes escarpées.","Image":{"Url":"/th?id=OHR.SapaVietnam_FR-FR9797558235_1920x1080.webp","Wallpaper":"/th?id=OHR.SapaVietnam_FR-FR9797558235_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Une autre montée des marches","Title":"Champs de riz à Sapa, Lào Cai, Vietnam","Copyright":"© Anujak Jaimook/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/22.374456,103.842076/4?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=22.374456,103.842076;S9;Sapa, Lào Cai, Vietnam&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260709_SapaVietnam\"&FORM=HPQUIZ","BackstageUrl":"/search?q=L%c3%a0o+Cai+Vietnam&form=hpcapt&filters=HpDate:\"20260708_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260709_SapaVietnam"},"Ssd":"20260709","Name":"SapaVietnam","Market":"FR-FR","Hash":"9797558235","FullDateString":"9 juil. 2026"},{"ImageContent":{"Description":"Situé dans les hauts plateaux de l'ouest du Guatemala, le lac Atitlán occupe une vaste caldeira volcanique. Ses eaux d'un bleu profond sont encadrées par les parois abruptes du cratère et les volcans coniques Atitlán, Tolimán et San Pedro. Des jetées en bois s'avancent dans les eaux calmes du lac, soulignant le contraste entre sa surface paisible et le relief accidenté façonné par l'activité volcanique.","Image":{"Url":"/th?id=OHR.LakeAtitlan_FR-FR9789294273_1920x1080.webp","Wallpaper":"/th?id=OHR.LakeAtitlan_FR-FR9789294273_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Échos d'un passé volcanique","Title":"Lever du soleil sur le lac Atitlán, Guatemala","Copyright":"© shayes17/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/14.702858,-91.194628/3?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=fr-FR&od=2&shading=flat&pp=14.702858,-91.194628;S9;Lac Atitlán, Guatemala&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20260708_LakeAtitlan\"&FORM=HPQUIZ","BackstageUrl":"/search?q=lac+atitlan+guatemala&form=hpcapt&filters=HpDate:\"20260707_2200\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20260708_LakeAtitlan"},"Ssd":"20260708","Name":"LakeAtitlan","Market":"FR-FR","Hash":"9789294273","FullDateString":"8 juil. 2026"}],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"Image du jour","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"En savoir plus","LOC_HOMEPAGE_VERTICAL_SCROLL_DONATE_NOW":"Faire un don","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"Le saviez-vous :","LOC_HOMEPAGE_GALLERY_CARD_TITLE":"Images récentes de la page d’accueil","LOC_HOMEPAGE_VERTICAL_SCROLL_GALLERY_IMAGE_ARIALABEL":"Image de page d’accueil pour {0}","LOC_HOME