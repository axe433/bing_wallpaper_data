{"ClientSettings":{"Pn":{"Cn":1,"St":0,"Qs":0,"Prod":"P"},"Sc":{"Cn":1,"St":0,"Qs":0,"Prod":"H"},"Qz":{"Cn":1,"St":0,"Qs":0,"Prod":"T"},"Ap":true,"Mute":true,"Lad":"2026-11-14T00:00:00Z","Iotd":0,"Gwb":0,"Tns":0,"Dft":null,"Mvs":0,"Flt":0,"Imp":1,"Tobn":0},"MediaContents":[{"ImageContent":{"Description":"Welcome to Hong Kong, home to more skyscrapers than any other city in the world. Those pictured here tower above Victoria Harbour, whose deep waters helped the island develop into a busy trading port. Ships carrying tea, silk and other goods have passed through since the 1840s, but growth accelerated in the decades after the Second World War, fuelling a construction boom. With little flat land available between the harbour and the hills, developers had to build upwards, creating this distinctive skyline. As of 2026, Hong Kong has 569 completed buildings at least 150 metres tall — more than any other city in the world.","Image":{"Url":"/th?id=OHR.BlueHK_EN-GB3274323919_1920x1080.webp","Wallpaper":"/th?id=OHR.BlueHK_EN-GB3274323919_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"The only way is up","Title":"Victoria Harbour, Hong Kong, China","Copyright":"© Juan Romero/Cavan Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/22.285,114.165/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=22.285,114.165;S9;Victoria Harbour, Hong Kong&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261114_BlueHK\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Victoria+Harbour+Hong+Kong&form=hpcapt&filters=HpDate:\"20261114_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261114_BlueHK"},"Ssd":"20261114","Name":"BlueHK","Market":"EN-GB","Hash":"3274323919","FullDateString":"14 Nov 2026"},{"ImageContent":{"Description":"Dawn's first light reflects off the frozen surface of Abraham Lake, framed by the peaks of the Rocky Mountains. In winter, this picturesque lake in Alberta is famous for its frozen methane bubbles, trapped beneath the ice. Strong winds keep the ice largely clear of snow, revealing the bubbles below throughout the winter. As spring arrives and the ice thaws, the trapped gas can escape into the atmosphere.","Image":{"Url":"/th?id=OHR.AbrahamCanada_EN-GB1908527515_1920x1080.webp","Wallpaper":"/th?id=OHR.AbrahamCanada_EN-GB1908527515_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Hidden depths","Title":"Abraham Lake in Alberta, Canada","Copyright":"© Guang Cao/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/52.1392,-116.4355/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=52.1392,-116.4355;S9;Abraham Lake, Alberta&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261113_AbrahamCanada\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Abraham+Lake+Alberta&form=hpcapt&filters=HpDate:\"20261113_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261113_AbrahamCanada"},"Ssd":"20261113","Name":"AbrahamCanada","Market":"EN-GB","Hash":"1908527515","FullDateString":"13 Nov 2026"},{"ImageContent":{"Description":"Just north of Moab, Utah, Arches National Park is home to more than 2,000 natural sandstone arches – the densest concentration of arches in the world. Today's image, North Window, is one of the best-known formations in the park's Windows Section, where towering fins, openings and sculpted sandstone create a landscape that looks almost architectural.","Image":{"Url":"/th?id=OHR.NorthWindow_EN-GB5518413161_1920x1080.webp","Wallpaper":"/th?id=OHR.NorthWindow_EN-GB5518413161_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Architecture without an architect","Title":"North Window, Arches National Park, Moab, Utah, USA","Copyright":"© lightphoto/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/38.6857117,-109.5328291/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=38.6857117,-109.5328291;S9;North Window, Arches National Park, Moab, Utah&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261112_NorthWindow\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Arches+National+Park&form=hpcapt&filters=HpDate:\"20261112_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261112_NorthWindow"},"Ssd":"20261112","Name":"NorthWindow","Market":"EN-GB","Hash":"5518413161","FullDateString":"12 Nov 2026"},{"ImageContent":{"Description":"For Remembrance Day, we are looking out over a field of poppies, recognised as symbols of remembrance for more than a century.","Image":{"Url":"/th?id=OHR.PoppiesField_EN-GB3947926925_1920x1080.webp","Wallpaper":"/th?id=OHR.PoppiesField_EN-GB3947926925_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"We will remember them","Title":"A field of poppies","Copyright":"© lloyd-horgan/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"The Poppy Appeal raised £56.6m in 2025 for work to support serving personnel, veterans and their families.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261111_PoppiesField\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Remembrance+Day&form=hpcapt&filters=HpDate:\"20261111_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261111_PoppiesField"},"Ssd":"20261111","Name":"PoppiesField","Market":"EN-GB","Hash":"3947926925","FullDateString":"11 Nov 2026"},{"ImageContent":{"Description":"From above, Rose Island looks like a brushstroke of green surrounded by every shade of blue. Just five kilometres east of Paradise Island in The Bahamas, this slender cay trades busy roads and city blocks for sandy shores, shallow waters and an inland lagoon. Its peaceful appearance comes with a touch of movie drama. Rose Island was used as a filming location for the 1965 James Bond adventure Thunderball, including the explosive destruction of the Disco Volante.","Image":{"Url":"/th?id=OHR.RoseIsland_EN-GB4222638797_1920x1080.webp","Wallpaper":"/th?id=OHR.RoseIsland_EN-GB4222638797_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Licensed to chill","Title":"Aerial view of Rose Island, The Bahamas","Copyright":"© Abstract Aerial Art/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/25.088243,-77.225304/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=25.088243,-77.225304;S9;Rose Island, The Bahamas&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261110_RoseIsland\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Rose+Island+Bahamas&form=hpcapt&filters=HpDate:\"20261110_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261110_RoseIsland"},"Ssd":"20261110","Name":"RoseIsland","Market":"EN-GB","Hash":"4222638797","FullDateString":"10 Nov 2026"},{"ImageContent":{"Description":"Cross the Guadalquivir River in Seville, the capital of Spain's Andalusia region, and the city's rhythm seems to change. On the other side lies Triana, a colourful neighbourhood where ceramics, flamenco and local traditions are woven into everyday life. Since the 19th century, the Isabel II Bridge, also known as the Triana Bridge, has connected the neighbourhood to Seville's historic centre.","Image":{"Url":"/th?id=OHR.TrianaSpain_EN-GB4312074959_1920x1080.webp","Wallpaper":"/th?id=OHR.TrianaSpain_EN-GB4312074959_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Where art finds its rhythm","Title":"Historic district of Triana, Seville, Spain","Copyright":"© Andrzej Rostek/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/37.382904,-6.006341/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=37.382904,-6.006341;S9;Triana, Seville, Spain&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261109_TrianaSpain\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Seville+Spain&form=hpcapt&filters=HpDate:\"20261109_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261109_TrianaSpain"},"Ssd":"20261109","Name":"TrianaSpain","Market":"EN-GB","Hash":"4312074959","FullDateString":"9 Nov 2026"},{"ImageContent":{"Description":"What happens when the darkest night of the year gets the brightest celebration? Diwali. The Festival of Lights is celebrated by millions worldwide, bringing together diyas, lanterns, rangoli, prayers, sweets and family gatherings.","Image":{"Url":"/th?id=OHR.DiwaliLamps_EN-GB4404345220_1920x1080.webp","Wallpaper":"/th?id=OHR.DiwaliLamps_EN-GB4404345220_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"A celebration that shines","Title":"Lanterns for Diwali in Mumbai, Maharashtra, India","Copyright":"© Dinodia Photo/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/18.969048,72.821182/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=18.969048,72.821182;S9;Mumbai, Maharashtra, India&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261108_DiwaliLamps\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Diwali&form=hpcapt&filters=HpDate:\"20261108_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261108_DiwaliLamps"},"Ssd":"20261108","Name":"DiwaliLamps","Market":"EN-GB","Hash":"4404345220","FullDateString":"8 Nov 2026"}],"PreloadMediaContents":[{"ImageContent":{"Description":"Bathed in a sun-kissed glow, Nice is a patchwork of terracotta rooftops, historic churches and pastel façades along the French Riviera, as seen in today's image. Founded by the ancient Greeks and long associated with the Italian House of Savoy, Nice officially became part of France in 1860. Today, its layered past remains visible throughout this coastal city in the south of France, where historic architecture meets the blue waters of the Mediterranean and the sunlit hills of the Côte d'Azur.","Image":{"Url":"/th?id=OHR.RedNice_EN-GB3371662260_1920x1080.webp","Wallpaper":"/th?id=OHR.RedNice_EN-GB3371662260_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Terracotta dreams","Title":"Nice, Provence-Alpes-Côte d'Azur, France","Copyright":"© Siripong Kaewla-iad/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/43.70094,7.26839/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=43.70094,7.26839;S9;Nice, France&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261121_RedNice\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Nice+France&form=hpcapt&filters=HpDate:\"20261121_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261121_RedNice"},"Ssd":"20261121","Name":"RedNice","Market":"EN-GB","Hash":"3371662260","FullDateString":"21 Nov 2026"},{"ImageContent":{"Description":"Off the coast of Kvaløya in Troms, northern Norway, humpback whales move through the cold Arctic waters in search of a proper feast. They visit the region in winter, following migrating herring into the fjords. Humpbacks are known for their remarkable feeding techniques, including bubble-net feeding, in which some whales blow rings or walls of bubbles to corral fish before surging upwards with their mouths open to catch their prey. In today's image, a humpback slips beneath the icy waves under a glowing pastel sky, capturing a moment of tranquillity in Norway's wild north.","Image":{"Url":"/th?id=OHR.Megaptera_EN-GB2786065203_1920x1080.webp","Wallpaper":"/th?id=OHR.Megaptera_EN-GB2786065203_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Feasting in the fjords","Title":"Diving humpback whale, Kvaloya, Troms, Northern Norway","Copyright":"© Espen Bergersen/Minden Pictures","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/69.62389,18.53103/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=69.62389,18.53103;S9;Kvaloya, Troms, Norway&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261120_Megaptera\"&FORM=HPQUIZ","BackstageUrl":"/search?q=humpback+whales&form=hpcapt&filters=HpDate:\"20261120_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261120_Megaptera"},"Ssd":"20261120","Name":"Megaptera","Market":"EN-GB","Hash":"2786065203","FullDateString":"20 Nov 2026"},{"ImageContent":{"Description":"It's World Philosophy Day, when thinkers come together to explore life's enduring questions. To mark the occasion, today's image features \"Body of Knowledge\", a sculpture at Goethe University in Frankfurt, Germany. Created by Spanish artist Jaume Plensa, it combines steel letters from eight different alphabets to form a human figure. Plensa explains: 'Our body is the home of the spirit. The place in which ideas live.'","Image":{"Url":"/th?id=OHR.KnowledgeSculpture_EN-GB1364284090_1920x1080.webp","Wallpaper":"/th?id=OHR.KnowledgeSculpture_EN-GB1364284090_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":false},"Headline":"Where ideas take shape","Title":"The \"Body of Knowledge\" sculpture by Jaume Plensa at Goethe University in Frankfurt, Germany","Copyright":"© Todamo/Shutterstock","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/50.127805,8.667807/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=50.127805,8.667807;S9;Goethe University, Frankfurt&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261119_KnowledgeSculpture\"&FORM=HPQUIZ","BackstageUrl":"/search?q=World+Philosophy+Day&form=hpcapt&filters=HpDate:\"20261119_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261119_KnowledgeSculpture"},"Ssd":"20261119","Name":"KnowledgeSculpture","Market":"EN-GB","Hash":"1364284090","FullDateString":"19 Nov 2026"},{"ImageContent":{"Description":"These barn owls, bathed in the evening light, are waiting for the hunt to begin. As night falls, the birds of prey swoop into action, listening for the faint movements of mice and voles in the grass and leaves. Their heart-shaped faces help funnel sound towards their exceptionally sensitive ears, allowing them to locate prey with remarkable precision in the dark. They then swoop down almost silently, their soft feathers helping to muffle the sound of their approach.","Image":{"Url":"/th?id=OHR.BarnOwlsUnite_EN-GB9873814926_1920x1080.webp","Wallpaper":"/th?id=OHR.BarnOwlsUnite_EN-GB9873814926_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Hunting from dusk till dawn","Title":"Pair of barn owls","Copyright":"© Zahoor Salmi/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"Barn owls don't hoot; they make eerie, screeching noises, which might explain their reputation as harbingers of doom.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261118_BarnOwlsUnite\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Barn+owl&form=hpcapt&filters=HpDate:\"20261118_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261118_BarnOwlsUnite"},"Ssd":"20261118","Name":"BarnOwlsUnite","Market":"EN-GB","Hash":"9873814926","FullDateString":"18 Nov 2026"},{"ImageContent":{"Description":"Today's image features the Trail of the Cedars, one of 1,126 kilometres of hiking trails in Glacier National Park, Montana. Its 1.4km-long loop includes a raised boardwalk which cuts a path through western red cedars and hemlock trees. The park boasts routes for all abilities, taking in alpine lakes, wildflower meadows, mountain passes and wilderness stretching to the Canadian border.","Image":{"Url":"/th?id=OHR.TrailCedars_EN-GB2504891943_1920x1080.webp","Wallpaper":"/th?id=OHR.TrailCedars_EN-GB2504891943_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Step into the great outdoors","Title":"Trail of the Cedars, Glacier National Park, Montana, USA","Copyright":"© DBushue Photography/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/48.706957,-113.817235/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=48.706957,-113.817235;S9;Glacier National Park, Montana&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261117_TrailCedars\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Trail+of+the+Cedars+Glacier+National+Park+Montana&form=hpcapt&filters=HpDate:\"20261117_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261117_TrailCedars"},"Ssd":"20261117","Name":"TrailCedars","Market":"EN-GB","Hash":"2504891943","FullDateString":"17 Nov 2026"},{"ImageContent":{"Description":"Incredible views and rock-solid foundations are part of the charm of these ancient dwellings, set into the cliffside in New Mexico. Nomads had long used the natural caves above Cliff Dweller Creek as temporary shelter, but it was the Native American Mogollon people who made them their home. Archaeologists believe they created dozens of rooms inside five alcoves in the 1270s and 1280s. Up to 15 families lived here at any one time, raising children, making pottery and overlooking the fertile Gila River valley where they grew crops and hunted wildlife. For reasons unknown, the Mogollon people moved on around 1300, leaving behind one of the American Southwest's most important archaeological sites.","Image":{"Url":"/th?id=OHR.GilaCliff_EN-GB1863069273_1920x1080.webp","Wallpaper":"/th?id=OHR.GilaCliff_EN-GB1863069273_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Built to last","Title":"Gila Cliff Dwellings National Monument, New Mexico, USA","Copyright":"© Chiara Salvadori/Getty Images","SocialGood":null,"MapLink":{"Url":"//platform.bing.com/geo/REST/v1/Imagery/Map/RoadVibrant/33.254028,108.272634/5?key=AsSOKo7OOz5VAtfAj0rjgaXlhCrCZI6PGbLj7GCH8IW2HUalyg4BVhqA0z77PRCj&c=en-GB&od=2&shading=flat&pp=33.254028,108.272634;S9;Gila Cliff Dwellings National Monument, New Mexico&st=pp|v:false;lv:false_trs|v:false;lv:false&ml=Basemap,Landmarks&logo=no&mapSize=386,434&da=ro","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261116_GilaCliff\"&FORM=HPQUIZ","BackstageUrl":"/search?q=Gila+Cliff+Dwellings+National+Monument&form=hpcapt&filters=HpDate:\"20261116_0000\"+mgzv3configlist:\"BingQA_Encyclopedia_Layout\"","TriviaId":"HPQuiz_20261116_GilaCliff"},"Ssd":"20261116","Name":"GilaCliff","Market":"EN-GB","Hash":"1863069273","FullDateString":"16 Nov 2026"},{"ImageContent":{"Description":"As autumn's first frost sets in, ice crystals form on the leaves of evergreen shrubs, such as this azalea. The pinks, oranges and yellows of their spring blooms have long since faded, but a new colourful display awaits as their green leaves turn shades of red and purple. For the plants, these pigments can help protect leaves against environmental stresses as temperatures drop. For gardeners, they create a vibrant autumnal display, framed in white frost. When spring arrives, fresh green growth will emerge, and the colourful cycle begins anew.","Image":{"Url":"/th?id=OHR.FirstFrost_EN-GB4338987849_1920x1080.webp","Wallpaper":"/th?id=OHR.FirstFrost_EN-GB4338987849_1920x1200.jpg&rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Frosty foliage","Title":"Frozen azalea with red leaves","Copyright":"© avoferten/Shutterstock","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"The pigments that turn azalea leaves shades of red or purple are called anthocyanins.","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz&filters=WQOskey:\"HPQuiz_20261115_FirstFrost\"&FORM=HPQUIZ","BackstageUrl":"/search?q=azaleas&form=hpcapt&filters=HpDate:\"20261115_0000\"+mgzv3configlist:\"BingQ